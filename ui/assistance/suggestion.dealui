import * as app from "./experience";
import * as ui from "./platform.dealui-pack";
// @ui-root
export view Suggestion(state: app.State): View {
    ui.Card() {
        ui.Text(text: "Suggestion", style: "caption")
        ui.Text(text: state.title, style: "heading")
        ui.Row() {
            ui.Button(text: "Open", enabled: !state.busy, onClick: action app.Open {value: payload}, style: "primary")
            ui.Button(text: "Dismiss", enabled: !state.busy, onClick: action app.Dismiss {value: payload}, style: "secondary")
        }
    }
}
