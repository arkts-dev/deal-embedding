export class Amount { id: string; label: string; minorUnits: number; }
export class State { amounts: Amount[] ; status: string; }
export function initialState(): State {
    let packageAmount: Amount = { id: "package", label: "Package", minorUnits: 1200 };
    let separateAmount: Amount = { id: "separate", label: "Separate items", minorUnits: 1300 };
    return { amounts: [packageAmount, separateAmount], status: "Package costs less" };
}
export function main(): null { return null; }
