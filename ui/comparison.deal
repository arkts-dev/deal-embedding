import * as values from "ui/values";
export class State { approved: number; committed: number; difference: number; status: string; }
export class Approved { value: number; }
export class Committed { value: number; }
export class Reset {}
export function initialState(): State { return {approved: 18000, committed: 19750, difference: 1750, status: "Over budget"}; }
function compare(approved: number, committed: number): State {
    let difference: number = committed - approved;
    let status: string = "On budget";
    if (difference > 0) { status = "Over budget"; }
    if (difference < 0) { status = "Under budget"; difference = 0 - difference; }
    return { approved: approved, committed: committed, difference: difference, status: status };
}
// @ui-update
export function approved(state: State, action: Approved): State {
    if (!values.inBounds(action.value, 0, 10000000)) { return compare(state.approved, state.committed); }
    return compare(action.value, state.committed);
}
// @ui-update
export function committed(state: State, action: Committed): State {
    if (!values.inBounds(action.value, 0, 10000000)) { return compare(state.approved, state.committed); }
    return compare(state.approved, action.value);
}
// @ui-update
export function reset(state: State, action: Reset): State { return initialState(); }
export function main(): null { return null; }
