export class NumberStatProps { label: string; value: number; supporting: string = ""; icon: string = ""; prefix: string = ""; suffix: string = ""; minimumDigits: number = 1; decimals: number = -1; style: string = ""; }
export class KeyValueItemProps { label: string; value: string; supporting: string = ""; style: string = ""; }
export class ListGroupProps { title: string = ""; style: string = ""; }
export class TimelineProps { title: string = ""; style: string = ""; }
export class ListItemProps { title: string; subtitle: string = ""; trailing: string = ""; icon: string = ""; onTap?: Action; eventValue: number = 0; enabled: boolean = true; style: string = ""; accessibilityLabel?: string; }
export class TimelineItemProps { title: string; subtitle: string = ""; trailing: string = ""; icon: string = ""; onTap?: Action; eventValue: number = 0; enabled: boolean = true; style: string = ""; accessibilityLabel?: string; }
export class NumberListItemProps { title: string; value: number; subtitle: string = ""; icon: string = ""; prefix: string = ""; suffix: string = ""; minimumDigits: number = 1; decimals: number = -1; onTap?: Action; eventValue: number = 0; enabled: boolean = true; style: string = ""; accessibilityLabel?: string; }
export class TableProps { headers: string[] = []; columns: number; style: string = ""; }
export class TableRowProps { cells: string[]; style: string = ""; }
export class ButtonProps { text: string; onClick?: Action; value: number = 0; enabled: boolean = true; style: string = ""; accessibilityLabel?: string; }
export class CellProps { text: string; onClick?: Action; value: number = 0; enabled: boolean = true; style: string = ""; accessibilityLabel?: string; }
export class IconButtonProps { icon: string; label: string; onClick?: Action; value: number = 0; enabled: boolean = true; style: string = ""; accessibilityLabel?: string; }
export class TextFieldProps { label: string; value: string; onChange?: Action; keyboardType: string = ""; required: boolean = false; email: boolean = false; minLength: number = 0; maxLength: number = 0; pattern: string = ""; requiredMessage: string = ""; emailMessage: string = ""; minLengthMessage: string = ""; maxLengthMessage: string = ""; patternMessage: string = ""; style: string = ""; accessibilityLabel?: string; }
export class NumberFieldProps { label: string; value: number; minimum: number; maximum: number; onChange?: Action; step: number = 1; style: string = ""; accessibilityLabel?: string; }
export class TimeFieldProps { label: string; value: number; onChange?: Action; style: string = ""; accessibilityLabel?: string; }
export class DateFieldProps { label: string; value: number; onChange?: Action; style: string = ""; accessibilityLabel?: string; }
