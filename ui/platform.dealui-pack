export class SpacerProps { style: string = ""; }
export class TimerProps { millis: number; down: boolean; style: string = ""; }
export class TickerProps { id: string; intervalMs: number; running: boolean; onTick: Action; style: string = ""; }
export class BackHandlerProps { onBack: Action; }
export class PathProps { commands: string; spinPeriodMs: number = 0; onTap?: Action; value: number = 0; style: string = ""; accessibilityLabel?: string; }
export class MotionProps { trigger: number; style: string = "pop"; }
export class TransformProps { pose: number[]; durationMs: number; size: number = 0; style: string = ""; }
export class StageProps { perspective: number = 900; height: number = 0; style: string = ""; }
export class SurfaceProps { width: number; height: number; shapes: graphics.Shape[]; onFrame?: Action; onPointer?: Action; style: string = ""; accessibilityLabel?: string; }
export class SparklineProps { series: number[]; maximum: number; label: string = ""; seriesLabel: string = ""; series2Label: string = ""; series2Style: string = ""; bars: boolean = false; series2: number[] = []; categories: string[] = []; minimum: number = 0; style: string = ""; }

export component Column(props: ColumnProps): View { children optional; capability "renderer.Column"; }
export component Row(props: RowProps): View { children optional; capability "renderer.Row"; }
export component Card(props: CardProps): View { children optional; capability "renderer.Card"; }
export component Scroll(props: ScrollProps): View { children optional; capability "renderer.Scroll"; }
export component ActionBar(props: ActionBarProps): View { children required Button | IconButton | Badge; capability "renderer.ActionBar"; }
export component TileGrid(props: TileGridProps): View { children required Tile; capability "renderer.TileGrid"; }
export component Canvas(props: CanvasProps): View { children required Path; capability "renderer.Canvas"; }
