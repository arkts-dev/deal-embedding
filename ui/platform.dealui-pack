export component Timeline(props: TimelineProps): View { children required TimelineItem | ActionBar; capability "renderer.Timeline"; }
export component ListItem(props: ListItemProps): View { event onTap(payload: number); accessibility accessibilityLabel; capability "renderer.ListItem"; }
export component TimelineItem(props: TimelineItemProps): View { event onTap(payload: number); accessibility accessibilityLabel; capability "renderer.TimelineItem"; }
export component NumberListItem(props: NumberListItemProps): View { event onTap(payload: number); accessibility accessibilityLabel; capability "renderer.NumberListItem"; }
