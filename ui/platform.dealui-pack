export class CheckboxProps { label: string; checked: boolean; onChange?: Action; style: string = ""; accessibilityLabel?: string; }
export class SliderProps { label: string; value: number; minimum: number; maximum: number; onChange?: Action; style: string = ""; accessibilityLabel?: string; }
export class SelectProps { labels: string[]; selected: number; onChange?: Action; style: string = ""; accessibilityLabel?: string; }
export class TabsProps { labels: string[]; selected: number; onChange?: Action; style: string = ""; accessibilityLabel?: string; }
export class InsetBannerProps { title: string; message: string; actionText: string = ""; icon: string = ""; onAction?: Action; style: string = ""; accessibilityLabel?: string; }
export class EmptyStateProps { title: string; message: string; actionText: string = ""; icon: string = ""; onAction?: Action; style: string = ""; accessibilityLabel?: string; }
