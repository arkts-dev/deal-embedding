{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "fragments",
    "commands",
    "display"
  ],
  "properties": {
    "title": {
      "type": "string"
    },
    "fragments": {
      "type": "array",
      "items": {
        "anyOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "input"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "format",
                  "value",
                  "minimum",
                  "maximum"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "integer",
                      "money",
                      "time",
                      "text",
                      "boolean"
                    ]
                  },
                  "value": {
                    "anyOf": [
                      {
                        "type": "number"
                      },
                      {
                        "type": "string"
                      },
                      {
                        "type": "boolean"
                      }
                    ]
                  },
                  "minimum": {
                    "type": "number",
                    "description": "Numeric lower bound <= initial value; time at least 0. Text/boolean use zero placeholders."
                  },
                  "maximum": {
                    "type": "number",
                    "description": "Numeric upper bound >= initial value and minimum. For time at most 1439 (never 1440). Only text/boolean use zero placeholders."
                  }
                }
              }
            },
            "description": "Publishes <id>.value, never a bare identifier. Preserve period instants with text format."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "read"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "binding",
                  "arguments"
                ],
                "properties": {
                  "binding": {
                    "$ref": "#/$defs/binding"
                  },
                  "arguments": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/formula"
                    }
                  }
                }
              }
            },
            "description": "Publishes <id>.result and <id>.present; input arguments use <inputId>.value."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "result"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "label",
                  "format",
                  "value"
                ],
                "properties": {
                  "label": {
                    "type": "string"
                  },
                  "format": {
                    "type": "string",
                    "enum": [
                      "money",
                      "time",
                      "number",
                      "integer",
                      "text"
                    ]
                  },
                  "value": {
                    "$ref": "#/$defs/formula"
                  }
                }
              }
            },
            "description": "Pure derived output. References require an actual fragment ID and its published port."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "comparison"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "limit",
                  "actual",
                  "label"
                ],
                "properties": {
                  "limit": {
                    "$ref": "#/$defs/formula"
                  },
                  "actual": {
                    "$ref": "#/$defs/formula"
                  },
                  "label": {
                    "type": "string"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "choice"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "identity",
                  "label",
                  "eligible",
                  "cost"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/$defs/formula"
                  },
                  "identity": {
                    "$ref": "#/$defs/formula"
                  },
                  "label": {
                    "$ref": "#/$defs/formula"
                  },
                  "eligible": {
                    "$ref": "#/$defs/formula"
                  },
                  "cost": {
                    "$ref": "#/$defs/formula"
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "allocation"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "identity",
                  "label",
                  "cost",
                  "eligible",
                  "total",
                  "budget",
                  "surcharge",
                  "quotas"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/$defs/formula"
                  },
                  "identity": {
                    "$ref": "#/$defs/formula"
                  },
                  "label": {
                    "$ref": "#/$defs/formula"
                  },
                  "cost": {
                    "$ref": "#/$defs/formula"
                  },
                  "eligible": {
                    "$ref": "#/$defs/formula"
                  },
                  "total": {
                    "$ref": "#/$defs/formula"
                  },
                  "budget": {
                    "$ref": "#/$defs/formula"
                  },
                  "surcharge": {
                    "$ref": "#/$defs/formula"
                  },
                  "quotas": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "minimum",
                        "predicate"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "minimum": {
                          "$ref": "#/$defs/formula"
                        },
                        "predicate": {
                          "$ref": "#/$defs/formula"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "alternatives"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "identity",
                  "label",
                  "stock",
                  "components",
                  "roles"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/$defs/formula"
                  },
                  "identity": {
                    "$ref": "#/$defs/formula"
                  },
                  "label": {
                    "$ref": "#/$defs/formula"
                  },
                  "stock": {
                    "$ref": "#/$defs/formula"
                  },
                  "components": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "source",
                      "identity",
                      "quantity"
                    ],
                    "properties": {
                      "source": {
                        "$ref": "#/$defs/formula",
                        "description": "Current catalogue row component array, e.g. row.components or row.parts; NOT the full catalogue."
                      },
                      "identity": {
                        "$ref": "#/$defs/formula"
                      },
                      "quantity": {
                        "$ref": "#/$defs/formula"
                      }
                    }
                  },
                  "roles": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": [
                        "label",
                        "quantity",
                        "predicate"
                      ],
                      "properties": {
                        "label": {
                          "type": "string"
                        },
                        "quantity": {
                          "$ref": "#/$defs/formula"
                        },
                        "predicate": {
                          "$ref": "#/$defs/formula"
                        }
                      }
                    }
                  }
                }
              }
            },
            "description": "Publishes <id>.baskets; never <id>.result. Roles consume distinct physical units."
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "id",
              "kind",
              "config"
            ],
            "properties": {
              "id": {
                "type": "string",
                "description": "Actual fragment identifier used verbatim in formulas; no hyphens or reserved row/item/reply."
              },
              "kind": {
                "type": "string",
                "enum": [
                  "quotes"
                ]
              },
              "config": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "source",
                  "binding",
                  "arguments",
                  "cost",
                  "deposit",
                  "available",
                  "ttlMillis",
                  "budget"
                ],
                "properties": {
                  "source": {
                    "$ref": "#/$defs/formula"
                  },
                  "binding": {
                    "$ref": "#/$defs/binding"
                  },
                  "arguments": {
                    "type": "array",
                    "items": {
                      "anyOf": [
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind",
                            "value"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "value"
                              ]
                            },
                            "value": {
                              "$ref": "#/$defs/formula"
                            }
                          }
                        },
                        {
                          "type": "object",
                          "additionalProperties": false,
                          "required": [
                            "kind",
                            "encoding",
                            "idField",
                            "quantityField"
                          ],
                          "properties": {
                            "kind": {
                              "type": "string",
                              "enum": [
                                "basket"
                              ]
                            },
                            "encoding": {
                              "type": "string",
                              "enum": [
                                "idQuantity",
                                "records"
                              ]
                            },
                            "idField": {
                              "type": "string"
                            },
                            "quantityField": {
                              "type": "string"
                            }
                          }
                        }
                      ]
                    }
                  },
                  "cost": {
                    "$ref": "#/$defs/formula",
                    "description": "Pure formula over the actual provider reply: reply.field, NOT row.field."
                  },
                  "deposit": {
                    "$ref": "#/$defs/formula",
                    "description": "Pure formula over the actual provider reply: reply.field, NOT row.field."
                  },
                  "available": {
                    "$ref": "#/$defs/formula",
                    "description": "Pure formula over the actual provider reply: reply.field, NOT row.field."
                  },
                  "ttlMillis": {
                    "$ref": "#/$defs/formula",
                    "description": "Pure formula over the actual provider reply: reply.field, NOT row.field."
                  },
                  "budget": {
                    "$ref": "#/$defs/formula"
                  }
                }
              }
            }
          }
        ]
      }
    },
    "commands": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "targets"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "targets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "description": "Each resource belongs to one explicit command; reuse it to refresh. Local-only composition uses an empty array. Never duplicate load and refresh commands over shared resources."
    },
    "display": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "formula": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr"
      ],
      "properties": {
        "expr": {
          "type": "string",
          "description": "Pure expression. Use actualId.value for inputs, actualId.result for reads, actualId.baskets for alternatives. Never write literal prefixes instance or port. Collection predicates use row.field; quote response formulas use reply.field."
        }
      }
    },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "function"
      ],
      "properties": {
        "module": {
          "type": "string"
        },
        "function": {
          "type": "string"
        }
      }
    }
  }
}
