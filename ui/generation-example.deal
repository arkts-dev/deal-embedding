import * as sample from "host/sample";
export class State { loading: boolean = false; message: string = ""; value: int = 0; ready: boolean = false; }
export class Load {}
export class Done { message: string = ""; value: int = 0; ready: boolean = false; }
export function initialState(): State { return {}; }
// A fresh outer helper preserves scalar fields without permitting nested alias mutation.
function copy(state: State): State { return { loading: state.loading, message: state.message, value: state.value, ready: state.ready }; }
// @ui-update
export function begin(state: State, action: Load): State {
    let result: State = copy(state);
    result.loading = true;
    result.message = "";
    return result;
}
// @ui-effect
export async function read(state: State, action: Load): Done {
    try { let value: int = await sample.value(); return { value: value, ready: true }; }
    catch (error) { return { message: "Check access and try again", value: state.value }; }
}
// @ui-update
export function finish(state: State, action: Done): State {
    return { loading: false, message: action.message, value: action.value, ready: action.ready };
}
export function main(): null { return null; }
