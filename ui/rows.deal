export class Row { id: string; quantity: number; }
export class State { rows: Row[] ; }
export class SetQuantity { id: string; value: number; }
export class Reverse {}
export class Remove {}
export function initialState(): State { return { rows: [{ id: "a", quantity: 1 }, { id: "b", quantity: 2 }] }; }
// @ui-update
export function setQuantity(state: State, action: SetQuantity): State {
    let rows: Row[] = [];
    for (let row: Row of state.rows) {
        let quantity: number = row.quantity;
        if (row.id === action.id && action.value >= 0 && action.value <= 20) { quantity = action.value; }
        rows[rows.length] = { id: row.id, quantity: quantity };
    }
    return { rows: rows };
}
// @ui-update
export function reverse(state: State, action: Reverse): State {
    let rows: Row[] = [];
    { let i: number = state.rows.length - 1; while (i >= 0) {  rows[rows.length] = state.rows[i];  i = i - 1; } }
    return { rows: rows };
}
// @ui-update
export function remove(state: State, action: Remove): State {
    let rows: Row[] = [];
    for (let row: Row of state.rows) { if (row.id !== "a") { rows[rows.length] = row; } }
    return { rows: rows };
}
export function main(): null { return null; }
