import * as search from "./support/alternatives";
export class State { baskets: search.Basket[]; }
export function initialState(): State { let baskets: search.Basket[] = []; return {baskets:baskets}; }
export function enumerate(rows: search.Row[], requirements: number[]): State { return {baskets:search.enumerate(rows,requirements)}; }
export function main(): null { return null; }
