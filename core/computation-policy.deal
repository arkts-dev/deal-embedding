import * as decoded from "./decoded";
import * as s from "./construction-schema";
import * as syntax from "embedding/fragment-syntax";

export class Facts { functions: Record<string, unknown>; pureImports: string[]; aliases: string[]; aliased: boolean; }
// An import alias is a call/member receiver only. Any other occurrence (for example `let m = net;`) binds
// an effectful value to a local name, which would hide the receiver of a later call from the pure-intrinsic
// admission below: that region is refused as untrusted instead of guessed at.
function identifierChar(value: string): boolean { return value !== "" && "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789_".includes(value); }
// Whether a position lies in code rather than in a string literal or a line comment, so an alias spelling
// inside authored text is never mistaken for a bound import.
function inCode(source: string, position: number): boolean {
  let index: number = 0; let quote: string = ""; let comment: boolean = false;
  while (index < position) {
    let ch: string = source.substring(index,index+1); let next: string = source.substring(index+1,index+2);
    if (comment) { if (ch === "\n") { comment = false; } index = index+1; }
    else if (quote !== "") { if (ch === "\\") { index = index+2; } else { if (ch === quote) { quote = ""; } index = index+1; } }
    else if (ch === "/" && next === "/") { comment = true; index = index+2; }
    else if (ch === "\"" || ch === "'") { quote = ch; index = index+1; }
    else { index = index+1; }
  }
  return quote === "" && !comment;
}
function boundAlias(source: string, alias: string): boolean {
  if (alias === "") { return false; }
  let index: number = source.indexOf(alias);
  while (index >= 0) {
    let before: string = ""; if (index > 0) { before = source.substring(index-1,index); }
    let after: string = source.substring(index+alias.length,index+alias.length+1);
    let token: boolean = !identifierChar(before) && !identifierChar(after);
    if (token && after !== "." && inCode(source,index)) { return true; }
    index = source.indexOf(alias,index+1);
  }
  return false;
}
export async function inspect(source: string, imports: Record<string, string>, types: Record<string, string>): Promise<Facts> {
  let pure: string[] = []; let aliases: string[] = []; let aliased: boolean = false;
  for (let alias of Object.keys(imports)) {
    let module: string = imports[alias] as string;
    aliases[aliases.length] = alias;
    if (boundAlias(source,alias)) { aliased = true; }
    if (s.contains(["std/math","std/string","std/table"],module)) { pure[pure.length] = alias; }
  }
  return {functions:JSON.parse(await syntax.analyzeFunctions(s.encode({source:source,types:types}))),pureImports:pure,aliases:aliases,aliased:aliased};
}
// The call chain to the rejected construct, so a located reason names the helper that carries it. An
// empty chain (the computation's own expression) adds no clause instead of a dangling separator.
function chain(path: string[]): string { if (path.length === 0) { return ""; } return " via "+path.join(">"); }
function check(fact: Record<string, unknown>, facts: Facts, reads: string[], path: string[]): void {
  if (fact.indirect as boolean) { s.reject("Recomputation requires checked read-only summary for indirect/effectful calls"+chain(path)); }
  // Fresh local computation is legal (docs/spec-v0.8.md:363): a container this helper allocated
  // itself is written without reaching any committed value, so its element and field writes are the
  // mechanic a constructive calculation over actual records uses. A write that reaches the state
  // parameter or a container of unproven provenance stays refused here; a write through a borrowed
  // local is the borrowed-state write the ownership policy rejects for every helper of the instance.
  for (let target of decoded.strings(fact.writes)) { s.reject("Recomputation writes state or an unproven container: "+target+chain(path)); }
  for (let read of decoded.strings(fact.reads)) {
    let parts: string[] = read.split(".");
    if (parts[0] === "state") { if (parts.length < 2 || !s.contains(reads,parts[1])) { s.reject("Undeclared computation read: "+read); } }
  }
  for (let call of decoded.strings(fact.calls)) {
    let parts: string[] = call.split(".");
    if (["Array.isArray","String","Number","Number.isFinite","Number.isNaN","JSON.stringify","Math.floor","Math.ceil","Math.sqrt","Math.abs","Math.round","Math.min","Math.max","Math.pow"].includes(call)) { }
    else if (parts.length === 2 && s.contains(facts.pureImports,parts[0])) { }
    // Pure receiver intrinsics: the ECMAScript string and nonmutating array operations return fresh
    // values and never write, so a case-insensitive match or a slice stays a read-only summary. Mutators
    // (push/pop/splice/sort/reverse) and any callback-taking operation are absent: a callback is an
    // indirect value and stays rejected above.
    // A pure receiver intrinsic is admitted only when its receiver root is the state or a local value:
    // a call on an import alias that is not a known pure module stays effectful and rejected.
    else if (parts.length >= 2 && s.contains(["toLowerCase","toUpperCase","substring","slice","trim","split","replace","includes","startsWith","endsWith","indexOf","lastIndexOf","join","toSorted"],parts[parts.length-1]) && (parts[0] === "state" || !s.contains(facts.aliases,parts[0]))) { }
    else if (parts.length === 1 && Object.hasOwn(facts.functions,call)) {
      if (s.contains(path,call)) { s.reject("Recursive recomputation helper lacks bounded read-only summary"); }
      const next = path.concat([call]);
      check(facts.functions[call] as Record<string, unknown>,facts,reads,next);
    } else { s.reject("Effectful or unverified recomputation call: "+call+chain(path)); }
  }
}
export function checkedExpression(encoded: string, facts: Facts, reads: string[]): void {
  if (facts.aliased) { s.reject("Aliased import in a read-only summary"); }
  let fact: Record<string, unknown> = JSON.parse(encoded);
  check(fact,facts,reads,[]);
}
export async function expression(source: string, facts: Facts, reads: string[]): Promise<void> {
  checkedExpression(await syntax.analyzeExpression(s.encode({source:source})),facts,reads);
}
export function main(): void { return; }
