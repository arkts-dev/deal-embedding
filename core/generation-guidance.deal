import * as decoded from "./decoded";
import * as assets from "./generation-guidance.generated";

// Portable composition prose is packaged from ui/; contract facts remain build-derived.
export function composition(): string { return assets.composition(); }
export function componentFacts(pack: Record<string, unknown>): string {
    let out: string = ""; let components: Record<string, unknown>[] = decoded.records(pack.components);
    for (let component of components) {
        let name: string = (component.name as string); let fields: Record<string, unknown>[] = decoded.records(component.fields); let contracts: Record<string, unknown>[] = decoded.records(component.contracts);
        let callArguments: string = ""; let requiredProps: string = "";
        for (let field of fields) {
            let fieldName: string = (field.name as string); let type: string = (field.type as string);
            let defaultKind: string = (field.defaultKind as string); let defaultText: string = (field.defaultText as string); let required: boolean = (field.required as boolean);
            if (required) { if (requiredProps !== "") { requiredProps = requiredProps + ", "; } requiredProps = requiredProps + fieldName; }
            let action: boolean = type === "Action";
            for (let contract of contracts) {
                let kind: string = (contract.kind as string);
                if (kind === "event") { let prop: string = (contract.prop as string); if (prop === fieldName) { action = true; } }
            }
            if (callArguments !== "") { callArguments = callArguments + ", "; }
            callArguments = callArguments + fieldName + ": " + type;
            if (!required) { callArguments = callArguments + " (optional";
                if (defaultKind === "string") { callArguments = callArguments + ", default string '" + defaultText + "'"; }
                if (defaultKind === "number" || defaultKind === "boolean") { callArguments = callArguments + ", default " + defaultText; }
                callArguments = callArguments + ")";
            }
            if (action) { callArguments = callArguments + " [use events, not props]"; }
        }
        let behaviour: string = ""; let children: boolean = false;
        if (requiredProps !== "") { behaviour = "required props: " + requiredProps; }
        for (let contract of contracts) {
            let kind: string = (contract.kind as string); let text: string = "";
            if (kind === "event") {
                let prop: string = (contract.prop as string); let payload: string = (contract.payload as string);
                text = "raises " + prop;
                if (payload !== "") { text = text + " carrying a " + payload + " payload"; }
            }
            if (kind === "children") {
                children = true; let required: boolean = (contract.required as boolean); let childTypes: string = (contract.types as string);
                text = "accepts children"; if (required) { text = "requires children"; }
                if (childTypes !== "") { text = text + " of types " + childTypes; }
            }
            if (text !== "") { if (behaviour !== "") { behaviour = behaviour + "; "; } behaviour = behaviour + text; }
        }
        if (out !== "") { out = out + "\n"; }
        out = out + "- " + name + ": " + callArguments;
        if (children) { out = out + "; children are view IDs"; }
        if (behaviour !== "") { out = out + "  [" + behaviour + "]"; }
    }
    return out;
}
export function guidance(): string {
    return assets.behavior();
}
export function pureGuidance(): string { return "DEAL 1.5 PURE FUNCTION BODY RULES\n"+assets.language(); }
export function sourceGuidance(): string { return "DEAL 1.5 SOURCE RULES\n" + assets.language() + "\n\nRENDERER\n" + assets.renderer(); }
export function main(): null { return null; }
