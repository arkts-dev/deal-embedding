import * as decoded from "./decoded";
import * as assets from "./generation-guidance.generated";

// Portable composition prose is packaged from ui/; contract facts remain build-derived.
export function composition(): string { return assets.composition(); }
export function workflow(): string {
    return "\n\nFINAL WORKFLOW CHECK\n" +
        "Check proposed initial values against supporting facts. Task deadlines are not operation periods. Preserve an explicit operation period and its timezone: convert local clock times to offset-bearing instants, never append Z to unchanged local time. The friendly period label must represent the same instants sent to capabilities.\n" +
        "Implement the whole task from intent AND supporting facts, including alternatives, exact specifications, quantities and budget. Resolve unknown IDs/prices/stock through explicit reads. Match specification, units and included contents from returned records, not names alone; exclude incompatible options and show concise qualifying details. Never silently omit a requested alternative.\n" +
        "Preserve provider authority: invoke every required external read on explicit user action, never emulate a provider formula or return sample values locally. After actual data loads, compute the requested initial feasible allocation/selection across all supplied constraints, unless manual selection was explicitly requested; editable empty controls alone do not satisfy a planning request. Keep pending and infeasible distinct from success.\n" +
        "Keep supplied numeric assumptions editable. Use IntField format euro-cents for budget and recompute against its state field, never a hard-coded ceiling. Changing provider inputs clears old results until refreshed; local budget edits recompute without reads. Use TimeField for editable minute-of-day; preserve offset-bearing instants and show a concise friendly period instead of machine-format text fields.\n" +
        "Compare requested packages and components from actual returned data. Show hire cost and any returned deposit separately. Keep one useful primary action and concise results. Use typed maintained operations for initial construction, then edit_sources for exact targeted source repairs. submit_custom is explicitly measured custom behavior; full-source write_file is available only after explicit source_fallback. Never put raw source into maintained data fields.\n" +
        "Preserve selected maintained behavior and every uncovered requirement. The framework owns compact assembly; models fill only issued custom interfaces or explicitly request source_fallback. Collection fields retain every disclosed nesting level; never flatten provider records.\n";
}
export function componentFacts(pack: Record<string, unknown>): string {
    let out: string = ""; let components: Record<string, unknown>[] = decoded.records(pack.components);
    for (let component of components) {
        let name: string = (component.name as string); let fields: Record<string, unknown>[] = decoded.records(component.fields); let contracts: Record<string, unknown>[] = decoded.records(component.contracts);
        let callArguments: string = ""; let requiredProps: string = "";
        for (let field of fields) {
            let fieldName: string = (field.name as string); let type: string = (field.type as string);
            let defaultKind: string = (field.defaultKind as string); let defaultText: string = (field.defaultText as string); let required: boolean = (field.required as boolean);
            if (required) { if (requiredProps !== "") { requiredProps = requiredProps + ", "; } requiredProps = requiredProps + fieldName; }
            let action: boolean = type === "Action";
            for (let contract of contracts) {
                let kind: string = (contract.kind as string);
                if (kind === "event") { let prop: string = (contract.prop as string); if (prop === fieldName) { action = true; } }
            }
            if (callArguments !== "") { callArguments = callArguments + ", "; }
            callArguments = callArguments + fieldName + ": " + type;
            if (!required) { callArguments = callArguments + " (optional";
                if (defaultKind === "string") { callArguments = callArguments + ", default string '" + defaultText + "'"; }
                if (defaultKind === "number" || defaultKind === "boolean") { callArguments = callArguments + ", default " + defaultText; }
                callArguments = callArguments + ")";
            }
            if (action) { callArguments = callArguments + " [use events, not props]"; }
        }
        let behaviour: string = ""; let children: boolean = false;
        if (requiredProps !== "") { behaviour = "required props: " + requiredProps; }
        for (let contract of contracts) {
            let kind: string = (contract.kind as string); let text: string = "";
            if (kind === "event") {
                let prop: string = (contract.prop as string); let payload: string = (contract.payload as string);
                text = "raises " + prop;
                if (payload !== "") { text = text + " carrying a " + payload + " payload"; }
            }
            if (kind === "children") {
                children = true; let required: boolean = (contract.required as boolean); let childTypes: string = (contract.types as string);
                text = "accepts children"; if (required) { text = "requires children"; }
                if (childTypes !== "") { text = text + " of types " + childTypes; }
            }
            if (text !== "") { if (behaviour !== "") { behaviour = behaviour + "; "; } behaviour = behaviour + text; }
        }
        if (out !== "") { out = out + "\n"; }
        out = out + "- " + name + ": " + callArguments;
        if (children) { out = out + "; children are view IDs"; }
        if (behaviour !== "") { out = out + "  [" + behaviour + "]"; }
    }
    return out;
}
export function guidance(): string {
    return assets.behavior();
}
export function needs(): string {
    return "Extract requirements as one JSON object, not source or a compact plan. Shape: {title:string,terms:[{id,op,args,source,path,value,evidence,dimension}],needs:[{id,kind,label,config,evidence}]}. All fields required. args is an array of term IDs; value is a scalar or null. IDs are letter-first identifiers, excluding row/item/reply. Evidence is an exact nonempty quotation from intent or disclosed context. Unknown essential facts use kind unsupported, never invented defaults.\n"+
        "Terms: literal (scalar value, evidence, dimension); port (source=actual need ID, path=published port); field (source=row/reply/item, path=actual disclosed nested field); relations add/subtract/multiply/divide/eq/ne/lt/le/gt/ge/and/or/not/choose/floor/ceil/abs/clock/integer/length/sum/filter/any/all/project/concat use args. Empty source/path/evidence on relations. Only evidenced literals can declare dimensions scalar/money/minute/minuteOfDay/millisecond/length/count; otherwise unknown. Structural provider fields have unknown dimensions. Never infer units from names. Numeric evidence may use exact digit tokens or English number words zero through nineteen; no substring matches. A computed normalization/conversion is not an evidenced literal. When source/target units or calendar facts are explicitly disclosed, represent the transformation as an issued scalar custom function with real term arguments, or a section; do not call a computable transformation a missing fact. Unknown provider units remain unsupported: names alone establish no units. Never emit a converted literal just because its unconverted evidence exists. A field term MUST use source row/reply/item; a reference to an input/result/comparison ALWAYS uses op port with the need ID.\n"+
        "Need configs (all expression references are term IDs, not strings of source or need IDs): input {value:literalTerm,format,minimum,maximum}; minimum and maximum are finite whole numbers, never null; text/boolean bounds are zero; absent task-specific bounds use the editable numeric domain -2147483648..2147483647, or 0..1439 for time. Do not invent literal terms for bounds or null values. Only emit terms actually consumed by requirements. Use comparison directly for over/under/equal rather than extra status-label literals.  read {module,function,arguments:[termID]}; result {value,format}; comparison {limit,actual}; choice {source,identity,label,eligible,cost}; allocation {source,identity,label,eligible,cost,total,budget,surcharge,quotas:[{label,minimum,predicate}]}; alternatives {source,identity,label,stock,componentSource,componentIdentity,componentQuantity,roles:[{label,quantity,predicate}]}; quotes {source,module,function,arguments:[{kind:value,value:termID} or {kind:basket,encoding:idQuantity or records,idField,quantityField}],cost,deposit,available,ttlMillis,budget}; custom {parameters:[{name,type}],result,arguments:[termID],format} declares a pure scalar function, not a body: parameter/result types number/string/boolean; arguments are term IDs, not formulas, paths or literals. Use numeric/text results for downstream processing of that function's value port; section {imports:[{name,type,term:termID}],exports:[{name,type}],capabilities:[{module,function}]} for uncovered UI/state/action behavior; export types number/string/boolean; import types also array/record via exact published port terms, preserving disclosed wire shape (never retag a collection as scalar); capabilities only disclosed identities, no plan/body here; unsupported {}.\n"+
        "Published paths (without kind prefixes): for an input need with id amount use source=amount,path=value, never path=input.value. For a read use path=result or result.nestedField; result path=value; comparison path=difference (not value/result/status); choice path=selected.cost/id/label/eligible; allocation path=rows/total/valid/present; quotes path=results with row fields key/label/cost/deposit/available/expiresAt (not raw reply fields); alternatives path=baskets with items/key/label. Collection formulas use row fields; component mappings use item fields; quote projections use reply. Formats input text/boolean/integer/money/time; result text/number/integer/money/time. Money format always displays integral minor units; a major-unit editable amount must use integer/number presentation until explicitly converted. Use input port terms for every downstream reference to an editable assumption, never repeat its initial literal in formulas/provider arguments. Preserve direction/order and semantic anchors of requested temporal/arithmetic relations; equal structural types do not make values interchangeable. Do not add unrequested context/date displays or normalize date strings as literals: omit unused terms, or express transformations in issued custom/section behavior. Include every requirement and editable assumption, provider prerequisites, current-input recomputation, full-basket alternatives, deposit and freshness. Keep essential missing facts unsupported. No executable formulas, provider answers, invented fields or custom bodies.\n";
}
export function pureGuidance(): string { return "DEAL 1.5 PURE FUNCTION BODY RULES\n"+assets.language(); }
export function sourceGuidance(): string { return "DEAL 1.5 SOURCE RULES\n" + assets.language() + "\n\nRENDERER\n" + assets.renderer(); }
export function main(): null { return null; }
