import * as assets from "./generation-guidance.generated";

// Portable composition prose is packaged from ui/; contract facts remain build-derived.
export function composition(): string { return assets.composition(); }
export function workflow(): string {
    return "\n\nFINAL WORKFLOW CHECK\n" +
        "Check proposed initial values against supporting facts. Task deadlines are not operation periods. Preserve an explicit operation period and its timezone: convert local clock times to offset-bearing instants, never append Z to unchanged local time. The friendly period label must represent the same instants sent to capabilities.\n" +
        "Implement the whole task from intent AND supporting facts, including alternatives, exact specifications, quantities and budget. Resolve unknown IDs/prices/stock through explicit reads. Match specification, units and included contents from returned records, not names alone; exclude incompatible options and show concise qualifying details. Never silently omit a requested alternative.\n" +
        "Preserve provider authority: invoke every required external read on explicit user action, never emulate a provider formula or return sample values locally. After actual data loads, compute the requested initial feasible allocation/selection across all supplied constraints, unless manual selection was explicitly requested; editable empty controls alone do not satisfy a planning request. Keep pending and infeasible distinct from success.\n" +
        "Keep supplied numeric assumptions editable. Use IntField format euro-cents for budget and recompute against its state field, never a hard-coded ceiling. Changing provider inputs clears old results until refreshed; local budget edits recompute without reads. Use TimeField for editable minute-of-day; preserve offset-bearing instants and show a concise friendly period instead of machine-format text fields.\n" +
        "Compare requested packages and components from actual returned data. Show hire cost and any returned deposit separately. Keep one useful primary action and concise results. Use typed maintained operations for initial construction, then edit_sources for exact targeted source repairs. submit_custom is explicitly measured custom behavior; full-source write_file is available only after explicit source_fallback. Never put raw source into maintained data fields.\n";
}
export function componentFacts(pack: table): string {
    let out: string = ""; let components: table[] = pack.components;
    for (let component: table of components) {
        let name: string = component.name; let fields: table[] = component.fields; let contracts: table[] = component.contracts;
        let arguments: string = ""; let requiredProps: string = "";
        for (let field: table of fields) {
            let fieldName: string = field.name; let type: string = field.type;
            let defaultKind: string = field.defaultKind; let defaultText: string = field.defaultText; let required: boolean = field.required;
            if (required) { if (requiredProps !== "") { requiredProps = requiredProps + ", "; } requiredProps = requiredProps + fieldName; }
            let action: boolean = type === "Action";
            for (let contract: table of contracts) {
                let kind: string = contract.kind;
                if (kind === "event") { let prop: string = contract.prop; if (prop === fieldName) { action = true; } }
            }
            if (arguments !== "") { arguments = arguments + ", "; }
            arguments = arguments + fieldName + ": " + type;
            if (!required) { arguments = arguments + " (optional";
                if (defaultKind === "string") { arguments = arguments + ", default string '" + defaultText + "'"; }
                if (defaultKind === "number" || defaultKind === "boolean") { arguments = arguments + ", default " + defaultText; }
                arguments = arguments + ")";
            }
            if (action) { arguments = arguments + " [use events, not props]"; }
        }
        let behaviour: string = ""; let children: boolean = false;
        if (requiredProps !== "") { behaviour = "required props: " + requiredProps; }
        for (let contract: table of contracts) {
            let kind: string = contract.kind; let text: string = "";
            if (kind === "event") {
                let prop: string = contract.prop; let payload: string = contract.payload;
                text = "raises " + prop;
                if (payload !== "") { text = text + " carrying a " + payload + " payload"; }
            }
            if (kind === "children") {
                children = true; let required: boolean = contract.required; let childTypes: string = contract.types;
                text = "accepts children"; if (required) { text = "requires children"; }
                if (childTypes !== "") { text = text + " of types " + childTypes; }
            }
            if (text !== "") { if (behaviour !== "") { behaviour = behaviour + "; "; } behaviour = behaviour + text; }
        }
        if (out !== "") { out = out + "\n"; }
        out = out + "- " + name + ": " + arguments;
        if (children) { out = out + "; children are view IDs"; }
        if (behaviour !== "") { out = out + "  [" + behaviour + "]"; }
    }
    return out;
}
export function guidance(): string {
    return assets.behavior() + "\n\nPRESENTATION\n" + composition() +
        "\n\nCOMPONENTS (this is the complete set; use names/typed props, not source snippets)\n" + componentFacts(assets.pack());
}
export function sourceGuidance(): string { return "DEAL 1.4 SOURCE RULES\n" + assets.language() + "\n\nRENDERER\n" + assets.renderer(); }
export function main(): null { return null; }
