import * as embedding from "embedding";
import * as tables from "std/table";
import * as s from "./construction-schema";
import * as data from "embedding/policy-data";

// Issued after compiler resolution. Model strings cannot create sources or type identities.
export class Source {
  id: string; type: string; schema: embedding.WireType | null; dependencies: string[];
  owner: string; payloadOwner: string; getter: string; ready: string; derived?: boolean;
}
// Request/source evidence recorded with a binding. It is compiler-issued metadata: it records the
// frozen request and disclosed facts and the issued argument sources. It grants no authority, and a
// model quote, a substring match or a boolean never authorizes a mutation.
export class Evidence { request: string; facts: string; quote: string; sources: string[]; }
export class Binding { id: string; module: string; function: string; arguments: Record<string, string>; parameterOrder: string[]; owner: string; evidence: Evidence; }
export class Draft { sourceId: string; label: string; initial: string; }
export class Descriptor { id: string; label: string; binding: string; input?: Draft; evidence: Evidence; }
export class Registry { sources: Source[]; bindings: Binding[]; actions: Descriptor[]; contracts: embedding.CapabilityContract[]; }
export function create(contracts: embedding.CapabilityContract[]): Registry { return {sources:[],bindings:[],actions:[],contracts:contracts}; }
export function source(registry: Registry, id: string): Source { for (let item of registry.sources) { if (item.id === id) { return item; } } s.reject("Unissued argument source: "+id); throw {name:"CONSTRUCTION_SCHEMA",message:"Unissued source"}; }
// Presence test for a stage that must keep a need open instead of throwing when a source it would
// read was never issued by this candidate.
export function issued(registry: Registry, id: string): boolean { for (let item of registry.sources) { if (item.id === id) { return true; } } return false; }
export function binding(registry: Registry, id: string): Binding { for (let item of registry.bindings) { if (item.id === id) { return item; } } s.reject("Unissued binding: "+id); throw {name:"CONSTRUCTION_SCHEMA",message:"Unissued binding"}; }
function visit(registry: Registry, current: string, path: string[]): void {
  if (s.contains(path,current)) { s.reject("Source dependency cycle"); }
  let next: string[] = []; for (let prior of path) { next[next.length] = prior; } next[next.length] = current;
  for (let item of registry.sources) { if (item.id === current) { for (let dependency of item.dependencies) { visit(registry,dependency,next); } } }
}
// The known wire schema of a declared DEAL type. A reserved source always carries one, derived from
// its declared declaration type and the host wire domain (finite binary64 numbers, strings and arrays
// within the host's 8192 code-unit wire bound, booleans, null, open records), and it is checked against
// the frozen contract parameter like any host-supplied schema. A narrower declared domain (an input's
// bounds, a fixed literal value) is reserved by the caller instead of the whole type domain.
export function domain(type: string): embedding.WireType {
  let fields: embedding.WireField[] = [];
  if (type === "number") { return {kind:"number",fields:fields,element:null,maximum:0,minimumNumber:-1.7976931348623157e308,maximumNumber:1.7976931348623157e308}; }
  if (type === "string") { return {kind:"string",fields:fields,element:null,maximum:8192,minimumNumber:0,maximumNumber:0}; }
  if (type === "boolean") { return {kind:"boolean",fields:fields,element:null,maximum:0,minimumNumber:0,maximumNumber:0}; }
  if (type === "null") { return {kind:"null",fields:fields,element:null,maximum:0,minimumNumber:0,maximumNumber:0}; }
  if (type === "Record<string, unknown>") { return {kind:"record",fields:fields,element:null,maximum:0,minimumNumber:0,maximumNumber:0}; }
  if (type.endsWith("[]")) { return {kind:"array",fields:fields,element:domain(type.substring(0,type.length-2)),maximum:8192,minimumNumber:0,maximumNumber:0}; }
  s.reject("Unknown declared source type: "+type);
}
export function reserve(registry: Registry, issued: Source): void {
  s.identifier(issued.id); s.nonblank(issued.type); s.nonblank(issued.getter); s.nonblank(issued.ready);
  for (let item of registry.sources) { if (item.id === issued.id) { s.reject("Source identity collision"); } }
  // The schema is resolved when the source is reserved: a declared source never reaches the Bind
  // stage with an unknown wire type. A schema derived from a DEAL declaration states the type and its
  // host wire domain only; the value is validated against the exact frozen contract schema at the call
  // boundary. A host-supplied schema keeps its own bounds and is checked against the contract below.
  let derived: boolean = issued.schema === null;
  let noFields: embedding.WireField[] = [];
  let resolved: embedding.WireType = {kind:"null",fields:noFields,element:null,maximum:0,minimumNumber:0,maximumNumber:0};
  if (issued.schema === null) { resolved = domain(issued.type); } else { resolved = issued.schema as embedding.WireType; }
  if (Object.hasOwn(issued,"derived")) { derived = issued.derived as boolean; }
  if (derived && declarationType(resolved) !== issued.type) { s.reject("Source wire schema differs from its declared type: "+issued.id); }
  let staged0: Source = {id:issued.id,type:issued.type,schema:resolved,dependencies:issued.dependencies,owner:issued.owner,payloadOwner:issued.payloadOwner,getter:issued.getter,ready:issued.ready,derived:derived};
  // Reserve before resolving dependencies; all custom outputs are issued before binding.
  let staged: Registry = {sources:[],bindings:registry.bindings,actions:registry.actions,contracts:registry.contracts};
  for (let prior of registry.sources) { staged.sources[staged.sources.length] = prior; }
  staged.sources[staged.sources.length] = staged0; visit(staged,issued.id,[]);
  registry.sources = staged.sources;
}
function declarationType(schema: embedding.WireType): string {
  if (schema.kind === "record") { return "Record<string, unknown>"; }
  if (schema.kind === "array") { return declarationType(schema.element as embedding.WireType)+"[]"; }
  return s.oneOf(schema.kind,["number","string","boolean","null"]);
}
function compatible(actual: embedding.WireType, expected: embedding.WireType): boolean {
  if (actual.kind !== expected.kind) { return false; }
  if (actual.kind === "number") { return actual.minimumNumber >= expected.minimumNumber && actual.maximumNumber <= expected.maximumNumber; }
  if ((actual.kind === "string" || actual.kind === "array") && actual.maximum > expected.maximum) { return false; }
  if (actual.kind === "array") { return compatible(actual.element as embedding.WireType,expected.element as embedding.WireType); }
  if (actual.kind === "record") {
    for (let field of expected.fields) {
      let present: boolean = false;
      for (let existing of actual.fields) { if (existing.name === field.name) { present = true; if ((!field.optional && existing.optional) || !compatible(existing.type,field.type)) { return false; } } }
      if (!present && !field.optional) { return false; }
    }
    for (let field of actual.fields) { let present: boolean = false; for (let expectedField of expected.fields) { if (expectedField.name === field.name) { present = true; } } if (!present) { return false; } }
  }
  return true;
}
function selectedFunction(registry: Registry, module: string, name: string): embedding.CapabilityFunction {
  for (let contract of registry.contracts) { if (contract.module === module) { for (let item of contract.functions) { if (item.name === name) { return item; } } } }
  s.reject("Unknown frozen capability binding"); throw {name:"CONSTRUCTION_SCHEMA",message:"Unknown capability"};
}
function prepareBinding(registry: Registry, id: string, raw: Record<string, unknown>, owner: string, extra: Source | null, evidence: Evidence): Binding {
  s.identifier(id); s.closed(raw,["module","function","arguments"],[]);
  for (let prior of registry.bindings) { if (prior.id === id) { s.reject("Binding identity collision"); } }
  let module: string = s.nonblank(raw.module); let name: string = s.identifier(raw.function);
  let operation: embedding.CapabilityFunction = selectedFunction(registry,module,name);
  let argumentsByName: Record<string, unknown> = raw.arguments as Record<string, unknown>; let names: string[] = [];
  for (let parameter of operation.parameters) { names[names.length] = parameter.name; }
  s.closed(argumentsByName,names,[]); let copied: Record<string, string> = {};
  for (let parameter of operation.parameters) {
    let sourceId: string = s.identifier(argumentsByName[parameter.name]); let selected: Source | null = null;
    if (extra !== null && sourceId === (extra as Source).id) { selected = extra as Source; } else { selected = source(registry,sourceId); }
    let issued: Source = selected as Source;
    if (issued.payloadOwner !== "" && issued.payloadOwner !== owner) { s.reject("Foreign originating payload or descriptor draft"); }
    if (issued.type !== declarationType(parameter.type)) { s.reject("Argument type mismatch: "+parameter.name); }
    if (issued.schema === null) { s.reject("Unknown wire schema: "+parameter.name); }
    // Every source is checked against the frozen parameter it would fill. A schema is either
    // host-issued or derived from the declared domain, and either way a domain wider than the
    // parameter keeps the need open naming the parameter instead of issuing a call the provider
    // boundary must reject. There is no exemption for a state-backed argument.
    if (!compatible(issued.schema as embedding.WireType,parameter.type)) { s.reject("Incompatible wire schema: "+parameter.name); }
    copied[parameter.name] = sourceId;
  }
  let provenance: string[] = [];
  for (let parameter of operation.parameters) { provenance[provenance.length] = copied[parameter.name] as string; }
  evidence.sources = provenance;
  return {id:id,module:module,function:name,arguments:copied,parameterOrder:names,owner:owner,evidence:evidence};
}
function blankEvidence(original: string, facts: string): Evidence { return {request:original,facts:facts,quote:"",sources:[]}; }
export function issueBinding(registry: Registry, id: string, raw: Record<string, unknown>, owner: string): void {
  issueBindingWith(registry,id,raw,owner,blankEvidence("",""));
}
export function issueBindingWith(registry: Registry, id: string, raw: Record<string, unknown>, owner: string, evidence: Evidence): void {
  let issued: Binding = prepareBinding(registry,id,raw,owner,null,evidence); registry.bindings[registry.bindings.length] = issued;
}
export async function issueDescriptor(registry: Registry, raw: Record<string, unknown>, bindingId: string, bindingRaw: Record<string, unknown>): Promise<void> {
  await issueDescriptorWith(registry,raw,bindingId,bindingRaw,blankEvidence("",""));
}
// Descriptor and draft identities are reserved before the binding checks and issued atomically: a
// rejected descriptor publishes no source, draft, binding or descriptor.
export async function issueDescriptorWith(registry: Registry, raw: Record<string, unknown>, bindingId: string, bindingRaw: Record<string, unknown>, evidence: Evidence): Promise<void> {
  s.closed(raw,["id","label"],["input","binding"]); let id: string = s.identifier(raw.id); let label: string = s.nonblank(raw.label);
  if (Object.hasOwn(raw,"binding")) { if (s.identifier(raw.binding) !== bindingId) { s.reject("Descriptor binding identity mismatch"); } }
  if (label.length > 32) { s.reject("Descriptor label length"); }
  for (let prior of registry.actions) { if (prior.id === id) { s.reject("Descriptor identity collision"); } }
  let descriptor: Descriptor = {id:id,label:label,binding:bindingId,evidence:evidence}; let draft: Source | null = null;
  if (Object.hasOwn(raw,"input")) {
    let input: Record<string, unknown> = raw.input as Record<string, unknown>; s.closed(input,["sourceId","label","initial"],[]);
    let sourceId: string = s.identifier(input.sourceId); let initial: string = s.text(input.initial); let inputLabel: string = s.nonblank(input.label);
    if (initial.length > 512 || inputLabel.length > 32) { s.reject("Descriptor input length"); }
    for (let prior of registry.sources) { if (prior.id === sourceId) { s.reject("Descriptor draft collision"); } }
    let fields: embedding.WireField[] = [];
    let schema: embedding.WireType = {kind:"string",fields:fields,element:null,maximum:8192,minimumNumber:-1.7976931348623157e308,maximumNumber:1.7976931348623157e308};
    draft = {id:sourceId,type:"string",schema:schema,dependencies:[],owner:id,payloadOwner:id,getter:"draft_"+sourceId,ready:"ready_"+sourceId,derived:true};
    descriptor.input = {sourceId:sourceId,label:inputLabel,initial:initial};
  }
  let issued: Binding = prepareBinding(registry,bindingId,bindingRaw,id,draft,evidence);
  if (draft !== null) { let used: boolean = false; for (let key of Object.keys(issued.arguments)) { if ((issued.arguments[key] as string) === (draft as Source).id) { used = true; } } if (!used) { s.reject("Descriptor input unused by its binding"); } }
  // Recheck after adapters: another awaited issuance may have committed meanwhile.
  for (let prior of registry.actions) { if (prior.id === id) { s.reject("Descriptor identity collision"); } }
  for (let prior of registry.bindings) { if (prior.id === bindingId) { s.reject("Binding identity collision"); } }
  if (draft !== null) { for (let prior of registry.sources) { if (prior.id === (draft as Source).id) { s.reject("Descriptor draft collision"); } } }
  // Nothing is published until all checks have passed; no await in the commit.
  if (draft !== null) { registry.sources[registry.sources.length] = draft as Source; }
  registry.bindings[registry.bindings.length] = issued; registry.actions[registry.actions.length] = descriptor;
}
// The Bind stage: every selected binding and every intent-panel descriptor is issued against the
// frozen contracts with its request/source evidence before any source is written. An inexpressible
// binding rejects here and publishes nothing.
export async function issueComposition(registry: Registry, bindingsRaw: Record<string, unknown>, actionsRaw: Record<string, unknown>, original: string, facts: string): Promise<string[]> {
  let rejected: string[] = []; let viaDescriptor: string[] = [];
  for (let id of tables.keys(actionsRaw)) {
    let action: Record<string, unknown> = actionsRaw[id] as Record<string, unknown>;
    let bindingId: string = s.identifier(action.binding);
    if (!Object.hasOwn(bindingsRaw,bindingId)) { rejected[rejected.length] = id+": descriptor names an unissued binding"; continue; }
    viaDescriptor[viaDescriptor.length] = bindingId;
    try { await issueDescriptorWith(registry,action,bindingId,bindingsRaw[bindingId] as Record<string, unknown>,blankEvidence(original,facts)); }
    catch (unknownError) {
      let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; }
      rejected[rejected.length] = id+": "+error.message;
    }
  }
  for (let id of tables.keys(bindingsRaw)) {
    if (s.contains(viaDescriptor,id)) { continue; }
    // An inexpressible binding keeps its need open with the located reason and issues no callable.
    try { issueBindingWith(registry,id,bindingsRaw[id] as Record<string, unknown>,"",blankEvidence(original,facts)); }
    catch (unknownError) {
      let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; }
      rejected[rejected.length] = id+": "+error.message;
    }
  }
  return rejected;
}
export function main(): void { return; }
