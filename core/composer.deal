import * as plans from "./plan";
import * as screens from "./screen";
import * as bodies from "./hole-body";
import * as decoded from "./decoded";
import * as s from "./construction-schema";
import * as tables from "std/table";
import * as literals from "./source-literals";
import * as syntax from "embedding/fragment-syntax";
import * as policy from "./computation-policy";
import * as ownership from "./ownership";
import * as bindings from "./bindings";
import * as execution from "./execution";
import * as admission from "./admission";

// Internal resolved assembly input. Generated strings never issue type or owner identities.
// `dependencies` is the semantic dependency set of a derived resource: the authoritative resources
// whose validated value, readiness or identity the value is a function of. `buffers` names the raw
// text buffers the computation parses. A buffer is a read of the value, not a dependency resource:
// the derived value and its readiness already capture every semantic change, so an equivalent buffer
// spelling advances no operation revision.
export class Computation { instance: string; field: string; value: string; ready: string; reason: string; dependencies: string[]; buffers?: string[]; }
export class Import { module: string; alias: string; }
// One composition-level resource a descriptor owns: the seeded draft a panel edits and the readiness its
// binding consumes, together with the descriptor identity that may see it.
export class DescriptorField { name: string; type: string; descriptor: string; }
export class Field { instance: string; local: string; name: string; type: string; role: string; initial: string; }
export class Prepared { id: string; declarations: string; helpers: string; view: string; fields: Field[]; updates: screens.Handler[]; effects: screens.Handler[]; viewName: string; }
export class Source { deal: string; dealui: string; }
// Slot records, operation dependency sets, publication and driver identities and the runtime-only
// field list are compiler metadata. They are rebuilt on every assembly and never emitted into
// generated source.
export class SlotRecord { id: string; need: string; status: string; reads: string[]; writes: string[]; outputs: string[]; event: string; trigger: string; action: string; provider: boolean; allowedKinds: string[]; instance: string; reason: string; }
export class OperationRecord { id: string; owner: string; module: string; function: string; trigger: string; triggerResource: string; rowKey: string; dependencies: string[]; arguments: Record<string, string>; expires: string; expired: string; }
// The runtime route of one checked event slot: the operation its trigger raises, the ordered queue its
// committed events are retained in and the issued carrier the Session resolves the dispatch slot from.
// None of it is emitted source and no model string can add, rename or duplicate one.
export class TriggerRecord { slot: string; need: string; operation: string; event: string; trigger: string; queue: string; action: string; carrier: string; }
// An authorized initial read: the authoritative activation-needed field the compiled reducer clears
// before its effect starts and the issued carrier the Session dispatches once at activation.
export class ActivationRecord { instance: string; field: string; action: string; carrier: string; }
// The independently scheduled expiry transition and the deadline pair of every emitted operation.
export class DeadlineRecord { expires: string; expired: string; }
export class ExpiryRecord { action: string; carrier: string; deadlines: DeadlineRecord[]; }
export class CompositeRecord { action: string; type: string; update: string; arms: string[]; }
// The ownership matrix assembly decided over written resources, carried as compiler metadata so
// admission can re-check every slot against the compiled declarations instead of a source scan. A
// resource names its owning instance and its role; an instance names its kind, origin and the
// qualified authoritative resources its own reducers write.
export class ResourceRecord { name: string; owner: string; role: string; }
export class InstanceRecord { id: string; kind: string; origin: string; kinds: string[]; writes: string[]; }
// The one Session-local clock trust identity the expiry driver reads. It is issued metadata, never a
// model string, and every clock driver of the composition names these same two compiled fields.
export class SessionClock { epoch: string; trust: string; resume: string; }
export class Metadata { slots: SlotRecord[]; operations: OperationRecord[]; triggers: TriggerRecord[]; activation: ActivationRecord[]; expiry: ExpiryRecord; runtime: string[]; publications: string[]; drivers: string[]; clockDrivers: screens.Driver[]; readings: string[]; sessionClock: SessionClock; composites: CompositeRecord[]; chatRoot: boolean; notices: string[]; declarations: string[]; owners: ResourceRecord[]; composerOwned: string[]; instances: InstanceRecord[]; sources: string[]; }
export class ChildLabel { instance: string; label: string; }
export class ChatRoot { children: ChildLabel[]; initialSelection: number; }
// The chat root generation issues: one child per placed fragment in placement order, the label the
// covering need or the disclosure issued and the initial selection. Both the construction route and the
// custom writer ask this one rule, so the wrapper and its labels are decided once. The label text is the
// plan need's own wording; a disclosure instance carries its own rendered sentence, so its tab names the
// disclosure instead of an internal identity; any other child the plan does not name keeps its issued
// instance identity, so this rule never invents or reformats text of its own.
export function chatRoot(composition: screens.Composition, plan: plans.Plan | null): ChatRoot | null {
  if (composition.screen.target !== "chat" || composition.screen.instances.length < 2) { return null; }
  let children: ChildLabel[] = [];
  for (let instance of composition.screen.instances) {
    let label: string = instance.id;
    if (plan !== null) { for (let need of (plan as plans.Plan).needs) { if (s.contains(instance.fragment.covers,need.id)) { label = need.words; } } }
    // A notice is emitted for a disclosure, so its own disclosure sentence is its user-facing label.
    if (instance.kind === "notice" && typeof instance.parameters.text === "string") { label = instance.parameters.text as string; }
    children[children.length] = {instance:instance.id,label:label};
  }
  return {children:children,initialSelection:0};
}
export class Result { source: Source; fields: Field[]; computations: string[]; metadata: Metadata; }
function qualified(id: string, name: string): string { return "f_"+id+"_"+name; }
// The issued dependency set is closed over the checked reads of the values an operation consumes: each
// resource a computation produces names the resources it reads, so an edit of an upstream resource
// invalidates the invocation even when a derived result keeps the same value. Plan reads and authored
// arguments are never seeds.
function closeReads(dependencies: string[], seed: string, producerReads: Record<string, unknown>): void {
  let pending: string[] = [seed]; let visited: string[] = []; let cursor: number = 0;
  while (cursor < pending.length) {
    let current: string = pending[cursor]; cursor = cursor+1;
    if (s.contains(visited,current)) { continue; }
    visited[visited.length] = current;
    if (!Object.hasOwn(producerReads,current)) { continue; }
    for (let read of producerReads[current] as string[]) { addUnique(dependencies,read); pending[pending.length] = read; }
  }
}
class SyntaxRequest { function: string; input: string; }
class SyntaxResult { value: string; code: string; message: string; }
function syntaxValue(result: SyntaxResult): string {
  if (result.code !== "") { throw {name:result.code,message:result.message}; }
  return result.value;
}
function addImport(imports: Import[], module: string, alias: string): void {
  for (let item of imports) {
    if (item.alias === alias && item.module !== module) { s.reject("Conflicting resolved import alias"); }
    if (item.alias === alias && item.module === module) { return; }
  }
  imports[imports.length] = {module:module,alias:alias};
}
function importSource(imports: Import[]): string {
  let emitted: string[] = []; let result: string = "";
  while (emitted.length < imports.length) {
    let next: Import | null = null;
    for (let item of imports) { if (!s.contains(emitted,item.alias)) { if (next === null) { next = item; } else { let selected: Import = next as Import; if (item.module < selected.module || (item.module === selected.module && item.alias < selected.alias)) { next = item; } } } }
    let item: Import = next as Import; emitted[emitted.length] = item.alias;
    result = result+"import * as "+item.alias+" from "+literals.quote(item.module)+";\n";
  }
  return result;
}
function field(fields: Field[], instance: string, local: string): Field {
  for (let item of fields) { if (item.instance === instance && item.local === local) { return item; } }
  return s.reject("Unissued field producer/read");
}
function placeholder(type: string): string { if (type === "string") { return "\"\""; } if (type === "boolean") { return "false"; } if (type === "number") { return "0"; } if (type.endsWith("[]")) { return "[]"; } return "null"; }
function primitive(type: string): boolean { return s.contains(["string","boolean","number"],type); }
// A derived array binds a nonnullable prepared `_display` companion initialized empty, exactly as a
// derived primitive does; readiness still guards it so an empty array is never a displayed fact.
function displayable(type: string): boolean { return primitive(type) || type.endsWith("[]"); }
// The writer contract and qualifier consume the same issued reader projection. Authoritative
// resources have no invented readiness/display companions; derived resources keep their guards.
export function readerTypes(publisher: screens.Field, getter: string): Record<string, string> {
  let result: Record<string, string> = {}; result[getter] = publisher.type;
  if (publisher.role === "derived") {
    result[getter+"_ready"] = "boolean"; result[getter+"_reason"] = "string";
    if (displayable(publisher.type)) { result[getter+"_display"] = publisher.type; }
  }
  return result;
}
function copyExpression(fields: Field[], changes: Record<string, string>, state: string): string {
  let result: string = "{"; let separator: string = "";
  for (let item of fields) {
    let expression: string = state+"."+item.name;
    if (Object.hasOwn(changes,item.name)) { expression = changes[item.name] as string; }
    result = result+separator+item.name+": "+expression; separator = ", ";
    if (item.role === "derived") {
      let ready: string = state+"."+item.name+"_ready"; let reason: string = state+"."+item.name+"_reason";
      if (Object.hasOwn(changes,item.name+"_ready")) { ready = changes[item.name+"_ready"] as string; }
      if (Object.hasOwn(changes,item.name+"_reason")) { reason = changes[item.name+"_reason"] as string; }
      result = result+", "+item.name+"_ready: "+ready+", "+item.name+"_reason: "+reason;
      if (displayable(item.type)) { let display: string = state+"."+item.name+"_display"; if (Object.hasOwn(changes,item.name+"_display")) { display = changes[item.name+"_display"] as string; } result = result+", "+item.name+"_display: "+display; }
    }
  }
  return result+"}";
}
async function expression(value: string, expected: string, instance: Prepared, names: Record<string, string>, fields: Record<string, string>, types: Record<string, string>, variable: string): Promise<string> {
  let variables: Record<string, string> = {}; if (variable !== "") { variables[variable] = "AppState"; }
  return await syntax.expression(s.encode({source:value,expected:expected,names:names,fields:fields,types:types,variables:variables}));
}
// The permitted module surface of generated source. Assembly admits it before emitting anything;
// checking admission re-derives the same decision from the compiled manifest.
function permitted(registry: bindings.Registry, module: string): boolean {
  if (s.contains(["std/math","std/string","std/table","std/time","embedding/graphics","embedding/day","embedding/probe","embedding/session","./experience","./platform.dealui-pack","host/storage"],module)) { return true; }
  for (let contract of registry.contracts) { if (contract.module === module) { return true; } }
  return false;
}
function effectNames(instance: screens.Instance): string[] {
  let result: string[] = [];
  for (let effect of instance.fragment.effects) { result[result.length] = effect.function; }
  return result;
}
// `host/storage` is effect-bound: a call from an initializer, a recomputation helper or a reducer
// rejects. The mechanism returns call facts; this policy decides. A field's initial expression is
// emitted into `initialState()`, so its calls are analyzed exactly like a function body: a storage
// call there would run at mount, outside every effect.
async function storageConfined(instance: screens.Instance, aliases: Record<string, string>, facts: Record<string, unknown>): Promise<void> {
  let storage: string = "";
  for (let alias of Object.keys(aliases)) { if ((aliases[alias] as string) === "host/storage") { storage = alias; } }
  if (storage === "") { return; }
  let effects: string[] = effectNames(instance);
  for (let name of tables.keys(facts)) {
    let fact: Record<string, unknown> = facts[name] as Record<string, unknown>;
    if (s.contains(effects,name)) { continue; }
    for (let call of decoded.strings(fact.calls)) { if (call.startsWith(storage+".")) { s.reject("effect-bound storage: "+instance.id+"."+name); } }
  }
  // One batched mechanism request analyzes every field initializer of the instance; the policy decides.
  let initialNames: string[] = []; let initialRequests: SyntaxRequest[] = [];
  for (let field of instance.fragment.fields) {
    if (field.role === "derived") { continue; }
    initialNames[initialNames.length] = field.name;
    initialRequests[initialRequests.length] = {function:"analyzeExpression",input:s.encode({source:field.initial})};
  }
  if (initialRequests.length > 0) {
    let results: SyntaxResult[] = JSON.parse(await syntax.batch(s.encode({requests:initialRequests})));
    let index: number = 0;
    while (index < results.length) {
      let analyzed: Record<string, unknown> = JSON.parse(syntaxValue(results[index]));
      for (let call of decoded.strings(analyzed.calls)) { if (call.startsWith(storage+".")) { s.reject("effect-bound storage: "+instance.id+"."+initialNames[index]); } }
      index = index+1;
