          for (let dependency of computation.dependencies) { for (let input of allFields) { if (input.name === dependency && input.role === "derived") { ready = "state."+input.name+"_ready && ("+ready+")"; } } }
          let value: string = await expression(computation.value,types[computation.field] as string,instance,names,fields,types,"state");
          let reason: string = await expression(computation.reason,"string",instance,names,fields,types,"state");
          let changes: Record<string, unknown> = {}; changes[target.name] = "null"; changes[target.name+"_ready"] = "false"; changes[target.name+"_reason"] = reason; if (primitive(target.type)) { changes[target.name+"_display"] = placeholder(target.type); }
          recompute = recompute+"  if ("+ready+") {\n    let value: "+target.type+" = "+value+";\n";
          let finite: string = "true"; if (target.type === "number") { finite = "value - value === 0"; }
          recompute = recompute+"    if ("+finite+") {\n";
          let available: Record<string, unknown> = {}; available[target.name] = "value"; available[target.name+"_ready"] = "true"; available[target.name+"_reason"] = "\"\""; if (primitive(target.type)) { available[target.name+"_display"] = "value"; }
          recompute = recompute+"      state = "+copyExpression(allFields,available,"state")+";\n    } else {\n      state = "+copyExpression(allFields,changes,"state")+";\n    }\n  } else {\n    state = "+copyExpression(allFields,changes,"state")+";\n  }\n";
          ordered[ordered.length] = target.name; progress = true;
        }
      }
    }
    if (!progress) { s.reject("Derived dependency cycle"); }
  }
  recompute = recompute+"  return state;\n}\n";
  let initial: Record<string, unknown> = {};
  for (let item of allFields) { initial[item.name] = item.initial; if (item.role === "derived") { initial[item.name+"_ready"] = "false"; initial[item.name+"_reason"] = "\"Not ready\""; if (primitive(item.type)) { initial[item.name+"_display"] = placeholder(item.type); } } }
  declarations = declarations+recompute+"export function initialState(): AppState {\n  let capturedTime: number = embeddingClock.nowMillis();\n  let candidate: AppState = "+copyExpression(allFields,initial,"")+";\n  return recompute(candidate);\n}\nexport function main(): null { return null; }\n";
  viewSource = viewSource+"// @ui-root\nexport view Main(state: app.AppState): View {\n  ui.Column() {\n";
  for (let item of prepared) { viewSource = viewSource+"    "+item.viewName+"(state: state)\n"; }
  viewSource = viewSource+"  }\n}\n";
  return {source:{deal:declarations,dealui:viewSource},fields:allFields,computations:ordered};
}
export function main(): null { return null; }
