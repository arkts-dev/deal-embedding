    +"  if (action.event !== head.event) { return state; }\n"
    +"  if (state.status_"+id+" === \"pending\" || !("+condition+")) { return state; }\n"
    +"  let rest: "+eventClass+"[] = []; let position: number = 1;\n"
    +"  while (position < queue.length) { rest[rest.length] = queue[position]; position = position + 1; }\n"
