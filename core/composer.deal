function readyExpression(source: bindings.Source): string {
  if (source.ready === "true" || source.ready === "") { return "true"; }
  return "state."+source.ready;
}
function addUnique(values: string[], value: string): void { if (!s.contains(values,value)) { values[values.length] = value; } }
// The predicate that selects one attempt of an action that answers several operations: an action field the
