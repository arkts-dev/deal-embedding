    // readiness-guarded value; it never claims coverage of a missing publisher.
    let unsupplied: screens.Port[] = [];
    for (let port of instance.fragment.ports) { if (port.direction === "read") {
      let served: boolean = false;
      for (let connection of composition.connections) { if (connection.readerInstance === instance.id && connection.readerPort === port.name) { served = true; } }
      if (served) { continue; }
      if (!port.optional || !Object.hasOwn(port,"fallback")) { s.reject("Missing required publisher: "+instance.id+"/"+port.name); }
      if (Object.hasOwn(fieldNames,port.getter)) { s.reject("Reader field conflicts with owner field"); }
      fieldNames[port.getter] = qualified(instance.id,port.getter); types[port.getter] = port.type;
      for (let suffix of ["_ready","_reason"]) { fieldNames[port.getter+suffix] = qualified(instance.id,port.getter)+suffix; types[port.getter+suffix] = suffix === "_ready" ? "boolean" : "string"; }
      if (displayable(port.type)) { fieldNames[port.getter+"_display"] = qualified(instance.id,port.getter)+"_display"; types[port.getter+"_display"] = port.type; }
      unsupplied[unsupplied.length] = port;
    } }
    let importModules: Record<string, unknown> = {}; for (let item of decoded.records(raw.imports)) { let alias: string = item.alias as string; importModules[alias] = item.module; }
    modulesByInstance[instance.id] = importModules;
    factsByInstance[instance.id] = await policy.inspect(instance.fragment.helpers,importModules);
    namesByInstance[instance.id] = names; fieldsByInstance[instance.id] = fieldNames; typesByInstance[instance.id] = types;
    // Declared ownership grants no permission, so every claimed local is writable for qualification;
    // the ownership map decides derived and foreign writes from parsed facts.
    let writable: string[] = [];
    for (let entry of instance.fragment.fields) { if (entry.role !== "derived") { writable[writable.length] = entry.name; } }
    let holes: string = await holeFunctions(instance);
    let qualifiedSource: Record<string, unknown> = JSON.parse(await syntax.qualify(s.encode({declarations:instance.fragment.declarations,helpers:instance.fragment.helpers+holes,view:instance.fragment.view,names:names,fields:fieldNames,types:types,writable:writable})));
    for (let unissued of decoded.strings(qualifiedSource.unissuedWrites)) { s.reject("Write to a derived or foreign resource: "+instance.id+"."+unissued); }
    // The syntax mechanism reports every fragment-declared root; compiled ownership policy decides and
    // names the instance and the view it refuses.
    for (let declaredRoot of decoded.strings(qualifiedSource.roots)) { s.reject("Fragment declares a root view: "+instance.id+"."+declaredRoot); }
    let resolvedTypes: Record<string, unknown> = qualifiedSource.types as Record<string, unknown>;
    let item: Prepared = {id:instance.id,declarations:qualifiedSource.declarations as string,helpers:qualifiedSource.helpers as string,view:qualifiedSource.view as string,fields:[],updates:instance.fragment.updates,effects:instance.fragment.effects,viewName:qualified(instance.id,views[0].name as string)};
    for (let source of instance.fragment.fields) {
      let initial: string = "null"; if (source.role !== "derived") { initial = await expression(source.initial,source.type,item,names,fieldNames,types,""); }
      let current: Field = {instance:instance.id,local:source.name,name:qualified(instance.id,source.name),type:resolvedTypes[source.name] as string,role:source.role,initial:initial};
