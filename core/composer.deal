  }
}
// The provider flag of a filled slot derives from the resolved external provider calls of its
// implementation, never from the need type: a local implementation of a live need performs no
// provider call and a custom implementation that calls a frozen contract does.
function providerCalls(facts: Record<string, unknown>, modules: Record<string, string>, registry: bindings.Registry): boolean {
  for (let name of tables.keys(facts)) {
    let fact: Record<string, unknown> = facts[name] as Record<string, unknown>;
    for (let call of decoded.strings(fact.calls)) {
      let parts: string[] = call.split(".");
      if (parts.length !== 2) { continue; }
      let module: unknown = modules[parts[0]];
      if (module === undefined) { continue; }
      for (let contract of registry.contracts) { if (contract.module === (module as string)) { return true; } }
    }
  }
  return false;
}
// Every hole function is emitted from its declared signature and the selected body. The body is body
// text only: it replaces the declared default and never changes the parameter, the type or the name.
// The composed function is parsed before anything is emitted, so a body that closes the function or
