export async function assembleWith(composition: screens.Composition, computations: Computation[], registry: bindings.Registry, chatRoot: ChatRoot | null): Promise<Result> {
  let imports: Import[] = [{module:"std/time",alias:"embeddingClock"}];
  let prepared: Prepared[] = []; let allFields: Field[] = []; let namesByInstance: Record<string, unknown> = {}; let fieldsByInstance: Record<string, unknown> = {}; let typesByInstance: Record<string, unknown> = {}; let factsByInstance: Record<string, unknown> = {}; let modulesByInstance: Record<string, unknown> = {}; let dispatchesByInstance: Record<string, unknown> = {}; let completionsByInstance: Record<string, unknown> = {}; let exportedByInstance: Record<string, unknown> = {};
