          // admission deciding it. Every path a reachable function mentions is inspected, reads and writes
          // included, and a frozen contract a written effect names without calling is refused with its
          // instance, action and member instead of being admitted against a guess.
          for (let reference of admission.references(fact)) {
            if (s.contains(admission.calls(fact),reference)) { continue; }
            let parts: string[] = reference.split(".");
            if (!Object.hasOwn(aliases,parts[0] as string)) { continue; }
            let named: string = aliases[parts[0] as string] as string;
            let disclosed: boolean = false;
            for (let candidate of registry.contracts) { if (candidate.module === named) { disclosed = true; } }
