  for (let key of Object.keys(instance.bodies)) { if (!s.contains(declaredHoles,key)) { s.reject("Unissued body: "+key); } s.text(instance.bodies[key]); }
  for (let hole of instance.fragment.holes) {
    let id: string = s.identifier(hole.id);
    let signature: string = screens.holeSignature(hole);
    let body: string = "";
    if (Object.hasOwn(hole,"signature")) { body = s.text(hole.body); } else { body = s.text(hole.default); }
    if (Object.hasOwn(instance.bodies,id)) {
      if (Object.hasOwn(hole,"writer") && s.text(hole.writer) !== "fill") { s.reject("Controller-writer hole body: "+id); }
      let supplied: unknown = instance.bodies[id];
      if (typeof supplied !== "string") { s.reject("Catalogue hole body must be text: "+id); }
      body = supplied as string;
    }
    // The composed text, the body bound and every outside-hole verdict are the one classifier's, so the
    // body the author accepted is the body this emitter emits.
    let verdict: bodies.Verdict = await bodies.classify(instance.fragment.view,instance.id,id,signature,body);
