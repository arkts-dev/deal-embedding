  let ownershipFacts: Record<string, unknown> = {};
  for (let instance of composition.screen.instances) { ownershipFacts[instance.id] = JSON.parse(await syntax.analyzeFunctions(s.encode({source:instance.fragment.declarations+"\n"+instance.fragment.helpers+"\n"+await holeFunctions(instance)}))); }
  let fallbackComputations: Computation[] = [];
  let allComputations: Computation[] = [];
  for (let computation of computations) { allComputations[allComputations.length] = computation; }
  for (let instance of composition.screen.instances) {
    s.unique(instances,s.identifier(instance.id));
    // A fragment that conflicts with the definition its instance was issued from rejects before any
    // emission: field names, resolved types, roles, defaults, ports, actions and hole signatures come
    // from the issued definition, never from a replacement fragment.
    let conflict: string = screens.conflict(instance);
    if (conflict !== "") { s.reject(conflict); }
    // A declared `owns` entry grants no permission and gates nothing here either: ownership is decided
    // over the qualified authoritative resources the reducers write, so two instances declaring one
    // `owns` spelling with disjoint written resources are simply accepted.
    let raw: Record<string, unknown> = JSON.parse(await syntax.describe(s.encode({classes:instance.fragment.declarations,fields:"",functions:instance.fragment.helpers,view:instance.fragment.view})));
    // A completion action is the declared result action of an outer effect; it is reachable through
    // that effect, never from a view binding. Hole functions are never asynchronous, so an effect is
    // always a helper function of this region.
    let completions: string[] = [];
    for (let effect of instance.fragment.effects) { for (let fn of decoded.records(raw.functions)) { if ((fn.name as string) === effect.function) {
      let parts: string[] = (fn.result as string).split(".");
      completions[completions.length] = parts[parts.length-1] as string;
    } } }
    // A completion is the declared result action of an outer effect and must be an exported update
    // handler of the same owner: an asynchronous consequence that resolves to an action no reducer
    // handles is rejected with the instance and the action instead of being dispatched and lost.
    for (let completion of completions) {
      let handled: boolean = false;
      for (let handler of instance.fragment.updates) { if (handler.action === completion) { handled = true; } }
      if (!handled) { s.reject("Undeclared effect completion: "+instance.id+"."+completion); }
    }
    completionsByInstance[instance.id] = completions;
    // The action classes this owner exports; a view may bind those and nothing else.
    let exported: string[] = [];
    for (let declaration of decoded.records(raw.classes)) { if (declaration.exported as boolean) { exported[exported.length] = s.identifier(declaration.name); } }
    exportedByInstance[instance.id] = exported;
    // An effect completion must also be an action class this owner exports; a result action no
    // declaration carries cannot be constructed or dispatched.
    for (let completion of completions) { if (!s.contains(exported,completion)) { s.reject("Undeclared effect completion: "+instance.id+"."+completion); } }
    let names: Record<string, unknown> = {}; let fieldNames: Record<string, unknown> = {}; let types: Record<string, unknown> = {};
    for (let category of ["classes","functions","views"]) {
      for (let declaration of decoded.records(raw[category])) { let name: string = s.identifier(declaration.name); if (name === "AppState" || name === "initialState" || name === "recompute" || name === "invocationCurrent" || name === "expireOperations" || name === "recordExpiry" || name === "bump" || name === "bridgePersistedState" || name === "bridgeRestoredState") { s.reject("Composer-owned declaration"); } if (Object.hasOwn(names,name)) { s.reject("Duplicate fragment declaration"); } names[name] = qualified(instance.id,name); }
    }
    for (let hole of instance.fragment.holes) { let name: string = s.identifier(hole.id); if (Object.hasOwn(names,name)) { s.reject("Duplicate fragment declaration"); } names[name] = qualified(instance.id,name); }
    let aliases: Record<string, unknown> = {};
    for (let item of decoded.records(raw.imports)) {
      let alias: string = s.identifier(item.alias); let module: string = s.nonblank(item.module);
      if (Object.hasOwn(names,alias)) { s.reject("Import/declaration conflict"); }
      if (!permitted(registry,module)) { s.reject("unissued module "+module+" in "+instance.id); }
      aliases[alias] = module;
      let bound: string = qualified(instance.id,alias); names[alias] = bound; addImport(imports,module,bound);
    }
    await storageConfined(instance,aliases,ownershipFacts[instance.id] as Record<string, unknown>);
    let views: Record<string, unknown>[] = decoded.records(raw.views);
    // A fragment declares one exported view. Whether that view is a fragment-declared root is reported
    // by the qualification mechanism and decided by the compiled ownership policy below.
    if (views.length !== 1 || !(views[0].exported as boolean)) { s.reject("Fragment requires one exported view: "+instance.id); }
    let parameters: Record<string, unknown>[] = decoded.records(views[0].parameters);
    if (parameters.length !== 1 || (parameters[0].type as string) !== "app.AppState") { s.reject("Fragment view must receive app.AppState"); }
    let localNames: string[] = [];
    for (let item of instance.fragment.fields) { s.unique(localNames,item.name); if (item.owner !== instance.id) { s.reject("Foreign field owner"); } fieldNames[item.name] = qualified(instance.id,item.name); types[item.name] = item.type; if (item.role === "derived") { fieldNames[item.name+"_ready"] = qualified(instance.id,item.name)+"_ready"; fieldNames[item.name+"_reason"] = qualified(instance.id,item.name)+"_reason"; types[item.name+"_ready"] = "boolean"; types[item.name+"_reason"] = "string"; if (displayable(item.type)) { fieldNames[item.name+"_display"] = qualified(instance.id,item.name)+"_display"; types[item.name+"_display"] = item.type; } } }
    for (let connection of composition.connections) { if (connection.readerInstance === instance.id) {
      let reader: screens.Port | null = null; let writer: screens.Port | null = null; let writerField: screens.Field | null = null;
      for (let port of instance.fragment.ports) { if (port.name === connection.readerPort && port.direction === "read") { reader = port; } }
      for (let other of composition.screen.instances) { if (other.id === connection.writerInstance) {
        for (let port of other.fragment.ports) { if (port.name === connection.writerPort && port.direction === "publish") { writer = port; for (let item of other.fragment.fields) { if (item.name === port.getter) { writerField = item; } } } }
      } }
      if (reader === null || writer === null || writerField === null || (reader as screens.Port).type !== (writer as screens.Port).type || (writerField as screens.Field).type !== (reader as screens.Port).type) { s.reject("Unresolved typed port connection"); }
      let port: screens.Port = reader as screens.Port; let publisher: screens.Field = writerField as screens.Field;
      if (Object.hasOwn(fieldNames,port.getter)) { s.reject("Reader field conflicts with owner field"); }
      fieldNames[port.getter] = qualified(connection.writerInstance,publisher.name); types[port.getter] = publisher.type;
      if (publisher.role === "derived") {
        for (let suffix of ["_ready","_reason"]) {
          fieldNames[port.getter+suffix] = qualified(connection.writerInstance,publisher.name)+suffix;
          if (suffix === "_ready") { types[port.getter+suffix] = "boolean"; } else { types[port.getter+suffix] = "string"; }
        }
        if (displayable(publisher.type)) { fieldNames[port.getter+"_display"] = qualified(connection.writerInstance,publisher.name)+"_display"; types[port.getter+"_display"] = publisher.type; }
      }
    } }
