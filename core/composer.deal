}
function addUnique(values: string[], value: string): void { if (!s.contains(values,value)) { values[values.length] = value; } }
function issuedField(fields: Field[], name: string): boolean { for (let entry of fields) { if (entry.name === name) { return true; } } return false; }
// A slot's `reads` is the need read subset that resolves to an issued plan or composition source
// identifier, so a read this candidate never issued is not carried as a route admission would check.
function issuedReads(reads: string[], sources: string[], needs: string[]): string[] {
  let result: string[] = [];
  for (let read of reads) { if (s.contains(sources,read) || s.contains(needs,read)) { result[result.length] = read; } }
  return result;
}
export async function assembleWith(composition: screens.Composition, computations: Computation[], registry: bindings.Registry, chatRoot: ChatRoot | null): Promise<Result> {
  let imports: Import[] = [{module:"std/time",alias:"embeddingClock"}];
  let prepared: Prepared[] = []; let allFields: Field[] = []; let namesByInstance: Record<string, unknown> = {}; let fieldsByInstance: Record<string, unknown> = {}; let typesByInstance: Record<string, unknown> = {}; let factsByInstance: Record<string, unknown> = {}; let modulesByInstance: Record<string, unknown> = {}; let completionsByInstance: Record<string, unknown> = {}; let exportedByInstance: Record<string, unknown> = {};
  let instances: string[] = []; let storageNames: string[] = [];
