    kind("dose_schedule","Add/remove doses, daily taken marks and history with taken_today, doses and streak.",true,[param("rows","doses",false,null,0,"disclosed"),param("calendarBinding","binding",false,"",0,"configuration")],[publish("taken_today","number"),publish("doses","number"),publish("streak","number")],[],[],["calendar"],true),
    kind("due_items","Add/remove/change item dates with expired/soon/count and soon names.",true,[param("rows","due",false,null,0,"disclosed"),param("soonDays","count",false,7,0,"configuration")],[publish("count","number"),publish("soon_count","number"),publish("expired_count","number"),publish("soon_names","string")],[],[],["clock"],true),
