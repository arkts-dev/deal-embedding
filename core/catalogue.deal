    // not by a fixed guard that could drop a long tick.
    helpers = helpers+"export function walkInterval(phase: string, roundValue: number, elapsed: number, focus: number, remaining: number): IntervalWalk { let current: string = phase; let round: number = roundValue; let span: number = elapsed; let focusDone: number = focus; let left: number = remaining; let guard: number = 0; while (left > 0 && current !== \"done\" && guard < "+String(roundsValue*2+2)+") { guard = guard+1; let length: number = "+String(workSeconds)+"*1000; if (current === \"rest\") { length = "+String(restSeconds)+"*1000; } let room: number = length-span; if (!(room > 0)) { room = length; } if (left < room) { span = span+left; left = 0; } else { left = left-room; span = 0; if (current === \"work\") { focusDone = focusDone+"+String(workSeconds)+"; if (round >= "+String(roundsValue)+") { current = \"done\"; } else { current = \"rest\"; } } else { round = round+1; current = \"work\"; } } } return {phase: current, round: round, elapsed: span, focus: focusDone}; }";
    helpers = helpers+"export function readyInterval(state: AppState, action: ReadyInterval): AppState { return {pending: action.at}; }";
    helpers = helpers+"export function pressInterval(state: AppState, action: PressInterval): AppState { if (action.kind === 1 || action.kind === 2 || action.kind === 3) { return {request: action.kind}; } return {request: 0}; }";
    helpers = helpers+"export function startInterval(state: AppState, action: StartInterval): AppState { let raw: number = state.pending; if (clockStartRefused(state.sample, raw)) { return {request: 0, pending: -1, clockEpoch: state.clockEpoch+1, clockTrust: false, notice: \"Clock reading is undecidable or retreated; the start was refused and elapsed follows admitted monotone progress\"}; } if (state.phase === \"done\" || !clockStartAllowed(state.running, true, raw)) { return {request: 0, pending: raw}; } let at: number = raw; let rawWall: number = action.wall; let wall: number = clockWallValue(state.wall, action.wall); let epoch: number = clockEpochNext(state.clockEpoch, state.wall, state.sample, rawWall, at, "+String(clockTolerance())+"); return {running: true, anchor: at, sample: at, pending: at, wall: wall, clockEpoch: epoch, clockTrust: clockTrustNext(state.clockEpoch, epoch, rawWall, at), notice: clockNoticeNow(state.notice, true, false, rawWall, state.wall, at, state.sample, "+String(clockTolerance())+"), request: 0}; }";
    // A pause incorporates the monotone progress of the paired reading taken for its own press, then
    // stops the run; the paused interval counts no elapsed time and completion stays terminal.
    helpers = helpers+"export function pauseInterval(state: AppState, action: PauseInterval): AppState { "+clockPressReading("state.notice")+" if (!state.running) { return {request: 0}; } let walked: IntervalWalk = walkInterval(state.phase, state.round_value, state.elapsed, state.focus_done, clockAdvance(true, false, state.anchor, at)); return {phase: walked.phase, round_value: walked.round, elapsed: walked.elapsed, focus_done: walked.focus, running: false, anchor: -1, sample: at, pending: at, wall: wall, clockEpoch: epoch, clockTrust: trust, notice: notice, request: 0}; }";
    // A reset clears the authoritative run and keeps the paired reading it was admitted with, so the
    // next run compares against the reading the user actually reset at.
    helpers = helpers+"export function resetInterval(state: AppState, action: ResetInterval): AppState { "+clockPressReading("\"\"")+" return {phase: \"work\", round_value: 1, elapsed: 0, focus_done: 0, running: false, anchor: -1, sample: at, pending: at, wall: wall, clockEpoch: epoch, clockTrust: trust, notice: notice, request: 0}; }";
    // A skip is an ordinary renderer press: it changes no clock reading, so it re-baselines the run at
    // the last admitted monotone sample and never credits the skipped phase with time it did not spend.
    helpers = helpers+"export function skipInterval(state: AppState, action: SkipInterval): AppState { if (state.phase === \"work\") { if (state.round_value >= "+String(roundsValue)+") { return {phase: \"done\", elapsed: 0, running: false, anchor: -1, request: 0}; } return {phase: \"rest\", elapsed: 0, anchor: state.running ? state.sample : -1, pending: state.running ? state.sample : state.pending}; } if (state.phase === \"rest\") { return {phase: \"work\", round_value: state.round_value+1, elapsed: 0, anchor: state.running ? state.sample : -1, pending: state.running ? state.sample : state.pending}; } return state; }";
    helpers = helpers+"export function intervalTick(state: AppState, action: IntervalTick): AppState { "+clockTickReading("false")+" if (!state.running) { return {request: state.request}; } if (state.phase === \"done\") { return {request: state.request}; } let walked: IntervalWalk = walkInterval(state.phase, state.round_value, state.elapsed, state.focus_done, clockAdvance(true, false, state.anchor, at)); if (walked.phase === \"done\") { return {phase: \"done\", round_value: walked.round, elapsed: 0, focus_done: walked.focus, running: false, anchor: -1, sample: at, pending: at, wall: wall, clockEpoch: epoch, clockTrust: trust, notice: notice, request: state.request}; } return {phase: walked.phase, round_value: walked.round, elapsed: walked.elapsed, focus_done: walked.focus, running: true, anchor: clockAnchor(true, false, state.anchor, at), sample: at, pending: at, wall: wall, clockEpoch: epoch, clockTrust: trust, notice: notice}; }";
    helpers = helpers+"export function resumeInterval(state: AppState, action: ResumeInterval): AppState { return {anchor: clockResumeAnchor(state.sample, action.at), sample: clockResumeAnchor(state.sample, action.at), pending: clockResumeAnchor(state.sample, action.at), wall: -1, notice: clockResumeNotice(state.sample, action.at), request: 0, clockEpoch: state.clockEpoch+1, clockTrust: false}; }";
    helpers = helpers+"export function restorePaused(state: AppState): AppState { return {running: false, anchor: -1, sample: -1, pending: -1, wall: -1, notice: \"\", request: 0, clockEpoch: state.clockEpoch+1, clockTrust: false}; } export function restore(state: AppState): AppState { return recompute(restorePaused(state)); }";
    body = body+"ui.Text(text: state.phase) ui.NumberText(value: state.seconds_display)";
    body = body+"ui.Button(text: \"Start interval\", enabled: !state.running && state.phase !== \"done\", value: 1, onClick: action app.PressInterval {kind: payload}) ui.Button(text: \"Pause interval\", enabled: state.running, value: 2, onClick: action app.PressInterval {kind: payload}) ui.Button(text: \"Skip interval\", enabled: state.phase !== \"done\", value: 0, onClick: action app.SkipInterval {value: payload}) ui.Button(text: \"Reset interval\", enabled: !state.running, value: 3, onClick: action app.PressInterval {kind: payload})";
    body = body+"ui.Ticker(id: "+s.encode(id+"_sample")+", intervalMs: "+String(clockInterval())+", running: false, onTick: action app.ReadyInterval {at: payload})";
    body = body+"ui.Ticker(id: "+s.encode(id+"_tick")+", intervalMs: "+String(clockInterval())+", running: false, onTick: action app.IntervalTick {wall: payload})";
    body = body+"ui.Ticker(id: "+s.encode(id+"_start")+", intervalMs: "+String(clockInterval())+", running: false, onTick: action app.StartInterval {wall: payload})";
