    helpers = helpers+"export function dueCount(state: AppState): number { return state.rows.length; }";
    helpers = helpers+"export function soonCount(state: AppState): number { let result: number = 0; for (let row of state.rows) { if (dueSoon(state, row.day)) { result = result+1; } } return result; }";
    helpers = helpers+"export function expiredCount(state: AppState): number { let result: number = 0; for (let row of state.rows) { if (row.day < state.today) { result = result+1; } } return result; }";
    helpers = helpers+"export function soonNames(state: AppState): string { let result: string = \"\"; for (let row of state.rows) { if (dueSoon(state, row.day)) { if (result !== \"\") { result = result+\", \"; } result = result+row.name; } } return result; }";
    helpers = helpers+"export function dueSummary(state: AppState): string { let total: number = state.rows.length; if (total === 0) { return \"No due items\"; } return String(total)+\" items; \"+String(soonCount(state))+\" soon; \"+String(expiredCount(state))+\" expired\"; }";
