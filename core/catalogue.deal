        if (!numeric(s.finite(row.points),data)) { return refusal(entry,key+" "+String(index)+" points"); }
        index = index+1;
      }
    }
  }
  if (entry.definition.kind === "idea_deck") {
    let index: number = 0;
    for (let row of s.records(entry.parameters,"ideas")) {
      if (!supplied(s.text(row.title),data)) { return refusal(entry,"idea "+String(index)+" title"); }
      if (!supplied(s.text(row.level),data)) { return refusal(entry,"idea "+String(index)+" level"); }
      if (!supplied(s.text(row.instructions),data)) { return refusal(entry,"idea "+String(index)+" instructions"); }
      if (!numeric(s.finite(row.minutes),data)) { return refusal(entry,"idea "+String(index)+" minutes"); }
      index = index+1;
    }
  }
  if (entry.definition.kind === "live_figure") {
    let index: number = 0;
