    fields[fields.length] = derivedField(id,"live1","number"); fields[fields.length] = derivedField(id,"live2","number"); fields[fields.length] = derivedField(id,"live3","number");
    fields[fields.length] = derivedField(id,"live_source","string"); fields[fields.length] = derivedField(id,"live_asof","string"); fields[fields.length] = derivedField(id,"status","string");
    ports[ports.length] = publishPort("live1","number"); ports[ports.length] = publishPort("live2","number"); ports[ports.length] = publishPort("live3","number");
    ports[ports.length] = publishPort("live_source","string"); ports[ports.length] = publishPort("live_asof","string");
    updates[updates.length] = handler("RefreshLive","refreshLive"); updates[updates.length] = handler("PollLive","pollLive"); updates[updates.length] = handler("RefreshedLive","completeLive");
    updates[updates.length] = handler("Activate","activate");
    effects[effects.length] = {action:"RefreshLive",function:"runRefresh"}; effects[effects.length] = {action:"PollLive",function:"runPoll"};
    effects[effects.length] = {action:"Activate",function:"runActivate"};
    // The authorized initial read is admitted once: the reducer clears the activation-needed marker and
