  } else if (instance.kind === "interval_timer") {
    result[result.length] = computation(instance,"round","state.round_value","true","\"Unavailable\"",["f_"+instance.id+"_round_value"]);
    result[result.length] = computation(instance,"focus_seconds_done","state.focus_done","true","\"Unavailable\"",["f_"+instance.id+"_focus_done"]);
    result[result.length] = computation(instance,"seconds","state.elapsed/1000","true","\"Unavailable\"",["f_"+instance.id+"_elapsed"]);
  } else if (instance.kind === "timer") {
    result[result.length] = computation(instance,"seconds","state.elapsed/1000","true","\"Unavailable\"",["f_"+instance.id+"_elapsed"]);
  } else if (instance.kind === "due_items") {
    let dueSources: string[] = ["f_"+instance.id+"_rows","f_"+instance.id+"_today"];
    result[result.length] = computation(instance,"count","dueCount(state)","true","\"Unavailable\"",["f_"+instance.id+"_rows"]);
    result[result.length] = computation(instance,"soon_count","soonCount(state)","true","\"Unavailable\"",dueSources);
    result[result.length] = computation(instance,"expired_count","expiredCount(state)","true","\"Unavailable\"",dueSources);
    result[result.length] = computation(instance,"soon_names","soonNames(state)","true","\"Unavailable\"",dueSources);
    result[result.length] = computation(instance,"summary","dueSummary(state)","true","\"Unavailable\"",dueSources);
  } else if (instance.kind === "reminders") {
