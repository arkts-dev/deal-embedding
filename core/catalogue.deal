    body = body+"ui.Button(text: \"Add event\", value: state.event_sequence, onClick: action app.AddEvent {sequence: payload, id: \"\"})";
    body = body+"When(state.event_pending) {ui.Text(text: \"Adding the event\", style: \"muted\")} When(!state.event_pending && state.event_outcome === \"success\") {ui.Text(text: \"Added\")} When(!state.event_pending && state.event_outcome === \"failure\") {ui.Text(text: state.event_message, style: \"muted\")} When(!state.event_pending && state.event_outcome === \"none\") {ui.Text(text: \"Not added yet\", style: \"muted\")}";
  } else if (kind === "itinerary") {
    let stops: Record<string, unknown>[] = s.records(parameters,"stops");
