    declarations = declarations+"export class ReadyInterval { at: number; } export class PressInterval { kind: number; } export class StartInterval { wall: number; } export class PauseInterval { wall: number; } export class SkipInterval { value: number; } export class ResetInterval { wall: number; } export class IntervalTick { wall: number; } export class ResumeInterval { at: number; } export class IntervalWalk { phase: string; round: number; elapsed: number; focus: number; }";
    updates[updates.length] = handler("ReadyInterval","readyInterval"); updates[updates.length] = handler("PressInterval","pressInterval");
    updates[updates.length] = handler("StartInterval","startInterval"); updates[updates.length] = handler("PauseInterval","pauseInterval");
    updates[updates.length] = handler("SkipInterval","skipInterval"); updates[updates.length] = handler("ResetInterval","resetInterval");
    updates[updates.length] = handler("IntervalTick","intervalTick"); updates[updates.length] = handler("ResumeInterval","resumeInterval");
    if (!clockEmitted) { helpers = helpers+parts.clockHelpers(); clockEmitted = true; }
    // A phase walk spends elapsed milliseconds across phase boundaries: work then rest per round, no
    // final rest, and each completed phase is counted once even when the carried time spans several.
    // A tick that spans several phases carries the overflow and completion is terminal, so a late tick
