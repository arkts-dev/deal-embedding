    let index: number = 0;
    for (let row of entry.parameters.rows as Record<string, unknown>[]) {
      if (!supplied(s.text(row.title),data)) { return refusal(entry,"row "+String(index)+" title"); }
      if (!supplied(s.text(row.detail),data)) { return refusal(entry,"row "+String(index)+" detail"); }
      if (!numeric(s.finite(row.minute),data)) { return refusal(entry,"row "+String(index)+" minute"); }
      index = index+1;
    }
  }
  if ((entry.definition.kind === "bar_chart" || entry.definition.kind === "trend_chart") && Object.hasOwn(entry.parameters,"points")) {
    let index: number = 0;
    for (let point of entry.parameters.points as Record<string, unknown>[]) {
      if (!supplied(s.text(point.label),data)) { return refusal(entry,"point "+String(index)+" label"); }
      if (!numeric(s.finite(point.value),data)) { return refusal(entry,"point "+String(index)+" value"); }
      index = index+1;
    }
  }
