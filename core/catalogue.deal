}
export function computations(instance: screens.Instance, connections: screens.Connection[], instances: screens.Instance[]): composer.Computation[] {
  for (let connection of connections) { if (connection.readerInstance === instance.id) {
    let issued: boolean = false;
    for (let publisher of instances) { if (publisher.id === connection.writerInstance) { for (let port of publisher.fragment.ports) { if (port.direction === "publish" && port.name === connection.writerPort) { issued = true; } } } }
    if (!issued) { s.reject("Connection names an unissued publisher port: "+connection.writerInstance+"/"+connection.writerPort); }
  } }
  let result: composer.Computation[] = [];
  if (instance.kind === "checklist") {
    let dependencies: string[] = []; for (let field of instance.fragment.fields) { if (field.role === "authoritative") { dependencies[dependencies.length] = "f_"+instance.id+"_"+field.name; } }
    result[result.length] = computation(instance,"done","countDone(state)","true","\"Unavailable\"",dependencies);
    result[result.length] = computation(instance,"total",s.encode(s.records(instance.parameters,"items").length),"true","\"Unavailable\"",[]);
  } else if (instance.kind === "list_summary") {
    result[0] = computation(instance,"summary","summarize(state)","true","\"Publisher unavailable\"",[portDependency(instance,"done",connections,instances),portDependency(instance,"total",connections,instances)]);
  } else if (instance.kind === "search_list") {
    result[0] = computation(instance,"result","matched(state)","true","\"Unavailable\"",["f_"+instance.id+"_rows",portDependency(instance,"query",connections,instances)]);
  } else if (instance.kind === "master_list") {
    let rows: Record<string, unknown>[] = s.records(instance.parameters,"items"); let index: number = 0;
    while (index < rows.length) {
      result[result.length] = computation(instance,"shown_"+String(index),"rowMatches(state, state.rows["+String(index)+"])","true","\"Unavailable\"",["f_"+instance.id+"_rows",portDependency(instance,"query",connections,instances)]);
      index = index+1;
    }
  } else if (instance.kind === "detail_view") {
    result[0] = computation(instance,"detail","detailOf(state)","true","\"No publisher\"",[portDependency(instance,"items",connections,instances),portDependency(instance,"selected",connections,instances)]);
  } else if (instance.kind === "number_strip") {
    result[0] = computation(instance,"summary","summaryText(state)","true","\"Publisher unavailable\"",[portDependency(instance,"total",connections,instances),portDependency(instance,"average",connections,instances),portDependency(instance,"count",connections,instances),portDependency(instance,"currency",connections,instances)]);
  } else if (instance.kind === "breakdown_table") {
    result[0] = computation(instance,"breakdown","breakdownText(state)","true","\"Publisher unavailable\"",[portDependency(instance,"labels",connections,instances),portDependency(instance,"totals",connections,instances),portDependency(instance,"balances",connections,instances),portDependency(instance,"currency",connections,instances)]);
  } else if (instance.kind === "series_chart") {
    let valuesField: string = "totals"; if (s.text(instance.parameters.mode) === "balances") { valuesField = "balances"; }
    let sources: string[] = [portDependency(instance,"labels",connections,instances),portDependency(instance,"totals",connections,instances),portDependency(instance,"balances",connections,instances)];
    result[result.length] = computation(instance,"chart","chartText(state)","true","\"Publisher unavailable\"",sources);
    let scaleSources: string[] = [portDependency(instance,"labels",connections,instances),portDependency(instance,valuesField,connections,instances)];
    // The published fields carry their declared array types, so the guard reads them directly; a cast
    // would make the guard an indirect expression the read-only computation policy refuses.
    let scaleReady: string = "state."+valuesField+".length > 0 && state."+valuesField+".length === state.labels.length && state.chart_nonzero_display";
    result[result.length] = computation(instance,"chart_nonzero","seriesNonzero(state)","true","\"No aggregate rows\"",[portDependency(instance,valuesField,connections,instances)]);
    result[result.length] = computation(instance,"chart_min","seriesLow(state)",scaleReady,"\"No aggregate rows\"",scaleSources.concat(["f_"+instance.id+"_chart_nonzero"]));
    result[result.length] = computation(instance,"chart_max","seriesHigh(state)",scaleReady,"\"No aggregate rows\"",scaleSources.concat(["f_"+instance.id+"_chart_nonzero"]));
  } else if (instance.kind === "settle_up") {
    result[0] = computation(instance,"transfers","transfersText(state)","true","\"Publisher unavailable\"",[portDependency(instance,"labels",connections,instances),portDependency(instance,"balances",connections,instances),portDependency(instance,"currency",connections,instances)]);
  } else if (instance.kind === "itinerary") {
    let sources: string[] = ["f_"+instance.id+"_stop_labels","f_"+instance.id+"_stop_minutes"];
    sources[sources.length] = portDependency(instance,"start",connections,instances); sources[sources.length] = portDependency(instance,"deadline",connections,instances);
    // The per-stop reached flags are read by the schedule text and the done count, so both name them.
    let flagDependencies: string[] = []; let flagCount: number = s.records(instance.parameters,"stops").length; let flagIndex: number = 0;
    while (flagIndex < flagCount) { flagDependencies[flagDependencies.length] = "f_"+instance.id+"_reached_"+String(flagIndex); flagIndex = flagIndex+1; }
    for (let flag of flagDependencies) { sources[sources.length] = flag; }
    result[result.length] = computation(instance,"schedule","scheduleText(state)","true","\"Schedule unavailable\"",sources);
    result[result.length] = computation(instance,"done","countReached(state)","true","\"Unavailable\"",flagDependencies);
    result[result.length] = computation(instance,"total",s.encode(s.records(instance.parameters,"stops").length),"true","\"Unavailable\"",[]);
  } else if (instance.kind === "progress_line") {
    let sources: string[] = [portDependency(instance,"done",connections,instances),portDependency(instance,"total",connections,instances)];
    result[result.length] = computation(instance,"line","lineText(state)","(state.total as number) > 0 && (state.done as number) >= 0","\"Total unavailable\"",sources);
    result[result.length] = computation(instance,"percent","percentOf(state)","(state.total as number) > 0 && (state.done as number) >= 0","\"Total unavailable\"",sources);
  } else if (instance.kind === "quick_log") {
    result[result.length] = computation(instance,"goal_value",s.encode(s.finite(instance.parameters.goal)),"true","\"Unavailable\"",[]);
    // The tap history is retained, but today's total and count stay unavailable with their located
    // reason: no host-timezone adapter day is issued to project the captured instants onto. The value
    // expression is deliberately unreachable because the readiness is the literal `false`, so no
    // computed daily number can reach a consumer either.
    let history: string[] = ["f_"+instance.id+"_amounts","f_"+instance.id+"_stamps"];
    result[result.length] = computation(instance,"today_total","0","false",s.encode(dailyProjection("Today's total")),history);
    result[result.length] = computation(instance,"today_count","0","false",s.encode(dailyProjection("Today's count")),history);
  } else if (instance.kind === "reading_status") {
    let sources: string[] = ["f_"+instance.id+"_readings","f_"+instance.id+"_band_uppers","f_"+instance.id+"_band_labels","f_"+instance.id+"_band_levels"];
    result[result.length] = computation(instance,"latest","latestOf(state)","state.readings.length > 0","\"No reading\"",sources);
    result[result.length] = computation(instance,"status_level","levelOf(state, latestOf(state))","state.readings.length > 0","\"No reading\"",sources);
    result[result.length] = computation(instance,"status","statusOf(state, latestOf(state))","state.readings.length > 0","\"No reading\"",sources);
    result[result.length] = computation(instance,"history","historyOf(state)","true","\"Unavailable\"",["f_"+instance.id+"_readings"]);
    result[result.length] = computation(instance,"count","state.readings.length","true","\"Unavailable\"",["f_"+instance.id+"_readings"]);
    result[result.length] = computation(instance,"chart_min","chartLow(state)","state.readings.length > 0","\"No readings\"",["f_"+instance.id+"_readings"]);
    result[result.length] = computation(instance,"chart_max","chartHigh(state)","state.readings.length > 0","\"No readings\"",["f_"+instance.id+"_readings"]);
  } else if (instance.kind === "idea_deck") {
    let sources: string[] = ["f_"+instance.id+"_idea_ids","f_"+instance.id+"_idea_titles","f_"+instance.id+"_idea_levels","f_"+instance.id+"_idea_minutes","f_"+instance.id+"_idea_instructions","f_"+instance.id+"_time_filter","f_"+instance.id+"_level_filter","f_"+instance.id+"_cursor","f_"+instance.id+"_done_ids"];
    result[result.length] = computation(instance,"current","currentIdea(state)","true","\"Unavailable\"",sources);
    // The recorded marks keep their instants; the count of the marks made today stays unavailable with
    // its located reason because no host-timezone adapter day is issued to scope them. The value
    // expression is deliberately unreachable behind the literal `false` readiness.
    result[result.length] = computation(instance,"done_today","0","false",s.encode(dailyProjection("Done today")),["f_"+instance.id+"_done_ids","f_"+instance.id+"_done_stamps"]);
  } else if (instance.kind === "interval_timer") {
    result[result.length] = computation(instance,"round","state.round_value","true","\"Unavailable\"",["f_"+instance.id+"_round_value"]);
    result[result.length] = computation(instance,"focus_seconds_done","state.focus_done","true","\"Unavailable\"",["f_"+instance.id+"_focus_done"]);
    result[result.length] = computation(instance,"seconds","state.elapsed/1000","true","\"Unavailable\"",["f_"+instance.id+"_elapsed"]);
  } else if (instance.kind === "timer") {
    result[result.length] = computation(instance,"seconds","state.elapsed/1000","true","\"Unavailable\"",["f_"+instance.id+"_elapsed"]);
  }
  return result;
}
export function main(): void { return; }
