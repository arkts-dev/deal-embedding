import * as plans from "./plan";
import * as screens from "./screen";
import * as selecting from "./construction-selection";
import * as inference from "./inference";
import * as identity from "embedding/construction-identity";
import * as syntax from "embedding/fragment-syntax";
import * as bindings from "./bindings";
import * as composer from "./composer";
import * as s from "./construction-schema";
import * as disclosure from "./disclosure";

// Only executable definitions are issued. Unsupported kinds remain open for custom sections.
export class Parameter { name: string; type: string; required: boolean; fallback: unknown; maximum: number; }
// A kind's declared ports are eligibility facts: alignment offers a kind only when the composition can
// satisfy every declared reader. Each entry spells the port as `name:type`, so a reader and a publisher
// meet only on the exact nominal identity assembly resolves (ownership-slots-operations-and-assembly
// "Connection and layout").
export class Definition { kind: string; criteria: string; parameters: Parameter[]; mutable: boolean; reads: string[]; publishes: string[]; }
// The one placeholder a configured instance carries until the fill decodes it, and the located reason
// an instance keeps when the fill never answered for it.
export function notFilled(): string { return "Catalogue parameters were not filled"; }
export class Configured { need: string; definition: Definition; parameters: Record<string, unknown>; accepted: boolean; reason: string; }
// `maximum` is the row/text bound of a list or text parameter and the exact column count of
// `headers`; a heading itself decodes with the label bound of the shared row contract. Numeric
// parameters keep 0 there because their domains are declared by the spec row, not by a count.
export function definitions(): Definition[] {
  return [
    {kind:"note",criteria:"Editable retained text, not structured records, calculations or provider work.",parameters:[{name:"text",type:"string",required:false,fallback:"",maximum:512}],mutable:true,reads:[],publishes:[]},
    {kind:"spotlight",criteria:"Highlighted read-only message; never a substitute for constructing or obtaining a result.",parameters:[{name:"message",type:"string",required:true,fallback:"",maximum:512}],mutable:false,reads:[],publishes:[]},
    {kind:"metrics",criteria:"Read-only labelled facts from disclosed data, not generated estimates, calculations or provider records.",parameters:[{name:"values",type:"facts",required:true,fallback:null,maximum:12}],mutable:false,reads:[],publishes:[]},
    {kind:"key_facts",criteria:"Read-only labelled facts from disclosed data; no calculation, timer, action or external data.",parameters:[{name:"items",type:"facts",required:true,fallback:null,maximum:12}],mutable:false,reads:[],publishes:[]},
    {kind:"actions",criteria:"Local label selection and last-tapped label only. No external operation or completion claims.",parameters:[{name:"labels",type:"labels",required:true,fallback:null,maximum:12}],mutable:true,reads:[],publishes:[]},
    {kind:"checklist",criteria:"Keyed toggles with checked and total counts; not records, assignments or external operations.",parameters:[{name:"items",type:"entries",required:false,fallback:null,maximum:12}],mutable:true,reads:[],publishes:["done:number","total:number"]},
    {kind:"filter_box",criteria:"Editable query publishing query:string for an issued reader. No search provider or external effect.",parameters:[],mutable:true,reads:[],publishes:["query:string"]},
    {kind:"list_summary",criteria:"Read-only done/total/remaining from exact typed publishers; cannot create or replace a publisher.",parameters:[],mutable:false,reads:["done:number","total:number"],publishes:[]},
    {kind:"data_table",criteria:"Read-only disclosed cells in three columns whose rows match their headers; never calculations, estimates or provider data.",parameters:[{name:"headers",type:"headers",required:true,fallback:null,maximum:3},{name:"rows",type:"cells",required:true,fallback:null,maximum:12}],mutable:false,reads:[],publishes:[]},
    {kind:"timeline",criteria:"Read-only chronological rail of disclosed minute-ordered rows in their supplied order; no records, actions or external data.",parameters:[{name:"rows",type:"timeline",required:true,fallback:null,maximum:12}],mutable:false,reads:[],publishes:[]},
    {kind:"bar_chart",criteria:"Read-only zero-based labelled bars of disclosed values inside one declared positive scale; never an estimate or calculation.",parameters:[{name:"points",type:"points",required:true,fallback:null,maximum:12},{name:"maximum",type:"positive",required:true,fallback:null,maximum:0}],mutable:false,reads:[],publishes:[]},
    {kind:"trend_chart",criteria:"Read-only ordered line chart of two to twelve grounded disclosed points inside one declared scale; never an estimate or calculation.",parameters:[{name:"points",type:"points",required:true,fallback:null,maximum:12},{name:"minimum",type:"number",required:true,fallback:null,maximum:0},{name:"maximum",type:"number",required:true,fallback:null,maximum:0}],mutable:false,reads:[],publishes:[]}
  ];
}
// A reader kind can only be wired when the need requests a dependency another need publishes: a plan
// read that names an input or constant asks for a seed, never for a publisher's value, so issuing a
// reader kind for it would offer an instance assembly can never connect. Both call sites that issue
// catalogue alternatives — the two Select batches and alignment — share this one predicate.
export function carriesReaders(plan: plans.Plan, need: plans.Need): boolean {
  for (let other of plan.needs) { if (other.id !== need.id && s.contains(need.reads,other.id)) { return true; } }
  return false;
}
export function alternatives(plan: plans.Plan): selecting.Alternative[] {
  let result: selecting.Alternative[] = [];
  for (let need of plan.needs) { if (need.type === "content" || need.type === "other") {
    let readers: boolean = carriesReaders(plan,need);
    for (let definition of definitions()) {
      if (definition.reads.length > 0 && !readers) { continue; }
      result[result.length] = {id:"cat_"+need.id+"_"+definition.kind,need:need.id,origin:"catalogue",kind:definition.kind,criteria:definition.criteria,eligible:true,reason:""};
    }
  } }
  return result;
}
// Decoded values carry real JSON kinds, so their wire spelling identifies the type: a text begins
// with a quote, an array with a bracket and a row with a brace. A wrong-typed field or collection of
// these kinds then rejects instead of being read as an empty value or re-spelled by a later emitter.
async function text(value: unknown, maximum: number, nonblank: boolean): Promise<string> {
  if (!s.encode(value).startsWith("\"")) { s.reject("Catalogue text required"); }
  let result: string = s.text(value); if (nonblank) { s.nonblank(result); } if (result.length > maximum) { s.reject("Catalogue text bound"); } return result;
}
function list(value: unknown, name: string): void { if (!s.encode(value).startsWith("[")) { s.reject("Catalogue array required: "+name); } }
function record(value: unknown, name: string): void { if (!s.encode(value).startsWith("{")) { s.reject("Catalogue row required: "+name); } }
// Number.isFinite is the only total numeric test for a dynamic value: it never coerces, so a text
// or boolean value rejects here instead of reaching a checked numeric cast.
function number(value: unknown, name: string): number { if (!Number.isFinite(value)) { s.reject("Catalogue number required: "+name); } return s.finite(value); }
function integer(value: unknown, name: string): number { let result: number = number(value,name); if (Math.floor(result) !== result) { s.reject("Catalogue integral required: "+name); } return result; }
// An optional row field returns its dynamic value so the wire-kind guard of `text` runs before any
// typed cast; a typed accessor would raise the runtime type error instead of a schema rejection.
function optionalValue(owner: Record<string, unknown>, name: string): unknown { if (!Object.hasOwn(owner,name)) { return ""; } return owner[name]; }
// A row identity is a JSON string before it is a plan identifier; a wrong wire kind rejects like any
// other text field instead of raising the runtime type error.
function rowIdentity(value: unknown, name: string): string { if (!s.encode(value).startsWith("\"")) { s.reject("Catalogue text required: "+name); } return s.identifier(value); }
// A row boolean is admitted only as a JSON boolean, never through a cast of another wire kind.
function flag(owner: Record<string, unknown>, name: string, fallback: boolean): boolean {
  if (!Object.hasOwn(owner,name)) { return fallback; }
  let encoded: string = s.encode(owner[name]); if (encoded !== "true" && encoded !== "false") { s.reject("Catalogue boolean required: "+name); }
  return owner[name] as boolean;
}
// Timeline minutes are the shared minute-of-day domain; the rail keeps the supplied order and shows
// the minute as zero-padded 24-hour text, because the pack's rail item carries display text only.
function clock(minute: number): string { let hours: number = Math.floor(minute/60); let rest: number = minute-hours*60; let text: string = String(hours); if (hours < 10) { text = "0"+text; } let minutes: string = String(rest); if (rest < 10) { minutes = "0"+minutes; } return text+":"+minutes; }
// The parameter record arrives as dynamic JSON, so a null or scalar answer reaches the guard here
// and rejects like any row instead of raising a runtime type error at the call boundary.
export async function decode(definition: Definition, raw: unknown): Promise<Record<string, unknown>> {
  if (!s.encode(raw).startsWith("{")) { s.reject("Catalogue parameters required"); }
  let given: Record<string, unknown> = raw as Record<string, unknown>;
  let required: string[] = []; let optional: string[] = ["title","subtitle"];
  for (let parameter of definition.parameters) { if (parameter.required) { required[required.length] = parameter.name; } else { optional[optional.length] = parameter.name; } }
  s.closed(given,required,optional); let result: Record<string, unknown> = {title:"",subtitle:""};
  // Decoded lists keep their typed identity for the relations no single parameter can check.
  let headers: string[] = []; let table: string[][] = []; let points: Record<string, unknown>[] = [];
  let minimum: number = 0; let maximum: number = 0;
  for (let key of ["title","subtitle"]) { if (Object.hasOwn(given,key)) { result[key] = await text(given[key],512,false); } }
  for (let parameter of definition.parameters) {
    let value: unknown = parameter.fallback; if (value === null) { let empty: Record<string, unknown>[] = []; value = empty; } if (Object.hasOwn(given,parameter.name)) { value = given[parameter.name]; }
    if (parameter.type === "string") { result[parameter.name] = await text(value,parameter.maximum,false); }
    else if (parameter.type === "number" || parameter.type === "positive") {
      let checked: number = number(value,parameter.name); if (parameter.type === "positive" && checked <= 0) { s.reject("Catalogue positive bound: "+parameter.name); } result[parameter.name] = checked;
      if (parameter.name === "minimum") { minimum = checked; } else if (parameter.name === "maximum") { maximum = checked; }
    }
    else if (parameter.type === "labels") {
      list(value,parameter.name); let entries: unknown[] = value as unknown[]; if (entries.length < 1 || entries.length > parameter.maximum) { s.reject("Catalogue labels bound"); }
      let labels: string[] = [];
      for (let label of entries) { labels[labels.length] = await text(label,32,true); }
      result[parameter.name] = labels;
    }
    else if (parameter.type === "headers") {
      list(value,parameter.name); let entries: unknown[] = value as unknown[]; if (entries.length !== parameter.maximum) { s.reject("Catalogue headers bound"); }
      let names: string[] = [];
      for (let name of entries) { names[names.length] = await text(name,32,true); }
      headers = names; result[parameter.name] = names;
    } else if (parameter.type === "cells") {
      list(value,parameter.name); let entries: unknown[] = value as unknown[]; if (entries.length > parameter.maximum) { s.reject("Catalogue rows bound"); }
      for (let row of entries) {
        list(row,"cells"); let cells: string[] = [];
        for (let cell of row as unknown[]) { cells[cells.length] = await text(cell,512,false); }
        table[table.length] = cells;
      }
      result[parameter.name] = table;
    } else {
      list(value,parameter.name); let entries: unknown[] = value as unknown[]; if (entries.length > parameter.maximum) { s.reject("Catalogue rows bound"); }
      let checked: Record<string, unknown>[] = []; let ids: string[] = [];
      let previous: number = -1;
      for (let entry of entries) {
        record(entry,parameter.name); let row: Record<string, unknown> = entry as Record<string, unknown>;
        if (parameter.type === "facts") { s.closed(row,["label","value"],[]); checked[checked.length] = {label:await text(row.label,32,true),value:await text(row.value,512,false)}; }
        else if (parameter.type === "timeline") {
          s.closed(row,["minute","title"],["detail"]); let minute: number = integer(row.minute,"minute");
          if (minute < 0 || minute > 1439) { s.reject("Catalogue timeline minute domain"); }
          if (minute < previous) { s.reject("Catalogue timeline order"); } previous = minute;
          checked[checked.length] = {minute:minute,title:await text(row.title,32,true),detail:await text(optionalValue(row,"detail"),512,false)};
        }
        else if (parameter.type === "points") { s.closed(row,["label","value"],[]); checked[checked.length] = {label:await text(row.label,32,true),value:number(row.value,"value")}; }
        else if (parameter.type === "entries") { s.closed(row,["id","label"],["detail","done"]); let id: string = rowIdentity(row.id,"id"); s.unique(ids,id); checked[checked.length] = {id:id,label:await text(row.label,32,true),detail:await text(optionalValue(row,"detail"),512,false),done:flag(row,"done",false)}; }
        // A kind table typo must reject instead of decoding another row schema silently.
        else { s.reject("Catalogue parameter row type: "+parameter.type); }
      }
      if (parameter.type === "points") { points = checked; }
      result[parameter.name] = checked;
    }
  }
  // Relations that no single parameter can check are decided once every row is decoded.
  if (definition.kind === "data_table") {
    // Every row carries exactly one cell per declared header.
    for (let row of table) { if (row.length !== headers.length) { s.reject("Catalogue columns match headers"); } }
  } else if (definition.kind === "bar_chart" || definition.kind === "trend_chart") {
    if (definition.kind === "trend_chart") { if (minimum >= maximum) { s.reject("Catalogue chart scale"); } if (points.length < 2) { s.reject("Catalogue chart points bound"); } }
    for (let point of points) { let value: number = s.finite(point.value); if (value < minimum || value > maximum) { s.reject("Catalogue chart value outside scale"); } }
  }
  return result;
}
// The empty string admits the instance; a refusal names the issued catalogue instance, its kind and
// the supplied row or field that no evidence admits, so a rejected instance keeps a located reason.
function refusal(entry: Configured, where: string): string { return "Undisclosed personal or factual content: section_"+entry.need+" ("+entry.definition.kind+"): "+where; }
export function disclosed(entry: Configured, original: string, facts: string, userOwned: boolean): string {
  let data: string = disclosure.evidence(original,facts);
  if (entry.definition.kind === "metrics" || entry.definition.kind === "key_facts") {
    let key: string = "values"; if (entry.definition.kind === "key_facts") { key = "items"; }
    let index: number = 0;
    for (let row of s.records(entry.parameters,key)) {
      if (!disclosure.admitsText(data,s.text(row.label))) { return refusal(entry,"row "+String(index)+" label"); }
      if (!disclosure.admitsText(data,s.text(row.value))) { return refusal(entry,"row "+String(index)+" value"); }
      index = index+1;
    }
  }
  if (entry.definition.kind === "checklist") {
    let index: number = 0;
    for (let row of s.records(entry.parameters,"items")) {
      if (!disclosure.admitsText(data,s.text(row.label))) { return refusal(entry,"row "+String(index)+" label"); }
      if (!disclosure.admitsText(data,s.text(row.detail))) { return refusal(entry,"row "+String(index)+" detail"); }
      index = index+1;
    }
  }
  // The same row mapping covers the read-only sections: every supplied header, cell, rail title,
  // detail and minute, and chart label with its shortest round-trip decimal spelling needs evidence,
  // so an invented row is refused as a whole rather than kept in a shortened list. A section with no
  // rows, and an unfilled instance, display nothing and so supply no value.
  if (entry.definition.kind === "data_table" && Object.hasOwn(entry.parameters,"rows") && Object.hasOwn(entry.parameters,"headers")) {
    let table: string[][] = entry.parameters.rows as string[][];
    if (table.length > 0) {
      let column: number = 0;
      for (let header of entry.parameters.headers as string[]) { if (!disclosure.admitsText(data,header)) { return refusal(entry,"header "+String(column)); } column = column+1; }
      let index: number = 0;
      for (let row of table) { let cell: number = 0; for (let value of row) { if (!disclosure.admitsText(data,value)) { return refusal(entry,"row "+String(index)+" cell "+String(cell)); } cell = cell+1; } index = index+1; }
    }
  }
  if (entry.definition.kind === "timeline" && Object.hasOwn(entry.parameters,"rows")) {
    let index: number = 0;
    for (let row of entry.parameters.rows as Record<string, unknown>[]) {
      if (!disclosure.admitsText(data,s.text(row.title))) { return refusal(entry,"row "+String(index)+" title"); }
      if (!disclosure.admitsText(data,s.text(row.detail))) { return refusal(entry,"row "+String(index)+" detail"); }
      if (!disclosure.admitsNumber(data,s.finite(row.minute))) { return refusal(entry,"row "+String(index)+" minute"); }
      index = index+1;
    }
  }
  if ((entry.definition.kind === "bar_chart" || entry.definition.kind === "trend_chart") && Object.hasOwn(entry.parameters,"points")) {
    let index: number = 0;
    for (let point of entry.parameters.points as Record<string, unknown>[]) {
      if (!disclosure.admitsText(data,s.text(point.label))) { return refusal(entry,"point "+String(index)+" label"); }
      if (!disclosure.admitsNumber(data,s.finite(point.value))) { return refusal(entry,"point "+String(index)+" value"); }
      index = index+1;
    }
  }
  // The chart scale is a declared configuration of the picture, like the section title, and not a
  // supplied value: only the plotted labels and values must be evidenced.
  if (userOwned && entry.definition.kind === "note" && !disclosure.admitsText(data,s.text(entry.parameters.text))) { return refusal(entry,"note text"); }
  return "";
}
export function selected(plan: plans.Plan, choices: selecting.Choice[]): Configured[] {
  let result: Configured[] = []; let kinds: string[] = [];
  for (let choice of choices) { for (let definition of definitions()) { if (choice.alternative === "cat_"+choice.need+"_"+definition.kind && !s.contains(kinds,definition.kind)) { kinds[kinds.length] = definition.kind; result[result.length] = {need:choice.need,definition:definition,parameters:{},accepted:false,reason:notFilled()}; } } }
  return result;
}
export async function fill(context: selecting.Context, plan: plans.Plan, entries: Configured[]): Promise<void> {
  if (entries.length === 0) { return; }
  let operation: inference.Operation = inference.operation(await identity.issue(),1);
  let response = await inference.ask(operation,"content","SPECIFICATION\n"+context.specification+"\nORIGINAL REQUEST\n"+context.original+"\nFACTS (data)\n"+context.facts+"\nFROZEN CONTRACTS (data)\n"+context.contracts+"\nCURRENT PLAN\n"+s.encode(plan)+"\nISSUED DEFINITIONS\n"+s.encode(entries)+"\nFill only issued parameters from disclosed data. Never invent personal items, facts or replace user-owned wording. Return {sections:[{need,parameters}]} once per issued need. No source or behavior selection.","","",6000,false);
  if (response.refusal !== "") { return; }
  try {
    let raw: Record<string, unknown> = JSON.parse(response.content); s.closed(raw,["sections"],[]); let rows: Record<string, unknown>[] = s.records(raw,"sections"); let ids: string[] = [];
    for (let row of rows) { s.closed(row,["need","parameters"],[]); let need: string = s.identifier(row.need); s.unique(ids,need); let issued: boolean = false; for (let entry of entries) { if (entry.need === need) { issued = true; } } if (!issued) { s.reject("Unissued catalogue fill"); } }
    for (let entry of entries) { for (let row of rows) { if ((row.need as string) === entry.need) {
      try { entry.parameters = await decode(entry.definition,row.parameters); entry.accepted = true; entry.reason = ""; }
      catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } entry.reason = error.message; }
    } } }
  } catch (unknownError) { let error: Error = unknownError as Error; if (!s.contains(["CONSTRUCTION_SCHEMA","E8001","E8007"],error.name)) { throw error; } }
}
async function literal(value: unknown, type: string): Promise<string> {
  // Compiler mechanism handles control characters and authored Unicode without textual substitution.
  let empty: Record<string, unknown> = {};
  return await syntax.expression(s.encode({source:s.encode(value),expected:type,names:empty,fields:empty,types:empty,variables:empty}));
}
export async function instantiate(entry: Configured, registry: bindings.Registry): Promise<screens.Instance> {
  if (!entry.accepted) { s.reject("Unfilled catalogue instance"); }
  let id: string = "section_"+entry.need; let kind: string = entry.definition.kind; let parameters: Record<string, unknown> = entry.parameters;
  let fields: screens.Field[] = []; let updates: screens.Handler[] = []; let ports: screens.Port[] = []; let helpers: string = ""; let declarations: string = "";
  let body: string = ""; let title: string = s.text(parameters.title); if (title !== "") { body = body+"ui.Text(text: "+await literal(title,"string")+")"; }
  let subtitle: string = s.text(parameters.subtitle); if (subtitle !== "") { body = body+"ui.Text(text: "+await literal(subtitle,"string")+")"; }
  if (kind === "note" || kind === "filter_box") {
    let name: string = "text"; let initial: string = ""; if (kind === "filter_box") { name = "query"; } else { initial = s.text(parameters.text); }
    fields[0] = {name:name,type:"string",role:"authoritative",dependencies:[],initial:await literal(initial,"string"),owner:id};
    declarations = "export class Change { value: string; }"; updates[0] = {action:"Change",function:"change"}; helpers = "export function change(state: AppState, action: Change): AppState { return {"+name+":action.value}; }";
    body = body+"ui.TextField(label: "+await literal(title,"string")+", value: state."+name+", onChange: action app.Change {value: payload})";
    if (kind === "filter_box") { ports[0] = {name:"query",type:"string",direction:"publish",getter:"query",optional:false}; }
  } else if (kind === "spotlight") { body = body+"ui.Text(text: "+await literal(parameters.message,"string")+")"; }
  else if (kind === "metrics" || kind === "key_facts") {
    let key: string = "values"; if (kind === "key_facts") { key = "items"; }
    let rows: Record<string, unknown>[] = s.records(parameters,key);
    // Stat is the pack's labelled value and is valid on every target's component subset, unlike the
    // key/value group, so a fact section renders on a card as well as on a screen or chat target.
    let group: string = "ui.MetricGroup() {";
    for (let row of rows) { group = group+"ui.Stat(label: "+await literal(s.text(row.label),"string")+", value: "+await literal(s.text(row.value),"string")+")"; }
    if (rows.length === 0) { body = body+"ui.Text(text: \"No disclosed facts\", style: \"muted\")"; } else { body = body+group+"}"; }
  } else if (kind === "data_table") {
    // Array props have no view literal, so the supplied cells are seeded into authoritative state and
    // reach the table through the compiler mechanism instead of being re-spelled in view syntax.
    let rows: string[][] = parameters.rows as string[][]; let rowsBody: string = ""; let index: number = 0;
    // The declared column count is the decoded header count, so it is three by the row contract.
    let columns: number = (parameters.headers as string[]).length;
    // A section with no rows binds no table node, so it seeds no state at all.
    if (rows.length > 0) { fields[0] = {name:"headers",type:"string[]",role:"authoritative",dependencies:[],initial:await literal(parameters.headers as string[],"string[]"),owner:id}; }
    for (let row of rows) {
      let name: string = "row_"+String(index);
      fields[fields.length] = {name:name,type:"string[]",role:"authoritative",dependencies:[],initial:await literal(row,"string[]"),owner:id};
      rowsBody = rowsBody+"ui.TableRow(cells: state."+name+")"; index = index+1;
    }
    if (rows.length === 0) { body = body+"ui.Text(text: \"No disclosed rows\", style: \"muted\")"; }
    else { body = body+"ui.Table(headers: state.headers, columns: "+await literal(columns,"number")+") {"+rowsBody+"}"; }
  } else if (kind === "timeline") {
    let rows: Record<string, unknown>[] = parameters.rows as Record<string, unknown>[]; let rowsBody: string = "";
    for (let row of rows) {
      rowsBody = rowsBody+"ui.TimelineItem(title: "+await literal(s.text(row.title),"string")+", subtitle: "+await literal(s.text(row.detail),"string")+", trailing: "+await literal(clock(s.integral(row.minute)),"string")+")";
    }
    // The container requires children, so an empty rail is only its explanation.
    if (rows.length === 0) { body = body+"ui.Text(text: \"No disclosed entries\", style: \"muted\")"; }
    else { body = body+"ui.Timeline() {"+rowsBody+"}"; }
  } else if (kind === "bar_chart" || kind === "trend_chart") {
    let points: Record<string, unknown>[] = parameters.points as Record<string, unknown>[]; let values: number[] = []; let labels: string[] = []; let zero: boolean = true;
    for (let point of points) { let value: number = s.finite(point.value); values[values.length] = value; labels[labels.length] = s.text(point.label); if (value !== 0) { zero = false; } }
    if (points.length > 0) {
      fields[0] = {name:"series",type:"number[]",role:"authoritative",dependencies:[],initial:await literal(values,"number[]"),owner:id};
      fields[1] = {name:"categories",type:"string[]",role:"authoritative",dependencies:[],initial:await literal(labels,"string[]"),owner:id};
      // The scale is issued through the same compiler literal mechanism as every other value, so
      // the declared number reaches the view exactly and no spelling is assembled by hand.
      let chart: string = "ui.Sparkline(series: state.series, maximum: "+await literal(s.finite(parameters.maximum),"number")+", categories: state.categories";
      if (kind === "bar_chart") { chart = chart+", bars: true, minimum: "+await literal(0,"number")+")"; }
      else { chart = chart+", minimum: "+await literal(s.finite(parameters.minimum),"number")+")"; }
      body = body+chart;
    }
    if (points.length === 0) { body = body+"ui.Text(text: \"No disclosed points\", style: \"muted\")"; }
    else if (zero) { body = body+"ui.Text(text: \"All values are zero\", style: \"muted\")"; }
  } else if (kind === "actions") {
    fields[0] = {name:"selected",type:"string",role:"authoritative",dependencies:[],initial:"\"\"",owner:id}; declarations = "export class Select { value: string; rank: number; }"; updates[0] = {action:"Select",function:"select"};
    helpers = "export function select(state: AppState, action: Select): AppState { return {selected:action.value}; }";
    for (let label of s.stringArray(parameters.labels)) { body = body+"ui.Button(text: "+await literal(label,"string")+", onClick: action app.Select {value: "+await literal(label,"string")+", rank: payload})"; } body = body+"ui.Text(text: state.selected)";
  } else if (kind === "checklist") {
    let rows: Record<string, unknown>[] = s.records(parameters,"items"); let index: number = 0; let sum: string = "0";
    // An empty disclosed checklist binds no toggle control, so its action class and update stay unissued.
    if (rows.length > 0) { declarations = "export class Toggle { id: string; rank: number; }"; updates[0] = {action:"Toggle",function:"toggle"}; }
    let changes: string = ""; let separator: string = "";
    for (let row of rows) { let name: string = "checked_"+s.identifier(row.id); fields[fields.length] = {name:name,type:"boolean",role:"authoritative",dependencies:[],initial:s.encode(row.done),owner:id};
      helpers = helpers+"export function count_"+s.identifier(row.id)+"(state: AppState): number { if (state."+name+") {return 1;} return 0;}";
      sum = sum+"+count_"+s.identifier(row.id)+"(state)"; changes = changes+separator+name+":state."+name; separator = ", ";
      body = body+"ui.Button(text: "+await literal(row.label,"string")+", onClick: action app.Toggle {id: "+await literal(row.id,"string")+", rank: payload}) When(state."+name+") {ui.Text(text: \"Done\")}";
      index = index+1;
    }
    if (rows.length > 0) { helpers = helpers+"export function toggle(state: AppState, action: Toggle): AppState {";
      for (let row of rows) { helpers = helpers+"if(action.id === "+await literal(row.id,"string")+") {return {"; let comma: string = ""; for (let other of rows) { let name: string = "checked_"+s.identifier(other.id); helpers = helpers+comma+name+":"; if (other.id === row.id) { helpers = helpers+"!state."+name; } else { helpers = helpers+"state."+name; } comma = ", "; } helpers = helpers+"};}"; }
      helpers = helpers+"return state;}"; }
    helpers = helpers+" export function countDone(state: AppState): number { return "+sum+"; }";
    fields[fields.length] = {name:"done",type:"number",role:"derived",dependencies:[],initial:"null",owner:id};
    fields[fields.length] = {name:"total",type:"number",role:"derived",dependencies:[],initial:"null",owner:id};
    ports = [{name:"done",type:"number",direction:"publish",getter:"done",optional:false},{name:"total",type:"number",direction:"publish",getter:"total",optional:false}];
    if (index === 0) { body = body+"ui.Text(text: \"No disclosed items\", style: \"muted\")"; }
  } else if (kind === "list_summary") {
    ports = [{name:"done",type:"number",direction:"read",getter:"done",optional:false},{name:"total",type:"number",direction:"read",getter:"total",optional:false}];
    fields[0] = {name:"summary",type:"string",role:"derived",dependencies:[],initial:"null",owner:id};
    declarations = "";
    helpers = "export function summarize(state: AppState): string { let done: number = state.done as number; let total: number = state.total as number; let remaining: number = total-done; return String(done)+\" / \"+String(total)+\"; remaining: \"+String(remaining); }";
    body = body+"When(state.summary_ready) {ui.Text(text: state.summary_display)} When(!state.summary_ready) {ui.Text(text: state.summary_reason, style: \"muted\")}";
  }
  let view: string = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View {ui.Column(){"+body+"}}";
  let issued: screens.Instance = {id:id,kind:kind,origin:"catalogue",parameters:parameters,fragment:{declarations:declarations,fields:fields,updates:updates,effects:[],helpers:helpers,view:view,options:[],content:[],ports:ports,holes:[],covers:[entry.need],owns:[id]},bodies:{}};
  issued.definition = screens.issueDefinition(issued.fragment);
  return issued;
}
// The qualified authoritative resource a connection reads. It is the publisher's declared port getter,
// never its port name: a part publishes under a need identifier while the emitted field has its own
// name, so only the declared getter names a resource the composition emits.
function writerField(connection: screens.Connection, instances: screens.Instance[]): string {
  let getter: string = "";
  for (let publisher of instances) { if (publisher.id === connection.writerInstance) {
    for (let port of publisher.fragment.ports) { if (port.direction === "publish" && port.name === connection.writerPort) { getter = port.getter; } }
  } }
  if (getter === "") { s.reject("Connection names an unissued publisher port: "+connection.writerInstance+"/"+connection.writerPort); }
  return "f_"+connection.writerInstance+"_"+getter;
}
export function computations(instance: screens.Instance, connections: screens.Connection[], instances: screens.Instance[]): composer.Computation[] {
  let result: composer.Computation[] = [];
  if (instance.kind === "checklist") {
    let dependencies: string[] = []; for (let field of instance.fragment.fields) { if (field.role === "authoritative") { dependencies[dependencies.length] = "f_"+instance.id+"_"+field.name; } }
    result[result.length] = {instance:instance.id,field:"done",value:"countDone(state)",ready:"true",reason:"\"Unavailable\"",dependencies:dependencies};
    result[result.length] = {instance:instance.id,field:"total",value:s.encode(s.records(instance.parameters,"items").length),ready:"true",reason:"\"Unavailable\"",dependencies:[]};
  } else if (instance.kind === "list_summary") {
    let dependencies: string[] = [];
    for (let connection of connections) { if (connection.readerInstance === instance.id) { dependencies[dependencies.length] = writerField(connection,instances); } }
    result[0] = {instance:instance.id,field:"summary",value:"summarize(state)",ready:"true",reason:"\"Publisher unavailable\"",dependencies:dependencies};
  }
  return result;
}
export function main(): void { return; }
