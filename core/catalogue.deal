    fields[fields.length] = authoredField(id,"amounts","number[]","[]");
    fields[fields.length] = authoredField(id,"stamps","number[]","[]");
    fields[fields.length] = derivedField(id,"goal_value","number");
    fields[fields.length] = derivedField(id,"today_total","number");
    fields[fields.length] = derivedField(id,"today_count","number");
    ports[ports.length] = {name:"goal",type:"number",direction:"publish",getter:"goal_value",optional:false};
