    else if (parameter.type === "rounds") { let checked: number = integer(value,parameter.name); if (checked <= 0) { s.reject("Catalogue positive rounds: "+parameter.name); } result[parameter.name] = checked; }
    else if (parameter.type === "seconds") { let checked: number = integer(value,parameter.name); if (checked <= 0) { s.reject("Catalogue positive seconds: "+parameter.name); } result[parameter.name] = checked; }
    else if (parameter.type === "duration") { let checked: number = integer(value,parameter.name); if (checked <= 0) { s.reject("Catalogue positive duration: "+parameter.name); } result[parameter.name] = checked; }
