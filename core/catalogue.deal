    result[result.length] = computation(instance,"done","reminderDoneCount(state)","true","\"Unavailable\"",reminderSources);
    result[result.length] = computation(instance,"total","state.rows.length","true","\"Unavailable\"",["f_"+instance.id+"_rows"]);
