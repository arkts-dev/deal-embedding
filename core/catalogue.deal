    kind("interval_timer","Work/rest/complete interval rounds with elapsed, running, start/pause/skip/reset and once-only signals.",true,[param("workSeconds","seconds",true,null,0,"configuration"),param("restSeconds","seconds",true,null,0,"configuration"),param("rounds","rounds",true,null,0,"configuration")],[publish("round","number"),publish("focus_seconds_done","number")],[],[],["clock"],true),
