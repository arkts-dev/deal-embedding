    helpers = helpers+"export function pollLive(state: AppState, action: PollLive): AppState { if (state.refresh_pending || !state.refresh_polling || state.refresh_attempt >= 9007199254740991) { return state; } if (action.now < state.refresh_polled+"+String(intervalMs)+") { return state; } return {refresh_attempt: state.refresh_attempt+1, refresh_pending: true, refresh_polled: action.now, refresh_action: null, poll_action: action, refresh_code: \"\", refresh_outcome: \"none\", refresh_message: \"\"}; }";
    helpers = helpers+"export async function runRefresh(state: AppState, action: RefreshLive): Promise<RefreshedLive> { if (!state.refresh_pending || (state.refresh_action as RefreshLive) !== action) { return {sequence: -1, ok: false, outcome: \"none\", code: \"NOT_ADMITTED\", message: \"Not admitted\", values: [], asof: \"\"}; } try { let paths: string[] = []; for (let path of state.figure_paths) { paths[paths.length] = path; } let read: ProbeRead = JSON.parse(await probe_"+id+".fetch(state.source_url, state.source_mode, paths, state.source_asof_path)); return {sequence: state.refresh_attempt, ok: true, outcome: \"success\", code: \"\", message: \"\", values: read.values, asof: read.asof}; } catch (unknownError) { let error: Error = unknownError as Error; return {sequence: state.refresh_attempt, ok: false, outcome: \"failure\", code: error.name, message: error.message, values: [], asof: \"\"}; } }";
    // A poll is admitted by the tick's own instant, so the effect of a poll that was not admitted reports
