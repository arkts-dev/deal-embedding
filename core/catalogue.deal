    declarations = declarations+"export class Advance { value: number; } export class ResetItinerary { value: number; }";
    updates[updates.length] = handler("Advance","advance"); updates[updates.length] = handler("ResetItinerary","resetItinerary");
    let advanceBody: string = "export function advance(state: AppState, action: Advance): AppState {";
    let resetBody: string = "export function resetItinerary(state: AppState, action: ResetItinerary): AppState { return {";
    let countBody: string = "export function countReached(state: AppState): number { let total: number = 0;";
    let reachedIndex: number = 0; let resetSeparator: string = "";
    while (reachedIndex < labels2.length) {
      let flag: string = "reached_"+String(reachedIndex);
      advanceBody = advanceBody+"if (!state."+flag+") { return {";
      let copyIndex: number = 0; let copySeparator: string = "";
      while (copyIndex < labels2.length) {
        let other: string = "reached_"+String(copyIndex);
        advanceBody = advanceBody+copySeparator+other+": ";
        if (copyIndex === reachedIndex) { advanceBody = advanceBody+"true"; } else { advanceBody = advanceBody+"state."+other; }
        copySeparator = ", "; copyIndex = copyIndex+1;
      }
      advanceBody = advanceBody+"}; }";
      countBody = countBody+"if (state."+flag+") { total = total+1; }";
      resetBody = resetBody+resetSeparator+flag+": false"; resetSeparator = ", ";
      reachedIndex = reachedIndex+1;
    }
    let reachedBody: string = "export function isReached(state: AppState, index: number): boolean {";
    reachedIndex = 0;
    while (reachedIndex < labels2.length) { reachedBody = reachedBody+"if (index === "+String(reachedIndex)+") { return state.reached_"+String(reachedIndex)+"; }"; reachedIndex = reachedIndex+1; }
    helpers = helpers+advanceBody+"return state; }";
    helpers = helpers+resetBody+"}; }";
    helpers = helpers+countBody+"return total; }";
    helpers = helpers+reachedBody+"return false; }";
    // Cumulative minutes accumulate in the supplied stop order from the reader start. A missing start
    // leaves every time unavailable and an absent deadline compares nothing; an unsafe sum is shown
    // as unavailable instead of wrapping.
    helpers = helpers+"export function scheduleText(state: AppState): string { let start: number = state.start as number; let deadline: number = state.deadline as number; let total: number = 0; let result: string = \"\"; let index: number = 0; while (index < state.stop_minutes.length) { let next: number = total+state.stop_minutes[index]; if (!(next >= total)) { return \"Schedule unavailable: total overflow\"; } total = next; if (result !== \"\") { result = result+\"\\n\"; } result = result+state.stop_labels[index]; if (isReached(state,index)) { result = result+\" (reached)\"; } if (start >= 0) { let at: number = start+total; if (!(at >= start)) { return \"Schedule unavailable: total overflow\"; } result = result+\" at \"+String(at); } index = index+1; } if (result === \"\") { return \"No stops\"; } if (start < 0) { return result+\"\\nTimes unavailable without a start\"; } if (deadline >= 0 && start+total > deadline) { return result+\"\\nAfter the deadline\"; } return result; }";
    body = body+"When(state.schedule_ready) {ui.Text(text: state.schedule_display)} When(!state.schedule_ready) {ui.Text(text: state.schedule_reason, style: \"muted\")}";
    body = body+"When(state.done_ready) {ui.NumberText(value: state.done_display)} ui.Button(text: \"Advance\", onClick: action app.Advance {value: payload}) ui.Button(text: \"Reset trip\", onClick: action app.ResetItinerary {value: payload})";
    if (navigating) { body = body+"ForEach(state.stop_rows, row: app.f_"+id+"_ItineraryStop, key: row.key) { ui.Button(text: \"Navigate\", accessibilityLabel: row.label, value: state.navigate_sequence, onClick: action app.Navigate {sequence: payload, id: row.key}) } When(state.navigate_pending) {ui.Text(text: \"Opening directions\", style: \"muted\")} When(!state.navigate_pending && state.navigate_outcome === \"failure\") {ui.Text(text: state.navigate_message, style: \"muted\")}"; }
    if (scheduling) { body = body+"ui.Button(text: \"Schedule trip\", value: state.trip_sequence, onClick: action app.ScheduleTrip {sequence: payload, id: \"\"}) When(state.trip_pending) {ui.Text(text: \"Scheduling the trip\", style: \"muted\")} When(!state.trip_pending && state.trip_outcome === \"failure\") {ui.Text(text: state.trip_message, style: \"muted\")}"; }
  } else if (kind === "progress_line") {
    ports[ports.length] = requiredReader("done","number"); ports[ports.length] = requiredReader("total","number");
    fields[fields.length] = derivedField(id,"line","string"); fields[fields.length] = derivedField(id,"percent","number");
    helpers = helpers+"export function lineText(state: AppState): string { let total: number = state.total as number; let done: number = state.done as number; if (!(total > 0)) { return \"Unavailable\"; } return String(done)+\" of \"+String(total); }";
    helpers = helpers+"export function percentOf(state: AppState): number { let total: number = state.total as number; let done: number = state.done as number; return done*100/total; }";
    body = body+"When(state.line_ready) {ui.Progress(label: \"Completion\", value: state.percent_display, maximum: 100) ui.Text(text: state.line_display)} When(!state.line_ready) {ui.Text(text: state.line_reason, style: \"muted\")}";
  } else if (kind === "quick_log") {
    let amount: number = s.finite(parameters.amount); let goal: number = s.finite(parameters.goal); let unit: string = s.text(parameters.unit);
    let extras: number[] = []; for (let extra of parameters.extraAmounts as number[]) { extras[extras.length] = s.finite(extra); }
    fields[fields.length] = authoredField(id,"amounts","number[]","[]");
    fields[fields.length] = authoredField(id,"stamps","number[]","[]");
    fields[fields.length] = authoredField(id,"log_days","number[]","[]");
    fields[fields.length] = dayField(id);
    fields[fields.length] = derivedField(id,"goal_value","number");
    fields[fields.length] = derivedField(id,"today_total","number");
    fields[fields.length] = derivedField(id,"today_count","number");
    ports[ports.length] = {name:"goal",type:"number",direction:"publish",getter:"goal_value",optional:false};
    ports[ports.length] = publishPort("today_total","number"); ports[ports.length] = publishPort("today_count","number");
    // The extra-amount action exists only when a declared extra binds it, so no unreachable update
    // action is issued for a quick log without extra amounts.
    declarations = declarations+"export class Log { value: number; } export class UndoLog { value: number; }";
    if (extras.length > 0) { declarations = declarations+" export class LogExtra { amount: number; rank: number; }"; }
    updates[updates.length] = handler("Log","logTap"); if (extras.length > 0) { updates[updates.length] = handler("LogExtra","logExtra"); } updates[updates.length] = handler("UndoLog","undoLog");
    // A tap captures its own instant and the local day it was made on, once, so the daily projection
    // reads the recorded day of each tap and never derives one from an instant at recomputation time.
    helpers = helpers+"export function appendTap(state: AppState, value: number, now: number, day: number): AppState { if (!(now >= 0) || !(value > 0) || Math.floor(day) !== day) { return state; } let amounts: number[] = []; for (let amount of state.amounts) { amounts[amounts.length] = amount; } let stamps: number[] = []; for (let stamp of state.stamps) { stamps[stamps.length] = stamp; } let days: number[] = []; for (let logged of state.log_days) { days[days.length] = logged; } amounts[amounts.length] = value; stamps[stamps.length] = now; days[days.length] = day; return {amounts: amounts, stamps: stamps, log_days: days, today: day}; }";
    helpers = helpers+"export function logTap(state: AppState, action: Log): AppState { return appendTap(state, "+String(amount)+", embeddingClock.nowMillis(), embeddingDay.localDay()); }";
    if (extras.length > 0) { helpers = helpers+"export function logExtra(state: AppState, action: LogExtra): AppState { return appendTap(state, action.amount, embeddingClock.nowMillis(), embeddingDay.localDay()); }"; }
    helpers = helpers+"export function undoLog(state: AppState, action: UndoLog): AppState { let size: number = state.amounts.length; if (size === 0) { return state; } return {amounts: state.amounts.slice(0,size-1), stamps: state.stamps.slice(0,size-1), log_days: state.log_days.slice(0,size-1), today: embeddingDay.localDay()}; }";
    // Today's total sums the amounts recorded on the captured local day and today's count counts the
    // same taps; an out-of-range sum is reported as an unavailable projection instead of wrapping.
    helpers = helpers+"export function todayTotal(state: AppState): number { let total: number = 0; let index: number = 0; while (index < state.amounts.length) { if (state.log_days[index] === state.today) { total = total+state.amounts[index]; if (!(total >= 0) || total > 9007199254740991) { return -1; } } index = index+1; } return total; }";
    helpers = helpers+"export function todayCount(state: AppState): number { let result: number = 0; let index: number = 0; while (index < state.log_days.length) { if (state.log_days[index] === state.today) { result = result+1; } index = index+1; } return result; }";
    body = body+"ui.Text(text: "+await literal("Log "+String(amount)+" "+unit,"string")+")";
    body = body+"ui.Button(text: \"Log\", onClick: action app.Log {value: payload}) ui.Button(text: \"Undo log\", onClick: action app.UndoLog {value: payload})";
    // The configured goal and the two daily projections are published like any other ready projection;
    // an unready projection renders its located reason instead of a placeholder daily value.
    body = body+"When(state.today_total_ready) {ui.NumberStat(label: \"Today\", value: state.today_total_display, suffix: "+await literal(unit,"string")+")} When(!state.today_total_ready) {ui.Text(text: state.today_total_reason, style: \"muted\")}";
    body = body+"When(state.today_count_ready) {ui.NumberText(value: state.today_count_display)} When(state.goal_value_ready) {ui.NumberText(value: state.goal_value_display)}";
    for (let extra of extras) { body = body+"ui.Button(text: "+await literal("Log +"+String(extra),"string")+", onClick: action app.LogExtra {amount: "+String(extra)+", rank: payload})"; }
  } else if (kind === "reading_status") {
    let bands: Record<string, unknown>[] = s.records(parameters,"bands");
    let uppers: (number | null)[] = []; let bandNames: string[] = []; let levels: number[] = [];
    for (let band of bands) {
      uppers[uppers.length] = band.upper === null ? null : s.finite(band.upper);
      bandNames[bandNames.length] = s.text(band.label); levels[levels.length] = s.integral(band.level);
    }
    let decimals: number = s.integral(parameters.decimals);
    fields[fields.length] = authoredField(id,"band_uppers","(number | null)[]",await literal(uppers,"(number | null)[]"));
    fields[fields.length] = authoredField(id,"band_labels","string[]",await literal(bandNames,"string[]"));
    fields[fields.length] = authoredField(id,"band_levels","number[]",numberArray(levels));
    fields[fields.length] = authoredField(id,"readings","number[]","[]");
    fields[fields.length] = authoredField(id,"stamps","number[]","[]");
    fields[fields.length] = authoredField(id,"draft","number","0");
    fields[fields.length] = derivedField(id,"latest","number"); fields[fields.length] = derivedField(id,"status_level","number"); fields[fields.length] = derivedField(id,"status","string"); fields[fields.length] = derivedField(id,"history","string");
    fields[fields.length] = derivedField(id,"count","number");
    // The history chart is a declared own behavior of this kind: its scale is derived from the actual
    // readings, and a single distinct value still yields a nonempty range because the pack admits a
    // chart only when maximum is strictly greater than minimum.
    fields[fields.length] = derivedField(id,"chart_min","number"); fields[fields.length] = derivedField(id,"chart_max","number");
    ports[ports.length] = publishPort("count","number"); ports[ports.length] = publishPort("latest","number"); ports[ports.length] = publishPort("status_level","number");
    declarations = declarations+"export class DraftReading { value: number; } export class Read { value: number; } export class RemoveReading { value: number; }";
    updates[updates.length] = handler("DraftReading","draftReading"); updates[updates.length] = handler("Read","read"); updates[updates.length] = handler("RemoveReading","removeReading");
    // The reading domain is the safe finite number range the row declares: the sign is not restricted,
    // because a measured value and its band bounds may be negative. The draft is the control value and
    // is committed only when the explicit add runs.
    helpers = helpers+"export function draftReading(state: AppState, action: DraftReading): AppState { if (!(action.value > -9007199254740992) || !(action.value < 9007199254740992)) { return state; } return {draft: action.value}; }";
    helpers = helpers+"export function read(state: AppState, action: Read): AppState { if (!(state.draft > -9007199254740992) || !(state.draft < 9007199254740992)) { return state; } let values: number[] = []; for (let value of state.readings) { values[values.length] = value; } let stamps: number[] = []; for (let stamp of state.stamps) { stamps[stamps.length] = stamp; } values[values.length] = state.draft; stamps[stamps.length] = embeddingClock.nowMillis(); return {readings: values, stamps: stamps}; }";
    helpers = helpers+"export function removeReading(state: AppState, action: RemoveReading): AppState { let size: number = state.readings.length; if (size === 0) { return state; } return {readings: state.readings.slice(0,size-1), stamps: state.stamps.slice(0,size-1)}; }";
    helpers = helpers+"export function latestOf(state: AppState): number { if (state.readings.length === 0) { return -1; } return state.readings[state.readings.length-1]; }";
    // The first exclusive upper match decides the level; the final declared band is unbounded.
    helpers = helpers+"export function levelOf(state: AppState, value: number): number { let index: number = 0; while (index < state.band_uppers.length) { let upper: number | null = state.band_uppers[index]; if (upper === null) { return state.band_levels[index]; } if (value < upper) { return state.band_levels[index]; } index = index+1; } if (state.band_levels.length === 0) { return 0; } return state.band_levels[state.band_levels.length-1]; }";
    helpers = helpers+"export function historyOf(state: AppState): string { if (state.readings.length === 0) { return \"No readings\"; } let result: string = \"\"; let index: number = 0; while (index < state.readings.length) { if (result !== \"\") { result = result+\"\\n\"; } result = result+String(state.readings[index]); index = index+1; } return result; }";
    helpers = helpers+"export function statusOf(state: AppState, value: number): string { let index: number = 0; while (index < state.band_uppers.length) { let upper: number | null = state.band_uppers[index]; if (upper === null) { return state.band_labels[index]; } if (value < upper) { return state.band_labels[index]; } index = index+1; } if (state.band_labels.length === 0) { return \"\"; } return state.band_labels[state.band_labels.length-1]; }";
    helpers = helpers+"export function chartLow(state: AppState): number { let result: number = 0; let index: number = 0; while (index < state.readings.length) { if (index === 0) { result = state.readings[index]; } else if (state.readings[index] < result) { result = state.readings[index]; } index = index+1; } return result; }";
    helpers = helpers+"export function chartHigh(state: AppState): number { let low: number = chartLow(state); let result: number = low; let index: number = 0; while (index < state.readings.length) { if (state.readings[index] > result) { result = state.readings[index]; } index = index+1; } if (!(result > low)) { return low+1; } return result; }";
    body = body+"ui.NumberField(label: \"Reading\", value: state.draft, minimum: -1000000, maximum: 1000000, onChange: action app.DraftReading {value: payload}) ui.Button(text: \"Add reading\", onClick: action app.Read {value: payload}) ui.Button(text: \"Remove reading\", onClick: action app.RemoveReading {value: payload})";
    body = body+"When(state.latest_ready) {ui.NumberStat(label: "+await literal(s.text(parameters.unit),"string")+", value: state.latest_display, decimals: "+String(decimals)+")}";
    body = body+"When(!state.latest_ready) {ui.Text(text: state.latest_reason, style: \"muted\")} When(state.status_ready) {ui.Text(text: state.status_display)}";
    body = body+"When(state.status_level_ready) {ui.NumberText(value: state.status_level_display)} When(state.count_ready) {ui.NumberText(value: state.count_display)} When(state.history_ready) {ui.Text(text: state.history_display)} When(!state.history_ready) {ui.Text(text: state.history_reason, style: \"muted\")}";
    body = body+"When(state.chart_min_ready && state.chart_max_ready) {ui.Sparkline(series: state.readings, minimum: state.chart_min_display, maximum: state.chart_max_display)} When(!state.chart_min_ready) {ui.Text(text: \"No readings to chart\", style: \"muted\")}";
  } else if (kind === "points_ledger") {
    let people: string[] = s.stringArray(parameters.people);
    let tasks: Record<string, unknown>[] = s.records(parameters,"tasks"); let rewards: Record<string, unknown>[] = s.records(parameters,"rewards");
    // Configured tasks and rewards seed one mutable nominal row each, so the ledger can add a task or a
    // reward after the fact: the rows are the records the award and redeem actions resolve, never a copy
    // of the configuration beside them.
    let taskRows: string = "["; let taskSeparator: string = "";
    for (let row of tasks) { taskRows = taskRows+taskSeparator+"{id: "+s.encode(s.identifier(row.id))+", label: "+s.encode(s.text(row.label))+", points: "+s.encode(s.finite(row.points))+"}"; taskSeparator = ", "; }
    taskRows = taskRows+"]";
    let rewardRows: string = "["; let rewardSeparator: string = "";
    for (let row of rewards) { rewardRows = rewardRows+rewardSeparator+"{id: "+s.encode(s.identifier(row.id))+", label: "+s.encode(s.text(row.label))+", points: "+s.encode(s.finite(row.points))+"}"; rewardSeparator = ", "; }
    rewardRows = rewardRows+"]";
    fields[fields.length] = authoredField(id,"people","string[]",await literal(people,"string[]"));
    fields[fields.length] = authoredField(id,"tasks","PointRow[]",taskRows);
    fields[fields.length] = authoredField(id,"rewards","PointRow[]",rewardRows);
    fields[fields.length] = authoredField(id,"task_label_draft","string","\"\"");
    fields[fields.length] = authoredField(id,"task_points_draft","number","0");
    fields[fields.length] = authoredField(id,"reward_label_draft","string","\"\"");
    fields[fields.length] = authoredField(id,"reward_points_draft","number","0");
    fields[fields.length] = authoredField(id,"task_sequence","number",String(tasks.length+1));
    fields[fields.length] = authoredField(id,"reward_sequence","number",String(rewards.length+1));
    fields[fields.length] = authoredField(id,"selected","number","0");
    fields[fields.length] = authoredField(id,"history_people","string[]","[]");
    fields[fields.length] = authoredField(id,"history_points","number[]","[]");
    let zeroTotals: number[] = []; let zeroIndex: number = 0; while (zeroIndex < people.length) { zeroTotals[zeroTotals.length] = 0; zeroIndex = zeroIndex+1; }
    fields[fields.length] = authoredField(id,"labels","string[]",await literal(people,"string[]")); fields[fields.length] = authoredField(id,"totals","number[]",numberArray(zeroTotals));
    fields[fields.length] = authoredField(id,"total","number","0"); fields[fields.length] = authoredField(id,"count","number","0");
    ports[ports.length] = publishPort("labels","string[]"); ports[ports.length] = publishPort("totals","number[]");
    ports[ports.length] = publishPort("total","number"); ports[ports.length] = publishPort("count","number");
    declarations = declarations+"export class PointRow { id: string; label: string; points: number; } export class SelectPerson { index: number; } export class Award { id: string; value: number; } export class Redeem { id: string; value: number; } export class UndoPoints { value: number; } export class DraftTaskLabel { value: string; } export class DraftTaskPoints { value: number; } export class DraftRewardLabel { value: string; } export class DraftRewardPoints { value: number; } export class AddTask { value: number; } export class AddReward { value: number; }";
    updates[updates.length] = handler("SelectPerson","selectPerson"); updates[updates.length] = handler("Award","award");
    updates[updates.length] = handler("Redeem","redeem"); updates[updates.length] = handler("UndoPoints","undoPoints");
    updates[updates.length] = handler("DraftTaskLabel","draftTaskLabel"); updates[updates.length] = handler("DraftTaskPoints","draftTaskPoints");
    updates[updates.length] = handler("DraftRewardLabel","draftRewardLabel"); updates[updates.length] = handler("DraftRewardPoints","draftRewardPoints");
    updates[updates.length] = handler("AddTask","addTask"); updates[updates.length] = handler("AddReward","addReward");
    helpers = helpers+keyHelpers("task","tasks")+keyHelpers("reward","rewards");
    helpers = helpers+"export function selectPerson(state: AppState, action: SelectPerson): AppState { if (action.index < 0 || action.index >= state.people.length) { return state; } return {selected: action.index}; }";
    helpers = helpers+"export function balanceOf(state: AppState, person: string): number { let total: number = 0; let index: number = 0; while (index < state.history_people.length) { if (state.history_people[index] === person) { total = total+state.history_points[index]; } index = index+1; } return total; }";
    // One signed-history post also recomputes the per-person balances and the totals from the actual
    // records, so a redeemed balance can never be recomputed from a stale copy.
    helpers = helpers+"export function post(state: AppState, person: string, points: number): AppState { let names: string[] = []; for (let name of state.history_people) { names[names.length] = name; } let values: number[] = []; for (let value of state.history_points) { values[values.length] = value; } names[names.length] = person; values[values.length] = points; let totals: number[] = []; let total: number = 0; for (let name of state.people) { let sum: number = 0; let index: number = 0; while (index < names.length) { if (names[index] === name) { sum = sum+values[index]; } index = index+1; } totals[totals.length] = sum; total = total+sum; } return {history_people: names, history_points: values, totals: totals, total: total, count: names.length}; }";
    // A task row is resolved by issued identity: the tapped control carries the row, so a row added after
    // the fact awards exactly its own configured points.
    helpers = helpers+"export function taskPoints(state: AppState, id: string): number { for (let row of state.tasks) { if (row.id === id) { return row.points; } } return -1; }";
    helpers = helpers+"export function rewardPoints(state: AppState, id: string): number { for (let row of state.rewards) { if (row.id === id) { return row.points; } } return -1; }";
    helpers = helpers+"export function award(state: AppState, action: Award): AppState { let points: number = taskPoints(state, action.id); if (!(points > 0)) { return state; } if (state.selected < 0 || state.selected >= state.people.length) { return state; } return post(state, state.people[state.selected], points); }";
    // Insufficient balance blocks spending: nothing is posted and no history is rewritten.
    helpers = helpers+"export function redeem(state: AppState, action: Redeem): AppState { let points: number = rewardPoints(state, action.id); if (!(points > 0)) { return state; } if (state.selected < 0 || state.selected >= state.people.length) { return state; } let person: string = state.people[state.selected]; if (balanceOf(state, person) < points) { return state; } return post(state, person, -points); }";
    helpers = helpers+"export function undoPoints(state: AppState, action: UndoPoints): AppState { if (state.selected < 0 || state.selected >= state.people.length) { return state; } let person: string = state.people[state.selected]; let found: number = -1; let index: number = 0; while (index < state.history_people.length) { if (state.history_people[index] === person) { found = index; } index = index+1; } if (found < 0) { return state; } let names: string[] = []; let values: number[] = []; index = 0; while (index < state.history_people.length) { if (index !== found) { names[names.length] = state.history_people[index]; values[values.length] = state.history_points[index]; } index = index+1; } let totals: number[] = []; let total: number = 0; for (let name of state.people) { let sum: number = 0; let cursor: number = 0; while (cursor < names.length) { if (names[cursor] === name) { sum = sum+values[cursor]; } cursor = cursor+1; } totals[totals.length] = sum; total = total+sum; } return {history_people: names, history_points: values, totals: totals, total: total, count: names.length}; }";
    // A drafted task or reward is a local personal record: its label is nonblank and bounded and its
    // points are a positive integral amount, exactly the domain the configured rows already hold.
    helpers = helpers+"export function draftTaskLabel(state: AppState, action: DraftTaskLabel): AppState { return {task_label_draft: action.value}; }";
    helpers = helpers+"export function draftTaskPoints(state: AppState, action: DraftTaskPoints): AppState { if (!(action.value > 0) || Math.floor(action.value) !== action.value) { return state; } return {task_points_draft: action.value}; }";
    helpers = helpers+"export function draftRewardLabel(state: AppState, action: DraftRewardLabel): AppState { return {reward_label_draft: action.value}; }";
    helpers = helpers+"export function draftRewardPoints(state: AppState, action: DraftRewardPoints): AppState { if (!(action.value > 0) || Math.floor(action.value) !== action.value) { return state; } return {reward_points_draft: action.value}; }";
    helpers = helpers+"export function addTask(state: AppState, action: AddTask): AppState { if (state.task_label_draft.trim() === \"\" || state.task_label_draft.length > 32 || state.task_sequence >= 9007199254740991) { return state; } if (!(state.task_points_draft > 0) || Math.floor(state.task_points_draft) !== state.task_points_draft) { return state; } let rows: PointRow[] = []; for (let row of state.tasks) { rows[rows.length] = {id: row.id, label: row.label, points: row.points}; } rows[rows.length] = {id: free_task(state, state.task_sequence), label: state.task_label_draft, points: state.task_points_draft}; return {tasks: rows, task_label_draft: \"\", task_sequence: state.task_sequence+1}; }";
    helpers = helpers+"export function addReward(state: AppState, action: AddReward): AppState { if (state.reward_label_draft.trim() === \"\" || state.reward_label_draft.length > 32 || state.reward_sequence >= 9007199254740991) { return state; } if (!(state.reward_points_draft > 0) || Math.floor(state.reward_points_draft) !== state.reward_points_draft) { return state; } let rows: PointRow[] = []; for (let row of state.rewards) { rows[rows.length] = {id: row.id, label: row.label, points: row.points}; } rows[rows.length] = {id: free_reward(state, state.reward_sequence), label: state.reward_label_draft, points: state.reward_points_draft}; return {rewards: rows, reward_label_draft: \"\", reward_sequence: state.reward_sequence+1}; }";
    body = body+"ui.Select(labels: state.people, selected: state.selected, onChange: action app.SelectPerson {index: payload})";
    body = body+"ui.TextField(label: \"Task\", value: state.task_label_draft, onChange: action app.DraftTaskLabel {value: payload}) ui.NumberField(label: \"Task points\", value: state.task_points_draft, minimum: 1, maximum: 9007199254740991, onChange: action app.DraftTaskPoints {value: payload}) ui.Button(text: \"Add task\", onClick: action app.AddTask {value: payload})";
    body = body+"ui.TextField(label: \"Reward\", value: state.reward_label_draft, onChange: action app.DraftRewardLabel {value: payload}) ui.NumberField(label: \"Reward points\", value: state.reward_points_draft, minimum: 1, maximum: 9007199254740991, onChange: action app.DraftRewardPoints {value: payload}) ui.Button(text: \"Add reward\", onClick: action app.AddReward {value: payload})";
    body = body+"ForEach(state.tasks, row: app.f_"+id+"_PointRow, key: row.id) { ui.Button(text: row.label, accessibilityLabel: row.label, onClick: action app.Award {id: row.id, value: payload}) }";
    body = body+"ForEach(state.rewards, row: app.f_"+id+"_PointRow, key: row.id) { ui.Button(text: row.label, accessibilityLabel: row.label, onClick: action app.Redeem {id: row.id, value: payload}) }";
    body = body+"ui.Button(text: \"Undo\", onClick: action app.UndoPoints {value: payload})";
    body = body+"ui.NumberText(value: state.total) ui.NumberText(value: state.count)";
  } else if (kind === "idea_deck") {
    let ideas: Record<string, unknown>[] = s.records(parameters,"ideas");
    let titles: string[] = []; let levels2: string[] = []; let minutes2: number[] = []; let instructions: string[] = []; let ids2: string[] = [];
    for (let idea of ideas) { ids2[ids2.length] = s.text(idea.id); titles[titles.length] = s.text(idea.title); levels2[levels2.length] = s.text(idea.level); minutes2[minutes2.length] = s.integral(idea.minutes); instructions[instructions.length] = s.text(idea.instructions); }
    fields[fields.length] = authoredField(id,"idea_ids","string[]",await literal(ids2,"string[]"));
    fields[fields.length] = authoredField(id,"idea_titles","string[]",await literal(titles,"string[]"));
