    body = body+"ui.Ticker(id: \"live_"+id+"\", intervalMs: "+String(intervalMs)+", running: state.refresh_polling, onTick: action app.PollLive {now: payload})";
    body = body+"When(state.status_ready) {ui.Text(text: state.status_display)} When(state.live_source_ready) {ui.Text(text: state.live_source_display, style: \"muted\")} When(state.live_asof_ready) {ui.Text(text: state.live_asof_display, style: \"muted\")}";
  } else {
    s.reject("Unsupported catalogue kind: "+kind);
  }
  let view: string = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View {ui.Column(){"+body+"}}";
  let instance: screens.Instance = {id:id,kind:kind,origin:"catalogue",parameters:parameters,fragment:{declarations:declarations,fields:fields,updates:updates,effects:effects,helpers:helpers,view:view,options:[],content:[],ports:ports,holes:holes,covers:[entry.need],owns:[id]},bodies:{}};
