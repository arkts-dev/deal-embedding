    if (s.text(instance.parameters.scheduleBinding) !== "") { result[result.length] = computation(instance,"schedule_status","scheduleStatus(state)","state.schedule_pending || state.schedule_outcome === \"failure\"","\"Unavailable\"",["f_"+instance.id+"_schedule_pending","f_"+instance.id+"_schedule_outcome","f_"+instance.id+"_schedule_target","f_"+instance.id+"_schedule_message","f_"+instance.id+"_rows"]); }
    else { result[result.length] = computation(instance,"scheduled","0","true","\"Unavailable\"",[]); }
    result[result.length] = computation(instance,"summary","reminderSummary(state)","true","\"Unavailable\"",reminderSources);
  } else if (instance.kind === "dose_schedule") {
    let doseSources: string[] = ["f_"+instance.id+"_rows","f_"+instance.id+"_taken_keys","f_"+instance.id+"_today"];
    result[result.length] = computation(instance,"taken_today","takenToday(state)","true","\"Unavailable\"",doseSources);
    result[result.length] = computation(instance,"doses","state.rows.length","true","\"Unavailable\"",["f_"+instance.id+"_rows"]);
    result[result.length] = computation(instance,"streak","streakOf(state)","true","\"Unavailable\"",doseSources);
    result[result.length] = computation(instance,"history","doseHistory(state)","true","\"Unavailable\"",doseSources);
  } else if (instance.kind === "intent_panel") {
    // One status per descriptor: the panel renders the descriptor's own pending, classification and reply
    // text, so a reply about one descriptor never appears as another descriptor's result.
    let descriptors: string[] = s.stringArray(instance.parameters.actionIds);
    let index: number = 0;
    while (index < descriptors.length) {
      let key: string = s.identifier(descriptors[index]);
      let sources: string[] = [];
      for (let field of ["tap_pending_","tap_outcome_","tap_message_","tap_result_"]) { sources[sources.length] = "f_"+instance.id+"_"+field+key; }
      result[result.length] = computation(instance,"tap_status_"+key,"replyStatus(state.tap_pending_"+key+", state.tap_outcome_"+key+", state.tap_message_"+key+", state.tap_result_"+key+")","true","\"Unavailable\"",sources);
      index = index+1;
    }
  } else if (instance.kind === "live_figure") {
    // A figure is available only after a validated reply, and the observation time is the source's own
    // asof value: an absent, unresolved, empty or nonstring asof leaves that port unavailable, so no port
    // ever publishes a fetch time in place of the source's observation time.
    let readings: string[] = ["f_"+instance.id+"_refresh_values","f_"+instance.id+"_refresh_outcome"];
    let index: number = 0;
    // All three figure ports are issued: a panel with fewer figures leaves the remaining ports unavailable
    // instead of publishing a placeholder value for a figure that was never selected.
    while (index < 3) {
      let name: string = "live"+String(index+1);
      result[result.length] = computation(instance,name,"liveAt(state, "+String(index)+")","state.refresh_outcome === \"success\" && state.refresh_values.length > "+String(index),"\"Live figure unavailable\"",readings);
      index = index+1;
    }
    result[result.length] = computation(instance,"live_source","state.source_url","state.refresh_outcome === \"success\"","\"Live source unavailable\"",readings.concat(["f_"+instance.id+"_source_url"]));
    result[result.length] = computation(instance,"live_asof","state.refresh_asof","state.refresh_outcome === \"success\" && state.refresh_asof !== \"\"","\"Observation time unavailable\"",readings.concat(["f_"+instance.id+"_refresh_asof"]));
    result[result.length] = computation(instance,"status","liveStatus(state)","true","\"Unavailable\"",readings.concat(["f_"+instance.id+"_refresh_pending","f_"+instance.id+"_refresh_message"]));
  }
  return result;
}
export function main(): void { return; }
