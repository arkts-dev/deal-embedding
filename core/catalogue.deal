    initialRows = initialRows+"]";
    declarations = declarations+"export class ReminderRow { id: string; title: string; minute: number; daily: boolean; day: number; } export class DraftReminderTitle { value: string; } export class DraftReminderMinute { value: number; } export class DraftReminderDay { value: number; } export class DraftReminderDaily { value: boolean; } export class AddReminder { value: number; } export class RemoveReminder { value: number; id: string; } export class EditReminderTitle { value: string; id: string; } export class ToggleReminderDone { value: number; id: string; }";
    fields[fields.length] = authoredField(id,"rows","ReminderRow[]",initialRows);
    fields[fields.length] = authoredField(id,"done_keys","string[]","[]");
    fields[fields.length] = authoredField(id,"title_draft","string","\"\"");
    fields[fields.length] = authoredField(id,"minute_draft","number","0");
    fields[fields.length] = authoredField(id,"day_draft","number","0");
    fields[fields.length] = authoredField(id,"daily_draft","boolean","false");
    fields[fields.length] = authoredField(id,"sequence","number",String(rows.length+1));
