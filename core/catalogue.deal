      helpers = helpers+schedule.helpers;
      helpers = helpers+"export function hasScheduled(state: AppState, id: string): boolean { for (let key of state.scheduled_keys) { if (key === id) { return true; } } return false; }";
      helpers = helpers+"export function scheduledCount(state: AppState): number { let result: number = 0; for (let row of state.rows) { if (hasScheduled(state, row.id)) { result = result+1; } } return result; }";
      helpers = helpers+"export function scheduleKeys(state: AppState, id: string): string[] { let keys: string[] = []; let found: boolean = false; for (let key of state.scheduled_keys) { keys[keys.length] = key; if (key === id) { found = true; } } if (!found) { keys[keys.length] = id; } return keys; }";
      fields[fields.length] = derivedField(id,"schedule_status","string");
      helpers = helpers+"export function reminderTitle(state: AppState, id: string): string { for (let row of state.rows) { if (row.id === id) { return row.title; } } return \"\"; }";
      helpers = helpers+"export function scheduleStatus(state: AppState): string { if (state.schedule_pending) { return \"Scheduling \"+reminderTitle(state, state.schedule_target); } if (state.schedule_outcome === \"failure\") { return \"Scheduling \"+reminderTitle(state, state.schedule_target)+\" failed: \"+state.schedule_message; } return \"\"; }";
    }
    fields[fields.length] = derivedField(id,"done","number"); fields[fields.length] = derivedField(id,"total","number"); fields[fields.length] = derivedField(id,"scheduled","number"); fields[fields.length] = derivedField(id,"summary","string");
    ports[ports.length] = publishPort("done","number"); ports[ports.length] = publishPort("total","number"); ports[ports.length] = publishPort("scheduled","number");
    updates[updates.length] = handler("DraftReminderTitle","draftReminderTitle"); updates[updates.length] = handler("DraftReminderMinute","draftReminderMinute");
    updates[updates.length] = handler("DraftReminderDay","draftReminderDay"); updates[updates.length] = handler("DraftReminderDaily","draftReminderDaily");
    updates[updates.length] = handler("AddReminder","addReminder"); updates[updates.length] = handler("RemoveReminder","removeReminder");
    updates[updates.length] = handler("EditReminderTitle","editReminderTitle"); updates[updates.length] = handler("ToggleReminderDone","toggleReminderDone");
    helpers = helpers+"export function draftReminderTitle(state: AppState, action: DraftReminderTitle): AppState { return {title_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function draftReminderMinute(state: AppState, action: DraftReminderMinute): AppState { if (Math.floor(action.value) !== action.value || action.value < 0 || action.value > 1439) { return state; } return {minute_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function draftReminderDay(state: AppState, action: DraftReminderDay): AppState { if (Math.floor(action.value) !== action.value || Math.abs(action.value) > 9007199254740991) { return state; } return {day_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function draftReminderDaily(state: AppState, action: DraftReminderDaily): AppState { return {daily_draft: action.value, today: embeddingDay.localDay()}; }";
    // A one-shot reminder carries the day it is due on; a daily reminder omits it, so an addition keeps
    // the two shapes apart instead of inventing a day for a daily row.
    helpers = helpers+"export function addReminder(state: AppState, action: AddReminder): AppState { if (state.title_draft.trim() === \"\" || state.title_draft.length > 32 || state.sequence >= 9007199254740991) { return state; } if (!(state.minute_draft >= 0) || !(state.minute_draft <= 1439) || Math.floor(state.minute_draft) !== state.minute_draft) { return state; } if (!state.daily_draft && (Math.floor(state.day_draft) !== state.day_draft || Math.abs(state.day_draft) > 9007199254740991)) { return state; } let rows: ReminderRow[] = []; for (let row of state.rows) { rows[rows.length] = {id: row.id, title: row.title, minute: row.minute, daily: row.daily, day: row.day}; } let day: number = 0; if (!state.daily_draft) { day = state.day_draft; } rows[rows.length] = {id: free_rem(state, state.sequence), title: state.title_draft, minute: state.minute_draft, daily: state.daily_draft, day: day}; return {rows: rows, title_draft: \"\", sequence: state.sequence+1, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function removeReminder(state: AppState, action: RemoveReminder): AppState { let found: boolean = false; let rows: ReminderRow[] = []; for (let row of state.rows) { if (row.id === action.id) { found = true; } else { rows[rows.length] = {id: row.id, title: row.title, minute: row.minute, daily: row.daily, day: row.day}; } } if (!found) { return state; } return {rows: rows, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function editReminderTitle(state: AppState, action: EditReminderTitle): AppState { if (action.value.trim() === \"\" || action.value.length > 32) { return state; } let found: boolean = false; let rows: ReminderRow[] = []; for (let row of state.rows) { if (row.id === action.id) { found = true; rows[rows.length] = {id: row.id, title: action.value, minute: row.minute, daily: row.daily, day: row.day}; } else { rows[rows.length] = {id: row.id, title: row.title, minute: row.minute, daily: row.daily, day: row.day}; } } if (!found) { return state; } return {rows: rows, today: embeddingDay.localDay()}; }";
    // A one-shot completion key is the row; a daily completion key is the row and its local day, so a
    // retained one-shot mark survives the day while a daily mark belongs to the day it was made.
    helpers = helpers+keyHelpers("rem","rows");
    helpers = helpers+"export function reminderKey(row: ReminderRow, today: number): string { let key: string = row.id; if (row.daily) { key = key+\"/\"+String(today); } return key; }";
    helpers = helpers+"export function reminderDone(state: AppState, row: ReminderRow): boolean { let key: string = reminderKey(row, state.today); for (let done of state.done_keys) { if (done === key) { return true; } } return false; }";
    helpers = helpers+"export function toggleReminderDone(state: AppState, action: ToggleReminderDone): AppState { let daily: boolean = false; let found: boolean = false; for (let row of state.rows) { if (row.id === action.id) { found = true; daily = row.daily; } } if (!found) { return state; } let today: number = embeddingDay.localDay(); let key: string = action.id; if (daily) { key = key+\"/\"+String(today); } let matched: boolean = false; let keys: string[] = []; for (let done of state.done_keys) { if (done === key) { matched = true; } else { keys[keys.length] = done; } } if (!matched) { keys[keys.length] = key; } return {done_keys: keys, today: today}; }";
    helpers = helpers+"export function reminderDoneCount(state: AppState): number { let result: number = 0; for (let row of state.rows) { if (reminderDone(state, row)) { result = result+1; } } return result; }";
    helpers = helpers+"export function reminderSummary(state: AppState): string { let total: number = state.rows.length; if (total === 0) { return \"No reminders\"; } return String(reminderDoneCount(state))+\" of \"+String(total)+\" done\"; }";
    body = body+"ui.TextField(label: \"Reminder\", value: state.title_draft, onChange: action app.DraftReminderTitle {value: payload})";
    body = body+"ui.NumberField(label: \"Reminder minute\", value: state.minute_draft, minimum: 0, maximum: 1439, onChange: action app.DraftReminderMinute {value: payload})";
    body = body+"ui.Toggle(label: \"Daily\", checked: state.daily_draft, onChange: action app.DraftReminderDaily {value: payload})";
    body = body+"ui.NumberField(label: \"Reminder day\", value: state.day_draft, minimum: -9007199254740991, maximum: 9007199254740991, onChange: action app.DraftReminderDay {value: payload})";
    body = body+"ui.Button(text: \"Add reminder\", onClick: action app.AddReminder {value: payload})";
    body = body+"When(state.summary_ready) {ui.Text(text: state.summary_display)}";
    if (scheduled) { body = body+"When(state.schedule_status_ready) {ui.Text(text: state.schedule_status_display)}"; }
    body = body+"When(state.done_ready) {ui.NumberStat(label: \"Done\", value: state.done_display)} When(state.total_ready) {ui.NumberStat(label: \"Total\", value: state.total_display)} When(state.scheduled_ready) {ui.NumberStat(label: \"Scheduled\", value: state.scheduled_display)}";
    body = body+"ForEach(state.rows, row: app.f_"+id+"_ReminderRow, key: row.id) { ui.TextField(label: row.title, value: row.title, onChange: action app.EditReminderTitle {value: payload, id: row.id}) ui.Button(text: \"Done\", accessibilityLabel: row.title, onClick: action app.ToggleReminderDone {value: payload, id: row.id})"+(scheduled ? " ui.Button(text: \"Schedule\", accessibilityLabel: row.title, value: state.schedule_sequence, onClick: action app.ScheduleReminder {sequence: payload, id: row.id})" : "")+" ui.Button(text: \"Remove\", accessibilityLabel: row.title, onClick: action app.RemoveReminder {value: payload, id: row.id}) }";
  } else if (kind === "dose_schedule") {
    // A disclosed calendar operation reconciles the daily taken marks: the explicit take dispatches that
    // issued operation and the mark is recorded only after its success reply, so a refused or failed
    // reply records no dose. A section with no calendar operation keeps the local daily mark.
    let calendarName: string = s.text(parameters.calendarBinding);
    let reconciled: boolean = calendarName !== "";
    let rows: Record<string, unknown>[] = s.records(parameters,"rows");
    let initialRows: string = "["; let rowSeparator: string = "";
    for (let row of rows) { initialRows = initialRows+rowSeparator+"{id: "+s.encode(s.identifier(row.id))+", name: "+s.encode(s.text(row.name))+", minute: "+s.encode(s.integral(row.minute))+"}"; rowSeparator = ", "; }
    initialRows = initialRows+"]";
    declarations = declarations+"export class DoseRow { id: string; name: string; minute: number; } export class DraftDoseName { value: string; } export class DraftDoseMinute { value: number; } export class AddDose { value: number; } export class RemoveDose { value: number; id: string; } ";
    if (!reconciled) { declarations = declarations+"export class MarkDose { value: number; id: string; } "; }
    fields[fields.length] = authoredField(id,"rows","DoseRow[]",initialRows);
    fields[fields.length] = authoredField(id,"taken_keys","string[]","[]");
    fields[fields.length] = authoredField(id,"name_draft","string","\"\"");
    fields[fields.length] = authoredField(id,"minute_draft","number","0");
    fields[fields.length] = authoredField(id,"sequence","number",String(rows.length+1));
    fields[fields.length] = dayField(id);
    if (reconciled) {
      let take: Exchange = exchangeWith(id,"take","TakeDose","TookDose",issuedOperation(registry,calendarName,0),", taken_keys: takenKeys(state, state.take_target, takeDay), today: takeDay","let takeDay: number = embeddingDay.localDay();");
      declarations = declarations+take.declarations;
      for (let entry of take.fields) { fields[fields.length] = entry; }
      for (let entry of take.updates) { updates[updates.length] = entry; }
      for (let entry of take.effects) { effects[effects.length] = entry; }
      helpers = helpers+take.helpers;
    }
    fields[fields.length] = derivedField(id,"taken_today","number"); fields[fields.length] = derivedField(id,"doses","number"); fields[fields.length] = derivedField(id,"streak","number"); fields[fields.length] = derivedField(id,"history","string");
    ports[ports.length] = publishPort("taken_today","number"); ports[ports.length] = publishPort("doses","number"); ports[ports.length] = publishPort("streak","number");
    updates[updates.length] = handler("DraftDoseName","draftDoseName"); updates[updates.length] = handler("DraftDoseMinute","draftDoseMinute");
    updates[updates.length] = handler("AddDose","addDose"); updates[updates.length] = handler("RemoveDose","removeDose");
    if (!reconciled) { updates[updates.length] = handler("MarkDose","markDose"); }
    helpers = helpers+"export function draftDoseName(state: AppState, action: DraftDoseName): AppState { return {name_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function draftDoseMinute(state: AppState, action: DraftDoseMinute): AppState { if (Math.floor(action.value) !== action.value || action.value < 0 || action.value > 1439) { return state; } return {minute_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function addDose(state: AppState, action: AddDose): AppState { if (state.name_draft.trim() === \"\" || state.name_draft.length > 32 || state.sequence >= 9007199254740991) { return state; } if (!(state.minute_draft >= 0) || !(state.minute_draft <= 1439) || Math.floor(state.minute_draft) !== state.minute_draft) { return state; } let rows: DoseRow[] = []; for (let row of state.rows) { rows[rows.length] = {id: row.id, name: row.name, minute: row.minute}; } rows[rows.length] = {id: free_dose(state, state.sequence), name: state.name_draft, minute: state.minute_draft}; return {rows: rows, name_draft: \"\", sequence: state.sequence+1, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function removeDose(state: AppState, action: RemoveDose): AppState { let found: boolean = false; let rows: DoseRow[] = []; for (let row of state.rows) { if (row.id === action.id) { found = true; } else { rows[rows.length] = {id: row.id, name: row.name, minute: row.minute}; } } if (!found) { return state; } return {rows: rows, today: embeddingDay.localDay()}; }";
    helpers = helpers+keyHelpers("dose","rows");
    helpers = helpers+"export function doseKey(row: DoseRow, day: number): string { return row.id+\"/\"+String(day); }";
    helpers = helpers+"export function markedOn(state: AppState, row: DoseRow, day: number): boolean { let key: string = doseKey(row, day); for (let taken of state.taken_keys) { if (taken === key) { return true; } } return false; }";
    // A daily taken mark records the dose and the local day it was taken on; the history keeps every
    // earlier day, so a streak is counted from the recorded marks instead of a stored total.
    if (reconciled) {
      // The reconciled mark is the calendar reply: the same recorded key, written only on success.
      helpers = helpers+"export function takenKeys(state: AppState, id: string, day: number): string[] { let key: string = id+\"/\"+String(day); let keys: string[] = []; let matched: boolean = false; for (let taken of state.taken_keys) { keys[keys.length] = taken; if (taken === key) { matched = true; } } if (!matched) { keys[keys.length] = key; } return keys; }";
    } else {
      helpers = helpers+"export function markDose(state: AppState, action: MarkDose): AppState { let found: boolean = false; for (let row of state.rows) { if (row.id === action.id) { found = true; } } if (!found) { return state; } let today: number = embeddingDay.localDay(); let key: string = action.id+\"/\"+String(today); let matched: boolean = false; let keys: string[] = []; for (let taken of state.taken_keys) { keys[keys.length] = taken; if (taken === key) { matched = true; } } if (!matched) { keys[keys.length] = key; } return {taken_keys: keys, today: today}; }";
    }
    helpers = helpers+"export function takenToday(state: AppState): number { let result: number = 0; for (let row of state.rows) { if (markedOn(state, row, state.today)) { result = result+1; } } return result; }";
    helpers = helpers+"export function completedOn(state: AppState, day: number): boolean { if (state.rows.length === 0) { return false; } for (let row of state.rows) { if (!markedOn(state, row, day)) { return false; } } return true; }";
    // The streak counts consecutive fully completed nonempty days ending today when today is complete,
    // otherwise ending yesterday; an empty schedule is zero, and the walk is bounded by the recorded
    // history so it terminates without a clock.
    helpers = helpers+"export function streakOf(state: AppState): number { if (state.rows.length === 0) { return 0; } let day: number = state.today; if (!completedOn(state, day)) { day = day-1; if (!completedOn(state, day)) { return 0; } } let count: number = 0; let guard: number = 0; let limit: number = state.taken_keys.length+1; while (guard < limit && completedOn(state, day)) { count = count+1; day = day-1; guard = guard+1; } return count; }";
    helpers = helpers+"export function doseHistory(state: AppState): string { if (state.rows.length === 0) { return \"No doses scheduled\"; } let result: string = \"\"; for (let row of state.rows) { if (result !== \"\") { result = result+\"\\n\"; } result = result+row.name; if (markedOn(state, row, state.today)) { result = result+\" taken\"; } } return result; }";
    body = body+"ui.TextField(label: \"Dose\", value: state.name_draft, onChange: action app.DraftDoseName {value: payload})";
    body = body+"ui.NumberField(label: \"Dose minute\", value: state.minute_draft, minimum: 0, maximum: 1439, onChange: action app.DraftDoseMinute {value: payload})";
    body = body+"ui.Button(text: \"Add dose\", onClick: action app.AddDose {value: payload})";
    body = body+"When(state.taken_today_ready) {ui.NumberStat(label: \"Taken today\", value: state.taken_today_display)} When(state.doses_ready) {ui.NumberStat(label: \"Doses\", value: state.doses_display)} When(state.streak_ready) {ui.NumberStat(label: \"Streak\", value: state.streak_display)}";
    body = body+"When(state.history_ready) {ui.Text(text: state.history_display)}";
    body = body+"ForEach(state.rows, row: app.f_"+id+"_DoseRow, key: row.id) { ui.Text(text: row.name) "+(reconciled ? "ui.Button(text: \"Take\", accessibilityLabel: row.name, value: state.take_sequence, onClick: action app.TakeDose {sequence: payload, id: row.id})" : "ui.Button(text: \"Take\", accessibilityLabel: row.name, onClick: action app.MarkDose {value: payload, id: row.id})")+" ui.Button(text: \"Remove\", accessibilityLabel: row.name, onClick: action app.RemoveDose {value: payload, id: row.id}) }";
    if (reconciled) { body = body+"When(state.take_pending) {ui.Text(text: \"Recording the dose\", style: \"muted\")} When(!state.take_pending && state.take_outcome === \"failure\") {ui.Text(text: state.take_message, style: \"muted\")}"; }
  } else if (kind === "intent_panel") {
    // The panel renders the controller-issued descriptors by identity, in actionIds order: each label, the
    // seeded draft of the descriptor's own input and one tap that carries that identity through the provider
    // workflow the Bind stage froze. An id the composition never issued is an unresolved reference, so a
    // panel can never name an operation that was not issued.
    let actionIds: string[] = s.stringArray(parameters.actionIds);
    let named: bindings.Descriptor[] = [];
    for (let wanted of actionIds) {
      let resolved: boolean = false;
      for (let candidate of registry.actions) { if (candidate.id === wanted) { named[named.length] = candidate; resolved = true; } }
      if (!resolved) { s.reject("Unresolved catalogue registry reference: "+wanted); }
    }
    declarations = declarations+"export class TapDescriptor { id: string; sequence: number; } export class DescriptorReply { id: string; sequence: number; ok: boolean; outcome: string; code: string; message: string; text: string; }";
    // A reply is displayed as its own text literally, as validated JSON for any other JSON value and as
    // nothing for an undefined result; a failure is shown separately by the descriptor's own status.
    helpers = helpers+"export function replyText(value: unknown): string { if (typeof value === \"string\") { return value; } let encoded: string | undefined = JSON.stringify(value); if (encoded === undefined) { return \"\"; } return encoded; }";
    helpers = helpers+"export function replyStatus(pending: boolean, outcome: string, message: string, text: string): string { if (pending) { return \"Working\"; } if (outcome === \"failure\") { return message; } if (outcome === \"success\") { return text; } return \"\"; }";
    let imports: string = ""; let dispatch: string = ""; let calls: string = ""; let recorded: string = ""; let controls: string = "";
    let aliasesByModule: Record<string, unknown> = {}; let moduleCount: number = 0;
    let index: number = 0;
    while (index < named.length) {
      let descriptor: bindings.Descriptor = named[index];
      // A descriptor identity is the issued plan identifier, so the attempt state of one descriptor can
      // never be spelled as another descriptor's: labels, keys and fields all come from that identity.
      let key: string = s.identifier(descriptor.id);
      let issued: Issue = issuedOperation(registry,descriptor.binding,0);
      // One module alias per issued module, shared by the descriptors that reach it: two descriptors of the
      // same frozen contract import it once, while two contracts stay distinct imports.
      let alias: string = "";
      if (Object.hasOwn(aliasesByModule,issued.module)) { alias = s.text(aliasesByModule[issued.module]); }
      else { alias = "descriptor_module_"+String(moduleCount); moduleCount = moduleCount+1; aliasesByModule[issued.module] = alias; imports = imports+"import * as "+alias+" from "+s.encode(issued.module)+"; "; }
      // The issued argument sources, in frozen contract order: the descriptor's own draft is the
      // composition's field, so the panel edits exactly the value the call reads. An unready source blocks
      // the attempt with the same guard the exchange uses instead of dispatching its placeholder.
      let guard: string = ""; let call: string = ""; let separator: string = "";
      let source: number = 0;
      while (source < issued.sources.length) {
        if (issued.ready[source] !== "true" && issued.ready[source] !== "") { guard = guard+" || !(state."+issued.ready[source]+")"; }
        call = call+separator+"(state."+issued.sources[source]+" as "+issued.types[source]+")"; separator = ", ";
        source = source+1;
      }
      fields[fields.length] = authoredField(id,"tap_attempt_"+key,"number","0");
      // The pending marker is a live attempt like the exchange's: a restored panel starts idle, so the
      // descriptor's explicit tap retries instead of waiting for an effect that no longer exists.
      fields[fields.length] = {name:"tap_pending_"+key,type:"boolean",role:"runtime",dependencies:[],initial:"false",owner:id};
      fields[fields.length] = authoredField(id,"tap_outcome_"+key,"string","\"none\"");
      fields[fields.length] = authoredField(id,"tap_code_"+key,"string","\"\"");
      fields[fields.length] = authoredField(id,"tap_message_"+key,"string","\"\"");
      fields[fields.length] = authoredField(id,"tap_result_"+key,"string","\"\"");
      fields[fields.length] = derivedField(id,"tap_status_"+key,"string");
      // One explicit attempt per descriptor: a tap on a pending descriptor is ignored, a tap on another
      // descriptor is admitted, and the attempt identity the control carries decides which reply lands.
      dispatch = dispatch+"if (action.id === "+await literal(descriptor.id,"string")+") { if (action.sequence !== state.tap_attempt_"+key+" || state.tap_pending_"+key+" || state.tap_attempt_"+key+" >= 9007199254740991"+guard+") { return state; } return {tap_attempt_"+key+": state.tap_attempt_"+key+"+1, tap_pending_"+key+": true, tap_outcome_"+key+": \"none\", tap_code_"+key+": \"\", tap_message_"+key+": \"\", tap_result_"+key+": \"\"}; } ";
      calls = calls+"if (action.id === "+await literal(descriptor.id,"string")+") { if (!state.tap_pending_"+key+" || state.tap_attempt_"+key+" !== action.sequence+1) { return {id: action.id, sequence: -1, ok: false, outcome: \"none\", code: \"NOT_ADMITTED\", message: \"Not admitted\", text: \"\"}; } try { let value: unknown = await "+alias+"."+issued.function+"("+call+"); return {id: action.id, sequence: state.tap_attempt_"+key+", ok: true, outcome: \"success\", code: \"\", message: \"\", text: replyText(value)}; } catch (unknownError) { let error: Error = unknownError as Error; return {id: action.id, sequence: state.tap_attempt_"+key+", ok: false, outcome: \"failure\", code: error.name, message: error.message, text: \"\"}; } } ";
      recorded = recorded+"if (action.id === "+await literal(descriptor.id,"string")+") { if (!state.tap_pending_"+key+" || action.sequence !== state.tap_attempt_"+key+") { return state; } return {tap_pending_"+key+": false, tap_outcome_"+key+": action.outcome, tap_code_"+key+": action.code, tap_message_"+key+": action.message, tap_result_"+key+": action.text}; } ";
      controls = controls+"ui.Text(text: "+await literal(descriptor.label,"string")+")";
      if (Object.hasOwn(descriptor,"input")) { let draft: bindings.Draft = descriptor.input as bindings.Draft;
        // The descriptor's seeded draft is composition state: the panel edits it through the issued nominal
        // update of that draft, so the value the binding reads and the value the field shows are one field.
        controls = controls+"ui.TextField(label: "+await literal(draft.label,"string")+", value: state.draft_"+s.identifier(draft.sourceId)+", onChange: action app.Draft_"+s.identifier(draft.sourceId)+" {value: payload})"; }
      controls = controls+"ui.Button(text: "+await literal(descriptor.label,"string")+", value: state.tap_attempt_"+key+", onClick: action app.TapDescriptor {id: "+await literal(descriptor.id,"string")+", sequence: payload}) When(state.tap_status_"+key+"_ready) {ui.Text(text: state.tap_status_"+key+"_display)}";
      index = index+1;
    }
    declarations = declarations+imports;
    helpers = helpers+"export function tapDescriptor(state: AppState, action: TapDescriptor): AppState { "+dispatch+"return state; }";
    helpers = helpers+"export async function runDescriptor(state: AppState, action: TapDescriptor): Promise<DescriptorReply> { "+calls+"return {id: action.id, sequence: -1, ok: false, outcome: \"none\", code: \"NOT_ADMITTED\", message: \"Not admitted\", text: \"\"}; }";
    helpers = helpers+"export function completeDescriptor(state: AppState, action: DescriptorReply): AppState { "+recorded+"return state; }";
    updates[updates.length] = handler("TapDescriptor","tapDescriptor"); updates[updates.length] = handler("DescriptorReply","completeDescriptor");
    effects[effects.length] = {action:"TapDescriptor",function:"runDescriptor"};
    body = body+controls;
  } else if (kind === "live_figure") {
    // The figures are read through the host public-probe mechanism and never fabricated: the section starts
    // unavailable, one explicit Refresh (or the read-only poll a successful read enables) dispatches the
    // probe, and only a validated reply publishes values. The observation time is the source's own asof
    // value, never a fetch time, so an absent, unresolved, empty or nonstring asof keeps that port unavailable.
    let figures: Record<string, unknown>[] = s.records(parameters,"figures");
    let source: Record<string, unknown> = parameters.source as Record<string, unknown>;
