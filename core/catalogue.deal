      if (!numeric(s.finite(row.minute),data)) { return refusal(entry,"reminder "+String(index)+" minute"); }
      if (Object.hasOwn(row,"day") && !numeric(s.finite(row.day),data)) { return refusal(entry,"reminder "+String(index)+" day"); }
      index = index+1;
    }
  }
  if (entry.definition.kind === "points_ledger" && Object.hasOwn(entry.parameters,"people")) {
    let index: number = 0;
    for (let person of s.stringArray(entry.parameters.people)) { if (!supplied(person,data)) { return refusal(entry,"person "+String(index)); } index = index+1; }
  }
  if (entry.definition.kind === "dose_schedule") {
    let index: number = 0;
    for (let row of s.records(entry.parameters,"rows")) { if (!supplied(s.text(row.name),data)) { return refusal(entry,"dose "+String(index)+" name"); } if (!numeric(s.finite(row.minute),data)) { return refusal(entry,"dose "+String(index)+" minute"); } index = index+1; }
  }
  if (entry.definition.kind === "due_items") {
    let index: number = 0;
    for (let row of s.records(entry.parameters,"rows")) {
      if (!supplied(s.text(row.name),data)) { return refusal(entry,"item "+String(index)+" name"); }
      if (!numeric(s.finite(row.day),data)) { return refusal(entry,"item "+String(index)+" day"); }
