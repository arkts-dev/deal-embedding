    fields[fields.length] = authoredField(id,"refresh_message","string","\"\"");
    fields[fields.length] = authoredField(id,"refresh_values","number[]","[]");
    fields[fields.length] = authoredField(id,"refresh_asof","string","\"\"");
    fields[fields.length] = {name:"refresh_polling",type:"boolean",role:"runtime",dependencies:[],initial:"false",owner:id};
