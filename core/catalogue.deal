    declarations = declarations+"export class Advance { value: number; } export class ResetItinerary { value: number; }";
    updates[updates.length] = handler("Advance","advance"); updates[updates.length] = handler("ResetItinerary","resetItinerary");
    let advanceBody: string = "export function advance(state: AppState, action: Advance): AppState {";
    let resetBody: string = "export function resetItinerary(state: AppState, action: ResetItinerary): AppState { return {";
