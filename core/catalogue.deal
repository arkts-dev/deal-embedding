    helpers = helpers+"export async function runPoll(state: AppState, action: PollLive): Promise<RefreshedLive> { if (!state.refresh_pending || (state.poll_action as PollLive) !== action) { return {sequence: -1, ok: false, outcome: \"none\", code: \"NOT_ADMITTED\", message: \"Not admitted\", values: [], asof: \"\"}; } try { let paths: string[] = []; for (let path of state.figure_paths) { paths[paths.length] = path; } let read: ProbeRead = JSON.parse(await probe_"+id+".fetch(state.source_url, state.source_mode, paths, state.source_asof_path)); return {sequence: state.refresh_attempt, ok: true, outcome: \"success\", code: \"\", message: \"\", values: read.values, asof: read.asof}; } catch (unknownError) { let error: Error = unknownError as Error; return {sequence: state.refresh_attempt, ok: false, outcome: \"failure\", code: error.name, message: error.message, values: [], asof: \"\"}; } }";
    // A successful read records the values and keeps read-only polling enabled; a failure records its
    // classification, publishes nothing and pauses polling until an explicit Refresh.
    helpers = helpers+"export function completeLive(state: AppState, action: RefreshedLive): AppState { if (!state.refresh_pending || action.sequence !== state.refresh_attempt) { return state; } if (!action.ok) { return {refresh_pending: false, activation_action: null, refresh_code: action.code, refresh_outcome: action.outcome, refresh_message: action.message, refresh_values: [], refresh_asof: \"\", refresh_polling: false}; } return {refresh_pending: false, activation_action: null, refresh_code: action.code, refresh_outcome: action.outcome, refresh_message: action.message, refresh_values: action.values, refresh_asof: action.asof, refresh_polling: true}; }";
    helpers = helpers+"export function liveAt(state: AppState, index: number): number { return state.refresh_values[index]; }";
    helpers = helpers+"export function liveStatus(state: AppState): string { if (state.refresh_pending) { return \"Refreshing\"; } if (state.refresh_outcome === \"failure\") { return state.refresh_message; } if (state.refresh_outcome === \"success\") { return \"Updated\"; } return \"Unavailable\"; }";
    let figure: number = 0;
    while (figure < figures.length && figure < 3) {
      let name: string = "live"+String(figure+1);
      let unit: string = units[figure];
      body = body+"When(state."+name+"_ready) {ui.NumberStat(label: "+await literal(labels[figure],"string")+", value: state."+name+"_display, suffix: "+await literal(unit,"string")+")} When(!state."+name+"_ready) {ui.Text(text: "+await literal(labels[figure]+" unavailable","string")+", style: \"muted\")}";
      figure = figure+1;
    }
