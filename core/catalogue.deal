      let asofPath: string = ""; if (Object.hasOwn(source,"asofPath")) { asofPath = await text(source.asofPath,2048,false); pointer(asofPath,"asofPath"); }
      result[parameter.name] = {url:url,mode:modeValue(source.mode,"mode",["api","search"]),asofPath:asofPath};
