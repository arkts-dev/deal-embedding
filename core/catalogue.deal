      body = body+"When(state."+shown+"_ready && state."+shown+"_display) {ui.ListItem(title: "+await literal(s.text(row.label),"string")+", subtitle: "+await literal(s.text(row.detail),"string")+", onTap: action app.Pick {index: payload}, eventValue: "+String(rowIndex)+", accessibilityLabel: "+await literal(s.text(row.label),"string")+")}";
      rowIndex = rowIndex+1;
    }
    if (rows.length === 0) { body = body+"ui.Text(text: \"No disclosed rows\", style: \"muted\")"; }
  } else if (kind === "detail_view") {
    fields[fields.length] = derivedField(id,"detail","string");
    ports[ports.length] = requiredReader("items","unknown[]"); ports[ports.length] = requiredReader("selected","number");
    helpers = helpers+"export function detailOf(state: AppState): string { if (!(state.selected >= 0) || state.selected >= state.items.length) { return \"No row selected\"; } let item: Record<string, unknown> = state.items[state.selected] as Record<string, unknown>; let label: string = item.label as string; let detail: string = item.detail as string; if (detail === \"\") { return label; } return label+\": \"+detail; }";
    body = body+"When(state.detail_ready) {ui.Text(text: state.detail_display)} When(!state.detail_ready) {ui.Text(text: state.detail_reason, style: \"muted\")}";
  } else if (kind === "record_log") {
    let categories: string[] = s.stringArray(parameters.labels); let currency: string = s.text(parameters.currency);
    fields[fields.length] = authoredField(id,"categories","string[]",await literal(categories,"string[]"));
    fields[fields.length] = authoredField(id,"currency","string",await literal(currency,"string"));
    fields[fields.length] = authoredField(id,"category","number","0");
    fields[fields.length] = authoredField(id,"category_draft","string",await literal(categories[0],"string"));
    fields[fields.length] = authoredField(id,"amount_draft","string","\"\"");
    fields[fields.length] = authoredField(id,"note_draft","string","\"\"");
    fields[fields.length] = authoredField(id,"log_labels","string[]","[]");
    fields[fields.length] = authoredField(id,"log_cents","number[]","[]");
    fields[fields.length] = authoredField(id,"log_notes","string[]","[]");
    // The published aggregate arrays always have one entry per label, from the initial state onward;
    // a fresh log therefore publishes zero totals and balances rather than unequal-length arrays.
    let zeroTotals: number[] = []; let zeroIndex: number = 0; while (zeroIndex < categories.length) { zeroTotals[zeroTotals.length] = 0; zeroIndex = zeroIndex+1; }
