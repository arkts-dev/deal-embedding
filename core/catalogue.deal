    ports[ports.length] = publishPort("count","number"); ports[ports.length] = publishPort("soon_count","number"); ports[ports.length] = publishPort("expired_count","number"); ports[ports.length] = publishPort("soon_names","string");
    updates[updates.length] = handler("DraftDueName","draftDueName"); updates[updates.length] = handler("DraftDueDay","draftDueDay");
    updates[updates.length] = handler("AddDue","addDue"); updates[updates.length] = handler("RemoveDue","removeDue"); updates[updates.length] = handler("ChangeDueDay","changeDueDay");
    // Every action re-captures the adapter day, so a projection is scoped to the current local day
