    body = body+"ui.Button(text: \"Add item\", onClick: action app.AddDue {value: payload})";
    body = body+"When(state.summary_ready) {ui.Text(text: state.summary_display)}";
    body = body+"When(state.soon_count_ready) {ui.NumberStat(label: \"Soon\", value: state.soon_count_display)} When(state.expired_count_ready) {ui.NumberStat(label: \"Expired\", value: state.expired_count_display)}";
    body = body+"ForEach(state.rows, row: app.f_"+id+"_DueRow, key: row.id) { ui.NumberField(label: row.name, value: row.day, minimum: -9007199254740991, maximum: 9007199254740991, onChange: action app.ChangeDueDay {value: payload, id: row.id}) ui.Button(text: \"Remove\", accessibilityLabel: row.name, onClick: action app.RemoveDue {value: payload, id: row.id}) }";
  } else if (kind === "reminders") {
