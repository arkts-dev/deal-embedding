// One kind table declares every specification kind once. Schemas, validators, initialization and
// eligibility facts are derived from it; `executable` records whether this build issues a runnable
// definition, and a kind with no implementation stays open for custom sections instead of being
// substituted by a compiling default. Only executable definitions are issued.
export class Parameter { name: string; type: string; required: boolean; fallback: unknown; maximum: number; origin: string; owner: string; }
// A kind's declared ports are eligibility facts: alignment offers a kind only when the composition can
// satisfy every declared reader. Each port keeps its nominal type, so a reader and a publisher meet
// only on the exact nominal identity assembly resolves (ownership-slots-operations-and-assembly
// "Connection and layout").
export class PortDecl { name: string; type: string; optional: boolean; }
export class HoleDecl { id: string; signature: string; purpose: string; body: string; writer: string; requires: string; }
export class Definition { kind: string; criteria: string; parameters: Parameter[]; mutable: boolean; publishes: PortDecl[]; reads: PortDecl[]; holes: HoleDecl[]; requirements: string[]; executable: boolean; }
// The one placeholder a configured instance carries until the fill decodes it, and the located reason
// an instance keeps when the fill never answered for it.
export function notFilled(): string { return "Catalogue parameters were not filled"; }
// A daily projection runs under the frozen host timezone and the checked adapter day
// (`docs/spec-v0.8.md:358,414`). A day-scoped kind captures that local epoch-day at initialization and
// again in every action, so its daily projection reads authoritative state and recomputation never
// reads a clock. The captured day is a runtime resource: a restored store re-derives it from the
// adapter instead of reusing the saved day, so a timezone change invalidates the projection instead of
// silently keeping the old day. A UTC epoch-day or a lifetime count is never substituted.
function dayField(id: string): screens.Field { return {name:"today",type:"number",role:"runtime",dependencies:[],initial:"embeddingDay.localDay()",owner:id}; }
export class Configured { need: string; definition: Definition; parameters: Record<string, unknown>; accepted: boolean; reason: string; }
// AC-02 ownership facts: every parameter carries where its value comes from (`origin`) and the owner
// stage that may supply it (`owner`). `owner` is derived from `origin` so the two can never drift.
function param(name: string, type: string, required: boolean, fallback: unknown, maximum: number, origin: string): Parameter {
  let owner: string = "fill";
  if (origin === "disclosed") { owner = "request"; } else if (origin === "live") { owner = "provider"; } else if (origin === "configuration") { owner = "host"; }
  return {name:name,type:type,required:required,fallback:fallback,maximum:maximum,origin:origin,owner:owner};
}
function publish(name: string, type: string): PortDecl { return {name:name,type:type,optional:false}; }
// A reader port is required unless the specification row names it optional (only the query, currency,
// itinerary start and deadline readers are). A required reader with no publisher leaves its need
// unfilled instead of substituting a fallback value the section would present as a real result.
function reads(name: string, type: string): PortDecl { return {name:name,type:type,optional:false}; }
function optionalRead(name: string, type: string): PortDecl { return {name:name,type:type,optional:true}; }
function hole(id: string, signature: string, purpose: string, body: string, writer: string, requires: string): HoleDecl { return {id:id,signature:signature,purpose:purpose,body:body,writer:writer,requires:requires}; }
function kind(kindName: string, criteria: string, mutable: boolean, parameters: Parameter[], publishes: PortDecl[], readPorts: PortDecl[], holes: HoleDecl[], requirements: string[], executable: boolean): Definition {
  return {kind:kindName,criteria:criteria,parameters:parameters,mutable:mutable,publishes:publishes,reads:readPorts,holes:holes,requirements:requirements,executable:executable};
}
function whenFinished(): HoleDecl { return hole("whenFinished","(state: AppState): AppState","Runs once when the selected timer reaches its preset.","return state;","fill","clock"); }
function rowMatches(): HoleDecl { return hole("rowMatches","(state: AppState, item: Entry): boolean","Unicode simple-case-insensitive query substring match against the label.","let label: string = item.label.toLowerCase(); let query: string = state.query.toLowerCase(); return label.includes(query);","fill",""); }
