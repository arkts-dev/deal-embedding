// A declaration without an origin, an unknown owner stage or a non-fill writer on a body-bearing
// hole rejects the table instead of issuing an unusable ownership fact.
export function validate(definition: Definition): void { checkDefinition(definition); }
function checkDefinition(definition: Definition): void {
  s.nonblank(definition.kind); let names: string[] = [];
  for (let parameter of definition.parameters) {
    s.unique(names,s.identifier(parameter.name)); s.nonblank(parameter.type);
    if (parameter.origin !== "disclosed" && parameter.origin !== "live" && parameter.origin !== "content" && parameter.origin !== "configuration") { s.reject("Catalogue parameter without an origin: "+definition.kind+" "+parameter.name); }
    if (parameter.owner !== "request" && parameter.owner !== "provider" && parameter.owner !== "fill" && parameter.owner !== "host") { s.reject("Catalogue parameter without an owner: "+definition.kind+" "+parameter.name); }
  }
  let ports: string[] = [];
  for (let port of definition.publishes) { s.unique(ports,s.identifier(port.name)); s.nonblank(port.type); if (port.optional) { s.reject("Publisher cannot be optional: "+definition.kind+" "+port.name); } }
  // A reader is required unless the specification row names it optional, so the table never
  // flattens a required publisher into a fallback the section would present as a real result.
  for (let port of definition.reads) { s.identifier(port.name); s.nonblank(port.type); }
  for (let requirement of definition.requirements) { s.identifier(requirement); }
  let holes: string[] = [];
  for (let declared of definition.holes) {
    s.unique(holes,s.identifier(declared.id)); s.nonblank(declared.signature); s.nonblank(declared.purpose);
    if (declared.writer !== "fill" && declared.writer !== "controller") { s.reject("Catalogue hole writer: "+definition.kind+" "+declared.id); }
    if (declared.body.length > 600) { s.reject("Catalogue hole body bound: "+definition.kind+" "+declared.id); } s.text(declared.requires);
  }
}
export function definitionOf(name: string): Definition { for (let entry of definitions()) { if (entry.kind === name) { return entry; } } s.reject("Unknown catalogue kind: "+name); throw {name:"CONSTRUCTION_SCHEMA",message:"Unknown catalogue kind"}; }
// Eligibility facts published for the generation consumer: the parameter requirements, ports and
// holes this build issues for a kind. Selection itself stays generation's decision.
export function eligibility(name: string): Definition { return definitionOf(name); }
export function offered(definition: Definition): boolean {
  if (!definition.executable) { return false; }
  // A required live parameter needs a frozen provider contract; without one the owner is unachievable
  // and the kind is never offered, so no default silently stands in for missing grounded data.
  for (let parameter of definition.parameters) { if (parameter.required && parameter.owner === "provider") { return false; } }
  return true;
}
// A reader kind can only be wired when the need requests a dependency another need publishes: a plan
// read that names an input or constant asks for a seed, never for a publisher's value, so issuing a
// reader kind for it would offer an instance assembly can never connect. Both call sites that issue
// catalogue alternatives — the two Select batches and alignment — share this one predicate.
export function carriesReaders(plan: plans.Plan, need: plans.Need): boolean {
  for (let other of plan.needs) { if (other.id !== need.id && s.contains(need.reads,other.id)) { return true; } }
  return false;
}
// A kind is a reader kind only when the specification row makes one of its readers required. A kind
// whose readers are all optional takes each assembly fallback and runs standalone, so it stays offered
// for a need that requests no publisher (`search_list`, `master_list`, `itinerary`).
export function requiresPublishers(definition: Definition): boolean {
  for (let port of definition.reads) { if (!port.optional) { return true; } }
  return false;
}
// The readers that must meet a publisher, as issued eligibility facts. Alignment joins only these, so an
// optional reader never blocks a candidate the composition can run with its declared fallback.
export function requiredReaders(definition: Definition): PortDecl[] {
  let result: PortDecl[] = [];
  for (let port of definition.reads) { if (!port.optional) { result[result.length] = port; } }
  return result;
}
export function alternatives(plan: plans.Plan): selecting.Alternative[] {
  let result: selecting.Alternative[] = [];
  for (let need of plan.needs) { if (need.type === "content" || need.type === "other") {
    let readers: boolean = carriesReaders(plan,need);
    for (let definition of definitions()) {
      if (!offered(definition)) { continue; }
      if (requiresPublishers(definition) && !readers) { continue; }
      result[result.length] = {id:"cat_"+need.id+"_"+definition.kind,need:need.id,origin:"catalogue",kind:definition.kind,criteria:definition.criteria+" "+facts(definition),eligible:true,reason:""};
    }
  } }
  return result;
}
// The published eligibility facts in one sentence: the parameters this kind needs and the ports and
// holes it issues. Generation reads these facts; it decides selection.
export function facts(definition: Definition): string {
  let parameters: string[] = [];
  for (let parameter of definition.parameters) { let required: string = "optional"; if (parameter.required) { required = "required"; }
    // The published default is the value the decoder actually applies: a required parameter has none, and a
    // collection whose fallback is null starts empty instead of carrying a null element list.
    let fallback: string = "no default";
    if (!parameter.required) { if (s.encode(parameter.fallback) === "null") { fallback = "default []"; } else { fallback = "default "+s.encode(parameter.fallback); } }
    parameters[parameters.length] = parameter.name+":"+parameter.type+" "+required+" origin "+parameter.origin+" "+fallback; }
  let publishes: string[] = []; for (let port of definition.publishes) { publishes[publishes.length] = port.name+":"+port.type; }
  let readPorts: string[] = []; for (let port of definition.reads) { let optionality: string = "optional"; if (!port.optional) { optionality = "required"; } readPorts[readPorts.length] = port.name+":"+port.type+" "+optionality; }
  let holes: string[] = []; for (let declared of definition.holes) { holes[holes.length] = declared.id+" ("+declared.writer+")"+(declared.requires === "" ? "" : " requires "+declared.requires); }
  // The capability requirements a kind states (clock, calendar, money, descriptor, probe) are
  // eligibility facts too: generation reads them instead of inferring them from the emitted source.
  let requirements: string[] = []; for (let requirement of definition.requirements) { requirements[requirements.length] = requirement; }
  return "Parameters ["+parameters.join("; ")+"]; publishes ["+publishes.join("; ")+"]; readers ["+readPorts.join("; ")+"]; holes ["+holes.join("; ")+"]; requires ["+requirements.join("; ")+"].";
}
// Decoded values carry real JSON kinds, so their wire spelling identifies the type: a text begins
// with a quote, an array with a bracket and a row with a brace. A wrong-typed field or collection of
// these kinds then rejects instead of being read as an empty value or re-spelled by a later emitter.
async function text(value: unknown, maximum: number, nonblank: boolean): Promise<string> {
  if (!s.encode(value).startsWith("\"")) { s.reject("Catalogue text required"); }
  let result: string = s.text(value); if (nonblank) { s.nonblank(result); } if (result.length > maximum) { s.reject("Catalogue text bound"); } return result;
}
function list(value: unknown, name: string): void { if (!s.encode(value).startsWith("[")) { s.reject("Catalogue array required: "+name); } }
function record(value: unknown, name: string): void { if (!s.encode(value).startsWith("{")) { s.reject("Catalogue row required: "+name); } }
// Number.isFinite is the only total numeric test for a dynamic value: it never coerces, so a text
// or boolean value rejects here instead of reaching a checked numeric cast.
function number(value: unknown, name: string): number { if (!Number.isFinite(value)) { s.reject("Catalogue number required: "+name); } return s.finite(value); }
function integer(value: unknown, name: string): number { let result: number = number(value,name); if (Math.floor(result) !== result) { s.reject("Catalogue integral required: "+name); } return result; }
// An empty text carries no content and needs no evidence; any supplied text must occur in it.
function supplied(value: string, data: string): boolean { return disclosure.admitsText(data,value); }
// An optional row field returns its dynamic value so the wire-kind guard of `text` runs before any
// typed cast; a typed accessor would raise the runtime type error instead of a schema rejection.
function optionalValue(owner: Record<string, unknown>, name: string): unknown { if (!Object.hasOwn(owner,name)) { return ""; } return owner[name]; }
// A row identity is a JSON string before it is a plan identifier; a wrong wire kind rejects like any
// other text field instead of raising the runtime type error.
function rowIdentity(value: unknown, name: string): string { if (!s.encode(value).startsWith("\"")) { s.reject("Catalogue text required: "+name); } return s.identifier(value); }
// A row boolean is admitted only as a JSON boolean, never through a cast of another wire kind.
function flag(owner: Record<string, unknown>, name: string, fallback: boolean): boolean {
  if (!Object.hasOwn(owner,name)) { return fallback; }
  let encoded: string = s.encode(owner[name]); if (encoded !== "true" && encoded !== "false") { s.reject("Catalogue boolean required: "+name); }
  return owner[name] as boolean;
}
// Timeline minutes are the shared minute-of-day domain; the rail keeps the supplied order and shows
// the minute as zero-padded 24-hour text, because the pack's rail item carries display text only.
function clock(minute: number): string { let hours: number = Math.floor(minute/60); let rest: number = minute-hours*60; let text: string = String(hours); if (hours < 10) { text = "0"+text; } let minutes: string = String(rest); if (rest < 10) { minutes = "0"+minutes; } return text+":"+minutes; }
// A positive duration is a real quantity of its stated unit: sign and finiteness are checked here
// and no unit conversion is implied by the value.
function positiveNumber(value: unknown, name: string): number { let result: number = number(value,name); if (result <= 0) { s.reject("Catalogue positive bound: "+name); } return result; }
function nonnegative(value: unknown, name: string): number { let result: number = number(value,name); if (result < 0) { s.reject("Catalogue nonnegative bound: "+name); } return result; }
// Shared temporal domains: minute-of-day is integral 0-1439 and a day is an integral local epoch-day.
function minuteOfDay(value: unknown, name: string): number { let result: number = integer(value,name); if (result < 0 || result > 1439) { s.reject("Catalogue minute domain: "+name); } return result; }
function dayOf(value: unknown, name: string): number { return integer(value,name); }
// A zero maximum states "no dataset bound", which is how personal-record arrays keep the rows the
// user supplied instead of being trimmed to a fixture-shaped size.
function within(entries: unknown[], minimum: number, maximum: number, name: string): void {
  if (entries.length < minimum) { s.reject("Catalogue array minimum: "+name); }
  if (maximum > 0 && entries.length > maximum) { s.reject("Catalogue array bound: "+name); }
}
function modeValue(value: unknown, name: string, allowed: string[]): string { if (!s.encode(value).startsWith("\"")) { s.reject("Catalogue text required: "+name); } return s.oneOf(value,allowed); }
function coordinate(latitude: unknown, longitude: unknown, name: string): void {
  let absentLatitude: boolean = s.encode(latitude) === "null"; let absentLongitude: boolean = s.encode(longitude) === "null";
  if (absentLatitude !== absentLongitude) { s.reject("Catalogue coordinates must both be null or present: "+name); }
  if (absentLatitude) { return; }
  let lat: number = number(latitude,"latitude"); let lon: number = number(longitude,"longitude");
  if (lat < -90 || lat > 90) { s.reject("Catalogue latitude domain: "+name); }
  if (lon < -180 || lon > 180) { s.reject("Catalogue longitude domain: "+name); }
}
// RFC 6901 JSON Pointer: empty is the whole document, otherwise every reference token begins with "/"
// and escapes "~" as "~0" and "/" as "~1". No percent escapes or array shorthand are admitted.
// A live source is credential-free HTTPS on a public host: userinfo, loopback, link-local and the
// private IPv4 ranges are refused before any probe can be issued.
function publicHttps(url: string): boolean {
  if (!url.startsWith("https://")) { return false; }
  let rest: string = url.substring(8); let end: number = rest.length; let slash: number = rest.indexOf("/"); if (slash >= 0) { end = slash; }
  let authority: string = rest.substring(0,end); if (authority === "" || authority.includes("@")) { return false; }
  let host: string = authority; let colon: number = authority.indexOf(":"); if (colon >= 0) { host = authority.substring(0,colon); }
  if (host === "" ) { return false; }
  let lowered: string = host.toLowerCase();
  if (lowered === "localhost" || lowered === "[::1]" || lowered === "::1") { return false; }
  if (lowered.startsWith("127.") || lowered.startsWith("10.") || lowered.startsWith("192.168.") || lowered.startsWith("169.254.")) { return false; }
  if (lowered.startsWith("172.")) { let second: string = lowered.substring(4,5); if (second === "1" || second === "2" || second === "3") { let value: number = Number(lowered.substring(4,6)); if (value >= 16 && value <= 31) { return false; } } }
  return true;
}
function pointer(value: string, name: string): void {
  if (value === "") { return; }
  if (!value.startsWith("/")) { s.reject("Catalogue live path is not a JSON Pointer: "+name); }
  for (let token of value.substring(1).split("/")) {
