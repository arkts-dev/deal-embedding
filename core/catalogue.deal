    body = body+"ui.Select(labels: state.categories, selected: state.category, onChange: action app.SelectCategory {index: payload})";
    body = body+"ui.TextField(label: \"Amount\", value: state.amount_draft, onChange: action app.DraftAmount {value: payload}) ui.TextField(label: \"Note\", value: state.note_draft, onChange: action app.DraftNote {value: payload})";
    body = body+"ui.Button(text: \"Add\", onClick: action app.AddEntry {value: payload}) ui.Button(text: \"Remove last\", onClick: action app.RemoveLast {value: payload}) ui.Button(text: \"Clear\", onClick: action app.ClearLog {value: payload})";
    body = body+"ui.NumberStat(label: \"Total\", value: state.total, suffix: state.currency) ui.NumberStat(label: \"Average\", value: state.average, suffix: state.currency) ui.NumberStat(label: \"Records\", value: state.count)";

  } else if (kind === "number_strip" || kind === "breakdown_table" || kind === "series_chart" || kind === "settle_up") {
    if (kind === "number_strip") {
      ports[ports.length] = requiredReader("total","number"); ports[ports.length] = requiredReader("average","number");
      ports[ports.length] = requiredReader("count","number"); ports[ports.length] = readerPort("currency","string","\"\"");
      fields[fields.length] = derivedField(id,"summary","string");
      helpers = helpers+"export function summaryText(state: AppState): string { let total: number = state.total as number; let average: number = state.average as number; let count: number = state.count as number; let currency: string = state.currency as string; if (count === 0) { return \"No records\"; } let suffix: string = \"\"; if (currency !== \"\") { suffix = \" \"+currency; } return String(total)+suffix+\" total; \"+String(average)+suffix+\" average; \"+String(count)+\" records\"; }";
      body = body+"When(state.summary_ready) {ui.Text(text: state.summary_display)} When(!state.summary_ready) {ui.Text(text: state.summary_reason, style: \"muted\")}";
    } else if (kind === "series_chart") {
      ports[ports.length] = requiredReader("labels","string[]"); ports[ports.length] = requiredReader("totals","number[]"); ports[ports.length] = requiredReader("balances","number[]");
      let mode: string = s.text(parameters.mode); if (mode === "") { mode = "totals"; }
      // The row's owned behavior is labelled bars of the selected aggregate: the chart binds the
      // published values and labels, and its scale is derived from those actual values.
      let valuesField: string = "totals"; if (mode === "balances") { valuesField = "balances"; }
      fields[fields.length] = derivedField(id,"chart","string");
      fields[fields.length] = derivedField(id,"chart_min","number"); fields[fields.length] = derivedField(id,"chart_max","number"); fields[fields.length] = derivedField(id,"chart_nonzero","boolean");
      helpers = helpers+"export function chartText(state: AppState): string { let labels: string[] = state.labels as string[]; let totals: number[] = state.totals as number[]; let balances: number[] = state.balances as number[]; let values: number[] = totals; if (\""+mode+"\" === \"balances\") { values = balances; } if (values.length !== labels.length) { return \"Aggregate rows differ in length\"; } let result: string = \"\"; let nonzero: boolean = false; let index: number = 0; while (index < labels.length) { if (values[index] !== 0) { nonzero = true; } if (result !== \"\") { result = result+\"\\n\"; } result = result+labels[index]+\": \"+String(values[index]); index = index+1; } if (result === \"\") { return \"No aggregate rows\"; } if (!nonzero) { return \"All values are zero\"; } return result; }";
      helpers = helpers+"export function seriesLow(state: AppState): number { let values: number[] = state."+valuesField+" as number[]; let result: number = 0; let index: number = 0; while (index < values.length) { if (values[index] < result) { result = values[index]; } index = index+1; } return result; }";
      helpers = helpers+"export function seriesHigh(state: AppState): number { let values: number[] = state."+valuesField+" as number[]; let low: number = seriesLow(state); let result: number = low; let index: number = 0; while (index < values.length) { if (values[index] > result) { result = values[index]; } index = index+1; } if (!(result > low)) { return low+1; } return result; }";
      // A zero dataset renders its explanation instead of an all-zero plot.
      helpers = helpers+"export function seriesNonzero(state: AppState): boolean { let values: number[] = state."+valuesField+" as number[]; let index: number = 0; while (index < values.length) { if (values[index] !== 0) { return true; } index = index+1; } return false; }";
      body = body+"When(state.chart_max_ready) {ui.Sparkline(series: state."+valuesField+", minimum: state.chart_min_display, maximum: state.chart_max_display, categories: state.labels, bars: true)} When(!state.chart_max_ready) {ui.Text(text: state.chart_display)}";
    } else if (kind === "breakdown_table") {
      ports[ports.length] = requiredReader("labels","string[]"); ports[ports.length] = requiredReader("totals","number[]");
      ports[ports.length] = requiredReader("balances","number[]"); ports[ports.length] = readerPort("currency","string","\"\"");
      fields[fields.length] = derivedField(id,"breakdown","string");
      helpers = helpers+"export function breakdownText(state: AppState): string { let labels: string[] = state.labels as string[]; let totals: number[] = state.totals as number[]; let balances: number[] = state.balances as number[]; let currency: string = state.currency as string; if (totals.length !== labels.length || balances.length !== labels.length) { return \"Aggregate rows differ in length\"; } let suffix: string = \"\"; if (currency !== \"\") { suffix = \" \"+currency; } let result: string = \"\"; let nonzero: boolean = false; let index: number = 0; while (index < labels.length) { if (totals[index] !== 0 || balances[index] !== 0) { nonzero = true; } if (result !== \"\") { result = result+\"\\n\"; } result = result+labels[index]+\": \"+String(totals[index])+suffix+\" (\"+String(balances[index])+suffix+\")\"; index = index+1; } if (result === \"\" || !nonzero) { return \"No aggregate rows\"; } return result; }";
      body = body+"When(state.breakdown_ready) {ui.Text(text: state.breakdown_display)} When(!state.breakdown_ready) {ui.Text(text: state.breakdown_reason, style: \"muted\")}";
    } else {
      ports[ports.length] = requiredReader("labels","string[]"); ports[ports.length] = requiredReader("balances","number[]"); ports[ports.length] = readerPort("currency","string","\"\"");
      fields[fields.length] = derivedField(id,"transfers","string");
      // Settlement restores checked integer cents from the published major units, then repeatedly
      // transfers the minimum of debt and credit choosing the first debtor and creditor in label order.
    // Settlement restores checked integer cents from the published major units and repeatedly
    // transfers the minimum of debt and credit, choosing the first debtor and the first creditor in
    // label order. The walk keeps only scalar accumulators, so the computation is a read-only summary.
    helpers = helpers+"export function transfersText(state: AppState): string { let labels: string[] = state.labels as string[]; let balances: number[] = state.balances as number[]; let currency: string = state.currency as string; if (balances.length !== labels.length) { return \"Aggregate rows differ in length\"; } let suffix: string = \"\"; if (currency !== \"\") { suffix = \" \"+currency; } let debtor: number = 0; let creditor: number = 0; let debt: number = 0; let credit: number = 0; let result: string = \"\"; let guard: number = 0; while (guard < labels.length*2+1) { guard = guard+1; if (!(debt > 0)) { let found: boolean = false; while (debtor < balances.length && !found) { let cents: number = Math.round(balances[debtor]*100); if (Math.abs(balances[debtor]*100-cents) > 0.000001) { return \"Unsafe aggregate amount\"; } if (cents < 0) { debt = -cents; found = true; } debtor = debtor+1; } if (!found) { break; } } if (!(credit > 0)) { let found: boolean = false; while (creditor < balances.length && !found) { let cents: number = Math.round(balances[creditor]*100); if (Math.abs(balances[creditor]*100-cents) > 0.000001) { return \"Unsafe aggregate amount\"; } if (cents > 0) { credit = cents; found = true; } creditor = creditor+1; } if (!found) { break; } } let amount: number = debt; if (credit < amount) { amount = credit; } debt = debt-amount; credit = credit-amount; if (result !== \"\") { result = result+\"\\n\"; } result = result+labels[debtor-1]+\" pays \"+labels[creditor-1]+\" \"+String(amount/100)+suffix; } if (result === \"\") { return \"All balances settled\"; } return result; }";
      body = body+"When(state.transfers_ready) {ui.Text(text: state.transfers_display)} When(!state.transfers_ready) {ui.Text(text: state.transfers_reason, style: \"muted\")}";
    }
  } else if (kind === "calendar_event") {
    // The disclosed calendar operation is the only write path of this section: the explicit Add
