    let key: string = "values"; if (entry.definition.kind === "key_facts") { key = "items"; }
    let index: number = 0;
    for (let row of s.records(entry.parameters,key)) {
      if (!supplied(s.text(row.label),data)) { return refusal(entry,"row "+String(index)+" label"); }
      if (!supplied(s.text(row.value),data)) { return refusal(entry,"row "+String(index)+" value"); }
      index = index+1;
    }
  }
  if (entry.definition.kind === "checklist") {
    let index: number = 0;
    for (let row of s.records(entry.parameters,"items")) {
      if (!supplied(s.text(row.label),data)) { return refusal(entry,"row "+String(index)+" label"); }
      if (!supplied(s.text(row.detail),data)) { return refusal(entry,"row "+String(index)+" detail"); }
      index = index+1;
    }
  }
