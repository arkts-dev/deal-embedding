    ports[ports.length] = publishPort("done_today","number");
    declarations = declarations+"export class FilterTime { value: number; rank: number; } export class FilterLevel { value: string; rank: number; } export class Another { value: number; } export class DoneIdea { value: number; }";
    updates[updates.length] = handler("FilterTime","filterTime"); updates[updates.length] = handler("FilterLevel","filterLevel");
    updates[updates.length] = handler("Another","another"); updates[updates.length] = handler("DoneIdea","doneIdea");
    helpers = helpers+"export function matchesIdea(state: AppState, index: number, time: number, level: string): boolean { if (time > 0 && state.idea_minutes[index] > time) { return false; } if (level !== \"\" && state.idea_levels[index] !== level) { return false; } return true; }";
    helpers = helpers+"export function doneBefore(state: AppState, index: number): boolean { for (let id of state.done_ids) { if (id === state.idea_ids[index]) { return true; } } return false; }";
    // Another wraps forward to the next matching idea, preferring unfinished matches before it
    // repeats a completed one in the same pass; a filter change starts from the filtered cursor.
    helpers = helpers+"export function nextCursor(state: AppState, from: number, time: number, level: string): number { let total: number = state.idea_ids.length; if (total === 0) { return 0; } let step: number = 0; while (step < total) { let index: number = (from+step) % total; if (matchesIdea(state,index,time,level) && !doneBefore(state,index)) { return index; } step = step+1; } step = 0; while (step < total) { let index: number = (from+step) % total; if (matchesIdea(state,index,time,level)) { return index; } step = step+1; } return -1; }";
    helpers = helpers+"export function filterTime(state: AppState, action: FilterTime): AppState { if (action.value !== 0 && action.value !== 5 && action.value !== 15 && action.value !== 30) { return state; } return {time_filter: action.value, cursor: nextCursor(state,0,action.value,state.level_filter), today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function filterLevel(state: AppState, action: FilterLevel): AppState { return {level_filter: action.value, cursor: nextCursor(state,0,state.time_filter,action.value), today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function another(state: AppState, action: Another): AppState { let total: number = state.idea_ids.length; if (total === 0) { return state; } let next: number = nextCursor(state,(state.cursor+1) % total,state.time_filter,state.level_filter); return {cursor: next, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function doneIdea(state: AppState, action: DoneIdea): AppState { if (state.cursor < 0 || state.cursor >= state.idea_ids.length) { return state; } let ids: string[] = []; for (let id of state.done_ids) { ids[ids.length] = id; } let stamps: number[] = []; for (let stamp of state.done_stamps) { stamps[stamps.length] = stamp; } let days: number[] = []; for (let day of state.done_days) { days[days.length] = day; } let today: number = embeddingDay.localDay(); if (!doneBefore(state,state.cursor)) { ids[ids.length] = state.idea_ids[state.cursor]; stamps[stamps.length] = embeddingClock.nowMillis(); days[days.length] = today; } let total: number = state.idea_ids.length; return {done_ids: ids, done_stamps: stamps, done_days: days, cursor: nextCursor(state,(state.cursor+1) % total,state.time_filter,state.level_filter), today: today}; }";
    helpers = helpers+"export function doneToday(state: AppState): number { let result: number = 0; let index: number = 0; while (index < state.done_days.length) { if (state.done_days[index] === state.today) { result = result+1; } index = index+1; } return result; }";
    helpers = helpers+"export function currentIdea(state: AppState): string { if (state.idea_ids.length === 0) { return \"No ideas\"; } if (state.cursor < 0 || state.cursor >= state.idea_ids.length) { return \"No idea matches the current filter\"; } let result: string = state.idea_titles[state.cursor]+\" (\"+String(state.idea_minutes[state.cursor])+\" min, \"+state.idea_levels[state.cursor]+\")\"; if (state.idea_instructions[state.cursor] !== \"\") { result = result+\"\\n\"+state.idea_instructions[state.cursor]; } if (doneBefore(state,state.cursor)) { result = result+\"\\nDone\"; } return result; }";
    body = body+"When(state.current_ready) {ui.Text(text: state.current_display)}";
    body = body+"ui.Button(text: \"5 min\", onClick: action app.FilterTime {value: 5, rank: payload}) ui.Button(text: \"15 min\", onClick: action app.FilterTime {value: 15, rank: payload}) ui.Button(text: \"30 min\", onClick: action app.FilterTime {value: 30, rank: payload}) ui.Button(text: \"Any\", onClick: action app.FilterTime {value: 0, rank: payload})";
    for (let level of distinctLevels(levels2)) { body = body+"ui.Button(text: "+await literal("Level "+level,"string")+", onClick: action app.FilterLevel {value: "+await literal(level,"string")+", rank: payload})"; }
    body = body+"ui.Button(text: \"Any level\", onClick: action app.FilterLevel {value: \"\", rank: payload})";
    body = body+"ui.Button(text: \"Another\", onClick: action app.Another {value: payload}) ui.Button(text: \"Done\", onClick: action app.DoneIdea {value: payload})";
    body = body+"When(state.done_today_ready) {ui.NumberText(value: state.done_today_display)}";
  } else if (kind === "interval_timer") {
    let workSeconds: number = s.integral(parameters.workSeconds); let restSeconds: number = s.integral(parameters.restSeconds); let roundsValue: number = s.integral(parameters.rounds);
    if (workSeconds <= 0 || restSeconds <= 0 || roundsValue <= 0) { s.reject("Catalogue interval bounds"); }
    fields[fields.length] = authoredField(id,"phase","string","\"work\""); fields[fields.length] = authoredField(id,"round_value","number","1");
