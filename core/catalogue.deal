  if (type === "entries") { s.closed(value,["id","label"],["detail","done"]); let id: string = rowIdentity(value.id,"id"); s.unique(ids,id); return {id:id,label:await text(value.label,32,true),detail:await text(optionalValue(value,"detail"),512,false),done:flag(value,"done",false)}; }
  if (type === "presets") { s.closed(value,["label","seconds"],[]); return {label:await text(value.label,32,true),seconds:positiveNumber(value.seconds,"seconds")}; }
