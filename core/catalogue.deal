    body = body+"When(state.today_count_ready) {ui.NumberText(value: state.today_count_display)} When(!state.today_count_ready) {ui.Text(text: state.today_count_reason, style: \"muted\")} When(state.goal_value_ready) {ui.NumberText(value: state.goal_value_display)}";
    for (let extra of extras) { body = body+"ui.Button(text: "+await literal("Log +"+String(extra),"string")+", onClick: action app.LogExtra {amount: "+String(extra)+", rank: payload})"; }
  } else if (kind === "reading_status") {
