// The field a reader port is bound to: the writer's port getter field when this composition issues a
// connection, otherwise the fallback field the composer emits for the unconnected optional reader.
function portDependency(instance: screens.Instance, name: string, connections: screens.Connection[], instances: screens.Instance[]): string {
  for (let connection of connections) { if (connection.readerInstance === instance.id && connection.readerPort === name) {
    for (let writer of instances) { if (writer.id === connection.writerInstance) { for (let port of writer.fragment.ports) { if (port.name === connection.writerPort && port.direction === "publish") { return "f_"+writer.id+"_"+port.getter; } } } }
    s.reject("Unissued port connection");
  } }
  return "f_"+instance.id+"_"+name;
}
function computation(instance: screens.Instance, field: string, value: string, ready: string, reason: string, dependencies: string[]): composer.Computation {
