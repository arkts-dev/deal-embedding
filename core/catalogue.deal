    helpers = helpers+"export function activate(state: AppState, action: Activate): AppState { if (!state.activation_needed || state.refresh_pending) { return state; } return {activation_needed: false, activation_action: action, refresh_attempt: state.refresh_attempt+1, refresh_pending: true, refresh_polled: action.now, refresh_action: null, poll_action: null, refresh_code: \"\", refresh_outcome: \"none\", refresh_message: \"\"}; }";
    helpers = helpers+"export async function runActivate(state: AppState, action: Activate): Promise<RefreshedLive> { if (!state.refresh_pending || (state.activation_action as Activate) !== action) { return {sequence: -1, ok: false, outcome: \"none\", code: \"NOT_ADMITTED\", message: \"Not admitted\", values: [], asof: \"\"}; } try { let paths: string[] = []; for (let path of state.figure_paths) { paths[paths.length] = path; } let read: ProbeRead = JSON.parse(await probe_"+id+".fetch(state.source_url, state.source_mode, paths, state.source_asof_path)); return {sequence: state.refresh_attempt, ok: true, outcome: \"success\", code: \"\", message: \"\", values: read.values, asof: read.asof}; } catch (unknownError) { let error: Error = unknownError as Error; return {sequence: state.refresh_attempt, ok: false, outcome: \"failure\", code: error.name, message: error.message, values: [], asof: \"\"}; } }";
