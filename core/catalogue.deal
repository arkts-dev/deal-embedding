    helpers = helpers+"export function draftDueName(state: AppState, action: DraftDueName): AppState { return {name_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function draftDueDay(state: AppState, action: DraftDueDay): AppState { if (Math.floor(action.value) !== action.value || Math.abs(action.value) > 9007199254740991) { return state; } return {day_draft: action.value, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function addDue(state: AppState, action: AddDue): AppState { if (state.name_draft.trim() === \"\" || state.name_draft.length > 32 || Math.floor(state.day_draft) !== state.day_draft || Math.abs(state.day_draft) > 9007199254740991 || state.sequence >= 9007199254740991) { return state; } let rows: DueRow[] = []; for (let row of state.rows) { rows[rows.length] = {id: row.id, name: row.name, day: row.day}; } rows[rows.length] = {id: free_due(state, state.sequence), name: state.name_draft, day: state.day_draft}; return {rows: rows, name_draft: \"\", sequence: state.sequence+1, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function removeDue(state: AppState, action: RemoveDue): AppState { let found: boolean = false; let rows: DueRow[] = []; for (let row of state.rows) { if (row.id === action.id) { found = true; } else { rows[rows.length] = {id: row.id, name: row.name, day: row.day}; } } if (!found) { return state; } return {rows: rows, today: embeddingDay.localDay()}; }";
    helpers = helpers+"export function changeDueDay(state: AppState, action: ChangeDueDay): AppState { if (Math.floor(action.value) !== action.value || Math.abs(action.value) > 9007199254740991) { return state; } let found: boolean = false; let rows: DueRow[] = []; for (let row of state.rows) { if (row.id === action.id) { found = true; rows[rows.length] = {id: row.id, name: row.name, day: action.value}; } else { rows[rows.length] = {id: row.id, name: row.name, day: row.day}; } } if (!found) { return state; } return {rows: rows, today: embeddingDay.localDay()}; }";
