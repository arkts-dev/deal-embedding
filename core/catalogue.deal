    updates[updates.length] = handler("Log","logTap"); if (extras.length > 0) { updates[updates.length] = handler("LogExtra","logExtra"); } updates[updates.length] = handler("UndoLog","undoLog");
    // A tap captures its own instant once in the action, and the tap history keeps that instant, so the
    // daily projection has the timestamped history it needs. The day itself comes from the frozen
    // host-timezone adapter this build does not issue, so no epoch day is derived here.
    helpers = helpers+"export function appendTap(state: AppState, value: number, now: number): AppState { if (!(now >= 0) || !(value > 0)) { return state; } let amounts: number[] = []; for (let amount of state.amounts) { amounts[amounts.length] = amount; } let stamps: number[] = []; for (let stamp of state.stamps) { stamps[stamps.length] = stamp; } amounts[amounts.length] = value; stamps[stamps.length] = now; return {amounts: amounts, stamps: stamps}; }";
    helpers = helpers+"export function logTap(state: AppState, action: Log): AppState { return appendTap(state, "+String(amount)+", embeddingClock.nowMillis()); }";
    if (extras.length > 0) { helpers = helpers+"export function logExtra(state: AppState, action: LogExtra): AppState { return appendTap(state, action.amount, embeddingClock.nowMillis()); }"; }
    helpers = helpers+"export function undoLog(state: AppState, action: UndoLog): AppState { let size: number = state.amounts.length; if (size === 0) { return state; } return {amounts: state.amounts.slice(0,size-1), stamps: state.stamps.slice(0,size-1)}; }";
    body = body+"ui.Text(text: "+await literal("Log "+String(amount)+" "+unit,"string")+")";
    body = body+"ui.Button(text: \"Log\", onClick: action app.Log {value: payload}) ui.Button(text: \"Undo log\", onClick: action app.UndoLog {value: payload})";
    // The daily total and count render their located reason while the adapter day is not issued, and
