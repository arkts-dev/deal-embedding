import * as strings from "std/string";
import * as data from "embedding/policy-data";
import * as assets from "./generation-guidance.generated";
import * as guidance from "./generation-guidance";
import * as literals from "./source-literals";

// Advisory source feedback only. Complete compiler/behavioral admission remains mandatory.
export async function patchInstruction(previous: string, diagnostics: string): string {
    return "\n\nREPAIR GUIDANCE\nEdit only the smallest rejected source region and directly required dependencies. Preserve all unrelated source and behavior. Call edit_sources with unique, disjoint exact edits; the host binds them to the current revision. Do not supply a digest or source envelope.\n" + await details(previous, diagnostics);
}
async function details(previous: string, diagnostics: string): string {
    let out: string = "Fix the reported cause without redesigning the workflow. The bounded source windows below are context, not edit authority.\n";
    if (strings.contains(diagnostics, "E1034")) {
        out = out + "A wire table may have a keyword key such as from. Read it with a string index and an explicit target type: let periodStart: string = record[\"from\"];. Keyword member access record.from is invalid. Preserve actual provider keys; check all keyword member accesses.\n";
    }
    if (strings.contains(diagnostics, "E1037")) {
        out = out + "DEAL has no ternary conditional expression. Replace condition ? a : b with an initialized local followed by if/else assignments. Check both files for all ternary operators; do not confuse nullable type T | null with an expression.\n";
    }
    if (strings.contains(diagnostics, "E1013")) {
        out = out + "Every local variable requires an initializer, even when assigned in later branches: let label: string = \"\"; never let label: string;. Initialize to an honest pending value, then assign in branches. Check all declarations in both files.\n";
    }
    if (strings.contains(diagnostics, "UI2050") || strings.contains(diagnostics, "UI2051")) {
        out = out + "The state/action and borrowed collections are immutable. Compute locals and return a complete fresh State literal. A shallow-copy helper can still alias borrowed values. Build changed arrays with explicit loops.\n";
    }
    if (strings.contains(diagnostics, "UI2006")) {
        out = out + "Each update must be bound by an existing UI event or be an effect completion. Remove only genuinely unused actions; do not invent an interaction to satisfy reachability.\n";
    }
    if (strings.contains(diagnostics, "UI2023")) {
        out = out + "The view may traverse only checker-declared nominal fields. Keep view-visible scalars in the local State/row classes; do not traverse arrays or imported helper state.\n";
    }
    let nearby: string = await sourceWindow(previous, diagnostics);
    return out + nearby;
}
async function sourceWindow(previous: string, diagnostics: string): string {
    let envelope: table = {}; let wrapped: table = {};
    try { envelope = await data.parse(previous); wrapped = await data.parse("{\"report\":" + diagnostics + "}"); }
    catch (error) { if (error.code !== "INVALID_JSON") { throw error; } return ""; }
    try {
        let errors: table[] = [];
        try { let items: table[] = wrapped.report; errors = items; }
        catch (shape) { let report: table = wrapped.report; let items: table[] = report.diagnostics; errors = items; }
        let out: string = "";
        let count: int = 0;
        for (let error: table of errors) {
            if (count < 3) {
                let file: string = ""; let line: int = 0;
                try { file = error.file; line = error.line; }
                catch (shape) { let range: table = error.range; file = range.file; line = range.startLine; }
                let source: string = "";
                if (strings.endsWith(file, ".dealui")) { source = envelope.dealui; }
                else { if (strings.endsWith(file, ".deal")) { source = envelope.deal; } }
                if (source !== "" && line > 0) {
                    let lines: string[] = strings.split(source, "\n");
                    if (line <= lines.length) {
                        let reported: string = lines[line - 1];
                        let code: string = error.code;
                        if (strings.endsWith(file, ".dealui") && code === "UI1016") {
                            out = out + "View expressions cannot call functions. Compute this value in DEAL and bind a state/row field. Preserve other logic.\n";
                        }
                        if (strings.endsWith(file, ".deal") && code === "E1015" && (strings.contains(reported, " == ") || strings.contains(reported, " != "))) {
                            out = out + "The reported DEAL condition uses unsupported equality syntax. Use === or !==, preserving the operands and behavior.\n";
                        }
                        let patchFile: string = "deal";
                        if (strings.endsWith(file, ".dealui")) { patchFile = "dealui"; }
                        out = out + "\nDiagnostic file: " + file + "; patch file: " + patchFile + "; line: " + literals.decimal(line) + "; code: " + code + "\n";
                        if (code === "E1007") {
                            let column: int = error.column;
                            let tail: string = strings.substring(reported, column - 1, strings.length(reported));
                            let reserved: string[] = assets.reservedWords();
                            for (let word: string of reserved) {
                                if (strings.startsWith(tail, word)) {
                                    let boundary: boolean = strings.length(tail) === strings.length(word);
                                    if (!boundary) {
                                        let next: string = strings.substring(tail, strings.length(word), strings.length(word) + 1);
                                        boundary = !strings.contains("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_$", next);
                                    }
                                    if (boundary) { out = out + "Offending token '" + word + "' is a reserved keyword, not an identifier. Rename this declaration and its references using unique contextual edits. Preserve provider keys via explicitly typed string indexing; do not rename wire fields.\n"; }
                                }
                            }
                        }
                        if (code === "E1001" && strings.contains(reported, "\\")) {
                            out = out + "The reported file contains an invalid backslash. Inspect this exact decoded file for JSON envelope fragments or escaped UI accidentally embedded in DEAL. If present, remove only the misplaced fragment from this file; do not edit the separate dealui file merely because the fragment contains UI. Do not unescape the whole file or change valid string escapes.\n";
                        }
                        if (strings.endsWith(file, ".deal") && code === "E1052") {
                            out = out + "Unsupported DEAL string escape: write the intended literal Unicode character in source instead of a backslash-u sequence. Tool arguments must decode to literal source; do not unescape other valid source strings.\n";
                        }
                        if (strings.endsWith(file, ".deal") && code === "E3017") {
                            out = out + "Array length is read-only. Append with array[array.length] = value; to truncate or replace contents, build a fresh typed array and assign it to the owned local/state field. Never assign array.length.\n";
                        }
                        if (strings.endsWith(file, ".deal") && code === "E3003") {
                            out = out + "Table reads require an explicit contextual target type. Read into typed locals before arithmetic/comparison: let cents: int = record.cents;. Use the actual declared contract field/type; do not invent a field or cast.\n";
                        }
                        out = out + "Exact reported source line (line number is not source):\n" + literals.decimal(line) + " | " + reported + "\n";
                        let pack: table = assets.pack(); let components: table[] = pack.components;
                        for (let component: table of components) {
                            let name: string = component.name;
                            if (strings.contains(reported, "ui." + name + "(")) {
                                let selected: table[] = [component];
                                out = out + "Exact renderer component contract:\n" + guidance.componentFacts({ components: selected }) + "\n";
                            }
                        }
                        out = out + "Nearby source (context, not replacement authority):\n";
                        let start: int = line - 3; if (start < 0) { start = 0; }
                        let end: int = line + 2; if (end > lines.length) { end = lines.length; }
                        for (let index: int = start; index < end; index = index + 1) { out = out + literals.decimal(index + 1) + " | " + lines[index] + "\n"; }
                    }
                }
                count = count + 1;
            }
        }
        return out;
    } catch (shape) { return ""; }
}
export function main(): null { return null; }
