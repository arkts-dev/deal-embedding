import * as embedding from "embedding";
import * as mechanism from "embedding/controller-mechanisms";

class ContextEntry { id: string; schema: embedding.WireType; json: string; }
class RequestEntry {
  id: string; title: string; intent: string; context: ContextEntry;
  contracts: embedding.CapabilityContract[]; trace: string; used: boolean; cancelled: boolean;
}
class Permission { module: string; epoch: string; granted: boolean; }
class ExperienceEntry { metadata: embedding.Experience; source: embedding.Source; saved: boolean; session: string; starting: boolean; }
class SessionEntry { id: string; experience: string; trace: string; version: number; live: boolean; }
class SessionWaits { session: string; count: number; }
export class RunAdmission { experience: embedding.Experience; phase: string; session: string; }
export class Work {
  title: string; intent: string; schema: embedding.WireType; json: string;
  contracts: embedding.CapabilityContract[]; trace: string;
}
export class Controller {
  snapshot: (schema: embedding.WireType, valueJson: string) => embedding.GenerationContext;
  contextSchema: (id: string) => embedding.WireType;
  contextJson: (id: string) => string;
  request: (title: string, intent: string, contextId: string) => embedding.GenerationRequest;
  requestTrace: (id: string) => string;
  consume: (id: string) => Work;
  cancel: (id: string) => null;
  admissible: (id: string) => boolean;
  refresh: (contracts: embedding.CapabilityContract[]) => null;
  permission: (module: string, granted: boolean) => null;
  permitted: (module: string) => string | null;
  title: (value: string) => null;
  retain: (metadata: embedding.Experience, source: embedding.Source, saved: boolean) => embedding.Experience;
  source: (id: string) => embedding.Source;
  release: (id: string) => embedding.Experience;
  beginRun: (id: string) => RunAdmission;
  run: (id: string) => Promise<embedding.Session>;
  session: (id: string) => null;
  beginWait: (id: string) => null;
  endWait: (id: string) => null;
  dispatch: (id: string, slot: number) => null;
  eventLimit: (limit: number) => null;
  produced: (id: string, version: number) => null;
  published: (id: string, version: number) => null;
  sessionTrace: (id: string) => string;
  closed: (id: string) => null;
  saved: () => embedding.Experience[];
  experience: (id: string) => embedding.Experience;
  forgotten: (id: string) => null;
  liveSessions: (ids: string[]) => null;
  check: () => null;
  stop: () => null;
}
function require(condition: boolean, code: string, message: string): null {
  if (!condition) { throw {name:code,message:message}; }
  return null;
}
export function create(seed: string, initialContracts: embedding.CapabilityContract[], waitLimit: number): Controller {
  // One admitted slot serves the rendering observer, so the host waits need the rest of the domain.
  require(waitLimit >= 2 && waitLimit <= 64 && Math.floor(waitLimit) === waitLimit,"INVALID_ARGUMENT","Configured update wait limit must be an integer between 2 and 64");
  let sequence: number = 0;
  let stopped: boolean = false;
  let waiters: SessionWaits[] = [];
  let contexts: ContextEntry[] = [];
  let requests: RequestEntry[] = [];
  let permissions: Permission[] = [];
  let experiences: ExperienceEntry[] = [];
  let sessions: SessionEntry[] = [];
  let contracts: embedding.CapabilityContract[] = initialContracts;
  let nextId: () => string = function(): string {
    sequence = sequence + 1;
    return seed + "-" + String(sequence);
  };
  let active: () => null = function(): null {
    return require(!stopped,"STOPPED","Embedding instance is stopped");
  };
  let context: (id: string) => ContextEntry = function(id: string): ContextEntry {
    const entry = contexts.find((item: ContextEntry): boolean => item.id === id); if (entry !== undefined) { return entry; }
    throw {name:"INVALID_HANDLE",message:"Unissued context"};
  };
  let request: (id: string) => RequestEntry = function(id: string): RequestEntry {
    const entry = requests.find((item: RequestEntry): boolean => item.id === id); if (entry !== undefined) { return entry; }
    throw {name:"INVALID_HANDLE",message:"Unissued request"};
  };
  let experience: (id: string) => ExperienceEntry = function(id: string): ExperienceEntry {
    const entry = experiences.find((item: ExperienceEntry): boolean => item.metadata.id === id); if (entry !== undefined) { return entry; }
    throw {name:"INVALID_HANDLE",message:"Unissued or expired Experience"};
  };
  let session: (id: string) => SessionEntry = function(id: string): SessionEntry {
    const entry = sessions.find((item: SessionEntry): boolean => item.id === id); if (entry !== undefined) { return entry; }
    throw {name:"INVALID_HANDLE",message:"Unissued or closed Session"};
  };
  let title: (value: string) => null = function(value: string): null {
    return require(value.trim() !== "" && value.length <= 120,"INVALID_ARGUMENT","Experience title");
  };
  let removeSession: (id: string) => null = function(id: string): null {
    sessions = sessions.filter((entry: SessionEntry): boolean => entry.id !== id);
    waiters = waiters.filter((entry: SessionWaits): boolean => entry.session !== id);
    return null;
  };
  let waiterFor: (id: string) => SessionWaits = function(id: string): SessionWaits {
    for (let entry of waiters) { if (entry.session === id) { return entry; } }
    let created: SessionWaits = {session:id,count:0};
    waiters[waiters.length] = created;
    return created;
  };
  return {
    snapshot:function(schema: embedding.WireType, valueJson: string): embedding.GenerationContext {
      active();
      let checked: mechanism.ContextValue = mechanism.context(schema,valueJson,8192,8,32,8192);
      let id: string = nextId();
      contexts[contexts.length] = {id:id,schema:checked.schema,json:checked.json};
      return {id:id};
    },
    contextSchema:function(id: string): embedding.WireType { active(); return context(id).schema; },
    contextJson:function(id: string): string { active(); return context(id).json; },
    request:function(title: string, intent: string, contextId: string): embedding.GenerationRequest {
      active();
      require(title.trim() !== "" && title.length <= 120,"INVALID_ARGUMENT","Request title");
      require(intent.trim() !== "" && intent.length <= 4096,"INVALID_ARGUMENT","Request intent");
      let facts: ContextEntry = context(contextId);
      let id: string = nextId();
      requests[requests.length] = {id:id,title:title,intent:intent,context:facts,contracts:contracts,trace:nextId(),used:false,cancelled:false};
      return {id:id};
    },
    requestTrace:function(id: string): string { active(); return request(id).trace; },
    consume:function(id: string): Work {
      active();
      let entry: RequestEntry = request(id);
      require(!entry.used,"INVALID_ARGUMENT","Request is single use");
      entry.used = true;
      require(!entry.cancelled,"CANCELLED","Generation cancelled");
      return {title:entry.title,intent:entry.intent,schema:entry.context.schema,json:entry.context.json,contracts:entry.contracts,trace:entry.trace};
    },
    cancel:function(id: string): null { active(); request(id).cancelled = true; return null; },
    admissible:function(id: string): boolean { return !stopped && !request(id).cancelled; },
    refresh:function(value: embedding.CapabilityContract[]): null { active(); contracts = value; return null; },
    permission:function(module: string, granted: boolean): null {
      active();
      let known: boolean = false;
      for (let contract of contracts) { if (contract.module === module) { known = true; } }
      require(known,"INVALID_ARGUMENT","Unknown module");
      let epoch: string = nextId();
      for (let permission of permissions) {
        if (permission.module === module) { permission.epoch = epoch; permission.granted = granted; return null; }
      }
      permissions[permissions.length] = {module:module,epoch:epoch,granted:granted};
      return null;
    },
    permitted:function(module: string): string | null {
      if (!stopped) { for (let permission of permissions) { if (permission.module === module && permission.granted) { return permission.epoch; } } }
      return null;
    },
    title:function(value: string): null { active(); return title(value); },
    retain:function(metadata: embedding.Experience, source: embedding.Source, saved: boolean): embedding.Experience {
      active();
      for (let entry of experiences) { require(entry.metadata.id !== metadata.id,"INVALID_HANDLE","Duplicate Experience identity"); }
      experiences[experiences.length] = {metadata:metadata,source:source,saved:saved,session:"",starting:false};
      return metadata;
    },
    source:function(id: string): embedding.Source { active(); return experience(id).source; },
    release:function(id: string): embedding.Experience {
      active();
      let entry: ExperienceEntry = experience(id);
      require(!entry.saved && entry.session === "" && !entry.starting,"INVALID_ARGUMENT","Experience is saved or live");
      let retained: ExperienceEntry[] = [];
      for (let other of experiences) { if (other.metadata.id !== id) { retained[retained.length] = other; } }
      experiences = retained;
      return entry.metadata;
    },
    beginRun:function(id: string): RunAdmission {
      active();
      let entry: ExperienceEntry = experience(id);
      if (entry.session !== "" && session(entry.session).live) { return {experience:entry.metadata,phase:"live",session:entry.session}; }
      if (entry.starting) { return {experience:entry.metadata,phase:"pending",session:""}; }
      entry.starting = true;
      return {experience:entry.metadata,phase:"start",session:""};
    },
    run:async function(id: string): Promise<embedding.Session> {
      active();
      let entry: ExperienceEntry = experience(id);
      require(entry.starting,"INVALID_ARGUMENT","Unissued Session start");
      let sessionId: string = nextId();
      let prepared: mechanism.PreparedStart | null = null;
      try {
        let store: mechanism.PreparedStart = await mechanism.prepareStart(entry.metadata,sessionId);
        prepared = store;
        active();
        await mechanism.persistStart(store);
        active();
        await mechanism.activateStart(store);
        active();
        if (entry.session !== "") { removeSession(entry.session); }
        sessions[sessions.length] = {id:sessionId,experience:id,trace:store.trace,version:-1,live:true};
        entry.session = sessionId; entry.starting = false; entry.saved = true;
        return {id:sessionId};
      } catch (errorUnknown) {
        let error: Error = errorUnknown as Error;
        entry.starting = false;
        let store: mechanism.PreparedStart | null = prepared;
        if (store !== null) { await mechanism.abortStart(store,error.name,error.message); }
        throw error;
      }
    },
    session:function(id: string): null { active(); session(id); return null; },
    beginWait:function(id: string): null {
      active(); session(id);
      let held: SessionWaits = waiterFor(id);
      require(held.count < waitLimit,"LIMIT","Too many pending update waits");
      held.count = held.count + 1;
      return null;
    },
    endWait:function(id: string): null {
      for (let entry of waiters) {
        if (entry.session === id) { if (entry.count > 0) { entry.count = entry.count - 1; } return null; }
      }
      return null;
    },
    dispatch:function(id: string, slot: number): null {
      active(); session(id);
      return require(slot >= 0 && slot <= 2147483647 && Math.floor(slot) === slot,"INVALID_ARGUMENT","Action slot");
    },
    eventLimit:function(limit: number): null {
      active();
      return require(limit >= 1 && limit <= 200 && Math.floor(limit) === limit,"INVALID_ARGUMENT","Event limit");
    },
    produced:function(id: string, version: number): null {
      let entry: SessionEntry = session(id);
      if (version > entry.version) { entry.version = version; }
      return null;
    },
    published:function(id: string, version: number): null {
      active();
      require(version >= 0 && version <= session(id).version && Math.floor(version) === version,"INVALID_ARGUMENT","Unproduced snapshot version");
      return null;
    },
    sessionTrace:function(id: string): string { active(); return session(id).trace; },
    closed:function(id: string): null {
      let entry: SessionEntry = session(id);
      let owner: ExperienceEntry = experience(entry.experience);
      if (owner.session === id) { owner.session = ""; }
      removeSession(id); return null;
    },
    saved:function(): embedding.Experience[] {
      active(); let result: embedding.Experience[] = [];
      for (let entry of experiences) { if (entry.saved) { result[result.length] = entry.metadata; } }
      return result;
    },
    experience:function(id: string): embedding.Experience { active(); return experience(id).metadata; },
    forgotten:function(id: string): null {
      let entry: ExperienceEntry = experience(id);
      if (entry.session !== "") { removeSession(entry.session); }
      let retained: ExperienceEntry[] = [];
      for (let other of experiences) { if (other.metadata.id !== id) { retained[retained.length] = other; } }
      experiences = retained; return null;
    },
    liveSessions:function(ids: string[]): null {
      for (let entry of sessions) {
        let found: boolean = false;
        for (let id of ids) { if (id === entry.id) { found = true; } }
        if (!found) { entry.live = false; }
      }
      return null;
    },
    check:active,
    stop:function(): null {
      if (!stopped) { stopped = true; for (let entry of requests) { entry.cancelled = true; } }
      return null;
    }
  };
}
export function main(): void { return; }
