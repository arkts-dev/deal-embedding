import * as embedding from "embedding";
import * as data from "embedding/policy-data";
import * as identity from "embedding/construction-identity";
import * as decoded from "./decoded";
import * as s from "./construction-schema";
import * as plans from "./plan";
import * as planning from "./planning";
import * as classification from "./classification";
import * as selection from "./construction-selection";
import * as construction from "./construction";
import * as bindings from "./bindings";
import * as writing from "./custom-writing";
import * as assets from "./generation-guidance.generated";

export class GenerationInput { intent: string; context: embedding.GenerationContext; capabilities: embedding.CapabilityContract[]; target: string; }
// The classification, its reason and the construction outcome are retained with the request trace
// and the construction result (generation-recovery-and-source-editing "Construction classification").
export class GenerationResult { candidateId: string; attempts: number; diagnostics: string; origin: string; classification: string; classificationReason: string; }
export async function generate(request: GenerationInput): Promise<GenerationResult> {
  let target: string = s.oneOf(request.target,["screen","chat","card"]);
  let disclosed: string = embedding.contextJson(request.context);
  let contracts: string = await data.catalogJson(request.capabilities);
  contracts = contracts+"\nCOMPILER PROVIDER DECLARATIONS\n"+await data.capabilityDeclarations(request.capabilities);
  // Disclosed provider modules extend the permitted import surface; nothing else does.
  let providers: string[] = []; for (let contract of request.capabilities) { providers[providers.length] = contract.module; }
  let facts: Record<string, unknown> = JSON.parse(disclosed); let factIds: string[] = [];
  if (Object.hasOwn(facts,"facts")) { for (let fact of decoded.records(facts.facts)) { s.unique(factIds,s.nonblank(fact.id)); } }
  // Classification is decided once, before any plan dispatch, and is never revisited.
  let classified: classification.Outcome = await classification.run(request.intent,disclosed,contracts,target);
  let trace: string = classified.classification; let reason: string = classified.reason;
  if (classified.classification === "whole") {
    // A whole classification writes one complete Surface without a plan and never enters the
    // ordinary stages, even when an ordinary composition would have been runnable.
    let surfaceInput: writing.Input = {original:request.intent,facts:disclosed,contracts:contracts,specification:assets.writingSpecification(),language:assets.language(),pack:assets.pack(),target:target,plan:null,answers:[],wholeSurface:true,providers:providers};
    let surface: writing.Result = await writing.run(surfaceInput);
    return {candidateId:surface.candidateId,attempts:surface.attempts,diagnostics:surface.diagnostics,origin:"generated",classification:trace,classificationReason:reason};
  }
  let input: planning.Input = {requestId:await identity.issue(),request:request.intent,facts:disclosed,factIds:factIds,sourceIds:[],contracts:contracts,specification:assets.planningSpecification(),target:target};
  let result: planning.Result = await planning.review(input,await planning.run(input));
  // A part classification enters the plan as exactly one scene need that reads the plan inputs.
  if (result.plan !== null && classified.classification === "part") { classification.scene(result.plan as plans.Plan,request.intent); }
  let context: selection.Context = {original:request.intent,facts:disclosed,contracts:contracts,specification:assets.selectionSpecification()};
  let writingInput: writing.Input = {original:request.intent,facts:disclosed,contracts:contracts,specification:assets.writingSpecification(),language:assets.language(),pack:assets.pack(),target:input.target,plan:result.plan,answers:result.answers,providers:providers};
  if (result.plan !== null) {
    let ordinary: construction.Result = await construction.run(writingInput,context,result.plan as plans.Plan,bindings.create(request.capabilities));
    if (ordinary.runnable) { return {candidateId:ordinary.candidateId,attempts:ordinary.attempts,diagnostics:ordinary.diagnostics,origin:"generated",classification:trace,classificationReason:reason}; }
  }
  // The only whole-writing admission: no runnable ordinary composition (or no usable plan).
  let written: writing.Result = await writing.run(writingInput);
  return {candidateId:written.candidateId,attempts:written.attempts,diagnostics:written.diagnostics,origin:"generated",classification:trace,classificationReason:reason};
}
export function main(): void { return; }
