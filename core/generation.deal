import * as embedding from "embedding";
import * as data from "embedding/policy-data";
import * as identity from "embedding/construction-identity";
import * as decoded from "./decoded";
import * as s from "./construction-schema";
import * as plans from "./plan";
import * as planning from "./planning";
import * as classification from "./classification";
import * as chat from "./chat";
import * as lookup from "./lookup";
import * as selection from "./construction-selection";
import * as construction from "./construction";
import * as bindings from "./bindings";
import * as writing from "./custom-writing";
import * as assets from "./generation-guidance.generated";
// The edit route compiles into this production bundle: an Experience generated here is structurally
// edited and refined by the same compiled policy that generated it, from the record and assembler
// inputs the generation result issues. No edit lane re-implements the assembly or the commit.
import * as editing from "./editing";
import * as revisions from "./source-revisions";
import * as composer from "./composer";

export class GenerationInput { intent: string; context: embedding.GenerationContext; capabilities: embedding.CapabilityContract[]; target: string; clockIntervalMs: number; clockToleranceMs: number; }
// The classification, its reason and the construction outcome are retained with the request trace
// and the construction result (generation-recovery-and-source-editing "Construction classification").
export class GenerationResult { candidateId: string; attempts: number; diagnostics: string; origin: string; classification: string; classificationReason: string; }
export async function generate(request: GenerationInput): Promise<GenerationResult> {
  let target: string = s.oneOf(request.target,["screen","chat","card"]);
  // The clock driver interval and wall-clock tolerance are host configuration: both are finite and
  // positive, and the tolerance always covers one driver interval so a normal tick is never a jump.
  let clockIntervalMs: number = s.finite(request.clockIntervalMs);
  let clockToleranceMs: number = s.finite(request.clockToleranceMs);
  if (!(clockIntervalMs > 0)) { s.reject("Host clock driver interval must be positive"); }
  if (!(clockToleranceMs > 0)) { s.reject("Host wall-clock tolerance must be positive"); }
  if (clockToleranceMs < clockIntervalMs) { s.reject("Host wall-clock tolerance must cover the clock driver interval"); }
  let disclosed: string = embedding.contextJson(request.context);
  let contracts: string = await data.catalogJson(request.capabilities);
  contracts = contracts+"\nCOMPILER PROVIDER DECLARATIONS\n"+await data.capabilityDeclarations(request.capabilities);
  // Disclosed provider modules extend the permitted import surface; nothing else does.
  let providers: string[] = []; for (let contract of request.capabilities) { providers[providers.length] = contract.module; }
  let facts: Record<string, unknown> = JSON.parse(disclosed); let factIds: string[] = [];
  if (Object.hasOwn(facts,"facts")) { for (let fact of decoded.records(facts.facts)) { s.unique(factIds,s.nonblank(fact.id)); } }
  // Classification is decided once, before any plan dispatch, and is never revisited.
  let classified: classification.Outcome = await classification.run(request.intent,disclosed,contracts,target);
  let trace: string = classified.classification; let reason: string = classified.reason;
  if (classified.classification === "whole") {
    // A whole classification writes one complete Surface without a plan and never enters the
    // ordinary stages, even when an ordinary composition would have been runnable.
    let surfaceInput: writing.Input = {original:request.intent,facts:disclosed,contracts:contracts,specification:assets.writingSpecification(),language:assets.language(),pack:assets.pack(),target:target,plan:null,answers:[],wholeSurface:true,providers:providers,registry:bindings.create(request.capabilities),clockIntervalMs:clockIntervalMs,clockToleranceMs:clockToleranceMs};
    let surface: writing.Result = await writing.run(surfaceInput);
    return {candidateId:surface.candidateId,attempts:surface.attempts,diagnostics:surface.diagnostics,origin:"generated",classification:trace,classificationReason:reason};
  }
  let input: planning.Input = {requestId:await identity.issue(),request:request.intent,facts:disclosed,factIds:factIds,sourceIds:[],contracts:contracts,specification:assets.planningSpecification(),target:target};
  let result: planning.Result = await planning.review(input,await planning.run(input));
  // A part classification enters the plan as exactly one scene need that reads the plan inputs.
  if (result.plan !== null && classified.classification === "part") { classification.scene(result.plan as plans.Plan,request.intent); }
  // A chat projection is decided once, before construction: it retains the first five visible needs
  // with their hidden dependencies and discloses every omission as missing. One lookup session carries
  // the missing-need cache and counters across the route.
  let projection: chat.Projection | null = null;
  if (result.plan !== null) { projection = chat.project(result.plan as plans.Plan,target); }
  let planned: plans.Plan | null = null; let omitted: string[] = [];
  if (projection !== null) { planned = (projection as chat.Projection).plan; omitted = (projection as chat.Projection).omitted; }
  let lookups: lookup.Session = lookup.session();
  let context: selection.Context = {original:request.intent,facts:disclosed,contracts:contracts,specification:assets.selectionSpecification()};
  let writingInput: writing.Input = {original:request.intent,facts:disclosed,contracts:contracts,specification:assets.writingSpecification(),language:assets.language(),pack:assets.pack(),target:input.target,plan:planned,answers:result.answers,providers:providers,registry:bindings.create(request.capabilities),clockIntervalMs:clockIntervalMs,clockToleranceMs:clockToleranceMs,omitted:omitted};
  if (planned !== null) {
    let ordinary: construction.Result = await construction.run(writingInput,context,planned as plans.Plan,bindings.create(request.capabilities),lookups,omitted);
    if (ordinary.runnable) { return {candidateId:ordinary.candidateId,attempts:ordinary.attempts,diagnostics:ordinary.diagnostics,origin:"generated",classification:trace,classificationReason:reason}; }
  }
  // The only whole-writing admission: no runnable ordinary composition (or no usable plan).
  let written: writing.Result = await writing.run(writingInput);
  return {candidateId:written.candidateId,attempts:written.attempts,diagnostics:written.diagnostics,origin:"generated",classification:trace,classificationReason:reason};
}
export function main(): void { return; }

// --- the production structural-edit and live-refinement operations ---------------------------------

// One issued record, one selector decision and the catalogue fragment the selector issued for the
// selected kind. The route edits the record, rebuilds the pair through the assembler and commits it.
export async function structuralEdit(issued: editing.Issued, request: string, addition: string, confidence: number): Promise<editing.Edited> {
  return await editing.structuralEdit(issued,request,addition,confidence);
}
// One replacement pair with its issued assembly metadata over the state the running Session holds.
export async function refine(issued: editing.Issued, deal: string, dealui: string, metadata: string, before: string, after: string, record: string): Promise<editing.Edited> {
  let rebuilt: revisions.Source = {deal:deal,dealui:dealui};
  return await editing.refine(issued,rebuilt,metadata,before,after,record);
}
// The resolved field schema of an assembled pair, in the form the refinement copy reads.
export function editSchema(assembled: composer.Field[]): string { return editing.schema(assembled); }
