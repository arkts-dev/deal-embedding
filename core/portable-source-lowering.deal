                                while (at < pairs.length) { if (Object.hasOwn(pairs[at], "text") && field(pairs[at], "text") === (param.name as string)) { value = field(pairs[at + 1], "source"); count = count + 1; } at = at + 2; }
                                if (count !== 1) { fail("Expected one SDK value for parameter: " + (param.name as string)); }
