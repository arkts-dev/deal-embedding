    let lowered: views.Result = views.lower((view as Record<string, unknown>).body as Record<string, unknown>, functions);
    let actions: views.Action[] = lowered.actions; let actionAt: number = 0;
    while (actionAt < actions.length) {
        let action: views.Action = actions[actionAt]; actionAt = actionAt + 1;
        for (let call of calls) { if (call.function !== action.handler) { continue; } let chained: boolean = false; for (let next of calls) { if (next.function === call.answer) { chained = true; } } if (!chained) { continue; }
            let exists: boolean = false; for (let next of actions) { if (next.completion !== undefined && next.handler === call.answer) { exists = true; } }
            if (!exists) { actions[actions.length] = {name: "Action" + literals.decimal(actions.length), handler: call.answer, type: "string", argument: "", completion: true, channel: call.channel}; }
        }
    }
    let fields: string = ""; let values: string[] = ["app: state"]; let channels: string[] = []; let prologue: string = lowered.prologue;
    for (let call of calls) { if (decode.includes(channels, call.channel)) { continue; } channels[channels.length] = call.channel;
        fields = fields + "sdkVersion" + call.channel + ": number; sdkState" + call.channel + ": AppState;\n";
        prologue = prologue + "let sdkVersion" + call.channel + ": number = 0; let sdkState" + call.channel + ": AppState = state;\nif (previous !== null) { sdkVersion" + call.channel + " = previous.sdkVersion" + call.channel + "; sdkState" + call.channel + " = previous.sdkState" + call.channel + "; }\n";
        values[values.length] = "sdkVersion" + call.channel + ": sdkVersion" + call.channel; values[values.length] = "sdkState" + call.channel + ": sdkState" + call.channel;
    }
