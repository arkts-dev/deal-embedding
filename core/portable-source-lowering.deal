export class Pair { deal: string; dealui: string; }
class Call { function: string; target: string; args: string; answer: string; channel: string; }
function fail(message: string): void { throw {code: "PORTABLE_UNSUPPORTED", message: message}; }
function field(raw: Record<string, unknown>, key: string): string { return raw[key] as string; }
function records(raw: Record<string, unknown>, key: string): Record<string, unknown>[] {
