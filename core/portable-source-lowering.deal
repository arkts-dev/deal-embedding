        for (let call of calls) { if (call.function === action.handler) { let increment: string = " + 1"; if (action.completion !== undefined) { increment = ""; } update = "let next: PortableState = project(" + action.handler + "(state.app, action.value), state); next.sdkVersion" + call.channel + " = state.sdkVersion" + call.channel + increment + "; next.sdkState" + call.channel + " = state.app; return next;"; } }
        if (action.completion !== undefined) { fields = fields + "version: number;"; update = "if (action.version !== state.sdkVersion" + (action.channel as string) + ") { return state; } " + update; }
        logic = logic + "export class " + action.name + " {" + fields + "}\n// @ui-update\nexport function update" + action.name + "(state: PortableState, action: " + action.name + "): PortableState { " + update + " }\n";
    }
    for (let action of actions) { for (let call of calls) {
        if (call.function !== action.handler) { continue; } if (!Object.hasOwn(functions, call.answer)) { fail("Unknown SDK answer handler: " + call.answer); }
        let answer: Record<string, unknown> = functions[call.answer] as Record<string, unknown>; let params: Record<string, unknown>[] = records(answer, "parameters");
        if (params.length !== 2 || field(params[0], "type") !== "AppState" || field(params[1], "type") !== "string" || field(answer, "result") !== "AppState") { fail("SDK answer signature not yet lowered"); }
        let done: string = action.name + "Done"; let chain: boolean = false; for (let next of actions) { if (next.completion !== undefined && next.handler === call.answer) { done = next.name; chain = true; } }
        if (!chain) { logic = logic + "export class " + done + " { value: string; version: number; }\n"; }
        let guard: string = ""; if (action.completion !== undefined) { guard = "if (action.version !== current.sdkVersion" + call.channel + ") { return {value: \"\", version: -1}; }\n"; }
