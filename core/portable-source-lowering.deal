    } } }
    let sdkMembers: number = 0; for (let member of records(syntax, "members")) { if (field(member, "owner") === "sdk") { if (field(member, "name") !== "call") { fail("Unknown SDK operation"); } sdkMembers = sdkMembers + 1; } }
