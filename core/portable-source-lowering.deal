        if (str.startsWith(trimmed, "import ") && !str.endsWith(trimmed, ";")) { line = line + ";"; }
        out = out + line + "\n";
    }
    return out;
}
function join(values: string[], separator: string): string {
    let out: string = ""; let i: number = 0; for (let value of values) { if (i > 0) { out = out + separator; } out = out + value; i = i + 1; } return out;
}
function presentationSource(source: string, syntax: Record<string, unknown>): string {
