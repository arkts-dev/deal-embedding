        if (!chain) { logic = logic + "// @ui-update\nexport function finish" + action.name + "(state: PortableState, action: " + done + "): PortableState { if (action.version !== state.sdkVersion" + call.channel + ") { return state; } return project(" + call.answer + "(state.app, action.value), state); }\n"; }
