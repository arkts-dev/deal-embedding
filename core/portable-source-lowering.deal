        for (let key of ["object", "left", "right", "value", "callee", "index", "target", "expression", "condition", "then", "else", "body", "catch"]) { if (Object.hasOwn(node, key)) { enqueue(node[key] as Record<string, unknown>); } }
        for (let key of ["args", "items", "statements"]) { if (Object.hasOwn(node, key)) { for (let item of records(node, key)) { enqueue(item); } } }
