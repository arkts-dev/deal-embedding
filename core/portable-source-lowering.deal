        if (field(current, "kind") !== "IdentifierExpr") { return ""; }
        let type: string = decode.stringField(bindings, field(current, "name"), ""); let at: number = members.length;
        while (at > 0) { at = at - 1; if (!Object.hasOwn(classes, type)) { return ""; } type = decode.stringField(classes[type] as Record<string, unknown>, members[at], ""); }
        return type;
    };
