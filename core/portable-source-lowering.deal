    logic = imports + "import * as json from \"std/json\";\nimport * as strings from \"./portable-presentation\";\nimport * as presentation from \"./portable-presentation\";\n" + logic + lowered.classes + "export class PortableState { app: AppState;\n" + fields + "}\nfunction project(state: AppState, previous: PortableState | null): PortableState {\n" + prologue + "return {" + join(values, ", ") + "};\n}\nexport function initialState(): PortableState { return project(init(), null); }\n";
    for (let action of actions) {
