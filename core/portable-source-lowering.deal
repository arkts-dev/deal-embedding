        } else if (kind === "FunctionDeclaration") { let name: string = field(declaration, "name"); functions[name] = declaration; if (name === "view") { view = declaration; } else { logic = logic + field(declaration, "source") + "\n"; } }
        else if (kind === "ClassDeclaration") { logic = logic + field(declaration, "source") + "\n"; }
