        logic = logic + "export function " + wrapper + "(state: PortableState, value: " + type + "): PortableState { return project(" + field(declaration, "name") + "(state.app, value), state); }\n";
    }
    logic = logic + "export function portableHandlers(): string { return " + literals.quote(json.stringify(handlers) as string) + "; }\nexport function main(): null { return null; }\n";
    return {deal: logic, dealui: "import * as app from \"./experience\";\nimport * as ui from \"./platform.dealui-pack\";\n// @ui-root\nexport view Experience(state: app.PortableState): View { ui.Column() {\n" + tree + "}\n}\n"};
}
export function main(): null { return null; }
