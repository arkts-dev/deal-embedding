        let bindings: Record<string, unknown> = {}; if (Object.hasOwn(node, "bindings")) { bindings = node.bindings as Record<string, unknown>; }
        if (field(node, "kind") === "FunctionDeclaration") { let fresh: Record<string, unknown> = {}; bindings = fresh; for (let param of records(node, "parameters")) { bindings[field(param, "name")] = field(param, "type"); } }
        if (field(node, "kind") === "Block") { let scoped: Record<string, unknown> = {}; for (let key of table.keys(bindings)) { scoped[key] = bindings[key]; } for (let statement of records(node, "statements")) { if (field(statement, "kind") === "VariableDeclaration") { scoped[field(statement, "name")] = field(statement, "type"); } } bindings = scoped; }
