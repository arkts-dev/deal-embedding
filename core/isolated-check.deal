          let event: string = s.text(slot.event); let action: string = s.text(slot.action);
          if (event !== "" && action !== "" && !s.contains(seenDrivers,event+"_"+s.text(slot.trigger))) { return "ADMISSION_OWNERSHIP: triggered operation without its issued driver: "+action; }
        }
