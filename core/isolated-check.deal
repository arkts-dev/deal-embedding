      for (let identity of [s.text(value.sample),s.text(value.tick),s.text(value.start),s.text(value.pause),s.text(value.reset),s.text(value.restore),s.text(value.request),s.text(value.running),s.text(value.epoch),s.text(value.trust)]) { if (!s.contains(issuedIdentities,identity)) { issuedIdentities[issuedIdentities.length] = identity; } }
