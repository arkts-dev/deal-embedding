      for (let field of [s.text(value.request),s.text(value.running)]) { if (!s.contains(declared,field)) { return "ADMISSION_OWNERSHIP: clock driver field outside the compiled declarations: "+field; } }
      // A composition may carry more than one clock owner: a plan clock part and a catalogue timer
