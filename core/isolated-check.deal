      seenDrivers[seenDrivers.length] = driver;
      let matched: boolean = false;
      if (Object.hasOwn(composition,"slots")) { for (let slot of decoded.records(composition.slots)) {
        if (Object.hasOwn(slot,"event") && Object.hasOwn(slot,"trigger")) { if (s.text(slot.event) !== "" && s.text(slot.event)+"_"+s.text(slot.trigger) === driver) { matched = true; } }
      } }
      if (!matched) { return "ADMISSION_OWNERSHIP: trigger driver names no issued event slot: "+driver; }
    }
