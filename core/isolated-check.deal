import * as host from "embedding/checker";
import * as decoded from "./decoded";
import * as s from "./construction-schema";
import * as graphics from "./graphics";
import * as json from "std/json";
import * as strings from "std/string";

export class Result { accepted: boolean; candidateId: string; diagnostics: string; }
function tree(report: Record<string, unknown>): Record<string, unknown> { return json.parse(report.tree as string); }
function surfaces(node: Record<string, unknown>, result: Record<string, unknown>[]): null {
  if (strings.endsWith(node.component as string,".Surface") || (node.component as string) === "Surface") { result[result.length] = node; }
  for (let child of decoded.records(node.children)) { surfaces(child,result); } return null;
}
function prop(node: Record<string, unknown>, name: string): Record<string, unknown> | null { for (let value of decoded.records(node.props)) { if ((value.name as string) === name) { return value; } } return null; }
function numeric(node: Record<string, unknown>, name: string): number { let value = prop(node,name); if (value === null) { s.reject("Missing Surface "+name); } return s.finite((value as Record<string, unknown>).numberValue); }
function slot(node: Record<string, unknown>, name: string): number { let value = prop(node,name); if (value === null) { return -1; } return s.integral((value as Record<string, unknown>).actionSlot); }
function picture(node: Record<string, unknown>): string { let value = prop(node,"shapes"); if (value === null) { s.reject("Missing Surface shapes"); } let text: string = (value as Record<string, unknown>).stringValue as string; let wrapped: Record<string, unknown> = json.parse("{\"shapes\":"+text+"}"); graphics.surface(numeric(node,"width"),numeric(node,"height"),decoded.records(wrapped.shapes)); return text; }
function validate(report: Record<string, unknown>): string {
  if (!(report.ok as boolean)) { return report.diagnostics as string; }
  if ((report.providerCalls as number) !== 0) { return "CHECK_PROVIDER: provider access during checking"; }
  let pictures: Record<string, unknown>[] = []; surfaces(tree(report),pictures); for (let node of pictures) { picture(node); } return "";
}
function sameNode(left: Record<string, unknown>, right: Record<string, unknown>): boolean { return left.structural === right.structural && left.keyKind === right.keyKind && left.keyString === right.keyString && left.keyNumber === right.keyNumber; }
async function event(id: string, report: Record<string, unknown>, target: Record<string, unknown>, name: string, payload: unknown): Promise<Record<string, unknown>> {
  let pictures: Record<string, unknown>[] = []; surfaces(tree(report),pictures);
  let action: number = -1; for (let node of pictures) { if (sameNode(node,target)) { action = slot(node,name); } } if (action < 0) { return report; }
  return await host.step(id,"event",action,s.encode(payload));
}
function buttonSlots(node: Record<string, unknown>, result: number[]): null {
  let name: string = node.component as string;
  if (strings.endsWith(name,".Button") || strings.endsWith(name,".PrimaryAction") || strings.endsWith(name,".SecondaryAction")) { let action: number = slot(node,"onClick"); if (action >= 0) { result[result.length] = action; } }
  for (let child of decoded.records(node.children)) { buttonSlots(child,result); } return null;
}
async function execute(id: string): Promise<Result> {
  try {
    let report: Record<string, unknown> = await host.step(id,"start",0,"null"); let diagnostic: string = validate(report);
    if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; }
    let count: number = s.integral(report.handlers); let index: number = 0;
    while (index < count) { let repeat: number = 0; while (repeat < 2) {
      report = await host.step(id,"handler",index,"null"); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; } repeat = repeat+1;
    } index = index+1; }
    let pictures: Record<string, unknown>[] = []; surfaces(tree(report),pictures);
    for (let target of pictures) {
      let initial: string = picture(target); let width: number = numeric(target,"width"); let height: number = numeric(target,"height");
      let xs: number[] = [width/2,width/2,width*0.9,width/2]; let ys: number[] = [height/2,height*0.85,height/2,height/2];
      index = 0; while (index < 4) {
        report = await event(id,report,target,"onPointer",{phase:"down",id:0,x:xs[index],y:ys[index]}); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; }
        if (index === 1 || index === 3) { report = await event(id,report,target,"onPointer",{phase:"move",id:0,x:width*0.75,y:ys[index]}); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; } }
        report = await event(id,report,target,"onPointer",{phase:"up",id:0,x:xs[index],y:ys[index]}); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; } index = index+1;
      }
      report = await event(id,report,target,"onFrame",0); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; }
      let baseline: Record<string, unknown>[] = []; surfaces(tree(report),baseline); for (let node of baseline) { if (sameNode(node,target)) { initial = picture(node); } }
      index = 0; let changed: boolean = false;
      while (index < 240) { report = await event(id,report,target,"onFrame",16); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; } let now: Record<string, unknown>[] = []; surfaces(tree(report),now); for (let node of now) { if (sameNode(node,target) && picture(node) !== initial) { changed = true; } } index = index+1; }
      // Embedded scenes may require an explicit start button. Re-enumerate current
      // buttons after every commit; stale row captures are never replayed.
      if (!changed) {
        let buttons: number[] = []; buttonSlots(tree(report),buttons); let button: number = 0;
        while (button < buttons.length && button < 6 && !changed) {
          report = await host.step(id,"event",buttons[button],"1"); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; }
          let started: Record<string, unknown>[] = []; surfaces(tree(report),started); for (let node of started) { if (sameNode(node,target)) { initial = picture(node); } }
          index = 0; while (index < 120 && !changed) { report = await event(id,report,target,"onFrame",16); diagnostic = validate(report); if (diagnostic !== "") { return {accepted:false,candidateId:"",diagnostics:diagnostic}; } let now: Record<string, unknown>[] = []; surfaces(tree(report),now); for (let node of now) { if (sameNode(node,target) && picture(node) !== initial) { changed = true; } } index = index+1; }
          button = button+1; buttons = []; buttonSlots(tree(report),buttons);
        }
      }
      let final: Record<string, unknown>[] = []; surfaces(tree(report),final);
      let present: boolean = false; let blank: boolean = false;
      for (let node of final) { if (sameNode(node,target)) { present = true; let value = prop(node,"shapes") as Record<string, unknown>; let decodedValue: Record<string, unknown> = json.parse("{\"shapes\":"+(value.stringValue as string)+"}"); blank = decoded.records(decodedValue.shapes).length === 0; } }
      if (!present || blank || slot(target,"onFrame") >= 0 && !changed) { return {accepted:false,candidateId:"",diagnostics:"CHECK_SURFACE: missing, blank or unchanged frame scene"}; }
    }
    return {accepted:true,candidateId:id,diagnostics:""};
  } catch (unknownError) {
    let error: Error = unknownError as Error;
    if (!s.contains(["CONSTRUCTION_SCHEMA","E8001","E8010"],error.code)) { throw error; }
    return {accepted:false,candidateId:"",diagnostics:"CHECK_TREE: "+error.message};
  }
}
// Suppressed preparation validates fresh initialization/restoration, not synthetic
// interactions. It never promotes its isolate or executes an effect/driver.
export async function prepare(id: string): Promise<Result> {
  let report: Record<string, unknown> = await host.step(id,"start",0,"null");
  let diagnostic: string = validate(report);
  await host.finish(id);
  return {accepted:diagnostic === "",candidateId:id,diagnostics:diagnostic};
}
function admission(manifest: Record<string, unknown>): string {
  let providers: string[] = decoded.strings(manifest.providers);
  for (let module of decoded.strings(manifest.imports)) {
    if (!s.contains(["std/json","std/math","std/string","std/table","std/time","embedding/graphics"],module) && !s.contains(providers,module)) { return "ADMISSION_IMPORT: unissued module"; }
  }
  for (let digest of decoded.strings(manifest.packDigests)) { if (digest !== (manifest.issuedPackDigest as string)) { return "ADMISSION_PACK: compiler pack digest mismatch"; } }
  for (let version of decoded.strings(manifest.packVersions)) { if (version !== (manifest.issuedPackVersion as string)) { return "ADMISSION_PACK: compiler pack version mismatch"; } }
  return "";
}
export async function run(deal: string, dealui: string): Promise<Result> {
  let compiled: Record<string, unknown> = await host.compile(deal,dealui);
  if (!(compiled.accepted as boolean)) { return {accepted:false,candidateId:"",diagnostics:compiled.diagnostics as string}; }
  let id: string = compiled.candidateId as string;
  let diagnostic: string = admission(compiled.manifest as Record<string, unknown>);
  if (diagnostic !== "") { await host.discard(id); return {accepted:false,candidateId:"",diagnostics:diagnostic}; }
  // The host reclaims all outstanding isolates/staging on operational failure.
  let result: Result = await execute(id);
  if (!result.accepted) { await host.discard(id); } else { await host.finish(id); }
  return result;
}
