    if (!s.contains(["catalogue","part","custom","notice"],origin)) { return "ADMISSION_OWNERSHIP: unknown instance origin: "+id+" "+origin; }
    let implemented: string[] = []; if (Object.hasOwn(value,"kinds")) { implemented = decoded.strings(value.kinds); }
