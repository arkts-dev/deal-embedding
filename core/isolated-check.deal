    instanceIds[instanceIds.length] = id; instanceKinds[instanceKinds.length] = kind; instanceOrigins[instanceOrigins.length] = origin; instanceKindsList[instanceKindsList.length] = implemented; instanceWrites[instanceWrites.length] = written;
  }
