      if (s.contains(issuedEpochs,epochField) !== s.contains(issuedTrusts,trustField)) { return "ADMISSION_OWNERSHIP: clock drivers mix Session epoch and trust identities: "+need; }
      if (!s.contains(issuedEpochs,epochField)) { issuedEpochs[issuedEpochs.length] = epochField; issuedTrusts[issuedTrusts.length] = trustField; }
      if (!s.contains(declared,epochField) || !s.contains(declared,trustField)) { return "ADMISSION_OWNERSHIP: clock driver epoch field outside the compiled declarations: "+need; }
