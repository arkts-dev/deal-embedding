    else if (operator === "===" || operator === "!==") { if (left.type !== right.type) { s.reject("Equality formula operands"); } type = "boolean"; }
    else { if (left.type !== "number" || right.type !== "number") { s.reject("Numeric formula operands"); } if (precedence === 4) { type = "boolean"; } }
    let result: Expression = {source:"("+left.source+" "+operator+" "+right.source+")",type:type,dependencies:[]};
