      else if (operator === "===") { result.boolean = a === b; } else if (operator === "!==") { result.boolean = a !== b; } else if (operator === "<") { result.boolean = a < b; } else if (operator === "<=") { result.boolean = a <= b; } else if (operator === ">") { result.boolean = a > b; } else if (operator === ">=") { result.boolean = a >= b; }
    }
