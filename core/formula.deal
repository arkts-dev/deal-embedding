    if (Object.hasOwn(args[0],"number")) { let n: number = args[0].number as number; if (token === "floor") { result.number = math.floor(n); } else if (token === "ceil") { result.number = math.ceil(n); } else if (token === "sqrt") { result.number = math.sqrt(n); } else { result.number = math.absNumber(n); } }
