// Dynamic Record fields can contain typed framework arrays or untyped JSON arrays.
// Array invariance forbids casting an existing T[] to unknown[]: preserve an
// already-compatible array, otherwise check elements into a fresh typed array.
// Fixed envelopes decode through contextual JSON.parse instead.
export function records(value: unknown): Record<string, unknown>[] {
    try { return value as Record<string, unknown>[]; } catch (error) { }
    return Array.from(value as unknown[], (item: unknown): Record<string, unknown> => item as Record<string, unknown>);
}
export function strings(value: unknown): string[] {
    try { return value as string[]; } catch (error) { }
    return Array.from(value as unknown[], (item: unknown): string => item as string);
}
export function numbers(value: unknown): number[] {
    try { return value as number[]; } catch (error) { }
    return Array.from(value as unknown[], (item: unknown): number => item as number);
}
export function booleans(value: unknown): boolean[] {
    try { return value as boolean[]; } catch (error) { }
    return Array.from(value as unknown[], (item: unknown): boolean => item as boolean);
}
