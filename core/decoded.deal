// Readonly views admit every valid array without retagging its storage. Array.from
// checks each element and creates a fresh invariant result; sparse arrays still reject.
function refuse(message: string): never { throw {name:"CONSTRUCTION_SCHEMA",message:message}; }
function elements(value: unknown): readonly unknown[] {
    try { return value as readonly unknown[]; } catch (error) { refuse("Expected array"); }
}
export function records(value: unknown): Record<string, unknown>[] {
    const source: readonly unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): Record<string, unknown> => {
        if (typeof item === "object" && item !== null) { try { return item as Record<string, unknown>; } catch (error) { } }
        refuse("Expected record at index "+String(index));
    });
}
export function strings(value: unknown): string[] {
    const source: readonly unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): string => {
        if (typeof item === "string") { return item; }
        refuse("Expected text at index "+String(index));
    });
}
export function numbers(value: unknown): number[] {
    const source: readonly unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): number => {
        if (typeof item === "number") { if (Number.isFinite(item)) { return item; } }
        refuse("Expected finite number at index "+String(index));
    });
}
export function booleans(value: unknown): boolean[] {
    const source: readonly unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): boolean => {
        if (typeof item === "boolean") { return item; }
        refuse("Expected boolean at index "+String(index));
    });
}
