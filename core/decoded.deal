// Checked typed collections. A dynamic value is accepted only when it is an array whose
// every element matches the element schema; the result is a fresh invariant T[].
// A cast fallback never coerces, skips, retags or truncates an element. Array invariance
// forbids casting an existing T[] to unknown[], so an already compatible array copies
// directly and every other value is element-checked.
function refuse(message: string): void { throw {name:"CONSTRUCTION_SCHEMA",message:message}; }
function elements(value: unknown): unknown[] { try { return value as unknown[]; } catch (error) { } refuse("Expected array"); return []; }
export function records(value: unknown): Record<string, unknown>[] {
    try { return Array.from(value as Record<string, unknown>[], (item: Record<string, unknown>): Record<string, unknown> => item); } catch (error) { }
    let source: unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): Record<string, unknown> => {
        if (typeof item === "object" && item !== null) { try { return item as Record<string, unknown>; } catch (error) { } }
        refuse("Expected record at index "+String(index)); return {};
    });
}
export function strings(value: unknown): string[] {
    try { return Array.from(value as string[], (item: string): string => item); } catch (error) { }
    let source: unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): string => {
        if (typeof item === "string") { return item; }
        refuse("Expected text at index "+String(index)); return "";
    });
}
export function numbers(value: unknown): number[] {
    let typed: number[] | null = null;
    try { typed = value as number[]; } catch (error) { typed = null; }
    if (typed !== null) {
        let copy: number[] = Array.from(typed, (item: number): number => item);
        let index: number = 0;
        while (index < copy.length) { if (!Number.isFinite(copy[index])) { refuse("Expected finite number at index "+String(index)); } index = index+1; }
        return copy;
    }
    let source: unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): number => {
        if (typeof item === "number") { if (Number.isFinite(item)) { return item; } }
        refuse("Expected finite number at index "+String(index)); return 0;
    });
}
export function booleans(value: unknown): boolean[] {
    try { return Array.from(value as boolean[], (item: boolean): boolean => item); } catch (error) { }
    let source: unknown[] = elements(value);
    return Array.from(source, (item: unknown, index: number): boolean => {
        if (typeof item === "boolean") { return item; }
        refuse("Expected boolean at index "+String(index)); return false;
    });
}
