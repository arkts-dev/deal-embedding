import * as tables from "std/table";
import * as strings from "std/string";
import * as math from "std/math";
import * as decoded from "./decoded";

export function reject(message: string): void { throw {name:"CONSTRUCTION_SCHEMA",message:message}; }
export function closed(value: Record<string, unknown>, required: string[], optional: string[]): void {
  for (let key of required) { if (!Object.hasOwn(value,key)) { reject("Missing field: "+key); } }
  for (let key of tables.keys(value)) { if (!contains(required,key) && !contains(optional,key)) { reject("Unknown field: "+key); } }
}
export function contains(values: string[], value: string): boolean { return values.includes(value); }
export function finite(value: unknown): number { let n: number = value as number; if (n-n !== 0) { reject("Expected finite number"); } return n; }
export function integral(value: unknown): number { let n: number = finite(value); if (math.floor(n) !== n) { reject("Expected integral number"); } return n; }
export function text(value: unknown): string { return value as string; }
export function nonblank(value: unknown): string { let result: string = value as string; if (strings.trim(result) === "") { reject("Expected nonblank text"); } return result; }
export function identifier(value: unknown): string {
  let name: string = value as string; let index: number = 0;
  for (let ch of name) {
    let alphabet: string = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    if (index > 0) { alphabet = alphabet+"0123456789_"; }
    if (!strings.contains(alphabet,ch)) { reject("Invalid identifier: "+name); }
    index = index+1;
  }
  if (index < 1 || index > 64) { reject("Identifier length"); }
  return name;
}
export function unique(ids: string[], value: string): void { if (contains(ids,value)) { reject("Duplicate identity: "+value); } ids[ids.length] = value; }
export function oneOf(value: unknown, allowed: string[]): string { let name: string = value as string; if (!contains(allowed,name)) { reject("Unknown alternative: "+name); } return name; }
export function records(owner: Record<string, unknown>, name: string): Record<string, unknown>[] { if (!Object.hasOwn(owner,name)) { return []; } return decoded.records(owner[name]); }
export function stringArray(value: unknown): string[] { return decoded.strings(value); }
export function optionalText(owner: Record<string, unknown>, name: string): string { if (!Object.hasOwn(owner,name)) { return ""; } return owner[name] as string; }
export function optionalBoolean(owner: Record<string, unknown>, name: string, fallback: boolean): boolean { if (!Object.hasOwn(owner,name)) { return fallback; } return owner[name] as boolean; }
export function encode(value: unknown): string { return JSON.stringify(value) as string; }
export function main(): void { return; }
