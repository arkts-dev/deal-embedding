import * as decoded from "./decoded";
import * as s from "./construction-schema";
function require(condition: boolean, message: string): void { if (!condition) { s.reject(message); } }
function numeric(value: unknown): number { return s.finite(value); }
function nonnegative(value: unknown): number { const n = numeric(value); require(n >= 0,"Negative graphics size"); return n; }
function fields(tag: string): string[] {
  if (tag === "rect") { return ["x","y","width","height"]; }
  if (tag === "roundRect") { return ["x","y","width","height","radius"]; }
  if (tag === "circle") { return ["x","y","radius"]; }
  if (tag === "arc") { return ["x","y","radius","startDegrees","sweepDegrees","lineWidth"]; }
  if (tag === "line") { return ["x1","y1","x2","y2","lineWidth"]; }
  if (tag === "polyline") { return ["points","lineWidth"]; }
  if (tag === "polygon") { return ["points"]; }
  if (tag === "path") { return ["commands"]; }
  if (tag === "strokePath") { return ["commands","lineWidth"]; }
  if (tag === "text") { return ["x","y","size","align","text","bold"]; }
  if (tag === "group") { return ["x","y","rotation","scale","alpha","shapes"]; }
  return s.reject("Unknown graphics shape");
}
function color(value: unknown): void {
  const text = value as string;
  require((text.length === 7 || text.length === 9) && text.startsWith("#"),"Graphics color");
  let i = 1;
  while (i < text.length) { require("0123456789abcdefABCDEF".includes(text.substring(i,i+1)),"Graphics color digit"); i++; }
}
// Parse an absolute SVG command stream, not a renderer-specific permissive path dialect.
export function path(text: string): void {
  const length = text.length; let i = 0; let command = ""; let count = 0; let arity = 0; let first = true;
  while (i < length) {
    const c = text.substring(i,i+1);
    if (c === " " || c === "," || c === "\n" || c === "\t") { i++; continue; }
    if ("MLCQAZ".includes(c)) {
      require(command === "" || count >= arity && (arity === 0 || count % arity === 0),"Incomplete graphics path command");
      require(!first || c === "M","Graphics path starts with M"); first = false; command = c; count = 0; arity = 2;
      if (c === "C") { arity = 6; } if (c === "Q") { arity = 4; } if (c === "A") { arity = 7; } if (c === "Z") { arity = 0; }
      i++; continue;
    }
    require(command !== "" && arity > 0,"Graphics path command");
    const start = i; if (c === "-" || c === "+") { i++; }
    let digits = 0;
    while (i < length && "0123456789".includes(text.substring(i,i+1))) { i++; digits++; }
    if (i < length && text.substring(i,i+1) === ".") { i++; while (i < length && "0123456789".includes(text.substring(i,i+1))) { i++; digits++; } }
    require(digits > 0,"Graphics path number");
    if (i < length && (text.substring(i,i+1) === "e" || text.substring(i,i+1) === "E")) {
      i++; if (i < length && (text.substring(i,i+1) === "+" || text.substring(i,i+1) === "-")) { i++; }
      const exponent = i; while (i < length && "0123456789".includes(text.substring(i,i+1))) { i++; } require(i > exponent,"Graphics path exponent");
    }
    // Grammar checked above; Number handles SVG signs, leading zeros and dots.
    const value = numeric(Number(text.substring(start,i)));
    if (command === "A") { const position = count % 7; if (position < 2) { nonnegative(value); } if (position === 3 || position === 4) { require(value === 0 || value === 1,"Graphics arc flag"); } }
    count++;
  }
  require(!first && (arity === 0 || count >= arity && count % arity === 0),"Incomplete graphics path");
}
function shapes(values: Record<string, unknown>[], depth: number): number {
  require(depth <= 12,"Graphics depth"); let total = 0;
  for (let value of values) {
    total++; require(total <= 4000,"Graphics shape count");
    const tag = value.tag as string; const required = fields(tag); let allowed: string[] = ["tag"];
    for (let name of required) { allowed.push(name); require(Object.hasOwn(value,name),"Missing graphics field "+name); }
    if (tag !== "group") { allowed.push("color"); color(value.color); }
    s.closed(value,allowed,[]);
    for (let name of required) {
      if (name === "shapes") { total += shapes(decoded.records(value.shapes),depth+1); }
      else if (name === "points") { const points = decoded.numbers(value.points); require(points.length <= 2000 && points.length % 2 === 0,"Graphics paired point bound"); for (let point of points) { numeric(point); } }
      else if (name === "commands") { path(value.commands as string); }
      else if (name === "align") { require(s.contains(["left","center","right"],value.align as string),"Graphics text alignment"); }
      else if (name === "text") { const text = value.text as string; }
      else if (name === "bold") { const bold = value.bold as boolean; }
      else if (s.contains(["width","height","radius","lineWidth","size","scale"],name)) { nonnegative(value[name]); }
      else { const n = numeric(value[name]); if (name === "alpha") { require(n >= 0 && n <= 1,"Graphics opacity"); } }
    }
    require(total <= 4000,"Graphics shape count");
  }
  return total;
}
export function surface(width: number, height: number, values: Record<string, unknown>[]): number { nonnegative(width); nonnegative(height); return shapes(values,0); }
export function pointer(value: Record<string, unknown>): void { s.closed(value,["phase","id","x","y"],[]); require(s.contains(["down","move","up","cancel"],value.phase as string),"Pointer phase"); const id = nonnegative(value.id); require(id === Math.floor(id),"Pointer identity"); numeric(value.x); numeric(value.y); }
