import * as decoded from "./decoded";
import * as s from "./construction-schema";
import * as strings from "std/string";
import * as math from "std/math";
import * as json from "std/json";
function require(condition: boolean, message: string): void { if (!condition) { s.reject(message); } }
function numberText(text: string): number { let normalized: string = text; if (strings.startsWith(normalized,"+")) { normalized = strings.substring(normalized,1,strings.length(normalized)); } if (strings.startsWith(normalized,".")) { normalized = "0"+normalized; } if (strings.startsWith(normalized,"-.")) { normalized = "-0"+strings.substring(normalized,1,strings.length(normalized)); } if (strings.endsWith(normalized,".")) { normalized = normalized+"0"; } let parsed: Record<string, unknown> = json.parse("{\"n\":"+normalized+"}"); return s.finite(parsed.n); }

function numeric(value: unknown): number { return s.finite(value); }
function nonnegative(value: unknown): number { let n: number = numeric(value); require(n >= 0,"Negative graphics size"); return n; }
function fields(tag: string): string[] {
  if (tag === "rect") { return ["x","y","width","height"]; }
  if (tag === "roundRect") { return ["x","y","width","height","radius"]; }
  if (tag === "circle") { return ["x","y","radius"]; }
  if (tag === "arc") { return ["x","y","radius","startDegrees","sweepDegrees","lineWidth"]; }
  if (tag === "line") { return ["x1","y1","x2","y2","lineWidth"]; }
  if (tag === "polyline") { return ["points","lineWidth"]; }
  if (tag === "polygon") { return ["points"]; }
  if (tag === "path") { return ["commands"]; }
  if (tag === "strokePath") { return ["commands","lineWidth"]; }
  if (tag === "text") { return ["x","y","size","align","text","bold"]; }
  if (tag === "group") { return ["x","y","rotation","scale","alpha","shapes"]; }
  s.reject("Unknown graphics shape"); return [];
}
function color(value: unknown): null {
  let text: string = value as string; let length: number = strings.length(text); require((length === 7 || length === 9) && strings.substring(text,0,1) === "#","Graphics color");
  let i: number = 1; while (i < length) { require(strings.contains("0123456789abcdefABCDEF",strings.substring(text,i,i+1)),"Graphics color digit"); i = i+1; } return null;
}
// Parse an absolute SVG command stream, not a renderer-specific permissive path dialect.
export function path(text: string): null {
  let length: number = strings.length(text); let i: number = 0; let command: string = ""; let count: number = 0; let arity: number = 0; let first: boolean = true;
  while (i < length) {
    let c: string = strings.substring(text,i,i+1);
    if (c === " " || c === "," || c === "\n" || c === "\t") { i = i+1; continue; }
    if (strings.contains("MLCQAZ",c)) {
      require(command === "" || count >= arity && (arity === 0 || count / arity === math.floor(count / arity)),"Incomplete graphics path command");
      require(!first || c === "M","Graphics path starts with M"); first = false; command = c; count = 0; arity = 2;
      if (c === "C") { arity = 6; } if (c === "Q") { arity = 4; } if (c === "A") { arity = 7; } if (c === "Z") { arity = 0; }
      i = i+1; continue;
    }
    require(command !== "" && arity > 0,"Graphics path command");
    let start: number = i; if (c === "-" || c === "+") { i = i+1; }
    let digits: number = 0;
    while (i < length && strings.contains("0123456789",strings.substring(text,i,i+1))) { i = i+1; digits = digits+1; }
    if (i < length && strings.substring(text,i,i+1) === ".") { i = i+1; while (i < length && strings.contains("0123456789",strings.substring(text,i,i+1))) { i = i+1; digits = digits+1; } }
    require(digits > 0,"Graphics path number");
    if (i < length && (strings.substring(text,i,i+1) === "e" || strings.substring(text,i,i+1) === "E")) {
      i = i+1; if (i < length && (strings.substring(text,i,i+1) === "+" || strings.substring(text,i,i+1) === "-")) { i = i+1; }
      let exponent: number = i; while (i < length && strings.contains("0123456789",strings.substring(text,i,i+1))) { i = i+1; } require(i > exponent,"Graphics path exponent");
    }
    let value: number = numberText(strings.substring(text,start,i)); numeric(value);
    if (command === "A") { let position: number = count - math.floor(count/7)*7; if (position < 2) { nonnegative(value); } if (position === 3 || position === 4) { require(value === 0 || value === 1,"Graphics arc flag"); } }
    count = count+1;
  }
  require(!first && (arity === 0 || count >= arity && count/arity === math.floor(count/arity)),"Incomplete graphics path"); return null;
}
function shapes(values: Record<string, unknown>[], depth: number): number {
  require(depth <= 12,"Graphics depth"); let total: number = 0;
  for (let value of values) {
    total = total+1; require(total <= 4000,"Graphics shape count");
    let tag: string = value.tag as string; let required: string[] = fields(tag); let allowed: string[] = ["tag"];
    for (let name of required) { allowed[allowed.length] = name; require(Object.hasOwn(value,name),"Missing graphics field "+name); }
    if (tag !== "group") { allowed[allowed.length] = "color"; color(value.color); }
    s.closed(value,allowed,[]);
    for (let name of required) {
      if (name === "shapes") { total = total+shapes(decoded.records(value.shapes),depth+1); }
      else if (name === "points") { let points: number[] = decoded.numbers(value.points); require(points.length <= 2000 && points.length/2 === math.floor(points.length/2),"Graphics paired point bound"); for (let point of points) { numeric(point); } }
      else if (name === "commands") { path(value.commands as string); }
      else if (name === "align") { require(s.contains(["left","center","right"],value.align as string),"Graphics text alignment"); }
      else if (name === "text") { let text: string = value.text as string; }
      else if (name === "bold") { let bold: boolean = value.bold as boolean; }
      else if (s.contains(["width","height","radius","lineWidth","size","scale"],name)) { nonnegative(value[name]); }
      else { let n: number = numeric(value[name]); if (name === "alpha") { require(n >= 0 && n <= 1,"Graphics opacity"); } }
    }
    require(total <= 4000,"Graphics shape count");
  }
  return total;
}
export function surface(width: number, height: number, values: Record<string, unknown>[]): number { nonnegative(width); nonnegative(height); return shapes(values,0); }
export function pointer(value: Record<string, unknown>): null { s.closed(value,["phase","id","x","y"],[]); require(s.contains(["down","move","up","cancel"],value.phase as string),"Pointer phase"); let id: number = nonnegative(value.id); require(id === math.floor(id),"Pointer identity"); numeric(value.x); numeric(value.y); return null; }
