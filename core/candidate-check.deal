import * as data from "embedding/policy-data";
import * as tables from "std/table";
import * as json from "std/json";
import * as checker from "embedding/checker";
import * as observer from "embedding/observer";

function invalid(message: string): Record<string, unknown> {
    return { accepted: false, candidateId: "", diagnostics: (json.stringify({ diagnostics: [{ stage: "envelope", code: "INVALID_CANDIDATE", message: message }] }) as string) };
}
// Envelope/repair policy belongs here. Host compiler failures other than candidate
// rejection propagate: resource, transport and implementation defects are not repairable source.
export async function check(raw: string): Promise<Record<string, unknown>> {
    let envelope: Record<string, unknown> = {};
    try { envelope = await data.parse(raw); }
    catch (errorUnknown) { let error: Error = errorUnknown as Error;
        if (error.code !== "INVALID_JSON") { throw error; }
        await observer.record("check", "rejected", "INVALID_ENVELOPE");
        return invalid("Envelope is not a JSON object");
    }
    let deal: string = ""; let ui: string = "";
    try {
        let keys: string[] = tables.keys(envelope);
        if (keys.length !== 2) { throw { code: "INVALID_ENVELOPE", message: "Envelope must contain exactly deal and dealui" }; }
        deal = (envelope.deal as string); ui = (envelope.dealui as string);
        if (deal === "" || ui === "") { throw { code: "INVALID_ENVELOPE", message: "Both source files must be nonempty" }; }
    } catch (errorUnknown) { let error: Error = errorUnknown as Error;
        await observer.record("check", "rejected", "INVALID_ENVELOPE");
        return invalid("Envelope must contain exactly deal and dealui strings");
    }
    return await checker.check(deal, ui);
}
export async function probe(pair: Record<string, unknown>): Promise<Record<string, unknown>> {
    let deal: string = pair.deal as string; let ui: string = pair.dealui as string;
    if (deal === "" || ui === "") { return invalid("Provisional source pair must be nonempty"); }
    return await checker.probe(deal,ui);
}
export function main(): null { return null; }
