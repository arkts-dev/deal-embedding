import * as strings from "std/string";
import * as needs from "./needs";
import * as json from "std/json";

// Lexical containment, not semantic admission. The ordinary compiler still checks
// each complete pair. A repair cannot close its issued body or swallow its boundary.
function contained(body: string): boolean {
    let carriage: string = json.parse("{\"value\":\"\\r\"}").value as string;
    let mode: string = "code"; let quote: string = ""; let escaped: boolean = false; let depth: number = 0; let i: number = 0;
    while (i < strings.length(body)) {
        let ch: string = strings.substring(body,i,i+1); let next: string = strings.substring(body,i+1,i+2);
        if (mode === "string") {
            if (escaped) { escaped = false; }
            else if (ch === "\\") { escaped = true; }
            else if (ch === quote) { mode = "code"; }
            else if (ch === "\n" || ch === carriage) { return false; }
        } else if (mode === "line") { if (ch === "\n" || ch === carriage) { mode = "code"; } }
        else if (mode === "block") { if (ch === "*" && next === "/") { mode = "code"; i = i+1; } }
        else if (ch === "\"" || ch === "'") { mode = "string"; quote = ch; }
        else if (ch === "/" && next === "/") { mode = "line"; i = i+1; }
        else if (ch === "/" && next === "*") { mode = "block"; i = i+1; }
        else if (ch === "{") { depth = depth+1; }
        else if (ch === "}") { depth = depth-1; if (depth < 0) { return false; } }
        else if (ch === "`") { return false; }
        i = i+1;
    }
    return depth === 0 && (mode === "code" || mode === "line");
}
// Return null for malformed/reserved boundaries, including text inserted to spoof
// another section. Compare all nonbody bytes against the original canonical pair.
export function skeleton(source: string): string | null {
    let result: string = ""; let remaining: string = source;
    let begin: string = "// DEAL-SECTION-BEGIN "; let close: string = "// DEAL-SECTION-END "; let seen: string[] = [];
    while (strings.contains(remaining,begin)) {
        let pieces: string[] = strings.split(remaining,begin); let prefix: string = pieces[0];
        if (strings.contains(prefix,close)) { return null; }
        result = result+prefix+begin;
        let tail: string = strings.substring(remaining,strings.length(prefix)+strings.length(begin),strings.length(remaining));
        let lines: string[] = strings.split(tail,"\n"); let id: string = lines[0]; let end: string = close+id+"\n";
        if (!needs.identifier(id) || needs.contains(seen,id) || !strings.contains(tail,end)) { return null; }
        seen[seen.length] = id;
        let ends: string[] = strings.split(tail,end); let content: string = ends[0];
        if (strings.contains(content,begin) || strings.contains(content,close)) { return null; }
        let body: string = strings.substring(content,strings.length(id)+1,strings.length(content));
        if (!contained(body)) { return null; }
        result = result+id+"\n"+end;
        remaining = strings.substring(tail,strings.length(content)+strings.length(end),strings.length(tail));
    }
    if (strings.contains(remaining,close)) { return null; }
    return result+remaining;
}
export function preserves(deal: string, ui: string, proposedDeal: string, proposedUi: string): boolean {
    let baseline: string | null = skeleton(deal); let proposed: string | null = skeleton(proposedDeal);
    return ui === proposedUi && baseline !== null && proposed !== null && baseline === proposed;
}
export function main(): null { return null; }
