import * as s from "./construction-schema";
import * as data from "embedding/policy-data";
import * as identity from "embedding/construction-identity";

export class Source { deal: string; dealui: string; }
export class Revision { revision: string; digest: string; source: Source; }
export class Edit { file: string; search: string; replace: string; start: number; end: number; }
export class Applied { accepted: boolean; current: Revision; diagnostics: string; }
class WireEdit { file:string; search:string; replace:string; }
class EditRequest { revision:string; digest:string; edits:WireEdit[]; }
export async function issue(source: Source): Promise<Revision> {
  let encoded: string = s.encode({deal:source.deal,dealui:source.dealui});
  return {revision:await identity.issue(),digest:await data.sha256(encoded),source:{deal:source.deal,dealui:source.dealui}};
}
function match(source: string, search: string): number {
  if (search.length === 0) { s.reject("Empty edit search"); }
  const found = source.indexOf(search);
  if (found < 0) { s.reject("Missing edit search"); }
  if (source.indexOf(search,found+1) >= 0) { s.reject("Ambiguous edit search"); }
  return found;
}
function edited(source: string, file: string, edits: Edit[]): string {
  let result: string = ""; let offset: number = 0; let left: number = 0;
  for (let edit of edits) { if (edit.file === file) { left = left+1; } }
  while (left > 0) {
    let next: Edit | null = null;
    for (let edit of edits) { if (edit.file === file && edit.start >= offset) { if (next === null) { next = edit; } else if (edit.start < (next as Edit).start) { next = edit; } } }
    // Defense in depth: a validated disjoint set always applies completely, so a skipped span
    // becomes a rejection instead of a silently truncated pair.
    if (next === null) { s.reject("Incomplete source edit"); }
    let selected: Edit = next as Edit;
    result = result+source.substring(offset,selected.start)+selected.replace; offset = selected.end; left = left-1;
  }
  return result+source.substring(offset);
}
export async function apply(current: Revision, response: string): Promise<Applied> {
  let next: Source | null = null;
  try {
    const raw: EditRequest = JSON.parse(response);
    if (raw.revision !== current.revision || raw.digest !== current.digest) { s.reject("Unissued source revision or digest"); }
    if (raw.edits.length === 0) { s.reject("Empty source edit set"); }
    let edits: Edit[] = [];
    for (let value of raw.edits) {
      let file: string = s.oneOf(value.file,["deal","dealui"]); const search = value.search;
      let source: string = current.source.deal; if (file === "dealui") { source = current.source.dealui; }
      let start: number = match(source,search); let edit: Edit = {file:file,search:search,replace:s.text(value.replace),start:start,end:start+search.length};
      for (let prior of edits) { if (prior.file === edit.file && edit.start < prior.end && prior.start < edit.end) { s.reject("Overlapping source edits"); } }
      edits[edits.length] = edit;
    }
    next = {deal:edited(current.source.deal,"deal",edits),dealui:edited(current.source.dealui,"dealui",edits)};
  } catch (unknownError) {
    let error: Error = unknownError as Error;
    if (error.name !== "CONSTRUCTION_SCHEMA" && error.name !== "E8001" && error.name !== "E8007") { throw error; }
    return {accepted:false,current:current,diagnostics:error.message};
  }
  // Identity/hash failures are operational; they never authorize another model edit.
  return {accepted:true,current:await issue(next as Source),diagnostics:""};
}
export function main(): void { return; }
