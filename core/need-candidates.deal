export class Candidate { id: string; need: string; fragment: Record<string, unknown>; dependencies: string[]; dimension: string; }
export class Issued { candidates: Candidate[]; gaps: string[]; }
export function contract(contracts: Record<string, unknown>[], module: string, name: string): Record<string, unknown> {
    for (let value of contracts) { let owner: string = value.module as string; if (owner === module) { for (let fn of decoded.records(value.functions)) { let id: string = fn.name as string; if (id === name) { return fn; } } } }
    n.fail("Undisclosed capability"); return {};
}
export function port(needs: n.Needs, owner: string, path: string): e.Value { let contracts: Record<string, unknown>[] = []; let need: n.Need = n.need(needs,owner); if (need.kind === "read") { n.fail("Custom read projections must be maintained results first"); } return output(needs,contracts,owner,path); }
export function output(needs: n.Needs, contracts: Record<string, unknown>[], owner: string, path: string): e.Value {
    let need: n.Need = n.need(needs,owner); let config: Record<string, unknown> = need.config;
    let parts: string[] = strings.split(path,"."); let port: string = parts[0]; let type: Record<string, unknown> = e.wire("number"); let dimension: string = "unknown";
    if (need.kind === "input") { if (port !== "value") { n.fail("Input port"); } let format: string = config.format as string; if (format === "text") { type = e.wire("string"); } if (format === "boolean") { type = e.wire("boolean"); } let fact: n.Term = n.term(needs,config.value as string); dimension = fact.dimension; }
    else if (need.kind === "read") { if (port !== "result") { n.fail("Read port"); } let fn: Record<string, unknown> = contract(contracts,config.module as string,config.function as string); type = fn.result as Record<string, unknown>; }
    else if (need.kind === "result") { if (port !== "value") { n.fail("Result port"); } let format: string = config.format as string; if (format === "text") { type = e.wire("string"); } }
    else if (need.kind === "comparison") { if (port !== "difference") { n.fail("Comparison port"); } }
    else if (need.kind === "choice") { if (path !== "selected.cost" && path !== "selected.id" && path !== "selected.label" && path !== "selected.eligible") { n.fail("Choice port"); } if (path === "selected.id" || path === "selected.label") { type = e.wire("string"); } if (path === "selected.eligible") { type = e.wire("boolean"); } return {expr:owner+"."+path,type:type,dimension:dimension,dependencies:[owner]}; }
    else if (need.kind === "allocation") {
        if (port === "total") { type = e.wire("number"); }
        else if (port === "valid" || port === "present") { type = e.wire("boolean"); }
        else if (port === "rows") { type = arrayType([{name:"id",type:e.wire("string"),optional:false},{name:"name",type:e.wire("string"),optional:false},{name:"cost",type:e.wire("number"),optional:false},{name:"quantity",type:e.wire("number"),optional:false}]); }
        else { n.fail("Allocation port"); }
    }
    else if (need.kind === "quotes") {
        if (port !== "results") { n.fail("Quotes port"); }
        type = arrayType([{name:"key",type:e.wire("string"),optional:false},{name:"label",type:e.wire("string"),optional:false},{name:"cost",type:e.wire("number"),optional:false},{name:"deposit",type:e.wire("number"),optional:false},{name:"available",type:e.wire("boolean"),optional:false},{name:"expiresAt",type:e.wire("number"),optional:false}]);
    }
    else if (need.kind === "alternatives") {
        if (port !== "baskets") { n.fail("Alternatives port"); }
        let components: Record<string, unknown> = arrayType([{name:"id",type:e.wire("string"),optional:false},{name:"quantity",type:e.wire("number"),optional:false}]);
        let items: Record<string, unknown> = arrayType([{name:"id",type:e.wire("string"),optional:false},{name:"label",type:e.wire("string"),optional:false},{name:"capacity",type:e.wire("number"),optional:false},{name:"quantity",type:e.wire("number"),optional:false},{name:"components",type:components,optional:false}]);
        type = arrayType([{name:"items",type:items,optional:false},{name:"key",type:e.wire("string"),optional:false},{name:"label",type:e.wire("string"),optional:false}]);
    }
    else if (need.kind === "section") { let found: boolean = false; for (let entry of decoded.records(config.exports)) { let name: string = entry.name as string; if (name === port) { type = e.wire(entry.type as string); found = true; } } if (!found) { n.fail("Undeclared section export"); } }
    else if (need.kind === "custom") { if (port !== "value") { n.fail("Custom port"); } type = e.wire(config.result as string); }
    else { n.fail("No declared need port"); }
    let tail: string = ""; let i: number = 1; while (i < parts.length) { if (tail !== "") { tail = tail+"."; } tail = tail+parts[i]; i = i+1; }
    return {expr:owner+"."+path,type:e.member(type,tail),dimension:dimension,dependencies:[owner]};
}
function arrayType(fields: Record<string, unknown>[]): Record<string, unknown> { let empty: Record<string, unknown>[] = []; let row: Record<string, unknown> = {kind:"record",fields:fields,element:null}; return {kind:"array",fields:empty,element:row}; }
function environment(needs: n.Needs, need: n.Need, contracts: Record<string, unknown>[]): e.Environment {
    return {port:function(owner: string, path: string): e.Value { return output(needs,contracts,owner,path); },field:function(owner: string, path: string): e.Value {
        if (path === "" || (owner !== "row" && owner !== "reply" && owner !== "item")) { n.fail("Field scope"); }
        let type: Record<string, unknown> = {};
        if (owner === "reply" && need.kind === "quotes") { let fn: Record<string, unknown> = contract(contracts,need.config.module as string,need.config.function as string); type = fn.result as Record<string, unknown>; }
        else {
            let key: string = "source"; if (owner === "item") { key = "componentSource"; }
            let source: string = need.config[key] as string; let sourceEnv: e.Environment = environmentWithoutRows(needs,contracts); if (owner === "item") { sourceEnv = environment(needs,need,contracts); }
            let value: e.Value = e.expression(needs,source,sourceEnv,[]); let kind: string = value.type.kind as string;
            if (kind !== "array") { n.fail("Row source type"); } type = value.type.element as Record<string, unknown>;
        }
        let local: string = owner; if (owner === "item") { local = "row"; }
        return {expr:local+"."+path,type:e.member(type,path),dimension:"unknown",dependencies:[]};
    }};
}
function environmentWithoutRows(needs: n.Needs, contracts: Record<string, unknown>[]): e.Environment {
    return {port:function(owner: string, path: string): e.Value { return output(needs,contracts,owner,path); },field:function(owner: string, path: string): e.Value { n.fail("Row outside scope"); return {expr:"",type:e.wire("null"),dimension:"unknown",dependencies:[]}; }};
}
export function editable(needs: n.Needs, id: string, visiting: string[]): null {
    if (n.contains(visiting,id)) { n.fail("Cyclic relation"); }
    let term: n.Term = n.term(needs,id);
    if (term.op === "literal") { for (let need of needs.needs) { if (need.kind === "input" && (need.config.value as string) === id) { n.fail("Editable assumption "+need.id+": reference its port value instead of initial literal "+id); } } }
    let next: string[] = []; for (let prior of visiting) { next[next.length] = prior; } next[next.length] = id;
    for (let child of term.args) { editable(needs,child,next); } return null;
}
function formula(needs: n.Needs, id: string, env: e.Environment, expected: string, deps: string[]): Record<string, unknown> {
    editable(needs,id,[]);
    let value: e.Value = e.expression(needs,id,env,[]); let kind: string = value.type.kind as string; if (expected !== "" && kind !== expected) { n.fail("Need relation type: expected "+expected); }
    for (let dependency of value.dependencies) { if (!n.contains(deps,dependency)) { deps[deps.length] = dependency; } }
    return {expr:value.expr};
}
function build(needs: n.Needs, need: n.Need, contracts: Record<string, unknown>[]): Candidate {
    let c: Record<string, unknown> = need.config; let out: Record<string, unknown> = {}; let deps: string[] = []; let dimension: string = "unknown"; let env: e.Environment = environment(needs,need,contracts);
    if (need.kind === "input") {
        n.closed(c,["value","format","minimum","maximum"]); let term: n.Term = n.term(needs,c.value as string); if (term.op !== "literal") { n.fail("Input must be evidenced fact"); }
        dimension = term.dimension; out = {label:need.label,format:c.format,value:term.value,minimum:c.minimum,maximum:c.maximum}; validation.input(out);
    } else if (need.kind === "read") {
        n.closed(c,["module","function","arguments"]); let fn: Record<string, unknown> = contract(contracts,c.module as string,c.function as string); let parameters: Record<string, unknown>[] = decoded.records(fn.parameters); let args: string[] = decoded.strings(c.arguments); if (args.length !== parameters.length) { n.fail("Capability arity"); }
        let values: Record<string, unknown>[] = []; let index: number = 0;
        for (let arg of args) { let value: e.Value = e.expression(needs,arg,env,[]); if (!e.same(value.type,parameters[index].type as Record<string, unknown>)) { n.fail("Capability argument type"); } values[values.length] = formula(needs,arg,env,"",deps); index = index+1; }
        out = {binding:{module:c.module,function:c.function},arguments:values};
    } else if (need.kind === "result") {
        n.closed(c,["value","format"]); let format: string = c.format as string; let kind: string = "number"; if (format === "text") { kind = "string"; } let value: Record<string, unknown> = formula(needs,c.value as string,env,kind,deps); out = {label:need.label,format:format,value:value};
    } else if (need.kind === "comparison") {
        n.closed(c,["limit","actual"]); let left: e.Value = e.expression(needs,c.limit as string,env,[]); let right: e.Value = e.expression(needs,c.actual as string,env,[]);
        if (left.dimension !== "unknown" && right.dimension !== "unknown" && left.dimension !== right.dimension) { n.fail("Comparison units"); }
        out = {label:need.label,limit:formula(needs,c.limit as string,env,"number",deps),actual:formula(needs,c.actual as string,env,"number",deps)};
    } else if (need.kind === "choice" || need.kind === "allocation") {
        let keys: string[] = ["source","identity","label","eligible","cost"];
        if (need.kind === "allocation") { keys = ["source","identity","label","eligible","cost","total","budget","surcharge","quotas"]; }
        n.closed(c,keys);
        out = {source:formula(needs,c.source as string,env,"array",deps),identity:formula(needs,c.identity as string,env,"string",deps),label:formula(needs,c.label as string,env,"string",deps),eligible:formula(needs,c.eligible as string,env,"boolean",deps),cost:formula(needs,c.cost as string,env,"number",deps)};
        if (need.kind === "allocation") {
            out.total = formula(needs,c.total as string,env,"number",deps); out.budget = formula(needs,c.budget as string,env,"number",deps); out.surcharge = formula(needs,c.surcharge as string,env,"number",deps);
            let quotas: Record<string, unknown>[] = []; for (let quota of decoded.records(c.quotas)) { n.closed(quota,["label","minimum","predicate"]); quotas[quotas.length] = {label:quota.label,minimum:formula(needs,quota.minimum as string,env,"number",deps),predicate:formula(needs,quota.predicate as string,env,"boolean",deps)}; } out.quotas = quotas;
        }
    } else if (need.kind === "alternatives") {
        n.closed(c,["source","identity","label","stock","componentSource","componentIdentity","componentQuantity","roles"]);
        out = {source:formula(needs,c.source as string,env,"array",deps),identity:formula(needs,c.identity as string,env,"string",deps),label:formula(needs,c.label as string,env,"string",deps),stock:formula(needs,c.stock as string,env,"number",deps),components:{source:formula(needs,c.componentSource as string,env,"array",deps),identity:formula(needs,c.componentIdentity as string,env,"string",deps),quantity:formula(needs,c.componentQuantity as string,env,"number",deps)}};
        let roles: Record<string, unknown>[] = []; for (let role of decoded.records(c.roles)) { n.closed(role,["label","quantity","predicate"]); roles[roles.length] = {label:role.label,quantity:formula(needs,role.quantity as string,env,"number",deps),predicate:formula(needs,role.predicate as string,env,"boolean",deps)}; } out.roles = roles;
    } else if (need.kind === "quotes") {
        n.closed(c,["source","module","function","arguments","cost","deposit","available","ttlMillis","budget"]);
        let fn: Record<string, unknown> = contract(contracts,c.module as string,c.function as string); let parameters: Record<string, unknown>[] = decoded.records(fn.parameters); let argumentsData: Record<string, unknown>[] = decoded.records(c.arguments); if (argumentsData.length !== parameters.length) { n.fail("Quote arity"); }
        let args: Record<string, unknown>[] = [];
        for (let argument of argumentsData) { let kind: string = argument.kind as string; if (kind === "value") { n.closed(argument,["kind","value"]); args[args.length] = {kind:kind,value:formula(needs,argument.value as string,env,"",deps)}; } else { n.closed(argument,["kind","encoding","idField","quantityField"]); args[args.length] = argument; } }
        out = {source:formula(needs,c.source as string,env,"array",deps),binding:{module:c.module,function:c.function},arguments:args,cost:formula(needs,c.cost as string,env,"number",deps),deposit:formula(needs,c.deposit as string,env,"number",deps),available:formula(needs,c.available as string,env,"boolean",deps),ttlMillis:formula(needs,c.ttlMillis as string,env,"number",deps),budget:formula(needs,c.budget as string,env,"number",deps)};
    } else { n.fail("Uncovered need "+need.id); }
    let fragment: Record<string, unknown> = {id:need.id,kind:need.kind,config:out};
    let commands: Record<string, unknown>[] = []; let display: string[] = [];
    // Check the authoritative maintained shape before freezing candidates. Numeric
