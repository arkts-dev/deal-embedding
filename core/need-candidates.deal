}
export function enumerate(needs: n.Needs, contracts: Record<string, unknown>[]): Issued {
    let candidates: Candidate[] = []; let gaps: string[] = [];
    for (let need of needs.needs) {
        try {
            let candidate: Candidate = build(needs,need,contracts); candidates[candidates.length] = candidate;
            if (need.kind === "comparison") {
                let config: Record<string, unknown> = candidate.fragment.config as Record<string, unknown>;
                let imports: Record<string, unknown>[] = [{name:"limit",type:"number",value:config.limit},{name:"actual",type:"number",value:config.actual}];
                let fragments: Record<string, unknown>[] = [{id:"comparison",kind:"comparison",config:{label:need.label,limit:{expr:"limit.value"},actual:{expr:"actual.value"}}},{id:"difference",kind:"result",config:{label:need.label+" difference",format:"number",value:{expr:"comparison.difference"}}}];
                let commands: Record<string, unknown>[] = []; let capabilities: Record<string, unknown>[] = [];
                candidates[candidates.length] = {id:need.id+"_detailed",need:need.id,fragment:{id:need.id,kind:"section",config:{imports:imports,exports:[{name:"difference",type:"number",value:{expr:"comparison.difference"}}],capabilities:capabilities,plan:{title:need.label,fragments:fragments,commands:commands,display:["comparison","difference"]}}},dependencies:candidate.dependencies,dimension:candidate.dimension};
            }
        }
        catch (errorUnknown) { let error: Error = errorUnknown as Error; if (error.code !== "NEEDS_INVALID" && error.code !== "INVALID_CONFIG" && error.code !== "E8001") { throw error; } gaps[gaps.length] = need.id+": "+error.message; }
    }
    return {candidates:candidates,gaps:gaps};
}
export function main(): null { return null; }
