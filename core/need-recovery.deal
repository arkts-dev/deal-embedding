import * as n from "./needs";
import * as c from "./need-candidates";
import * as decoded from "./decoded";
import * as formula from "./composition/formula";
import * as shapes from "./composition/validation.generated";
import * as strings from "std/string";
import * as tables from "std/table";

// Request-local accounting uses issued need identities, never model-provided aliases.
export class Budget { ids: string[]; used: number[]; }
export function budget(ids: string[]): Budget {
    let unique: string[] = []; let used: number[] = [];
    for (let id of ids) { if (n.contains(unique,id)) { n.fail("Duplicate recovery identity"); } unique[unique.length] = id; used[used.length] = 0; }
    return {ids:unique,used:used};
}
function index(value: Budget, id: string): number {
    let i: number = 0; for (let key of value.ids) { if (key === id) { return i; } i = i+1; }
    n.fail("Unissued recovery identity"); return -1;
}
export function count(value: Budget, id: string): number { return value.used[index(value,id)]; }
export function remaining(value: Budget, ids: string[]): string[] {
    let result: string[] = []; for (let id of ids) { if (count(value,id) < 3) { result[result.length] = id; } } return result;
}
export function charge(value: Budget, ids: string[]): boolean {
    if (ids.length === 0) { n.fail("Empty recovery dispatch"); }
    let seen: string[] = []; let thinking: boolean = false;
    // Preflight the complete group before changing accounting.
    for (let id of ids) {
        if (n.contains(seen,id) || count(value,id) >= 3) { n.fail("Duplicate/exhausted recovery dispatch"); }
        seen[seen.length] = id; thinking = thinking || count(value,id) === 2;
    }
    for (let id of ids) { let i: number = index(value,id); value.used[i] = value.used[i]+1; }
    return thinking;
}
// Losing one need removes only its transitive dependents, never unrelated selections.
export function retain(selected: c.Candidate[]): c.Candidate[] {
    let result: c.Candidate[] = []; for (let candidate of selected) { result[result.length] = candidate; }
    let changed: boolean = true;
    while (changed) {
        changed = false; let next: c.Candidate[] = [];
        for (let candidate of result) {
            let ready: boolean = true;
            for (let dependency of candidate.dependencies) {
                let found: boolean = false; for (let other of result) { found = found || other.need === dependency; } ready = ready && found;
            }
            if (ready) { next[next.length] = candidate; } else { changed = true; }
        }
        result = next;
    }
    return result;
}
export function visible(plan: Record<string, unknown>): boolean {
    if (!Object.hasOwn(plan,"fragments")) { return false; }
    if (Object.hasOwn(plan,"commands") && decoded.records(plan.commands).length > 0) { return true; }
    for (let fragment of decoded.records(plan.fragments)) {
        let kind: string = fragment.kind as string;
        if (kind !== "read" && kind !== "alternatives" && kind !== "notice") { return true; }
    }
    return false;
}
// Only ordinary source/plan rejection is gate evidence. Operational failures propagate.
export function authorize(plan: Record<string, unknown>, assembled: boolean, checked: boolean): null {
    if (visible(plan)) {
        if (assembled && checked) { throw {code:"FALLBACK_FORBIDDEN",message:"Retain the checked runnable composition; a local gap cannot authorize whole-source generation"}; }
        // A failed complete subset is not proof that every smaller subset fails.
        throw {code:"RECOVERY_UNRESOLVED",message:"Visible task components remain; repair/isolate them before considering whole-source generation"};
    }
    return null;
}
function dependencies(fragment: Record<string, unknown>): string[] {
    let result: string[] = []; let expressions: string[] = shapes.fragmentFormulas(fragment);
    let kind: string = fragment.kind as string;
    if (kind === "section") { expressions = []; let config: Record<string, unknown> = fragment.config as Record<string, unknown>; for (let entry of decoded.records(config.imports)) { let value: Record<string, unknown> = entry.value as Record<string, unknown>; expressions[expressions.length] = value.expr as string; } }
    for (let source of expressions) { for (let path of formula.references(formula.parse(source))) { let parts: string[] = strings.split(path,"."); if (!n.contains(["row","reply","item"],parts[0]) && !n.contains(result,parts[0])) { result[result.length] = parts[0]; } } }
    return result;
}
function include(id: string, fragments: Record<string, unknown>[], ids: string[], active: string[]): boolean {
    if (n.contains(ids,id)) { return true; } if (n.contains(active,id)) { return false; }
    let next: string[] = []; for (let prior of active) { next[next.length] = prior; } next[next.length] = id;
    for (let fragment of fragments) { let owner: string = fragment.id as string; if (owner === id) {
        let required: string[] = [];
        try { required = dependencies(fragment); }
        catch (errorUnknown) { let error: Error = errorUnknown as Error; if (error.code !== "INVALID_CONFIG" && error.code !== "INVALID_FORMULA" && error.code !== "E8001") { throw error; } return false; }
        for (let dependency of required) { if (!include(dependency,fragments,ids,next)) { return false; } }
        ids[ids.length] = id; return true;
    } } return false;
}
export function subset(plan: Record<string, unknown>, ids: string[]): Record<string, unknown> {
    let fragments: Record<string, unknown>[] = []; let commands: Record<string, unknown>[] = []; let display: string[] = [];
    for (let fragment of decoded.records(plan.fragments)) { let id: string = fragment.id as string; if (n.contains(ids,id)) { fragments[fragments.length] = fragment; } }
    for (let command of decoded.records(plan.commands)) { let targets: string[] = []; for (let id of decoded.strings(command.targets)) { if (n.contains(ids,id)) { targets[targets.length] = id; } } if (targets.length > 0) { commands[commands.length] = {id:command.id,label:command.label,targets:targets}; } }
    for (let id of decoded.strings(plan.display)) { if (n.contains(ids,id)) { display[display.length] = id; } }
    let result: Record<string, unknown> = {title:plan.title,fragments:fragments,commands:commands,display:display};
    if (Object.hasOwn(plan,"custom")) { let custom: Record<string, unknown>[] = []; for (let section of decoded.records(plan.custom)) { let id: string = section.id as string; if (n.contains(ids,id)) { custom[custom.length] = section; } } if (custom.length > 0) { result.custom = custom; result.reason = plan.reason; } }
    if (Object.hasOwn(plan,"notices")) { result.notices = plan.notices; }
    return result;
}
// Each minimal task closure is tested by actual assembly/compiler mechanisms. A failing
// complete set alone never establishes absence; missing/cyclic prerequisites prune it.
export function subsets(plan: Record<string, unknown>): Record<string, unknown>[] {
    let result: Record<string, unknown>[] = []; let fragments: Record<string, unknown>[] = decoded.records(plan.fragments);
    for (let fragment of fragments) { let ids: string[] = []; let id: string = fragment.id as string;
        if (include(id,fragments,ids,[])) { let candidate: Record<string, unknown> = subset(plan,ids); if (visible(candidate)) { result[result.length] = candidate; } }
    }
    return result;
}
export function main(): null { return null; }
