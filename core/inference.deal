import * as host from "embedding/inference";
import * as s from "./construction-schema";
export class Operation { id: string; used: number; cap: number; }
export function operation(id: string, cap: number): Operation { if (cap < 1) { s.reject("Invalid inference cap"); } return {id:id,used:0,cap:cap}; }
export async function ask(operation: Operation, stage: string, input: string, previous: string, diagnostics: string, tokens: number, thinking: boolean): Promise<host.Response> {
  return await dispatch(operation,stage,input,previous,diagnostics,tokens,thinking,"");
}
export async function choose(operation: Operation, stage: string, input: string, previous: string, diagnostics: string, tokens: number, questions: string): Promise<host.Response> {
  return await dispatch(operation,stage,input,previous,diagnostics,tokens,false,questions);
}
async function dispatch(operation: Operation, stage: string, input: string, previous: string, diagnostics: string, tokens: number, thinking: boolean, questions: string): Promise<host.Response> {
  if (operation.used >= operation.cap) { throw {name:"ASK_LIMIT",message:"Inference operation exhausted: "+operation.id}; }
  operation.used = operation.used+1;
  // Charge before dispatch, including operational failures. No adapter retries.
  return await host.dispatch({operation:operation.id,stage:stage,ask:operation.used,input:input,previous:previous,diagnostics:diagnostics,maxTokens:tokens,thinking:thinking,questions:questions});
}
export function main(): void { return; }
