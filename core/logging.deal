import * as json from "std/json";
import * as strings from "std/string";

// Canonical logging policy. Only trusted adapters submit events; application source cannot.
export class LogEvent {
    trace: string = ""; span: string = ""; parent: string = "";
    stage: string = ""; outcome: string = ""; code: string = "";
    candidate: string = ""; workspace: string = ""; operation: string = "";
    target: string = ""; durationMs: int = 0; version: int = -1;
    sequence: int = 0; time: string = ""; elapsed: string = "";
    capture: boolean = false; artifact: string = ""; bytes: int = 0;
}
function bounded(value: string, maximum: int): string {
    let cleaned: string = strings.replace(strings.replace(value, "\n", " "), "\r", " ");
    return strings.substring(cleaned, 0, maximum);
}
export function normalize(event: LogEvent): string {
    let stage: string = event.stage;
    let stages: string[] = ["request", "discovery", "grant", "session", "contract", "choice", "source", "policy", "lower", "check", "compiler-ui", "compiler-deal", "candidate", "route", "mount", "action", "capability", "effect-delivery", "snapshot", "storage", "host", "transport", "model-provider", "logger"];
    let known: boolean = false;
    for (let allowed: string of stages) { if (stage === allowed) { known = true; } }
    if (!known) { stage = "logger"; }
    let outcome: string = bounded(event.outcome, 32);
    let duration: int = event.durationMs;
    if (duration < 0) { duration = 0; }
    let content: string = "omitted";
    if (event.artifact !== "" && event.capture) { content = "captured"; }
    return json.stringify({ schema: 1, sequence: event.sequence, time: event.time, elapsed: event.elapsed,
        trace: bounded(event.trace, 80), span: bounded(event.span, 80), parent: bounded(event.parent, 80),
        stage: stage, outcome: outcome, code: bounded(event.code, 80),
        candidate: bounded(event.candidate, 80), workspace: bounded(event.workspace, 80), operation: bounded(event.operation, 80),
        target: bounded(event.target, 160), durationMs: duration, version: event.version,
        artifact: bounded(event.artifact, 80), content: content, bytes: event.bytes,
        summary: stage + " · " + outcome + " " + bounded(event.target, 160),
        contentLimit: 262144, artifactStoreLimit: 4194304, eventStoreLimit: 524288, queueLimit: 256 });
}
export function main(): null { return null; }
