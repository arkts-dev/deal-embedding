import * as app from "./experience";
import * as ui from "./platform.dealui-pack";
// @ui-root
export view Example(state: app.State): View {
    ui.Column() {
        ui.Text(value: state.message)
        ui.IntText(value: state.value)
        ui.Button(text: "Read value", enabled: !state.loading, accessibilityLabel: "Read value", onClick: action app.Load {})
        When(state.loading) { ui.Progress(label: "Reading") }
    }
}
