import * as decoded from "./decoded";
import * as policy from "./discovery-policy";
import * as guidance from "./discovery-guidance";

// String entry ABI is private to the framework's trusted-policy adapter.
export function prompt(captureJson: string): string {
    const capture: policy.Capture = JSON.parse(captureJson);
    return guidance.prompt(capture);
}
export function validate(reply: string, captureJson: string): string {
    const capture: policy.Capture = JSON.parse(captureJson);
    try {
        let result: policy.Suggestion | null = policy.validate(reply,capture);
        if (result !== null) {
            return JSON.stringify({accepted:true,suggestion:result}) as string;
        }
        return (JSON.stringify({accepted:true,suggestion:null}) as string);
    } catch (errorUnknown) { let error: Error = errorUnknown as Error;
        if (error.name !== "INVALID_REPLY" && error.name !== "E8001" && error.name !== "E8007") { throw error; }
        return (JSON.stringify({accepted:false,code:"INVALID_REPLY",message:error.message}) as string);
    }
}
export function intent(): string { return policy.intent(); }
export function handoff(suggestionJson: string, captureJson: string): string {
    const suggestion: policy.Suggestion = JSON.parse(suggestionJson);
    const capture: policy.Capture = JSON.parse(captureJson);
    const plan: policy.Handoff = policy.handoff(suggestion,capture);
    return JSON.stringify(plan) as string;
}
export function admit(captured: string, current: string, catalogue: string, freshCatalogue: string, issued: string): string {
    policy.admit(captured,current,catalogue,freshCatalogue,issued === "true");
    return "";
}
export function main(): void { return; }
