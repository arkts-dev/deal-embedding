    view = view+"ui.Text(text: "+literals.quote(s.text(clockNeed.spec.label))+") When(state."+shown+"_ready) {ui.NumberText(value: state."+shown+"_display, suffix: \" ms\")} When(!state."+shown+"_ready) {ui.Text(text: state."+shown+"_reason, style: \"muted\")}";
