  issueTextLiteral(instance,registry,"request",disclosed.request);
  for (let fact of disclosure.context(disclosed.facts)) { if (s.identifierText(fact.id)) { issueTextLiteral(instance,registry,fact.id,fact.text); } }
  // The emitted definition is reissued from the fragment carrying the new data fields, so assembly
  // compares the placed fragment with the declarations that were actually issued.
