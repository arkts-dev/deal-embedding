    let reading: string = "let at: number = clockPrepared(state."+sample+", state."+pending+"); let retreated: boolean = clockRetreated(state."+sample+", state."+pending+"); let rawWall: number = action.wall; let wall: number = clockWallValue(state."+wall+", action.wall);";
