}
// A literal's wire schema is the value it actually emits, not the whole declared-type domain: a fixed
// value outside a frozen parameter's bounds can never satisfy the call, so the Bind stage keeps that
// need open instead of issuing an operation the provider boundary must reject.
function issueNumberLiteral(instance: screens.Instance, registry: bindings.Registry, id: string, value: number): void {
  let fields: embedding.WireField[] = [];
  let schema: embedding.WireType = {kind:"number",fields:fields,element:null,maximum:0,minimumNumber:value,maximumNumber:value};
  issueLiteral(instance,registry,id,"number",s.encode(value),schema);
}
function issueTextLiteral(instance: screens.Instance, registry: bindings.Registry, id: string, text: string): void {
  let fields: embedding.WireField[] = [];
  let schema: embedding.WireType = {kind:"string",fields:fields,element:null,maximum:text.length,minimumNumber:0,maximumNumber:0};
  issueLiteral(instance,registry,id,"string",s.encode(text),schema);
