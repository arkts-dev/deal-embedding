    fields[fields.length] = {name:elapsed,type:"number",role:"authoritative",dependencies:[],initial:"0",owner:"parts"};
    fields[fields.length] = {name:running,type:"boolean",role:"authoritative",dependencies:[],initial:"false",owner:"parts"};
    fields[fields.length] = {name:completed,type:"boolean",role:"authoritative",dependencies:[],initial:"false",owner:"parts"};
