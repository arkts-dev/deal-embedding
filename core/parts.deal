    fields[fields.length] = {name:pending,type:"number",role:"runtime",dependencies:[],initial:"-1",owner:"parts"};
    fields[fields.length] = {name:wall,type:"number",role:"runtime",dependencies:[],initial:"-1",owner:"parts"};
