    if (field.role === "derived" && (field.name+"_ready" === id || field.name+"_reason" === id || field.name+"_display" === id)) { return; }
  }
  instance.fragment.fields[instance.fragment.fields.length] = {name:id,type:type,role:"authoritative",dependencies:[],initial:initial,owner:"parts"};
  bindings.reserve(registry,{id:id,type:type,schema:schema,dependencies:[],owner:"parts",payloadOwner:"",getter:"f_parts_"+id,ready:"true"});
}
// The parts implementation is placed when it fills a need and also when an issued operation reads one
// of its sources, so an emitted operation never names a resource the composition lacks.
export function places(built: Built, registry: bindings.Registry): boolean {
  if (built.instance.fragment.covers.length > 0) { return true; }
  for (let binding of registry.bindings) { for (let key of tables.keys(binding.arguments)) { if (bindings.source(registry,binding.arguments[key] as string).owner === "parts") { return true; } } }
  return false;
}
export function define(plan: plans.Plan): Definitions { return defineWithProviders(plan,[]); }
// Record the first located reason per need: the figure fixpoint retries an unbuilt figure on every
// pass, so a readmitted reason would repeat in the result.
function problem(definitions: Definitions, need: string, reason: string): void {
  for (let issued of definitions.unavailable) { if (issued.need === need) { return; } }
  definitions.unavailable[definitions.unavailable.length] = {need:need,reason:reason};
}
// The example must supply a value for every operand its formula uses, so an operand missing from the
// example is located as the example's own gap instead of the unissued-operand text of the formula pass.
function exampleExpression(source: string, operands: formula.Operand[]): formula.Expression {
  try { return formula.compile(source,operands); }
  catch (unknownError) {
    let error: Error = unknownError as Error;
    let prefix: string = "Unissued formula operand: ";
    if (error.name === "CONSTRUCTION_SCHEMA" && error.message.startsWith(prefix)) { s.reject("example supplies no value for operand "+error.message.substring(prefix.length)); }
    throw error;
