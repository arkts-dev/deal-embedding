    let sourceReady: string = "true"; if (valueType === "number" && input.kind !== "choice") { sourceReady = "f_parts_"+input.id+"_ready"; }
    bindings.reserve(registry,{id:input.id,type:valueType,schema:inputWire(input),dependencies:[],owner:"parts",payloadOwner:"",getter:"f_parts_"+input.id,ready:sourceReady});
