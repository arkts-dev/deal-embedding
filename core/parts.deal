    helpers = helpers+"export function tick_"+id+"(state: AppState, action: Tick_"+id+"): AppState { "+reading+" if (!state."+running+") { return {"+request+": state."+request+"}; } "+step+" let epoch: number = retreated ? state.clockEpoch+1 : "+epochNext+"; return {"+elapsed+": advanced, "+running+": "+runningNext+", "+completed+": "+finished+", "+triggered+": "+counted+", "+anchor+": clockAnchor(true, state."+completed+", state."+anchor+", at), clockEpoch: epoch, clockTrust: retreated ? false : "+trustNext+", "+notice+": retreated ? \"Clock reading retreated; elapsed follows admitted monotone progress\" : "+noticeNext+", "+sample+": at, "+pending+": at, "+wall+": wall}; }";
