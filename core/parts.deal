function issueLiteral(instance: screens.Instance, registry: bindings.Registry, id: string, type: string, initial: string, schema: embedding.WireType): void {
  // An issued data source is emitted as an authoritative field of this owner. An id that cannot be a
  // field name here is already a composer resource of this owner, so nothing is issued for it: the
  // Bind stage reports any binding that names it with `Unissued argument source` and keeps that need
  // open, instead of the whole request being rejected over a name no emitted field can carry.
  for (let field of instance.fragment.fields) {
