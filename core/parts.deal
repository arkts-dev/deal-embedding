// carries the field's own readiness, so a figure over an unavailable total is unready with its reason
// instead of receiving a placeholder. The operand names the entries need it belongs to, which is the
// need identifier such a figure declares in its reads.
function entryAggregates(plan: plans.Plan): formula.Operand[] {
  let result: formula.Operand[] = [];
  for (let need of plan.needs) {
    if (need.type !== "entries") { continue; }
    result[result.length] = {id:"count_"+need.id,expression:"(state.count_"+need.id+" as number)",type:"number",dependency:"f_parts_count_"+need.id,aggregate:need.id};
    result[result.length] = {id:"total_"+need.id,expression:"(state.total_"+need.id+" as number)",type:"number",dependency:"f_parts_total_"+need.id,aggregate:need.id};
  }
  return result;
}
// The issued source an emitted dependency belongs to: an entry aggregate is attributed to the entries
// need it reads, so the need declares that need identifier in its reads; every other dependency names
// its own resource.
function readSource(dependency: string, operands: formula.Operand[]): string {
  for (let operand of operands) { if (operand.dependency === dependency && Object.hasOwn(operand,"aggregate")) { return operand.aggregate as string; } }
  return dependency.substring(8,dependency.length);
}
// The aggregate alternatives of one figure's compatible set, so the enumeration counts and orders the
// issued entry aggregates it can reference.
function aggregateIds(operands: formula.Operand[]): string[] {
  let result: string[] = [];
  for (let operand of operands) { if (Object.hasOwn(operand,"aggregate")) { result[result.length] = operand.id; } }
  return result;
}
// Plan constants, the frozen request and every disclosed fact DEAL can name are issued sources
