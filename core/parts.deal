    let unitsText: string = "Independently check the ORIGINAL REQUEST AND FACTS against this exact numeric expression and rendered unit: "+figure.expression.source+"; label="+figure.label+"; unit="+figure.unit+". Trace every input, constant and provider result through the arithmetic. Currency alone does not specify scale: cents/minor units are not major units. Accept only if both arithmetic scale and displayed unit preserve the original quantities; a numerically correct example does not prove this.";
    if (figure.valueType === "boolean") {
      formulaText = "Does this exact typed comparison preserve the original requested condition, its operands and dependencies? "+figure.expression.source;
      unitsText = "Independently check the ORIGINAL REQUEST AND FACTS against this exact boolean comparison: "+figure.expression.source+"; label="+figure.label+". The stored and published value stays boolean and displays Yes or No. Accept only if the compared operands, the boundary of the condition and the user-facing spelling preserve the original request; a matching example does not prove this.";
