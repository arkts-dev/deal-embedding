    // written formula the figure is not built and its need stays open with the located reason.
    if (overCap && written === "") { problem(result,figure.need,"compatible formula set is over the issued bound and no written formula was accepted"); continue; }
    if (written === "") { result.figures[result.figures.length] = figure; continue; }
