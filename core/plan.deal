import * as json from "std/json";
import * as tables from "std/table";
import * as math from "std/math";
import * as s from "./construction-schema";

export class Requirement { id: string; text: string; sources: string[]; needs: string[]; }
export class Need { id: string; type: string; words: string; quote: string; reads: string[]; required: boolean; spec: Record<string, unknown>; }
export class Input { id: string; label: string; kind: string; measure: string; unit: string; value: unknown; min?: number; max?: number; options: Record<string, unknown>[]; setting: boolean; }
export class Constant { id: string; label: string; measure: string; unit: string; value: number; }
export class HumanQuestion { id: string; text: string; options: Record<string, unknown>[]; default: string; }
export class Plan { title: string; eyebrow: string; subtitle: string; inputs: Input[]; constants: Constant[]; requirements: Requirement[]; needs: Need[]; questions: HumanQuestion[]; }
function measure(value: unknown): string { return s.oneOf(value,["money","percent","count","seconds","minutes","number"]); }
function numericKind(kind: string, value: unknown): number {
  let number: number = s.finite(value);
  if (kind === "count" || kind === "choice" || kind === "time" || kind === "date") { number = s.integral(value); }
  if (kind === "time" && (number < 0 || number > 1439)) { s.reject("Minute-of-day outside domain"); }
  return number;
}
function input(raw: Record<string, unknown>): Input {
  s.closed(raw,["id","label","kind","measure","value"],["unit","min","max","options","setting"]);
  let kind: string = s.oneOf(raw.kind,["amount","percent","count","choice","toggle","text","time","date"]);
  let result: Input = {id:s.identifier(raw.id),label:s.nonblank(raw.label),kind:kind,measure:measure(raw.measure),unit:s.optionalText(raw,"unit"),value:raw.value,options:s.records(raw,"options"),setting:s.optionalBoolean(raw,"setting",false)};
  if (kind === "text") { let text: string = raw.value as string; }
  else if (kind === "toggle") { let checked: boolean = raw.value as boolean; }
  else { let value: number = numericKind(kind,raw.value);
    if (Object.hasOwn(raw,"min")) { result.min = s.finite(raw.min); if (value < (result.min as number)) { s.reject("Input below minimum"); } }
    if (Object.hasOwn(raw,"max")) { result.max = s.finite(raw.max); if (value > (result.max as number)) { s.reject("Input above maximum"); } }
    if (Object.hasOwn(raw,"min") && Object.hasOwn(raw,"max")) { if ((result.min as number) > (result.max as number)) { s.reject("Reversed input bounds"); } }
    if (kind === "count") { if (Object.hasOwn(raw,"min")) { s.integral(raw.min); } if (Object.hasOwn(raw,"max")) { s.integral(raw.max); } }
  }
  let ids: string[] = [];
  for (let option of result.options) { s.closed(option,["id","label","value"],[]); s.unique(ids,s.identifier(option.id)); s.nonblank(option.label); s.finite(option.value); }
  if (kind === "choice") { let value: number = raw.value as number; if (ids.length === 0 || value < 0 || value >= ids.length) { s.reject("Invalid choice index/options"); } }
  else if (Object.hasOwn(raw,"options")) { s.reject("Options on nonchoice input"); }
  if ((kind === "text" || kind === "toggle") && (Object.hasOwn(raw,"min") || Object.hasOwn(raw,"max"))) { s.reject("Numeric bounds on nonnumeric input"); }
  return result;
}
function decimals(raw: Record<string, unknown>): void { if (Object.hasOwn(raw,"decimals")) { let n: number = s.integral(raw.decimals); if (n < -1 || n > 6) { s.reject("Invalid decimals"); } } else { raw.decimals = -1; } }
function need(raw: Record<string, unknown>): Need {
  s.closed(raw,["id","type","words","spec"],["quote","reads","required"]);
  let kind: string = s.oneOf(raw.type,["figure","live","countdown","stopwatch","entries","content","action","scene","other"]);
  let reads: string[] = []; if (Object.hasOwn(raw,"reads")) { reads = s.stringArray(raw.reads); }
  let spec: Record<string, unknown> = raw.spec as Record<string, unknown>;
  if (kind === "figure") {
    s.closed(spec,["label","format","unit","formula","example"],["decimals","shown"]); s.nonblank(spec.label); s.text(spec.unit); s.text(spec.formula);
    s.oneOf(spec.format,["plain","money","percent","count","seconds","minutes","time_of_day","fraction","yes_no"]); decimals(spec); if (!Object.hasOwn(spec,"shown")) { spec.shown = true; } else { let shown: boolean = spec.shown as boolean; }
    let example: Record<string, unknown> = spec.example as Record<string, unknown>; s.closed(example,["inputs","result"],[]); s.finite(example.result);
    let operands: Record<string, unknown> = example.inputs as Record<string, unknown>; for (let key of tables.keys(operands)) { s.identifier(key); s.finite(operands[key]); }
  } else if (kind === "live") { s.closed(spec,["label","measure","unit","query"],[]); s.nonblank(spec.label); measure(spec.measure); s.text(spec.unit); s.nonblank(spec.query); }
  else if (kind === "countdown") { s.closed(spec,["label","length"],[]); s.nonblank(spec.label); s.identifier(spec.length); }
  else if (kind === "stopwatch") { s.closed(spec,["label"],[]); s.nonblank(spec.label); }
  else if (kind === "action") {
    s.closed(spec,["on","operation"],["at","arguments"]); let on: string = s.oneOf(spec.on,["button","countdown_end","entry_added","row_tap","time","other"]); s.nonblank(spec.operation);
    if (on === "button" && Object.hasOwn(spec,"at")) { s.reject("Button omits trigger source"); }
    if (on === "countdown_end" || on === "entry_added" || on === "row_tap" || on === "time") { s.identifier(spec.at); }
    if (Object.hasOwn(spec,"arguments")) { let bindings: Record<string, unknown> = spec.arguments as Record<string, unknown>; for (let key of tables.keys(bindings)) { s.identifier(key); s.identifier(bindings[key]); } }
  } else if (kind === "entries") {
    s.closed(spec,["label"],["fields","seeds"]); s.nonblank(spec.label); let fields: Record<string, unknown>[] = s.records(spec,"fields"); if (fields.length > 4) { s.reject("Too many entry fields"); }
    let ids: string[] = [];
    for (let field of fields) {
      s.closed(field,["id","label","kind","initial","measure"],["unit","decimals"]); s.unique(ids,s.identifier(field.id)); s.nonblank(field.label); measure(field.measure); s.optionalText(field,"unit"); decimals(field);
      let fk: string = s.oneOf(field.kind,["text","number","time","date","toggle"]);
      if (fk === "text") { s.text(field.initial); } else if (fk === "toggle") { let value: boolean = field.initial as boolean; } else { numericKind(fk,field.initial); }
    }
    for (let seed of s.records(spec,"seeds")) {
      s.closed(seed,["values"],["timestamp"]); if (Object.hasOwn(seed,"timestamp")) { s.integral(seed.timestamp); }
      let values: Record<string, unknown> = seed.values as Record<string, unknown>; s.closed(values,ids,[]);
      for (let field of fields) { let id: string = field.id as string; let fk: string = field.kind as string; if (fk === "text") { s.text(values[id]); } else if (fk === "toggle") { let value: boolean = values[id] as boolean; } else { numericKind(fk,values[id]); } }
    }
  } else { s.closed(spec,[],[]); }
  return {id:s.identifier(raw.id),type:kind,words:s.nonblank(raw.words),quote:s.optionalText(raw,"quote"),reads:reads,required:s.optionalBoolean(raw,"required",true),spec:spec};
}
function visit(id: string, needs: Need[], path: string[]): void {
  if (s.contains(path,id)) { s.reject("Dependency cycle: "+id); }
  let next: string[] = []; for (let prior of path) { next[next.length] = prior; } next[next.length] = id;
  for (let entry of needs) { if (entry.id === id) { for (let read of entry.reads) { visit(read,needs,next); } } }
}
export function decode(raw: string, factIds: string[], issuedSourceIds: string[]): Plan {
  let value: Record<string, unknown> = json.parse(raw);
  s.closed(value,["title"],["eyebrow","subtitle","inputs","constants","requirements","needs","questions"]);
  let result: Plan = {title:s.nonblank(value.title),eyebrow:s.optionalText(value,"eyebrow"),subtitle:s.optionalText(value,"subtitle"),inputs:[],constants:[],requirements:[],needs:[],questions:[]};
  let ids: string[] = []; let sourceIds: string[] = []; let needIds: string[] = [];
  for (let sourceId of issuedSourceIds) { s.unique(sourceIds,s.identifier(sourceId)); }
  for (let item of s.records(value,"inputs")) { let entry: Input = input(item); s.unique(ids,entry.id); s.unique(sourceIds,entry.id); result.inputs[result.inputs.length] = entry; }
  for (let item of s.records(value,"constants")) { s.closed(item,["id","label","measure","value"],["unit"]); let entry: Constant = {id:s.identifier(item.id),label:s.nonblank(item.label),measure:measure(item.measure),unit:s.optionalText(item,"unit"),value:s.finite(item.value)}; s.unique(ids,entry.id); s.unique(sourceIds,entry.id); result.constants[result.constants.length] = entry; }
  for (let item of s.records(value,"needs")) { let entry: Need = need(item); s.unique(ids,entry.id); needIds[needIds.length] = entry.id; s.unique(sourceIds,entry.id); result.needs[result.needs.length] = entry; }
  for (let item of s.records(value,"requirements")) {
    s.closed(item,["id","text"],["sources","needs"]); let sources: string[] = []; let covers: string[] = [];
    if (Object.hasOwn(item,"sources")) { sources = s.stringArray(item.sources); } if (Object.hasOwn(item,"needs")) { covers = s.stringArray(item.needs); }
    for (let origin of sources) { if (origin !== "request" && !s.contains(factIds,origin)) { s.reject("Unissued requirement source: "+origin); } }
    for (let target of covers) { if (!s.contains(needIds,target)) { s.reject("Unknown requirement need: "+target); } }
    let entry: Requirement = {id:s.identifier(item.id),text:s.nonblank(item.text),sources:sources,needs:covers}; s.unique(ids,entry.id); result.requirements[result.requirements.length] = entry;
  }
  for (let item of s.records(value,"questions")) {
    s.closed(item,["id","text","default"],["options"]); let options: Record<string, unknown>[] = s.records(item,"options"); let choices: string[] = [];
    for (let option of options) { s.closed(option,["id","label"],[]); s.unique(choices,s.identifier(option.id)); s.nonblank(option.label); }
    let defaultId: string = item.default as string; if (!s.contains(choices,defaultId)) { s.reject("Question default not issued"); }
    let entry: HumanQuestion = {id:s.identifier(item.id),text:s.nonblank(item.text),options:options,default:defaultId}; s.unique(ids,entry.id); result.questions[result.questions.length] = entry;
  }
  for (let entry of result.needs) { for (let read of entry.reads) { if (!s.contains(sourceIds,read)) { s.reject("Unissued dependency: "+read); } } visit(entry.id,result.needs,[]); }
  return result;
}
export function main(): null { return null; }
