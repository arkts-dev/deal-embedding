    let owner: string = "input "+id; if (id === "") { owner = "plan input #"+String(position); }
    closedAt(item,["id","label","kind","measure","value"],["unit","min","max","options","setting"],owner);
    if (Object.hasOwn(item,"options")) { for (let option of rows(item.options,owner+".options")) { closedAt(option,["id","label","value"],[],nestedOwner(owner+" option",option)); } }
    position = position+1;
