class WireConstant { id:unknown; label:unknown; measure:unknown; value:unknown; unit?:unknown; }
class WireNeed { id:unknown; type:unknown; words:unknown; spec:Record<string, unknown>; quote?:unknown; reads?:string[]; required?:unknown; }
class WireRequirement { id:unknown; text:unknown; sources?:unknown; needs?:unknown; }
class WireQuestion { id:unknown; text:unknown; default:unknown; options?:Record<string, unknown>[]; }
class WirePlan { title:unknown; eyebrow?:unknown; subtitle?:unknown; inputs?:WireInput[]; constants?:WireConstant[]; needs?:WireNeed[]; requirements?:WireRequirement[]; questions?:WireQuestion[]; }
