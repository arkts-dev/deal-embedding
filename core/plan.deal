      // an untyped number that happens to match is not history and creates no record.
      if (disclosure.admitsTimestamp(facts,stamp) === "") { s.reject(need.id+": seed "+String(index)+" timestamp "+String(stamp)+" is not disclosed"); }
    }
    if (supplied === 0 && !disclosure.admitsQuote(original,need.quote)) { s.reject(need.id+": seed "+String(index)+" supplies no values and the need quote is not an exact request substring"); }
    index = index+1;
  }
}
// Action.at names its clock/entries/list for countdown_end/entry_added/row_tap and a time source for
// time; a button omits it. Labels imply no trigger, so the target kind is resolved here.
function trigger(id: string, on: string, inputs: Input[], constants: Constant[], needs: Need[], owner: string): void {
  if (on === "countdown_end" || on === "entry_added" || on === "row_tap") {
    for (let need of needs) { if (need.id === id) {
      if (on === "countdown_end") { if (need.type === "countdown") { return; } s.reject(owner+": countdown_end target is not a countdown"); }
      if (on === "entry_added") { if (need.type === "entries") { return; } s.reject(owner+": entry_added target is not an entries need"); }
      if (need.type === "content" || need.type === "other" || need.type === "entries") { return; }
      s.reject(owner+": row_tap target is not a list need");
    } }
    s.reject(owner+": unissued trigger target "+id);
  }
  if (on === "time") {
    if (timeSource(inputs,id)) { return; }
    for (let input of inputs) { if (input.id === id) { s.reject(owner+": time target is not a time source"); } }
    for (let constant of constants) { if (constant.id === id) { s.reject(owner+": time target is not a time source"); } }
    for (let need of needs) { if (need.id === id) { s.reject(owner+": time target is not a time source"); } }
    s.reject(owner+": unissued trigger target "+id);
  }
}
function visit(id: string, needs: Need[], path: string[]): void {
  if (s.contains(path,id)) { s.reject("Dependency cycle: "+id); }
  let next: string[] = []; for (let prior of path) { next[next.length] = prior; } next[next.length] = id;
  for (let entry of needs) { if (entry.id === id) { for (let read of entry.reads) { visit(read,needs,next); } } }
}
// Plan decode issues identifiers, typed values, duration sources, figure value types and admitted
// seeds only. It builds no part, chooses no alternative and emits no source.
export function decode(raw: string, factIds: string[], issuedSourceIds: string[], original: string, facts: string): Plan {
  // The planner document enters construction as JSON text, so this is one classified boundary: a
  // fenced, truncated or prose-wrapped reply is a located plan rejection that names the plan instead of
  // leaving the host parser's own uncoded error as the reply the bounded re-plan receives. The parser's
  // own detail is carried inside that located message, never as the whole rejection. Presence is read
  // from the declared document itself, because a converted value defaults an absent optional array to
  // empty and only the declared record can report a required array the model omitted; both reads are of
  // this one text and neither can raise outside the classification.
  let presence: Record<string, unknown> = {};
  try { presence = record(JSON.parse(raw),"plan"); }
  catch (unknownError) {
    let error: Error = unknownError as Error;
    if (error.name === "CONSTRUCTION_SCHEMA") { throw error; }
    s.reject("plan: not a JSON document: "+error.message);
  }
  s.closed(presence,["title","inputs","constants","requirements","needs","questions"],["eyebrow","subtitle"]);
  let position: number = 0;
  for (let item of rows(presence.requirements,"plan requirements")) { requiredRequirement(item,position); position = position+1; }
  position = 0;
  for (let item of rows(presence.questions,"plan questions")) { requiredQuestion(item,position); position = position+1; }
  position = 0;
  for (let item of rows(presence.needs,"plan needs")) { requiredNeed(item,position); position = position+1; }
  declaredRecords(presence);
  // The declared document is checked first, so the contextual decode below never sees a value it would
  // reject unlocated; it stays inside the same classification so no parser or decoder error escapes.
  let value: WirePlan = {title:"",inputs:[],constants:[],requirements:[],needs:[],questions:[]};
  try { value = JSON.parse(raw); }
  catch (unknownError) {
    let error: Error = unknownError as Error;
    if (error.name === "CONSTRUCTION_SCHEMA") { throw error; }
    s.reject("plan: not a JSON document: "+error.message);
  }
  let result: Plan = {title:namedText(value.title,"plan.title"),eyebrow:optionalText(value.eyebrow,Object.hasOwn(value,"eyebrow"),"plan.eyebrow"),subtitle:optionalText(value.subtitle,Object.hasOwn(value,"subtitle"),"plan.subtitle"),inputs:[],constants:[],requirements:[],needs:[],questions:[]};
  let ids: string[] = []; let sourceIds: string[] = []; let needIds: string[] = [];
  for (let sourceId of issuedSourceIds) { s.unique(sourceIds,s.identifier(sourceId)); }
  // The frozen request and every disclosed fact DEAL can name are issued source identifiers: a plan
  // read may name any of them, and construction emits each of those identifiers as data of its
  // source. A host fact id DEAL cannot express (a hyphenated discovery id or an over-long id) stays
  // requirement evidence only, so a read or an argument naming it is rejected here with the
  // identifier instead of passing decode as a source no emitted resource can satisfy. The request
  // reservation is added after the plan identifiers, so a plan that reuses it is reported against the
  // plan instead of as a bare duplicate; a disclosed fact that happens to be named `request` is
  // evidence only, because that identifier already names the frozen request literal.
  for (let fact of factIds) { if (fact === "request" || !s.identifierText(fact)) { continue; } s.unique(sourceIds,fact); }
  const inputs: WireInput[] = value.inputs ?? []; const constants: WireConstant[] = value.constants ?? []; const needs: WireNeed[] = value.needs ?? []; const questions: WireQuestion[] = value.questions ?? []; const declared: WireRequirement[] = value.requirements ?? [];
  for (let item of inputs) { let entry: Input = input(item); s.unique(ids,entry.id); s.unique(sourceIds,entry.id); result.inputs[result.inputs.length] = entry; }
  for (let item of constants) { let owner: string = "constant "+namedIdentifier(item.id,"constant.id"); let entry: Constant = {id:namedIdentifier(item.id,"constant.id"),label:namedText(item.label,owner+".label"),measure:measure(item.measure,owner),unit:optionalText(item.unit,Object.hasOwn(item,"unit"),owner+".unit"),value:number(item.value,owner)}; s.unique(ids,entry.id); s.unique(sourceIds,entry.id); result.constants[result.constants.length] = entry; }
  for (let item of needs) { let entry: Need = need(item); s.unique(ids,entry.id); needIds[needIds.length] = entry.id; s.unique(sourceIds,entry.id); result.needs[result.needs.length] = entry; }
  for (let item of declared) {
    let owner: string = "requirement "+namedIdentifier(item.id,"requirement.id");
    const sources: string[] = Object.hasOwn(item,"sources") ? strings(item.sources,owner+".sources") : []; const covers: string[] = Object.hasOwn(item,"needs") ? strings(item.needs,owner+".needs") : [];
    for (let origin of sources) { if (origin !== "request" && !s.contains(factIds,origin)) { s.reject(owner+": Unissued requirement source "+origin); } }
    for (let target of covers) { if (!s.contains(needIds,target)) { s.reject(owner+": Unknown requirement need "+target); } }
    let entry: Requirement = {id:namedIdentifier(item.id,"requirement.id"),text:namedText(item.text,owner+".text"),sources:sources,needs:covers}; s.unique(ids,entry.id); result.requirements[result.requirements.length] = entry;
  }
  for (let item of questions) {
    let owner: string = "question "+namedIdentifier(item.id,"question.id");
    const options: Record<string, unknown>[] = item.options ?? []; let choices: string[] = [];
    for (let option of options) { let optionOwner: string = owner+" option "+namedIdentifier(option.id,owner+" option id"); closedAt(option,["id","label"],[],optionOwner); s.unique(choices,namedIdentifier(option.id,owner+" option id")); namedText(option.label,optionOwner+".label"); }
    let defaultId: string = namedIdentifier(item.default,owner+".default"); if (!s.contains(choices,defaultId)) { s.reject(owner+": Question default not issued"); }
    let entry: HumanQuestion = {id:namedIdentifier(item.id,"question.id"),text:namedText(item.text,owner+".text"),options:options,default:defaultId}; s.unique(ids,entry.id); result.questions[result.questions.length] = entry;
  }
  // The frozen request is the issued `request` source. A plan identifier that reuses it would make an
  // argument or a read ambiguous, so the collision is reported against the plan. A disclosed fact with
  // the same id is rejected above, so one identifier never names two different values.
  if (s.contains(ids,"request")) { s.reject("Plan identifier conflicts with the issued request source: request"); }
  sourceIds[sourceIds.length] = "request";
  for (let entry of result.needs) { for (let read of entry.reads) { if (!s.contains(sourceIds,read)) { s.reject("need "+entry.id+": Unissued dependency "+read); } } visit(entry.id,result.needs,[]); }
  for (let entry of result.needs) {
    if (entry.type === "countdown") { entry.duration = durationSource(s.identifier(entry.spec.length),result.inputs,result.constants,result.needs,entry.id); }
    if (entry.type === "entries") { admitSeeds(entry,original,facts); }
    if (entry.type === "action" && Object.hasOwn(entry.spec,"at")) {
      let on: string = s.text(entry.spec.on);
      // Only the four event kinds resolve `at` to an issued trigger target and issue a checked
      // trigger slot; an `other` action keeps its `at` as the written declaration of a custom action,
      // so prose there is data and assembly never reads it as an event.
      if (on === "countdown_end" || on === "entry_added" || on === "row_tap" || on === "time") {
        let at: string = s.identifier(entry.spec.at);
        trigger(at,on,result.inputs,result.constants,result.needs,entry.id);
        entry.trigger = {on:on,at:at};
      }
    }
  }
  // A figure example supplies its operands by issued identifier: every plan value source, the issued
  // entry aggregates of its entries needs, and the fact and request sources decode was given. An
  // example naming anything else proves nothing, so it rejects here with the need and the operand
  // instead of being admitted as plan evidence and refused later without a location.
  let valueIds: string[] = [];
  for (let entry of result.inputs) { valueIds[valueIds.length] = entry.id; }
  for (let entry of result.constants) { valueIds[valueIds.length] = entry.id; }
  for (let entry of result.needs) { valueIds[valueIds.length] = entry.id; if (entry.type === "entries") { valueIds[valueIds.length] = "count_"+entry.id; valueIds[valueIds.length] = "total_"+entry.id; } }
  for (let sourceId of sourceIds) { valueIds[valueIds.length] = sourceId; }
  for (let entry of result.needs) {
    if (entry.type !== "figure" || !Object.hasOwn(entry.spec,"example")) { continue; }
    let example: Record<string, unknown> = record(entry.spec.example,"need "+entry.id+".example");
    if (!Object.hasOwn(example,"inputs")) { continue; }
    let operands: Record<string, unknown> = record(example.inputs,"need "+entry.id+".example.inputs");
    for (let key of tables.keys(operands)) { if (!s.contains(valueIds,key)) { s.reject("need "+entry.id+".example."+key+": unissued example operand"); } }
  }
  return result;
}
export function main(): void { return; }
