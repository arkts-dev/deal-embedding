import * as plans from "./plan";
import * as s from "./construction-schema";
import * as host from "embedding/questions";

// Every proposed question is closed exactly once: the caller carries the closed identities in its
// request trace, so a question is never re-asked, reopened after its answer, or reissued by the
// answered replan (docs/spec-v0.8.md:270; generation-recovery-and-source-editing "Human question review").
export class Resolution { answers: Record<string, unknown>[]; changed: boolean; }
export async function resolve(requestId: string, questions: plans.HumanQuestion[], alreadyClosed: string[]): Promise<Resolution> {
  s.nonblank(requestId);
  if (questions.length > 2) { s.reject("At most two blocking questions"); }
  // Validate the complete batch before displaying any question.
  let ids: string[] = [];
  let closed: string[] = [];
  for (let prior of alreadyClosed) { s.unique(closed,s.identifier(prior)); }
  for (let question of questions) {
    s.identifier(question.id);
    if (s.contains(closed,question.id)) { s.reject("Question already closed: "+question.id); }
    s.unique(ids,question.id);
    if (question.options.length < 2 || question.options.length > 4) { s.reject("Question needs two to four options"); }
    s.nonblank(question.text); let options: string[] = [];
    for (let option of question.options) { s.closed(option,["id","label"],[]); s.unique(options,s.identifier(option.id)); s.nonblank(option.label); }
    if (!s.contains(options,question.default)) { s.reject("Question default not issued"); }
  }
  let result: Resolution = {answers:[],changed:false};
  for (let question of questions) {
    let response: host.Answer = await host.ask(requestId,s.encode(question));
    // A cancelled question ends generation as a cancellation: the name is the classification the host
    // adapter reports, so the request never surfaces as a generic generation failure.
    if (response.cancelled) { throw {name:"CANCELLED",message:"Question cancelled"}; }
    if (response.optionId !== null && response.text !== null) { s.reject("Option and text are mutually exclusive"); }
    let optionId: string | null = response.optionId; let text: string | null = response.text;
    if (text !== null) {
      if (text.trim() === "" || text.length > 4096) { s.reject("Question text length"); }
      result.changed = true;
    } else {
      if (optionId === null) { optionId = question.default; }
      let present: boolean = false;
      for (let option of question.options) { if ((option.id as string) === optionId) { present = true; } }
      if (!present) { s.reject("Unissued question option"); }
      if (optionId !== question.default) { result.changed = true; }
    }
    result.answers[result.answers.length] = {id:question.id,optionId:optionId,text:text};
  }
  return result;
}
export function main(): void { return; }
