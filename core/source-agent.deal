import * as decoded from "./decoded";
import * as math from "std/math";
import * as data from "embedding/policy-data";
import * as tables from "std/table";
import * as strings from "std/string";
import * as json from "std/json";
import * as model from "embedding/model";
import * as observer from "embedding/observer";
import * as checker from "./candidate-check";
import * as repair from "./source-repair";
import * as feedback from "./repair-guidance";
import * as composer from "embedding/composer";
import * as guidance from "./generation-guidance";
import * as needs from "./needs";
import * as holes from "./need-holes";
import * as recovery from "./need-recovery";
import * as preservation from "./source-preservation";

// Reads are advisory only; numbered text never changes exact-edit authority.
function readSource(args: Record<string, unknown>, deal: string, ui: string): Record<string, unknown> {
    let file: string = (args.file as string); let keys: string[] = tables.keys(args);
    if (file !== "deal" && file !== "dealui") { return { accepted: false, diagnostics: "TOOL_SHAPE: read_file permits only deal or dealui" }; }
    let source: string = deal; if (file === "dealui") { source = ui; }
    let lines: string[] = strings.split(source, "\n"); let total: number = lines.length;
    if (source === "") { total = 0; }
    if (keys.length === 1) { return { accepted: true, file: file, source: source, total_lines: total }; }
    if (keys.length !== 3) { return { accepted: false, diagnostics: "TOOL_SHAPE: supply file and both nullable line bounds" }; }
    for (let key of keys) { if (key !== "file" && key !== "start_line" && key !== "end_line") { return { accepted: false, diagnostics: "TOOL_SHAPE: unknown read_file argument" }; } }
    let start: number | null = (args.start_line as number | null); let end: number | null = (args.end_line as number | null);
    if (start === null && end === null) { return { accepted: true, file: file, source: source, total_lines: total }; }
    if (start === null) { return { accepted: false, diagnostics: "READ_RANGE: supply both bounds or null for both" }; }
    if (end === null) { return { accepted: false, diagnostics: "READ_RANGE: supply both bounds or null for both" }; }
    let first: number = (args.start_line as number); let last: number = (args.end_line as number);
    if (math.floor(first) !== first || math.floor(last) !== last || first < 1 || last < first || last > total) { return { accepted: false, total_lines: total, diagnostics: "READ_RANGE: require 1 <= start_line <= end_line <= total_lines" }; }
    let selected: Record<string, unknown>[] = [];
    { let index: number = first - 1; while (index < last) {  let text: string = lines[index]; selected[selected.length] = { number: index + 1, text: text };  index = index + 1; } }
    return { accepted: true, file: file, start_line: first, end_line: last, total_lines: total, lines: selected };
}

export async function materialized(input: string, pair: Record<string, unknown>, attempts: number): Promise<Record<string, unknown>> {
    let checked: Record<string, unknown> = await checker.check(json.stringify(pair) as string);
    if (checked.accepted as boolean) { return {candidateId:checked.candidateId,attempts:attempts,usedFallback:false}; }
    let source: string = pair.deal as string;
    if (!strings.contains(source,"// DEAL-SECTION-BEGIN ")) { throw {code:"MAINTAINED_REJECTED",message:checked.diagnostics as string}; }
    return await workspace(input,checked.diagnostics as string,pair,attempts,false);
}

// Only exact repair or explicitly authorized full-source staging reaches this workspace.
async function workspace(input: string, diagnostic: string, pair: Record<string, unknown>, priorAttempts: number, fallback: boolean): Promise<Record<string, unknown>> {
    let preserved: Record<string, unknown> = {deal:pair.deal,dealui:pair.dealui};
    let deal: string = pair.deal as string; let ui: string = pair.dealui as string; let previous: string = "";
    if (deal !== "" && ui !== "") { previous = json.stringify(pair) as string; }
    let history: Record<string, unknown>[] = []; let attempts: number = priorAttempts; let compact: boolean = false;
    let route: string = "maintained-only"; let fallbacks: number = 0; let repairs: number = 0;
    if (fallback) { route = "full-source"; fallbacks = 1; }
    while (true) {
        attempts = attempts + 1;
        let operation: string = "initial"; if (previous !== "") { operation = "repair"; }
        let initialWrites: boolean = deal === "" && ui === "";
        let instruction: string = "";
        if (!compact) { instruction = guidance.sourceGuidance() + "\nCreate both missing files using paired write_file calls. Once files exist use one operation per turn; repair with exact edit_sources, never overwrite. read_file supports inclusive ranges; both null reads full source. check_sources checks the complete pair."; }
        if (!initialWrites) { instruction = guidance.sourceGuidance() + "\nThe canonical source pair already exists. Use exact edit_sources, read_file or check_sources only. No plan regeneration or source overwrite. Read relevant ranges; numbers are metadata, not search text." + await feedback.patchInstruction(previous, diagnostic); }
        let prompt: string = input + "\nSOURCE OPERATION\n" + operation + "\n" + instruction + "\nNATIVE TOOL TURN\n" + (json.stringify({ messages: history, initialWrites: initialWrites, compact: compact && initialWrites }) as string);
        let raw: string = "";
        try { raw = await model.complete(prompt, previous, diagnostic); }
        catch (errorUnknown) { let error: Error = errorUnknown as Error;
            if (error.code !== "MODEL_RECOVERABLE") { throw error; }
            await observer.record("recovery", "model", error.message); continue;
        }
        let message: Record<string, unknown> = {}; let calls: Record<string, unknown>[] = [];
        try {
            message = await data.parse(raw); calls = decoded.records(message.tool_calls);
            let role: string = (message.role as string); let text: string = (message.content as string);
            if (role !== "assistant" || calls.length === 0 || text !== "") { throw { code: "INVALID_TOOL", message: "Use native tools without exterior text" }; }
            let ids: string[] = []; let files: string[] = [];
            if (calls.length > 1 && !initialWrites) { throw { code: "INVALID_TOOL", message: "Batching is only available before either file exists" }; }
            for (let call of calls) {
                let id: string = (call.id as string); let kind: string = (call.type as string); let functionData: Record<string, unknown> = (call["function"] as Record<string, unknown>);
                let name: string = (functionData.name as string); let args: string = (functionData.arguments as string);
                if (id === "" || kind !== "function" || (calls.length > 1 && name !== "write_file")) { throw { code: "INVALID_TOOL", message: "Use one operation per turn except independent initial writes" }; }
                for (let prior of ids) { if (prior === id) { throw { code: "INVALID_TOOL", message: "Duplicate tool identity" }; } }
                if (compact && (name === "write_file" || calls.length > 1)) { throw { code: "INVALID_TOOL", message: "Initial compact submission is one atomic call; use source_fallback explicitly before writes" }; }
                if (calls.length > 1) {
                    let write: Record<string, unknown> = await data.parse(args); let file: string = (write.file as string); let source: string = (write.source as string); let keys: string[] = tables.keys(write);
                    if (keys.length !== 2 || (file !== "deal" && file !== "dealui") || strings.trim(source) === "") { throw { code: "INVALID_TOOL", message: "Invalid initial write" }; }
                    for (let prior of files) { if (prior === file) { throw { code: "INVALID_TOOL", message: "Initial writes must target different files" }; } }
                    files[files.length] = file;
                }
                ids[ids.length] = id;
            }
        } catch (errorUnknown) { let error: Error = errorUnknown as Error;
            if (error.code !== "INVALID_JSON" && error.code !== "INVALID_TOOL" && error.code !== "E8001") { throw error; }
            let invalidHistory: Record<string, unknown>[] = []; history = invalidHistory;
            history[history.length] = { role: "user", content: "Invalid tool response. Use the currently issued native tools, no textual envelope. The canonical workspace is unchanged." };
            await observer.record("recovery", "tool", "INVALID_TOOL"); continue;
        }
        // Canonical source + current diagnostic are the repair authority. Retain the
        // current native assistant/tool exchange, not an ever-growing duplicate of edits.
        // Full prior exchanges remain in unified model/tool evidence, never regenerated.
        let currentHistory: Record<string, unknown>[] = []; history = currentHistory;
        history[history.length] = message;
        for (let call of calls) {
            let id: string = (call.id as string); let functionData: Record<string, unknown> = (call["function"] as Record<string, unknown>); let name: string = (functionData.name as string); let callArguments: string = (functionData.arguments as string);
            let result: Record<string, unknown> = { accepted: false, diagnostics: "INVALID_TOOL" }; let changed: boolean = false; let check: boolean = false;
            let args: Record<string, unknown> = {};
            try { args = await data.parse(callArguments); }
            catch (errorUnknown) { let error: Error = errorUnknown as Error; if (error.code !== "INVALID_JSON") { throw error; } }
            if (name === "write_file") {
                if (compact) { result = { accepted: false, diagnostics: "SOURCE_FALLBACK_REQUIRED: full-source staging must be explicitly authorized" }; }
                else { try {
                    let keys: string[] = tables.keys(args); let file: string = (args.file as string); let source: string = (args.source as string);
                    if (keys.length !== 2 || strings.trim(source) === "" || (file !== "deal" && file !== "dealui")) { throw { code: "TOOL_SHAPE", message: "Invalid file/source" }; }
                    if ((file === "deal" && deal !== "") || (file === "dealui" && ui !== "")) { result = { accepted: false, diagnostics: "FILE_EXISTS: use exact edits, never overwrite" }; }
                    else {
                        if (file === "deal") { deal = source; } else { ui = source; }
                        result = { accepted: true, diagnostics: "File staged; create the other file before checking" }; changed = true;
                    }
                } catch (errorUnknown) { let error: Error = errorUnknown as Error; result = { accepted: false, diagnostics: "TOOL_SHAPE: write_file requires one missing file and nonempty source" }; } }
            } else if (name === "edit_sources") {
                if (deal === "" || ui === "") { result = { accepted: false, diagnostics: "INCOMPLETE_PAIR: write both files first" }; }
                else {
                    let base: string = (json.stringify({ deal: deal, dealui: ui }) as string);
                    let digest: string = await data.sha256(repair.digestInput(deal, ui));
                    let emptyEdits: Record<string, unknown>[] = []; let patch: Record<string, unknown> = { baseDigest: digest, edits: emptyEdits };
                    try { let edits: Record<string, unknown>[] = decoded.records(args.edits); let keys: string[] = tables.keys(args); if (keys.length === 1) { patch.edits = edits; } } catch (errorUnknown) { let error: Error = errorUnknown as Error; }
                    await observer.record("patch", "started", "");
                    result = await repair.apply(base, (json.stringify(patch) as string));
                    await observer.record("patch", "completed", (json.stringify(result) as string));
                    let accepted: boolean = (result.accepted as boolean);
                    if (accepted && !fallback) {
                        let proposed: Record<string, unknown> = await data.parse(result.source as string);
                        if (!preservation.preserves(preserved.deal as string,preserved.dealui as string,proposed.deal as string,proposed.dealui as string)) { result = {accepted:false,diagnostics:"PATCH_NEIGHBOR: maintained source is immutable; edits must remain inside issued pure-section bodies"}; accepted = false; }
                    }
                    if (accepted) {
                        repairs = repairs + 1;
                        await observer.record("composition", "source-repair", (json.stringify({route:route,repairs:repairs}) as string));
                        let source: string = (result.source as string); let pair: Record<string, unknown> = await data.parse(source); deal = (pair.deal as string); ui = (pair.dealui as string); changed = true;
                    }
                }
            } else if (name === "read_file") {
                try { result = readSource(args, deal, ui); }
                catch (errorUnknown) { let error: Error = errorUnknown as Error;
                    if (error.code !== "E8001") { throw error; }
                    result = { accepted: false, diagnostics: "TOOL_SHAPE: read_file requires a valid file and integral nullable line bounds" };
                }
            } else if (name === "check_sources") { let keys: string[] = tables.keys(args); check = keys.length === 0; }
            if (changed || check) {
                if (deal !== "" && ui !== "") {
                    previous = (json.stringify({ deal: deal, dealui: ui }) as string);
                    let checked: Record<string, unknown> = await checker.check(previous); let accepted: boolean = (checked.accepted as boolean);
                    let candidate: string = (checked.candidateId as string);
                    if (accepted) { await observer.record("composition","checked",(json.stringify({route:route,fallbacks:fallbacks,repairs:repairs}) as string)); return { candidateId: candidate, attempts: attempts, usedFallback: fallback }; }
                    diagnostic = (checked.diagnostics as string);
                    let advice: string = await feedback.patchInstruction(previous, diagnostic);
                    result = { accepted: true, checked: false, diagnostics: diagnostic, guidance: advice };
                } else if (check) { result = { accepted: false, diagnostics: "INCOMPLETE_PAIR: write both files first" }; }
            }
            history[history.length] = { role: "tool", tool_call_id: id, content: (json.stringify(result) as string) };
        }
    }
    throw { code: "UNREACHABLE", message: "Source agent exited unexpectedly" };
}
export async function fullSource(input: string, reason: string, selected: Record<string, unknown>, attempts: number): Promise<Record<string, unknown>> {
    if (strings.trim(reason) === "") { needs.fail("Explicit full-source reason required"); }
    if (Object.hasOwn(selected,"fragments")) {
        // These primitives remain outside shape catches: operational errors never open the gate.
        let assembled: Record<string, unknown> = await data.parse(await composer.assemble(json.stringify(selected) as string));
        let accepted: boolean = assembled.accepted as boolean; let checked: boolean = false;
        if (accepted) { let result: Record<string, unknown> = await checker.probe(assembled.source as Record<string, unknown>); checked = result.accepted as boolean; }
        await observer.record("composition","fallback-gate",json.stringify({selected:selected,revision:await data.sha256(json.stringify(selected) as string),assembled:accepted,checked:checked}) as string);
        if (recovery.visible(selected) && (!accepted || !checked)) {
            let retained: Record<string, unknown>[] = []; let ids: string[] = [];
            for (let subset of recovery.subsets(selected)) {
                let trial: Record<string, unknown> = await data.parse(await composer.assemble(json.stringify(subset) as string)); let compiled: boolean = false;
                if (trial.accepted as boolean) { let result: Record<string, unknown> = await checker.probe(trial.source as Record<string, unknown>); compiled = result.accepted as boolean; }
                await observer.record("composition","fallback-subset",json.stringify({subset:subset,revision:await data.sha256(json.stringify(subset) as string),assembled:trial.accepted,checked:compiled}) as string);
                if (compiled) { for (let fragment of decoded.records(subset.fragments)) { let id: string = fragment.id as string; if (!needs.contains(ids,id)) { ids[ids.length] = id; retained[retained.length] = fragment; } } }
            }
            if (ids.length > 0) {
                let partial: Record<string, unknown> = recovery.subset(selected,ids); let notices: string[] = [];
                for (let fragment of decoded.records(selected.fragments)) { let id: string = fragment.id as string; if (!needs.contains(ids,id)) { notices[notices.length] = "Unavailable: "+id; } } partial.notices = notices;
                let merged: Record<string, unknown> = await data.parse(await composer.assemble(json.stringify(partial) as string));
                if (!(merged.accepted as boolean)) { throw {code:"RECOVERY_UNRESOLVED",message:merged.diagnostics as string}; }
                let result: Record<string, unknown> = await materialized(input,merged.source as Record<string, unknown>,attempts); result.usedFallback = true; return result;
            }
            // Every dependency-closed task component failed ordinary source admission.
        } else { recovery.authorize(selected,accepted,checked); }
    }
    await observer.record("composition","fallback",json.stringify({reason:reason,selected:selected}) as string);
    return await workspace(input+"\nPRESERVE SELECTED BEHAVIOR\n"+(json.stringify(selected) as string)+guidance.workflow(),"",{deal:"",dealui:""},attempts,true);
}
// The slow path receives exact uncovered IDs and immutable selected-plan data.
export async function uncovered(input: string, requirements: needs.Needs, selected: Record<string, unknown>, gaps: string[], priorAttempts: number, contracts: Record<string, unknown>[]): Promise<Record<string, unknown>> {
    let diagnostics: string = ""; let attempts: number = priorAttempts;
    let budget: recovery.Budget = recovery.budget(gaps);
    let revision: string = await data.sha256(json.stringify(selected) as string);
    let pending: string[] = []; for (let id of gaps) { pending[pending.length] = id; }
    let isolated: boolean = false; let history: Record<string, unknown>[] = [];
    while (recovery.remaining(budget,pending).length > 0) {
        let active: string[] = recovery.remaining(budget,pending);
        if (isolated) { active = [active[0]]; }
        let interfaces: Record<string, unknown>[] = []; let pureInterfaces: Record<string, unknown>[] = []; let ready: string[] = []; let blocked: string = "";
        for (let id of active) {
            let need: needs.Need = needs.need(requirements,id);
            if (need.kind === "custom") { pureInterfaces[pureInterfaces.length] = {id:id,parameters:need.config.parameters,result:need.config.result,arguments:need.config.arguments}; ready[ready.length] = id; continue; }
            try { let boundary: Record<string, unknown> = holes.issue(requirements,selected,id,contracts); interfaces[interfaces.length] = boundary; ready[ready.length] = id; }
            catch (errorUnknown) { let error: Error = errorUnknown as Error; if (error.code !== "NEEDS_INVALID" && error.code !== "E8001" && error.code !== "INVALID_CONFIG") { throw error; } blocked = error.message; }
        }
        if (ready.length === 0 && diagnostics === "") { diagnostics = blocked; }
        // Blocked dependents do not consume calls or invent missing imports. Retry them only
        // after another section supplies the declared output; terminal gaps get notices.
        if (ready.length === 0) {
            if (isolated && active.length === 1) {
                let found: boolean = false; for (let id of recovery.remaining(budget,pending)) { if (id !== active[0]) { try { let boundary: Record<string, unknown> = holes.issue(requirements,selected,id,contracts); ready = [id]; interfaces = [boundary]; found = true; break; } catch (errorUnknown) { let error: Error = errorUnknown as Error; if (error.code !== "NEEDS_INVALID" && error.code !== "E8001" && error.code !== "INVALID_CONFIG") { throw error; } } } }
                if (!found) { break; }
            } else { break; }
        }
        active = ready;
        let thinking: boolean = recovery.charge(budget,active); attempts = attempts+1;
        let pureInstruction: string = ""; if (pureInterfaces.length > 0) { pureInstruction = "\n"+guidance.pureGuidance(); }
        let prompt: string = pureInstruction+"\nMAINTAINED SECTION CONTRACT\n"+guidance.guidance()+guidance.workflow()+input+"\nUNCOVERED NEEDS\n"+(json.stringify({requirements:needs.document(requirements),selected:selected,gaps:active,interfaces:interfaces,pureInterfaces:pureInterfaces}) as string)+"\nFill only active gaps, not other requirements or retained parts. Use submit_section for interfaces, or submit_custom for pureInterfaces. For submit_custom copy id/parameters/result/arguments EXACTLY (arguments are frozen term IDs, not source expressions), adding only a DEAL function body using those named parameters and return; no formula DSL/lambda or record result. submit_section owns only a namespaced compact subtree: title, maintained fragments, commands, display. No raw graph/source, nested sections, neighbor edits, undeclared imports or calls. Copy exact imports/capabilities; exports copy name/type and add value:{expr:localPortFormula}. Imports are local result ports name.value. Preserve every selected part. If this cannot implement the uncovered behavior, report the local diagnostic; source_fallback is forbidden while selected task components remain. Only a request with no retained task component may request source_fallback with a reason. Essential missing facts are unsupported, never invented.\nNATIVE TOOL TURN\n"+(json.stringify({messages:history,initialWrites:true,compact:false,holes:true,thinking:thinking}) as string);
        let fingerprint: string = await data.sha256(diagnostics);
        await observer.record("composition","hole-dispatch",json.stringify({gaps:active,thinking:thinking,revision:revision,diagnosticFingerprint:fingerprint,diagnostic:diagnostics}) as string);
        let raw: string = await model.complete(prompt,"",diagnostics);
        let args: Record<string, unknown> = {}; let name: string = ""; let current: Record<string, unknown>[] = []; history = current;
        try {
            let message: Record<string, unknown> = await data.parse(raw); let calls: Record<string, unknown>[] = decoded.records(message.tool_calls); if (calls.length !== 1 || (message.role as string) !== "assistant" || (message.content as string) !== "") { needs.fail("One native hole operation without exterior text required"); }
            let call: Record<string, unknown> = calls[0]; let fn: Record<string, unknown> = call["function"] as Record<string, unknown>; name = fn.name as string;
            if ((call.type as string) !== "function" || (call.id as string) === "") { needs.fail("Native hole tool identity required"); }
            history[history.length] = message; history[history.length] = {role:"tool",tool_call_id:call.id,content:""};
            args = await data.parse(fn.arguments as string);
            if (name !== "submit_custom" && name !== "submit_section" && name !== "source_fallback") { needs.fail("Unissued hole operation"); }
            if (name === "submit_custom" || name === "submit_section") { args = holes.merge(requirements,selected,active,args,contracts); }
            else { needs.closed(args,["reason"]); let reason: string = args.reason as string; if (strings.trim(reason) === "") { needs.fail("Fallback reason required"); } }
        } catch (errorUnknown) { let error: Error = errorUnknown as Error; if (error.code !== "NEEDS_INVALID" && error.code !== "INVALID_CONFIG" && error.code !== "INVALID_FORMULA" && error.code !== "INVALID_JSON" && error.code !== "E8001") { throw error; } diagnostics = error.message; holeFeedback(history,diagnostics); isolated = true; continue; }
        if (name === "source_fallback") {
            await observer.record("composition","fallback-request",json.stringify({reason:args.reason,gaps:active,selected:selected}) as string);
            if (!recovery.visible(selected)) { return await fullSource(input,args.reason as string,selected,attempts); }
            diagnostics = "FALLBACK_FORBIDDEN: repair only the issued holes; selected task components must be retained";
            holeFeedback(history,diagnostics); isolated = true; continue;
        }
        let assembled: Record<string, unknown> = await data.parse(await composer.assemble(json.stringify(args) as string));
        if (!(assembled.accepted as boolean)) { diagnostics = assembled.diagnostics as string; holeFeedback(history,diagnostics); isolated = true; continue; }
        let checked: Record<string, unknown> = await checker.probe(assembled.source as Record<string, unknown>);
        if (!(checked.accepted as boolean)) { diagnostics = checked.diagnostics as string; holeFeedback(history,diagnostics); isolated = true; continue; }
        await observer.record("composition","custom",json.stringify({gaps:active,sections:args.custom}) as string);
        selected = args; revision = await data.sha256(json.stringify(selected) as string);
        let rest: string[] = []; for (let id of pending) { if (!needs.contains(active,id)) { rest[rest.length] = id; } } pending = rest;
        diagnostics = ""; let cleared: Record<string, unknown>[] = []; history = cleared;
        if (pending.length === 0) { let final: Record<string, unknown> = await materialized(input,assembled.source as Record<string, unknown>,attempts); final.usedFallback = true; return final; }
    }
    await observer.record("composition","hole-exhausted",json.stringify({gaps:pending,diagnostics:diagnostics}) as string);
    let partial: Record<string, unknown> = {};
    for (let key of tables.keys(selected)) { partial[key] = selected[key]; }
    let notices: string[] = []; for (let id of pending) { let need: needs.Need = needs.need(requirements,id); notices[notices.length] = "Unavailable: "+need.label; }
    partial.notices = notices;
    if (!recovery.visible(selected)) { return await fullSource(input,"No retained task component after local recovery",partial,attempts); }
    let assembled: Record<string, unknown> = await data.parse(await composer.assemble(json.stringify(partial) as string));
    if (!(assembled.accepted as boolean)) { return await fullSource(input,"Retained composition requires subset isolation",partial,attempts); }
    let pair: Record<string, unknown> = assembled.source as Record<string, unknown>;
    let checked: Record<string, unknown> = await checker.probe(pair);
    if (!(checked.accepted as boolean)) { return await fullSource(input,"Retained compilation requires subset isolation",partial,attempts); }
    await observer.record("composition","partial",json.stringify({gaps:pending,source:pair}) as string);
    let final: Record<string, unknown> = await materialized(input,pair,attempts); final.usedFallback = true; return final;
}
function holeFeedback(history: Record<string, unknown>[], diagnostic: string): null {
    if (history.length === 2) { history[1].content = json.stringify({accepted:false,diagnostics:diagnostic}) as string; }
    return null;
}
export function main(): null { return null; }
