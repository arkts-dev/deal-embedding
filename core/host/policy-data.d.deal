import * as embedding from "./embedding";

export function catalogJson(capabilities: embedding.CapabilityContract[]): Promise<string> ;
export function contextEntries(input: string): Promise<string> ;
export function member(input: Record<string, unknown>, key: string): Promise<Record<string, unknown>> ;
export function stringMember(input: Record<string, unknown>, key: string): Promise<string> ;
// Host JSON transport; records preserve presence, arrays retain unknown descriptors.
// Portable decoding validates elements into fresh typed arrays.
export function parse(input: string): Promise<Record<string, unknown>> ;
// Unicode string primitive; no catalogue or source policy in the host.
export function lowercase(input: string): Promise<string> ;
// Wire bounds count UTF-16 code units (including each surrogate), not Unicode scalars.
export function utf16Length(input: string): Promise<number> ;
// Digest mechanism; repair base identity and edit decisions stay in core.
export function sha256(input: string): Promise<string> ;
