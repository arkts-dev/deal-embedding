// v1.6 accepts JSON string escapes, including controls and lone UTF-16 units.
export function quote(value: string): string { return JSON.stringify(value) as string; }
export function decimal(value: number): string {
    if (!Number.isFinite(value) || Math.floor(value) !== value) { throw {name:"INVALID_INTEGER",message:"Expected an integral value"}; }
    return String(value);
}
export function main(): void { return; }
