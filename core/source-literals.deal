import * as strings from "std/string";
import * as math from "std/math";

// Source literals use DEAL escaping, not JSON escaping (notably no escaped slash).
export function quote(value: string): string {
    let out: string = "\"";
    for (let ch: string of value) {
        let escaped: string = ch;
        if (ch === "\\") { escaped = "\\\\"; }
        if (ch === "\"") { escaped = "\\\""; }
        if (ch === "\n") { escaped = "\\n"; }
        if (ch === "\t") { escaped = "\\t"; }
        out = out + escaped;
    }
    return out + "\"";
}
export function decimal(value: number): string {
    if (value - value !== 0 || math.floor(value) !== value) { throw {code: "INVALID_INTEGER", message: "Expected an integral value"}; }
    if (value === 0) { return "0"; }
    let out: string = "";
    let remaining: number = value; if (remaining > 0) { remaining = -remaining; }
    while (remaining < 0) {
        let next: number = math.ceil(remaining / 10);
        let digit: number = -(remaining - next * 10);
        out = strings.substring("0123456789", digit, digit + 1) + out;
        remaining = next;
    }
    if (value < 0) { out = "-" + out; }
    return out;
}
export function main(): null { return null; }
