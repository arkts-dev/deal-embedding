import * as json from "std/json";
import * as strings from "std/string";
import * as tables from "std/table";
import * as decode from "./plan-decoding";
import * as sketch from "./sketch";

// Port of NeedsPlan.ets at 7ee06af. Raw fields belong to the composer, not
// this decoder: preserve their presence and values rather than invent a schema.
export class Need {
    type: string;
    words: string;
    raw: Record<string, unknown>;
    on: string;
    reads: string[];
    length: string;
    from: string;
}

export class NeedsPlan {
    base: Record<string, unknown>;
    needs: Need[];
}

function text(raw: Record<string, unknown>, key: string): string {
    return decode.trim(decode.stringField(raw, key, ""));
}

function copy(raw: Record<string, unknown>): Record<string, unknown> {
    let result: Record<string, unknown> = {};
    for (let key of tables.keys(raw)) { result[key] = raw[key]; }
    return result;
}

function quantitiesIn(raw: Record<string, unknown>): string[] {
    let found: string[] = [];
    let formula: string = text(raw, "formula");
    for (let quantity of ["clock.remaining", "clock.elapsed", "clock.duration", "entries.count", "entries.total"]) {
        if (strings.contains(formula, quantity)) { found[found.length] = quantity; }
    }
    return found;
}

function composerNames(value: string): string {
    let names: string[] = ["remaining", "elapsed", "duration", "entryCount", "entryTotal"];
    let index: number = 0;
    let result: string = value;
    for (let quantity of ["clock.remaining", "clock.elapsed", "clock.duration", "entries.count", "entries.total"]) {
        result = strings.replace(result, quantity, names[index]);
        index = index + 1;
    }
    return result;
}

// Extract the first '{' through the last '}', just as the reference does.
// DEAL's JSON boundary additionally rejects duplicate object keys and invalid
// Unicode. It must not be weakened to imitate JSON.parse's lossy acceptance.
export function parseNeedsPlan(reply: string): NeedsPlan | null {
    let parsed: Record<string, unknown> | null = decode.parseObject(reply);
    if (parsed === null) { return null; }
    let raw: Record<string, unknown> = parsed as Record<string, unknown>;
    let base: Record<string, unknown> = {};
    for (let key of ["title", "eyebrow", "subtitle", "inputs", "constants", "questions"]) {
        if (Object.hasOwn(raw, key)) { base[key] = raw[key]; }
    }
    let needs: Need[] = [];
    for (let item of decode.arrayOrEmpty(raw.needs)) {
        let decoded: Record<string, unknown> | null = decode.objectOrNull(item);
        if (decoded === null) { continue; }
        // DEAL narrowing is block-local; an early continue does not refine
        // the following statements. Assert the already-checked boundary once.
        let fields: Record<string, unknown> = decoded as Record<string, unknown>;
        let type: string = text(fields, "type");
        if (!decode.includes(["figure", "countdown", "stopwatch", "entries", "content", "action", "scene", "other"], type)) {
            continue;
        }
        let need: Need = {type: type, words: "", raw: fields, on: "", reads: [], length: "", from: ""};
        if (type === "figure") {
            need.words = text(fields, "label");
            let means: string = text(fields, "means");
            if (means !== "") { need.words = need.words + " (" + means + ")"; }
            need.reads = quantitiesIn(fields);
        } else if (type === "countdown" || type === "stopwatch" || type === "entries") {
            need.words = text(fields, "label");
            need.length = text(fields, "length");
        } else if (type === "action") {
            need.words = text(fields, "when") + ": " + text(fields, "what");
            need.on = text(fields, "on");
            if (!decode.includes(["countdown_end", "entry_added", "row_tap", "button", "time", "other"], need.on)) {
                need.on = "other";
            }
            need.from = text(fields, "from");
        } else {
            need.words = text(fields, "what");
            if (type === "content" || type === "scene") { need.from = text(fields, "from"); }
        }
        needs[needs.length] = need;
    }
    return {base: base, needs: needs};
}

export function needOf(plan: NeedsPlan, type: string): Need | null {
    for (let need of plan.needs) {
        if (need.type === type) { return need; }
    }
    return null;
}

function figureFields(raw: Record<string, unknown>): Record<string, unknown> {
    let result: Record<string, unknown> = copy(raw);
    result.formula = composerNames(text(raw, "formula"));
    let example: Record<string, unknown> | null = decode.objectOrNull(raw.example);
    if (example !== null) {
        let samples: Record<string, unknown> | null = decode.objectOrNull(example.given);
        if (samples !== null) {
            let given: Record<string, unknown> = samples;
            let renamed: Record<string, unknown> = {};
            for (let key of tables.keys(given)) { renamed[composerNames(key)] = given[key]; }
            let replaced: Record<string, unknown> = copy(example);
            replaced.given = renamed;
            result.example = replaced;
        }
    }
    return result;
}

// The exact input of VeraCompose.parseSketch, before its own normalization.
// Kept explicit for differential checks and diagnostics; sketchFrom below
// applies the reference's JSON boundary and typed parseSketch normalization.
export function sketchDocument(plan: NeedsPlan): Record<string, unknown> {
    let result: Record<string, unknown> = copy(plan.base);
    let values: Record<string, unknown>[] = [];
    let events: Record<string, unknown>[] = [];
    let ready: string[] = [];
    let other: string[] = [];
    for (let need of plan.needs) {
        let raw: Record<string, unknown> = copy(need.raw);
        if (need.type === "figure") {
            values[values.length] = figureFields(raw);
        } else if (need.type === "countdown" || need.type === "stopwatch") {
            if (!Object.hasOwn(result, need.type)) { result[need.type] = raw; }
            else { other[other.length] = "a second " + need.type + ": " + need.words; }
        } else if (need.type === "entries") {
            if (!Object.hasOwn(result, "list")) { result.list = raw; }
            else { other[other.length] = "a second list of entries: " + need.words; }
        } else if (need.type === "content") {
            ready[ready.length] = need.words;
        } else if (need.type === "action") {
            events[events.length] = raw;
        } else if (need.type === "scene") {
            other[other.length] = "a scene the app draws itself: " + need.words;
        } else {
            other[other.length] = need.words;
        }
    }
    result.values = values;
    result.events = events;
    result.ready = ready;
    result.other = other;
    return result;
}

export function sketchFrom(plan: NeedsPlan): sketch.Sketch | null {
    // The reference crosses this JSON boundary too. Besides preserving its
    // nonfinite-number semantics, decoding gives arrays unknown descriptors;
    // a typed string[] cannot be asserted to invariant unknown[].
    let encoded: string = json.stringify(sketchDocument(plan)) as string;
    return sketch.parseSketch(encoded);
}

export function plainScenes(plan: NeedsPlan): number {
    let changed: number = 0;
    for (let need of plan.needs) {
        if (need.type === "scene") {
            need.type = "other";
            changed = changed + 1;
        }
    }
    return changed;
}

export function main(): null { return null; }
