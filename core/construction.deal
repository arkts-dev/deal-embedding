    for (let slot of composition.screen.slots) { if (slot.need === choice.need) { slot.allowedKinds = [kind]; } }
  }
  let computations: composer.Computation[] = [];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,second.choices,registry,scalar.build(plan,scalarCandidates,first,second),{intervalMs:input.clockIntervalMs,toleranceMs:input.clockToleranceMs});
  let bound: Bound = await issueBindings(composition,plan,built,registry,input.original,input.facts);
