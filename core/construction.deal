  } }
  return "";
}
function mark(screen: screens.Screen, instance: screens.Instance): void {
  screen.instances[screen.instances.length] = instance;
  for (let slot of screen.slots) { if (s.contains(instance.fragment.covers,slot.need)) {
    slot.status = "filled"; slot.instance = instance.id; slot.reason = "";
    // A section added by alignment carries no selection choice; its kind still comes from the
    // instance that fills the slot, never from a label. A custom or notice implementation declares
    // no allowed kind, because no issued alternative kind produced it.
    if (slot.allowedKinds.length === 0 && instance.origin === "catalogue") { slot.allowedKinds = [instance.kind]; }
  } }
}
function notice(id: string, message: string): screens.Instance {
  // Encode data through the same compiler expression mechanism used by other fragments.
  let escaped: string = s.encode(message);
  return {id:id,kind:"notice",origin:"notice",parameters:{text:message},fragment:{declarations:"",fields:[],updates:[],effects:[],helpers:"",view:"import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View {ui.Text(text: "+escaped+", style: \"muted\")}",options:[],content:[],ports:[],holes:[],covers:[],owns:[]},bodies:{}};
}
function issueSources(registry: bindings.Registry, instance: screens.Instance): void {
  for (let port of instance.fragment.ports) { if (port.direction === "publish") {
    bindings.reserve(registry,{id:instance.id+"_"+port.name,type:port.type,schema:null,dependencies:[],owner:instance.id,payloadOwner:"",getter:"f_"+instance.id+"_"+port.getter,ready:"f_"+instance.id+"_"+port.getter+"_ready"});
  } }
}
// The issued identity of one published port. A catalogue instance reserves `<instance>_<port>`; the
// parts owner issues each publication under its need identifier, which is also what a plan action may
// name, so reader resolution asks that identity for it instead of inventing a second one.
function publishedSource(publisher: screens.Instance, output: screens.Port): string {
  if (publisher.id === "parts") { return output.name; }
  return publisher.id+"_"+output.name;
}
// Reader resolution for one accepted reader instance: exact port name and type, the requested
// dependency, and the publisher's issued publication source. An unserved required port leaves the
// reader unconnected instead of substituting a value, with the located reason the need reports.
export function connect(composition: screens.Composition, instance: screens.Instance, registry: bindings.Registry, plan: plans.Plan): string {
  let connections: screens.Connection[] = [];
  for (let port of instance.fragment.ports) { if (port.direction === "read") {
    let found: boolean = false; let published: string = "";
    for (let publisher of composition.screen.instances) { if (publisher.id !== instance.id && !found) { for (let output of publisher.fragment.ports) {
      if (!found && output.direction === "publish" && output.name === port.name && output.type === port.type) {
        published = publisher.id;
        let requested: boolean = false;
        for (let need of plan.needs) { if (s.contains(instance.fragment.covers,need.id)) { for (let publisherNeed of publisher.fragment.covers) { if (s.contains(need.reads,publisherNeed)) { requested = true; } } } }
        if (!requested) { continue; }
        let source: bindings.Source = bindings.source(registry,publishedSource(publisher,output));
        if (source.type !== port.type) { s.reject("Port source type mismatch"); }
        connections[connections.length] = {readerInstance:instance.id,readerPort:port.name,writerInstance:publisher.id,writerPort:output.name}; found = true;
      }
    } } }
    if (!found && !port.optional) {
      // A publisher that exists but is not a requested dependency is a different rejection from a port
      // the composition never publishes, and the need's located reason names which one happened.
      if (published !== "") { return "Reader port is not a requested dependency: "+port.name; }
      return "Required reader port has no publisher: "+port.name;
    }
  } }
  for (let connection of connections) { composition.connections[composition.connections.length] = connection; }
  return "";
}
function ownership(plan: plans.Plan, alternatives: selecting.Alternative[]): selections.Question[] {
  let result: selections.Question[] = [];
  for (let need of plan.needs) {
    let applicable: boolean = false; for (let alternative of alternatives) { if (alternative.need === need.id && alternative.origin === "catalogue") { applicable = true; } }
    if (applicable) { result[result.length] = selections.question("ownership_"+need.id,need.id,"ownership","Is the requested content personal/user-owned? User-owned content must remain exact disclosed data; a missing exact quote remains unchecked.",[{id:"user",criteria:"Personal records, authored wording or existing user content must be retained."},{id:"authored",criteria:"The request permits new nonfactual authored text or local configuration."}]); }
  }
  return result;
}
// Every catalogue kind the catalogue issues is an alternative for a need no accepted choice fills. A
// reader section is offered only for a need that requests a dependency another need publishes
// (catalogue.carriesReaders), so an alignment the connection step can never wire is never selected. Only
// content and other needs are issued kinds today, which is what keeps a scene need out of alignment: the
// scene is written by the ordinary writing operation (generation-recovery-and-source-editing
// "Alignment"). Kind eligibility for the remaining need types is catalogue-owned and missing.
function alignmentCandidates(plan: plans.Plan, settled: string[]): alignment.Candidate[] {
  let result: alignment.Candidate[] = [];
  for (let need of plan.needs) {
    if (s.contains(settled,need.id)) { continue; }
    if (need.type !== "content" && need.type !== "other") { continue; }
    for (let definition of catalogue.definitions()) {
      if (definition.reads.length > 0 && !catalogue.carriesReaders(plan,need)) { continue; }
      result[result.length] = {need:need.id,id:"cat_"+need.id+"_"+definition.kind,kind:definition.kind,criteria:definition.criteria,reads:definition.reads,publishes:definition.publishes};
    }
  }
  return result;
}
function published(entries: catalogue.Configured[]): string[] {
  let result: string[] = [];
  for (let entry of entries) { for (let port of entry.definition.publishes) { if (!s.contains(result,port)) { result[result.length] = port; } } }
  return result;
}
function usedKinds(entries: catalogue.Configured[]): string[] {
  let result: string[] = [];
  for (let entry of entries) { if (!s.contains(result,entry.definition.kind)) { result[result.length] = entry.definition.kind; } }
  return result;
}
function locate(composition: screens.Composition, need: string, reason: string): void {
  // A need alignment could not implement stays visibly missing with its located reason instead of a
