export class Result { candidateId: string; attempts: number; diagnostics: string; runnable: boolean; }
// The outcome of the Bind stage: the located reasons of bindings that kept their need open, and
// whether the parts implementation must be placed for the operations that were issued.
export class Bound { unbound: string[]; placed: boolean; }
// The Bind stage of one candidate, in its required order: the parts owner issues its data sources
// (inputs, constants, disclosed facts and the frozen request), every plan action need's binding is
// issued against the frozen contracts, and the parts implementation is placed when a need or an
// issued operation reads one of its resources. One function, so no caller can issue operations before
// the sources they read exist.
export async function issueBindings(composition: screens.Composition, plan: plans.Plan, built: parts.Built, registry: bindings.Registry, original: string, facts: string): Promise<Bound> {
  parts.issueData(plan,built.instance,registry,{request:original,facts:facts});
  let planned: Planned = planBindings(plan,registry);
  let unbound: string[] = planned.reasons;
  composition.bindings = planned.bindings;
  for (let reason of await bindings.issueComposition(registry,composition.bindings,composition.actions,original,facts)) { unbound[unbound.length] = reason; }
  // A checked trigger is raised from a resource this candidate must emit. The decision is made over
  // the issued bindings, never over a planned one a later stage may drop, and dropping a trigger
  // binding can change whether the parts implementation is placed, so it runs to a fixpoint: the bind
  // stage and assembly then read exactly one registry state. A trigger without its resource keeps its
  // need open with the located reason instead of issuing an operation assembly would reject.
  let changed: boolean = true;
  while (changed) {
    changed = false;
    let placedNow: boolean = parts.places(built,registry);
    let kept: bindings.Binding[] = [];
    for (let binding of registry.bindings) {
      let reason: string = triggerReason(plan,binding.id,built,registry,placedNow);
      if (reason !== "") {
        unbound[unbound.length] = reason; delete composition.bindings[binding.id]; changed = true; continue;
      }
      // A row tap is raised from one captured stable row, so the row-scoped identity resource is issued
      // together with the binding that consumes it.
      rowScope(plan,binding.id,built);
      kept[kept.length] = binding;
    }
    registry.bindings = kept;
  }
  let placed: boolean = parts.places(built,registry);
  // The parts implementation is placed when it fills a need and also when an issued operation reads
  // one of its sources, so an emitted operation never names a resource the composition lacks.
  if (placed) { mark(composition.screen,built.instance); }
  // An action need whose binding was issued is implemented by that operation, so its slot names the
  // operation identity the dispatch reaches and reports the state it is really in: an implementation
  // exists and its behavior has not been judged yet. Leaving it open would both misreport the need and
  // demote an accepted coverage judgement of the emitted operation. A slot an instance already fills
  // keeps its filled identity and writes.
  for (let binding of registry.bindings) {
    for (let slot of composition.screen.slots) { if (slot.need === binding.id && binding.owner === "") {
      slot.action = binding.id;
      if (slot.status !== "filled") { slot.status = "unchecked"; slot.reason = "Behavior coverage not yet judged"; }
    } }
  }
  // A trigger is the route to an issued operation. A need whose operation this candidate did not
  // issue claims no event: its slot carries no route nothing raises, the Bind stage's reason for the
  // dropped operation reaches the caller through `Bound.unbound`, and assembly rejects any event left
  // without its operation.
  for (let slot of composition.screen.slots) { if (Object.hasOwn(slot,"event") && !Object.hasOwn(slot,"action")) { delete slot.event; delete slot.trigger; } }
  return {unbound:unbound,placed:placed};
}
// The located reason a plan action's checked trigger cannot be issued in this candidate, or "" when
// it can. This is the same predicate assembly applies: the trigger must be raised from a resource
// this candidate actually issues. A countdown_end trigger needs the completion counter, an
// entry_added or row_tap trigger the records collection, and a time trigger an issued time source. A
// plan argument can never carry a row identity, so a row tap over a list that emits no collection
// keeps its need open instead of claiming a route nothing raises.
function partField(built: parts.Built, name: string): boolean { for (let field of built.instance.fragment.fields) { if (field.name === name) { return true; } } return false; }
// A row_tap binding observes the row it is raised from: the captured stable key and the comparison over
// that row's own values are issued with the binding, never the collection that happens to contain it.
function rowScope(plan: plans.Plan, id: string, built: parts.Built): void {
  let source: plans.Trigger | null = null;
  for (let need of plan.needs) { if (need.id === id && need.type === "action" && Object.hasOwn(need,"trigger")) { source = need.trigger as plans.Trigger; } }
  if (source === null) { return; }
  let trigger: plans.Trigger = source as plans.Trigger;
  if (trigger.on !== "row_tap") { return; }
  let fields: Record<string, unknown>[] = [];
  for (let need of plan.needs) { if (need.id === trigger.at) { fields = s.records(need.spec,"fields"); } }
  parts.rowScope(built,trigger.at,id,fields);
}
function triggerReason(plan: plans.Plan, id: string, built: parts.Built, registry: bindings.Registry, placed: boolean): string {
  for (let need of plan.needs) { if (need.id === id) {
    if (need.type !== "action" || !Object.hasOwn(need,"trigger")) { return ""; }
    let trigger: plans.Trigger = need.trigger as plans.Trigger;
    if (trigger.on === "time") {
      if (!bindings.issued(registry,trigger.at)) { return id+": time trigger target "+trigger.at+" issues no time source"; }
