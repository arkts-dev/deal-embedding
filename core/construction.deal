        if (answer.id === "units_"+choice.need && answer.selected === "preserved" && answer.accepted) { unitsAccepted = true; }
        // Over the issueable alternative bound the written formula question must also be accepted.
        if (answer.id === "written_formula_"+choice.need && !(answer.selected === "written" && answer.accepted)) { writtenAccepted = false; }
