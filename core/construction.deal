      // implementation for the trigger resource to exist at assembly.
      if (bindings.source(registry,trigger.at).owner === "parts" && !placed) { return id+": time trigger source "+trigger.at+" is not emitted because no parts implementation is placed"; }
      return "";
    }
    let resource: string = "records_"+trigger.at;
    if (trigger.on === "countdown_end") { resource = "triggered_"+trigger.at; }
    if (partField(built,resource)) { return ""; }
