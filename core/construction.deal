  // unreachable, and the guard keeps a future second implementation from losing its coverage.
  for (let slot of composition.screen.slots) { if (slot.need === need && slot.status !== "filled") { slot.status = "missing"; slot.reason = reason; } }
}
// The kind an accepted alternative declares; it becomes the slot's allowedKinds and never a label.
function alternativeKind(choice: selecting.Choice): string {
  if (choice.alternative.startsWith("clock_")) { return "clock"; }
  if (choice.alternative.startsWith("entries_")) { return "entries"; }
  if (choice.alternative.startsWith("input_")) { return "inputs"; }
  if (choice.alternative.startsWith("part_")) { return "figure"; }
  if (choice.alternative.startsWith("scalar_")) { return "scalar_read"; }
  if (choice.alternative.startsWith("cat_")) {
