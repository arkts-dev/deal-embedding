}
// A plan action need names its operation and argument sources. The Bind stage resolves the module
// and function exactly against the frozen contracts; an unknown or ambiguous operation issues no
// binding and keeps its need open with the located reason, because the plan decode accepts any name
// and this is the only stage that resolves it.
export class Planned { bindings: Record<string, unknown>; reasons: string[]; }
export function planBindings(plan: plans.Plan, registry: bindings.Registry): Planned {
  let result: Record<string, unknown> = {}; let reasons: string[] = [];
  for (let need of plan.needs) {
    if (need.type !== "action") { continue; }
    let operation: string = s.text(need.spec.operation);
    let matches: number = 0; let module: string = "";
    for (let contract of registry.contracts) { for (let fn of contract.functions) { if (fn.name === operation) { matches = matches+1; module = contract.module; } } }
    if (matches !== 1) { reasons[reasons.length] = need.id+": operation "+operation+" resolves to "+String(matches)+" frozen contract function(s)"; continue; }
    let args: Record<string, unknown> = {};
    if (Object.hasOwn(need.spec,"arguments")) { let raw: Record<string, unknown> = need.spec.arguments as Record<string, unknown>; for (let key of tables.keys(raw)) { args[key] = s.identifier(raw[key]); } }
    result[need.id] = {module:module,function:operation,arguments:args};
  }
  return {bindings:result,reasons:reasons};
}
export async function run(input: writing.Input, context: selecting.Context, plan: plans.Plan, registry: bindings.Registry): Promise<Result> {
