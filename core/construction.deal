  // recorded, so a refused figure type or formula is reported against its need instead of a generic
  // "No implementation".
  for (let problem of definitions.unavailable) { for (let slot of composition.screen.slots) { if (slot.need === problem.need) { slot.status = "missing"; slot.reason = problem.reason; } } }
