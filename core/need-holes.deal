// Append only issued holes. Model-authored subtrees are namespaced and validated;
// they cannot replace maintained fragments, commands, state, actions or view roots.
export function merge(requirements: n.Needs, selected: Record<string, unknown>, uncovered: string[], supplied: Record<string, unknown>, contracts: Record<string, unknown>[]): Record<string, unknown> {
    n.closed(supplied,["reason","sections"]); let reason: string = supplied.reason as string; if (reason === "") { n.fail("Custom reason required"); }
    let sections: Record<string, unknown>[] = decoded.records(supplied.sections); let seen: string[] = [];
    let fragments: Record<string, unknown>[] = []; for (let fragment of decoded.records(selected.fragments)) { fragments[fragments.length] = fragment; }
    let custom: Record<string, unknown>[] = [];
    if (Object.hasOwn(selected,"custom")) { for (let section of decoded.records(selected.custom)) { custom[custom.length] = section; } }
    let display: string[] = []; for (let id of decoded.strings(selected.display)) { display[display.length] = id; }
    for (let section of sections) {
        let id: string = section.id as string; if (!n.contains(uncovered,id) || n.contains(seen,id)) { n.fail("Unissued/duplicate hole"); } seen[seen.length] = id;
        let need: n.Need = n.need(requirements,id);
        if (Object.hasOwn(section,"plan")) {
            n.closed(section,["id","imports","exports","capabilities","plan"]);
            let issued: Record<string, unknown> = issue(requirements,selected,id,contracts);
            for (let key of ["imports","capabilities"]) { if (!contract.same(issued[key],section[key])) { n.fail("Section interface changed: "+key); } }
            let descriptors: Record<string, unknown>[] = []; for (let entry of decoded.records(section.exports)) { descriptors[descriptors.length] = {name:entry.name,type:entry.type}; }
            if (!contract.same(descriptors,issued.exports)) { n.fail("Section exports changed"); }
            for (let capability of decoded.records(section.capabilities)) { c.contract(contracts,capability.module as string,capability.function as string); }
            let config: Record<string, unknown> = {imports:section.imports,exports:section.exports,capabilities:section.capabilities,plan:section.plan}; contract.check(config);
            fragments[fragments.length] = {id:id,kind:"section",config:config}; display[display.length] = id; continue;
        }
        n.closed(section,["id","parameters","result","body","arguments"]);
        if (need.kind !== "custom") { n.fail("Issued need has no pure interface; retain neighboring sections and report this local gap"); }
        n.closed(need.config,["parameters","result","arguments","format"]);
        if (!contract.same(section.parameters,need.config.parameters) || (section.result as string) !== (need.config.result as string) || !sameArguments(decoded.strings(section.arguments),decoded.strings(need.config.arguments))) { n.fail("Custom interface changed"); }
        let parameters: Record<string, unknown>[] = decoded.records(section.parameters); let argumentsData: string[] = decoded.strings(section.arguments); if (parameters.length !== argumentsData.length) { n.fail("Custom arity"); }
        let args: Record<string, unknown>[] = [];
        let env: e.Environment = {port:function(owner: string, path: string): e.Value { return c.port(requirements,owner,path); },field:function(owner: string, path: string): e.Value { n.fail("No row in pure custom hole"); return {expr:"",type:e.wire("null"),dimension:"unknown",dependencies:[]}; }};
        let index: number = 0;
        for (let argument of argumentsData) { let value: e.Value = e.expression(requirements,argument,env,[]); let type: string = parameters[index].type as string; let kind: string = value.type.kind as string; if (kind !== type) { n.fail("Custom argument type"); } args[args.length] = {expr:value.expr}; index = index+1; }
        let result: string = section.result as string; if (result !== "number" && result !== "string" && result !== "boolean") { n.fail("Custom scalar interface required"); }
        custom[custom.length] = {id:id,parameters:parameters,result:result,body:section.body};
        fragments[fragments.length] = {id:id,kind:"custom",config:{label:need.label,format:need.config.format,section:id,arguments:args,result:result}}; display[display.length] = id;
    }
    if (seen.length !== uncovered.length) { n.fail("Custom coverage incomplete"); }
    let result: Record<string, unknown> = {title:selected.title,fragments:fragments,commands:selected.commands,display:display,reason:reason}; if (custom.length > 0) { result.custom = custom; } shapes.validate(result); return result;
}
// Validate extraction boundaries before freezing identities. This does not require
// imported owners to have survived choice; that readiness check belongs to issue().
export function validate(requirements: n.Needs, contracts: Record<string, unknown>[]): null {
    for (let need of requirements.needs) {
        if (need.kind === "section") {
            n.closed(need.config,["imports","exports","capabilities"]);
            for (let entry of decoded.records(need.config.imports)) {
                n.closed(entry,["name","type","term"]); contract.name(entry.name as string); contract.importType(entry.type as string);
                c.editable(requirements,entry.term as string,[]);
                let value: e.Value = e.expression(requirements,entry.term as string,{port:function(owner: string, path: string): e.Value { return c.output(requirements,contracts,owner,path); },field:function(owner: string, path: string): e.Value { n.fail("No row in section import"); return {expr:"",type:e.wire("null"),dimension:"unknown",dependencies:[]}; }},[]);
                let actual: string = value.type.kind as string;
                if ((actual === "array" || actual === "record") && n.term(requirements,entry.term as string).op !== "port") { n.fail("Collection section imports require exact published port terms"); }
                if (actual !== (entry.type as string)) { n.fail("Section "+need.id+" import "+(entry.name as string)+": declared "+(entry.type as string)+", actual "+actual+". Declare array/record imports explicitly; never retag provider collections as scalars."); }
            }
            for (let entry of decoded.records(need.config.exports)) { n.closed(entry,["name","type"]); contract.name(entry.name as string); contract.type(entry.type as string); }
            for (let entry of decoded.records(need.config.capabilities)) { n.closed(entry,["module","function"]); c.contract(contracts,entry.module as string,entry.function as string); }
        }
    } return null;
}
// Derive immutable boundaries from frozen needs and the retained plan, never the response.
export function issue(requirements: n.Needs, selected: Record<string, unknown>, id: string, contracts: Record<string, unknown>[]): Record<string, unknown> {
    let need: n.Need = n.need(requirements,id); let imports: Record<string, unknown>[] = []; let exports: Record<string, unknown>[] = []; let capabilities: Record<string, unknown>[] = [];
    if (need.kind === "section") {
        n.closed(need.config,["imports","exports","capabilities"]);
        for (let entry of decoded.records(need.config.imports)) { n.closed(entry,["name","type","term"]); let value: e.Value = e.expression(requirements,entry.term as string,{port:function(owner: string, path: string): e.Value { return c.output(requirements,contracts,owner,path); },field:function(owner: string, path: string): e.Value { n.fail("No row in section import"); return {expr:"",type:e.wire("null"),dimension:"unknown",dependencies:[]}; }},[]); if ((value.type.kind as string) !== (entry.type as string)) { n.fail("Import type changed"); } for (let owner of value.dependencies) { present(selected,owner); } imports[imports.length] = {name:entry.name,type:entry.type,value:{expr:value.expr}}; }
        exports = decoded.records(need.config.exports); capabilities = decoded.records(need.config.capabilities);
    } else {
        // A rejected presentation candidate still has its exact typed imports/exports.
        let issued: c.Issued = c.enumerate(requirements,contracts); let found: boolean = false;
        for (let candidate of issued.candidates) { if (candidate.need === id && !found) { found = true; for (let owner of candidate.dependencies) { present(selected,owner); }
            if (need.kind === "result") { let format: string = need.config.format as string; let type: string = "number"; if (format === "text") { type = "string"; } let config: Record<string, unknown> = candidate.fragment.config as Record<string, unknown>; imports[imports.length] = {name:"source",type:type,value:config.value}; exports[exports.length] = {name:"value",type:type}; }
            else if (need.kind === "comparison") { let config: Record<string, unknown> = candidate.fragment.config as Record<string, unknown>; imports[imports.length] = {name:"limit",type:"number",value:config.limit}; imports[imports.length] = {name:"actual",type:"number",value:config.actual}; exports[exports.length] = {name:"difference",type:"number"}; }
            else if (need.kind === "input") { let config: Record<string, unknown> = candidate.fragment.config as Record<string, unknown>; let format: string = config.format as string; let type: string = "number"; if (format === "text") { type = "string"; } if (format === "boolean") { type = "boolean"; } exports[exports.length] = {name:"value",type:type}; }
            else if (need.kind === "read") { let fn: Record<string, unknown> = c.contract(contracts,need.config.module as string,need.config.function as string); let result: Record<string, unknown> = fn.result as Record<string, unknown>; let kind: string = result.kind as string; contract.exportType(kind); exports[exports.length] = {name:"result",type:kind}; capabilities[capabilities.length] = {module:need.config.module,function:need.config.function}; let config: Record<string, unknown> = candidate.fragment.config as Record<string, unknown>; let parameters: Record<string, unknown>[] = decoded.records(fn.parameters); let index: number = 0; for (let argument of decoded.records(config.arguments)) { let wire: Record<string, unknown> = parameters[index].type as Record<string, unknown>; let suffix: string = json.stringify(index) as string; if (strings.endsWith(suffix,".0")) { suffix = strings.substring(suffix,0,strings.length(suffix)-2); } imports[imports.length] = {name:"argument"+suffix,type:wire.kind,value:argument}; index = index+1; } }
            else { n.fail("Need requires an explicit typed section interface"); }
        } }
        if (!found) { n.fail("No checked local section interface for "+id); }
    }
    return {id:id,imports:imports,exports:exports,capabilities:capabilities};
}
function sameArguments(left: string[], right: string[]): boolean { if (left.length !== right.length) { return false; } let index: number = 0; for (let value of left) { if (value !== right[index]) { return false; } index = index+1; } return true; }
function present(selected: Record<string, unknown>, id: string): null { for (let fragment of decoded.records(selected.fragments)) { let owner: string = fragment.id as string; if (owner === id) { return null; } } n.fail("Missing section import "+id); return null; }
export function main(): null { return null; }
