import * as m from "./lowering-model";
import * as strings from "std/string";
import * as tables from "std/table";
export function value(model: m.Model, id: string, env: table): string { if (strings.startsWith(id,"$")) { let v: m.Value = m.ref(model,id,env); if (!m.scalar(v.type)) { m.reject("View requires scalar binding"); } return v.code; } let node: table = model.nodes[id]; let op: string = node.op; if (op !== "literal") { m.reject("View computations must bind derived state fields"); } let params: table = node.params; let name: string = params.type; let type: string = m.type(model,name); if (!m.scalar(type)) { m.reject("View literal must be scalar"); } let raw: string = params.value; return m.initial(model,type,m.data(raw)); }
export function render(model: m.Model, views: table, actions: table, id: string, env: table, active: string[]): string { if (m.contains(active,id)) { m.reject("View cycle"); } if (!m.present(views,id)) { m.reject("Unknown view "+id); } let view: table = views[id]; let next: string[] = []; for (let entry: string of active) { next[next.length] = entry; } next[next.length] = id; let each: string = view.each; if (each !== "") { if (!strings.startsWith(each,"$")) { m.reject("List must bind prepared state"); } let source: m.Value = m.ref(model,each,env); let type: string = m.element(source.type); if (type === "") { m.reject("List needs array"); } let row: string = m.fresh(model); let nested: table = m.extend(env,"row",{type:type,code:row}); let keyRef: string = view.key; let key: m.Value = m.ref(model,keyRef,nested); if (key.type !== "number" && key.type !== "string") { m.reject("List key type"); } return "ForEach("+source.code+", "+row+": app."+type+", key: "+key.code+") {\n"+component(model,views,actions,view,nested,next)+"}\n"; } return component(model,views,actions,view,env,next); }
function component(model: m.Model, views: table, actions: table, view: table, env: table, active: string[]): string { let name: string = view.component; m.name(name); let props: table[] = view.props; let events: table[] = view.events; let text: string = ""; let enabled: boolean = false; for (let prop: table of props) { let name: string = prop.name; let node: string = prop.node; if (name === "enabled") { enabled = true; } if (text !== "") { text = text+","; } text = text+m.name(name)+": "+value(model,node,env); } if (m.contains(["Button","PrimaryAction","SecondaryAction"],name) && !enabled) { if (text !== "") { text = text+","; } text = text+"enabled: !state.m_loading"; } for (let event: table of events) { let action: string = event.action; if (!m.present(actions,action)) { m.reject("Unknown event action "+action); } let type: string = actions[action]; let payload: table[] = event.payload; let values: table = {}; for (let field: table of payload) { let name: string = field.field; let node: string = field.node; let code: string = "payload"; if (node !== "$payload") { code = value(model,node,env); } values[name] = code; } let keys: string[] = []; for (let field: table of m.fields(model,type)) { let name: string = field.name; keys[keys.length] = name; } m.closed(values,keys); if (text !== "") { text = text+","; } let name: string = event.name; text = text+m.name(name)+": action app."+type+" "+m.copy(model,type,"",values); } let children: string[] = view.children; let result: string = "ui."+name+"("+text+")"; if (children.length === 0) { result = result+"\n"; } else { result = result+" {\n"; for (let child: string of children) { result = result+render(model,views,actions,child,env,active); } result = result+"}\n"; } let condition: string = view["when"]; if (condition !== "") { result = "When("+value(model,condition,env)+") {\n"+result+"}\n"; } return result; }
export function main(): null { return null; }
