import * as decoded from "../decoded";
import * as m from "./lowering-model";
import * as strings from "std/string";
import * as tables from "std/table";
export function value(model: m.Model, id: string, env: Record<string, unknown>): string { if (strings.startsWith(id,"$")) { let v: m.Value = m.ref(model,id,env); if (!m.scalar(v.type)) { m.reject("View requires scalar binding"); } return v.code; } let node: Record<string, unknown> = (model.nodes[id] as Record<string, unknown>); let op: string = (node.op as string); if (op !== "literal") { m.reject("View computations must bind derived state fields"); } let params: Record<string, unknown> = (node.params as Record<string, unknown>); let name: string = (params.type as string); let type: string = m.type(model,name); if (!m.scalar(type)) { m.reject("View literal must be scalar"); } let raw: string = (params.value as string); return m.initial(model,type,m.data(raw)); }
export function render(model: m.Model, views: Record<string, unknown>, actions: Record<string, unknown>, id: string, env: Record<string, unknown>, active: string[]): string { if (m.contains(active,id)) { m.reject("View cycle"); } if (!m.present(views,id)) { m.reject("Unknown view "+id); } let view: Record<string, unknown> = (views[id] as Record<string, unknown>); let next: string[] = []; for (let entry of active) { next[next.length] = entry; } next[next.length] = id; let each: string = (view.each as string); if (each !== "") { if (!strings.startsWith(each,"$")) { m.reject("List must bind prepared state"); } let source: m.Value = m.ref(model,each,env); let type: string = m.element(source.type); if (type === "") { m.reject("List needs array"); } let row: string = m.fresh(model); let nested: Record<string, unknown> = m.extend(env,"row",{type:type,code:row}); let keyRef: string = (view.key as string); let key: m.Value = m.ref(model,keyRef,nested); if (key.type !== "number" && key.type !== "string") { m.reject("List key type"); } return "ForEach("+source.code+", "+row+": app."+type+", key: "+key.code+") {\n"+component(model,views,actions,view,nested,next)+"}\n"; } return component(model,views,actions,view,env,next); }
function component(model: m.Model, views: Record<string, unknown>, actions: Record<string, unknown>, view: Record<string, unknown>, env: Record<string, unknown>, active: string[]): string { let name: string = (view.component as string); m.name(name); let props: Record<string, unknown>[] = decoded.records(view.props); let events: Record<string, unknown>[] = decoded.records(view.events); let text: string = ""; let enabled: boolean = false; for (let prop of props) { let name: string = (prop.name as string); let node: string = (prop.node as string); if (name === "enabled") { enabled = true; } if (text !== "") { text = text+","; } text = text+m.name(name)+": "+value(model,node,env); } if (m.contains(["Button","PrimaryAction","SecondaryAction"],name) && !enabled) { if (text !== "") { text = text+","; } text = text+"enabled: !state.m_loading"; } for (let event of events) { let action: string = (event.action as string); if (!m.present(actions,action)) { m.reject("Unknown event action "+action); } let type: string = (actions[action] as string); let payload: Record<string, unknown>[] = decoded.records(event.payload); let values: Record<string, unknown> = {}; for (let field of payload) { let name: string = (field.field as string); let node: string = (field.node as string); let code: string = "payload"; if (node !== "$payload") { code = value(model,node,env); } values[name] = code; } let keys: string[] = []; for (let field of m.fields(model,type)) { let name: string = (field.name as string); keys[keys.length] = name; } m.closed(values,keys); if (text !== "") { text = text+","; } let name: string = (event.name as string); text = text+m.name(name)+": action app."+type+" "+m.copy(model,type,"",values); } let children: string[] = decoded.strings(view.children); let result: string = "ui."+name+"("+text+")"; if (children.length === 0) { result = result+"\n"; } else { result = result+" {\n"; for (let child of children) { result = result+render(model,views,actions,child,env,active); } result = result+"}\n"; } let condition: string = (view["when"] as string); if (condition !== "") { result = "When("+value(model,condition,env)+") {\n"+result+"}\n"; } return result; }
export function main(): null { return null; }
