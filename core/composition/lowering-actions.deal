import * as decoded from "../decoded";
import * as m from "./lowering-model";
import * as x from "./lowering-expressions";
import * as codec from "./lowering-codec";
import * as syntax from "embedding/syntax";
import * as tables from "std/table";
import * as math from "std/math";

export class Context { model: m.Model; execution: Record<string, unknown>; workflows: Record<string, unknown>[]; stepTypes: Record<string, unknown>; imports: Record<string, unknown>; workflowSource: string; readSource: string; quotesSource: string; }
export function workflow(action: Record<string, unknown>): boolean { let steps: Record<string, unknown>[] = decoded.records(action.steps); for (let step of steps) { let kind: string = (step.kind as string); if (kind === "call" || kind === "eachCall") { return true; } } return false; }
export function epoch(id: string): string { return "workflow"+m.name(id)+"Epoch"; }
export function busy(id: string): string { return "workflow"+m.name(id)+"Pending"; }
export function failure(id: string): string { return "workflow"+m.name(id)+"Error"; }
export function names(id: string): Record<string, unknown> { let prefix: string = "workflow_"+m.symbol(id)+"_"; return {FragmentState:"State",requestEpoch:m.symbol(epoch(id)),requestPending:m.symbol(busy(id)),requestError:m.symbol(failure(id)),sessionEpoch:"m_sessionEpoch",sessionClock:"m_sessionClock",loading:"m_loading",error:"m_error",copyState:prefix+"copy",clearSuccess:prefix+"clear",start:prefix+"start",invalidate:prefix+"invalidate"}; }
export function writes(c: Context, id: string): string[] { let workflows: Record<string, unknown> = (c.execution.workflows as Record<string, unknown>); let entry: Record<string, unknown> = (workflows[id] as Record<string, unknown>); let result: string[] = decoded.strings(entry.writes); return result; }
export function invalidate(c: Context, action: string): string { let invalidations: Record<string, unknown> = (c.execution.invalidations as Record<string, unknown>); let entries: Record<string, unknown>[] = decoded.records(invalidations[action]); let result: string = ""; for (let entry of entries) { let id: string = (entry.id as string); let clear: boolean = (entry.clear as boolean); let markers: string = ""; for (let field of writes(c,id)) { if (m.field(c.model,"State",field) === "boolean") { markers = markers+"next."+m.symbol(field)+" = false;\n"; } } result = result+"next = workflow_"+m.symbol(id)+"_invalidate(next);\n"; if (!clear) { markers = "if (state."+m.symbol(busy(id))+") { "+markers+" }\n"; } result = result+markers; } return result; }
export function cancelAll(c: Context): string { let result: string = ""; for (let action of c.workflows) { let id: string = (action.id as string); result = result+"next."+m.symbol(busy(id))+" = false; next."+m.symbol(epoch(id))+" = state."+m.symbol(epoch(id))+" + 1;\n"; } return result; }
export function emitControl(c: Context, control: Record<string, unknown>, actionTypes: Record<string, unknown>): string { let field: string = (control.field as string); if (m.field(c.model,"State",field) !== "number") { m.reject("Numeric control requires number"); } let action: string = "Set"+m.name(field); let type: string = m.declare(c.model,m.symbol(action),[{name:"value",type:"number"}]); actionTypes[action] = type; let lo: number = (control.minimum as number); let hi: number = (control.maximum as number); let step: number = (control.step as number); let widget: string = (control.widget as string); if (widget === "time" && (lo < 0 || hi > 1439)) { m.reject("Time control requires minute-of-day bounds"); } if (lo-lo !== 0 || hi-hi !== 0 || step-step !== 0 || math.floor(lo) !== lo || math.floor(hi) !== hi || lo < -2147483648 || hi > 2147483647 || lo > hi || step <= 0 || math.floor(step) !== step) { m.reject("Invalid integral control bounds"); } let invalidations: string[] = decoded.strings(control.invalidate); let invalid: string = ""; for (let entry of invalidations) { if (m.field(c.model,"State",entry) !== "boolean") { m.reject("Control invalidate entry must be boolean"); } invalid = invalid+"next."+m.symbol(entry)+" = false;\n"; } invalid = invalid+invalidate(c,action); return "// @ui-update\nexport function update"+m.symbol(action)+"(state: State, action: "+type+"): State { let next: State = "+m.copy(c.model,"State","state",{})+"; if (action.m_value - action.m_value !== 0 || math.floor(action.m_value) !== action.m_value || !values.inBounds(action.m_value,"+m.decimal(lo)+","+m.decimal(hi)+")) { return next; } next."+m.symbol(field)+" = action.m_value;\n"+invalid+"return recompute(next); }\n"; }
export function emitAction(c: Context, action: Record<string, unknown>, views: Record<string, unknown>[], actionTypes: Record<string, unknown>): string {
    let model: m.Model = c.model; let id: string = (action.id as string); m.name(id); let fields: Record<string, unknown>[] = decoded.records(action.fields); let fs: Record<string, unknown>[] = []; for (let entry of fields) { let name: string = (entry.name as string); let type: string = (entry.type as string); fs[fs.length] = {name:name,type:m.type(model,type)}; } let type: string = m.declare(model,m.symbol(id),fs); if (m.present(actionTypes,id)) { m.reject("Duplicate action"); } actionTypes[id] = type;
    let env: Record<string, unknown> = {state:m.value("State","next"),action:m.value(type,"action")};
    let updates: string = localUpdates(c,action,env)+clockUpdate(c,id,type,views);
    let steps: Record<string, unknown>[] = decoded.records(action.steps); let asynchronous: boolean = workflow(action); let result: string = "// @ui-update\nexport function update"+m.symbol(id)+"(state: State, action: "+type+"): State { let next: State = "+m.copy(model,"State","state",{})+";\n"+updates;
    if (asynchronous) { for (let step of steps) { let kind: string = (step.kind as string); let bind: string = (step.bind as string); if (kind === "set" && m.field(model,"State",bind) === "boolean") { result = result+"next."+m.symbol(bind)+" = false;\n"; } } result = result+"next = workflow_"+m.symbol(id)+"_start(next);\n"; }
    result = result+"return recompute(next); }\n";
    if (asynchronous) { return result+execution(c,action,type,env); }
    if (steps.length > 0) { m.reject("Workflow without provider call: put local changes in updates"); } return result;
}
function localUpdates(c: Context, action: Record<string, unknown>, env: Record<string, unknown>): string {
    let model: m.Model = c.model; let updates: x.Output = {code:""}; let assignments: string = ""; let us: Record<string, unknown>[] = decoded.records(action.updates); let reset: boolean = false;
    for (let update of us) { let field: string = (update.field as string); let node: string = (update.node as string); let value: m.Value = m.require(x.expr(model,node,env,updates,[]),m.field(model,"State",field)); assignments = assignments+"next."+m.symbol(field)+" = "+value.code+";\n"; if (field === "sessionEpoch") { reset = true; } }
    updates.code = updates.code+assignments; if (reset) { updates.code = updates.code+cancelAll(c); }
    return updates.code;
}
function clockUpdate(c: Context, id: string, type: string, views: Record<string, unknown>[]): string {
    let model: m.Model = c.model; let updates: x.Output = {code:""}; let clock: boolean = false;
    for (let view of views) { let component: string = (view.component as string); if (component === "SessionClock") { let events: Record<string, unknown>[] = decoded.records(view.events); for (let event of events) { let target: string = (event.action as string); let name: string = (event.name as string); if (target === id && name === "onTick") { clock = true; let payload: Record<string, unknown>[] = decoded.records(event.payload); let field: string = ""; for (let entry of payload) { let node: string = (entry.node as string); if (node === "$payload") { field = (entry.field as string); } } if (field === "" || m.field(model,type,field) !== "number") { m.reject("SessionClock requires one captured numeric payload"); } let copy: string = "clockCopy"+m.symbol(id); let invalid: string = "clockInvalidate"+m.symbol(id); model.addHelper("function "+copy+"(state:State):State { return "+m.copy(model,"State","state",{})+"; }\nfunction "+invalid+"(state:State):State { let next:State = "+m.copy(model,"State","state",{})+"; "+cancelAll(c)+"return next; }\n"); model.addHelper(syntax.functionSource(c.workflowSource,"clock",{FragmentState:"State",sessionEpoch:"m_sessionEpoch",sessionClock:"m_sessionClock",clock:"clock"+m.symbol(id),copyState:copy,invalidateAll:invalid})); updates.code = updates.code+"next = clock"+m.symbol(id)+"(next,action."+m.symbol(field)+");\n"; } } } }
    if (!clock) { updates.code = updates.code+invalidate(c,id); }
    return updates.code;
}
function stepBody(c: Context, action: Record<string, unknown>, env: Record<string, unknown>): string {
    let model: m.Model = c.model; let id: string = (action.id as string);
    let body: x.Output = {code:""}; let steps: Record<string, unknown>[] = decoded.records(action.steps); let stepEnv: Record<string, unknown> = env;
    for (let step of steps) { let kind: string = (step.kind as string); let bind: string = (step.bind as string); if (kind === "call" || kind === "eachCall") {
        stepEnv = providerStep(c,id,step,stepEnv,body);
    } else { let node: string = (step.node as string); let value: m.Value = m.require(x.expr(model,node,stepEnv,body,[]),m.field(model,"State",bind)); body.code = body.code+"next."+m.symbol(bind)+" = "+value.code+";\n"; } body.code = body.code+"next = recompute(next);\n"; }
    return body.code;
}
function providerStep(c: Context, id: string, step: Record<string, unknown>, stepEnv: Record<string, unknown>, body: x.Output): Record<string, unknown> {
        let model: m.Model = c.model; let kind: string = (step.kind as string); let bind: string = (step.bind as string);
        let scope: Record<string, unknown> = stepEnv; let source: string = ""; let row: string = ""; let collection: string = ""; let rowType: string = ""; let element: string = "";
        if (kind === "eachCall") { let each: string = (step.each as string); let input: m.Value = x.expr(model,each,stepEnv,body,[]); rowType = m.element(input.type); if (rowType === "") { m.reject("eachCall requires an array"); } row = m.fresh(model); collection = m.fresh(model); element = m.element(m.field(model,"State",bind)); if (element === "") { m.reject("eachCall bind requires an array"); } source = input.code; scope = m.extend(stepEnv,"item",{type:rowType,code:row}); }
        let guard: string = (step["when"] as string); let condition: string = "true"; if (guard !== "") { condition = m.require(x.expr(model,guard,scope,body,[]),"boolean").code; }
        let stepId: string = (step.id as string); let rt: string = (c.stepTypes[id+"/"+stepId] as string); let dest: string = m.fresh(model);
        let decoded: string = decodeStep(c,step,scope,rt,dest);
        stepEnv = m.extend(stepEnv,stepId,{type:rt,code:dest}); stepEnv = m.extend(stepEnv,stepId+"Present",{type:"boolean",code:condition});
        let projectionEnv: Record<string, unknown> = m.extend(m.extend(scope,stepId,{type:rt,code:dest}),stepId+"Present",{type:"boolean",code:condition});
        body.code = body.code+readBlock(c,step,projectionEnv,{rt:rt,dest:dest,condition:condition,collection:collection,rowType:rowType,element:element,row:row,source:source,decoded:decoded});
    return stepEnv;
}
function decodeStep(c: Context, step: Record<string, unknown>, scope: Record<string, unknown>, rt: string, dest: string): string {
    let model: m.Model = c.model; let module: string = (step.module as string); let fn: string = (step["function"] as string); let contract: Record<string, unknown> = m.functionContract(model,module,fn);
    let args: string[] = decoded.strings(step.args); let params: Record<string, unknown>[] = decoded.records(contract.parameters); if (args.length !== params.length) { m.reject("Capability arity"); }
    let decoded: x.Output = {code:""}; let av: string = ""; let index: number = 0;
    for (let param of params) { let schema: Record<string, unknown> = (param.type as Record<string, unknown>); let value: m.Value = x.expr(model,args[index],scope,decoded,[]); if (index > 0) { av = av+","; } av = av+codec.encode(model,value,schema,decoded); index = index+1; }
    let alias: string = (c.imports[module] as string); let value: m.Value = codec.decode(model,rt,"await "+alias+"."+fn+"("+av+")",decoded);
    return decoded.code+dest+" = "+value.code+";\n";
}
function projectStep(c: Context, step: Record<string, unknown>, env: Record<string, unknown>, collection: string): string {
    let model: m.Model = c.model; let kind: string = (step.kind as string); let bind: string = (step.bind as string); let projected: x.Output = {code:""};
    if (bind !== "") { let expected: string = m.field(model,"State",bind); if (kind === "eachCall") { expected = m.element(expected); } let node: string = (step.node as string); let value: m.Value = m.require(x.expr(model,node,env,projected,[]),expected); if (kind === "eachCall") { projected.code = projected.code+collection+"["+collection+".length] = "+value.code+";\n"; } else { projected.code = projected.code+"next."+m.symbol(bind)+" = "+value.code+";\n"; } }
    return projected.code;
}
function readBlock(c: Context, step: Record<string, unknown>, env: Record<string, unknown>, bindings: Record<string, unknown>): string {
    let model: m.Model = c.model; let kind: string = (step.kind as string); let bind: string = (step.bind as string);
    let rt: string = (bindings.rt as string); let dest: string = (bindings.dest as string); let condition: string = (bindings.condition as string); let collection: string = (bindings.collection as string);
    let projected: string = projectStep(c,step,env,collection);
    let decoded: string = (bindings.decoded as string);
    let read: string = syntax.bodySource(c.readSource,"read",{ProviderReply:rt,reply:dest},{emptyReply:m.defaultValue(model,rt),available:condition},{decodeReply:decoded,projectReply:projected});
    if (kind === "eachCall") { let rowType: string = (bindings.rowType as string); let element: string = (bindings.element as string); let row: string = (bindings.row as string); let source: string = (bindings.source as string); return syntax.bodySource(c.quotesSource,"collect",{QuoteRow:rowType,QuoteValue:element,results:collection,item:row},{source:source},{readQuote:read,commitQuotes:"next."+m.symbol(bind)+" = "+collection+";"}); }
    return read;
}
function execution(c: Context, action: Record<string, unknown>, type: string, env: Record<string, unknown>): string {
    let model: m.Model = c.model; let id: string = (action.id as string); let changed: string[] = writes(c,id); let completion: Record<string, unknown>[] = [{name:"sessionEpoch",type:"number"}]; completion[completion.length] = {name:epoch(id),type:"number"}; let completionValues: Record<string, unknown> = {};
    for (let entry of m.fields(model,"State")) { let field: string = (entry.name as string); let type: string = (entry.type as string); if (m.contains(changed,field) || field === busy(id) || field === failure(id)) { completion[completion.length] = {name:field,type:type}; completionValues[field] = "action."+m.symbol(field); } }
    let done: string = m.declare(model,"Done"+m.decimal(model.serial),completion); model.serial = model.serial+1;
    let body: string = stepBody(c,action,env);
    let prefix: string = "workflow_"+m.symbol(id)+"_"; let names: Record<string, unknown> = names(id); names["FragmentAction"] = type; names["FragmentDone"] = done; names["complete"] = prefix+"complete"; names["execute"] = prefix+"execute"; names["merge"] = prefix+"merge"; names["run"] = "run"+m.symbol(id); names["finish"] = "finish"+m.symbol(id);
    let result: string = "function "+prefix+"copy(state:State):State { return "+m.copy(model,"State","state",{})+"; }\nfunction "+prefix+"clear(state:State):State { return "+m.copy(model,"State","state",{})+"; }\n";
    result = result+syntax.functionSource(c.workflowSource,"start",names)+syntax.functionSource(c.workflowSource,"invalidate",names);
    result = result+"function "+prefix+"complete(state:State):"+done+" { return "+m.copy(model,done,"state",{})+"; }\nasync function "+prefix+"execute(state:State,action:"+type+"):Promise<State> { let next:State = "+m.copy(model,"State","state",{})+";\n"+body+"return next; }\nfunction "+prefix+"merge(state:State,action:"+done+"):State { return "+m.copy(model,"State","state",completionValues)+"; }\n";
    return result+"// @ui-effect\n"+syntax.functionSource(c.workflowSource,"run",names)+"// @ui-update\n"+syntax.functionSource(c.workflowSource,"finish",names);
}
export function main(): null { return null; }
