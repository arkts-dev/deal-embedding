import * as m from "./lowering-model";
import * as strings from "std/string";
import * as tables from "std/table";
function unique(entries: table[], key: string): null { let seen: string[] = []; for (let entry: table of entries) { let value: string = entry[key]; if (m.contains(seen,value)) { m.reject("Duplicate "+key); } seen[seen.length] = value; } return null; }
export function references(node: table): string[] { let args: string[] = node.args; let result: string[] = []; for (let arg: string of args) { result[result.length] = arg; } let p: table = node.params; let op: string = node.op; if (op === "record" || op === "update") { let fields: table[] = p.fields; for (let field: table of fields) { let ref: string = field.node; result[result.length] = ref; } } if (op === "allocate") { let quotas: table[] = p.quotas; for (let quota: table of quotas) { let ref: string = quota.minimum; result[result.length] = ref; } } if (op === "alternatives") { let roles: table[] = p.roles; for (let role: table of roles) { let ref: string = role.quantity; result[result.length] = ref; } } if (op === "selections") { let cs: table[] = p.constraints; for (let c: table of cs) { let lo: string = c.minimum; let hi: string = c.maximum; result[result.length] = lo; result[result.length] = hi; } } if (op === "covers") { let groups: table[] = p.groups; for (let group: table of groups) { let minimum: string = group.minimum; let predicate: string = group.predicate; result[result.length] = minimum; result[result.length] = predicate; } } return result; }
export function checkNode(model: m.Model, id: string, active: string[]): null { if (strings.startsWith(id,"$")) { return null; } if (m.contains(active,id)) { m.reject("Expression cycle at "+id); } if (!m.present(model.nodes,id)) { m.reject("Unknown expression "+id); } let next: string[] = []; for (let entry: string of active) { next[next.length] = entry; } next[next.length] = id; let node: table = model.nodes[id]; for (let ref: string of references(node)) { checkNode(model,ref,next); } return null; }
export function shapes(model: m.Model, p: table): null {
    let keys: string[] = ["records","state","nodes","derived","controls","actions","views","root"]; if (model.allowCustom) { keys[keys.length] = "custom"; keys[keys.length] = "reason"; } m.closed(p,keys);
    let records: table[] = p.records; for (let record: table of records) { m.closed(record,["name","fields"]); let fields: table[] = record.fields; for (let field: table of fields) { m.closed(field,["name","type"]); } unique(fields,"name"); }
    let state: table[] = p.state; unique(state,"name"); for (let field: table of state) { m.closed(field,["name","type","initial"]); }
    let derived: table[] = p.derived; unique(derived,"field"); for (let field: table of derived) { m.closed(field,["field","node"]); }
    let controls: table[] = p.controls; unique(controls,"field"); for (let control: table of controls) { m.closed(control,["field","label","widget","minimum","maximum","step","invalidate"]); }
    let actions: table[] = p.actions; unique(actions,"id"); for (let action: table of actions) { m.closed(action,["id","fields","updates","steps"]); let fields: table[] = action.fields; unique(fields,"name"); for (let field: table of fields) { m.closed(field,["name","type"]); } let updates: table[] = action.updates; unique(updates,"field"); for (let update: table of updates) { m.closed(update,["field","node"]); } let steps: table[] = action.steps; let names: string[] = ["state","action","row","left","right"]; for (let step: table of steps) { let kind: string = step.kind; if (kind === "call" || kind === "eachCall") { let keys: string[] = ["kind","id","module","function","args","bind","node","when"]; if (kind === "eachCall") { keys[keys.length] = "each"; } m.closed(step,keys); let name: string = step.id; m.name(name); if (m.contains(names,name) || m.contains(names,name+"Present")) { m.reject("Duplicate/reserved workflow reference"); } names[names.length] = name; names[names.length] = name+"Present"; } else { if (kind !== "set") { m.reject("Unknown workflow step"); } m.closed(step,["kind","bind","node"]); } } }
    let views: table[] = p.views; unique(views,"id"); for (let view: table of views) { m.closed(view,["id","component","props","events","children","each","key","when"]); let props: table[] = view.props; unique(props,"name"); let names: string[] = []; for (let prop: table of props) { m.closed(prop,["name","node"]); let name: string = prop.name; names[names.length] = name; } let events: table[] = view.events; unique(events,"name"); for (let event: table of events) { m.closed(event,["name","action","payload"]); let name: string = event.name; if (m.contains(names,name)) { m.reject("Duplicate prop/event"); } let payload: table[] = event.payload; unique(payload,"field"); for (let field: table of payload) { m.closed(field,["field","node"]); } } }
    let arities: table = {literal:0,record:0,add:2,subtract:2,multiply:2,divide:2,floor:1,ceil:1,abs:1,numberText:1,eq:2,ne:2,lt:2,le:2,gt:2,ge:2,choicePick:1,choiceSelect:3,choiceValid:3,resultText:2,fragmentComparison:3,comparisonValue:1,inputEdit:2,and:2,or:2,not:1,choose:3,integer:1,clock:1,length:1,filter:2,project:2,sum:2,any:2,all:2,update:2,first:1,lookup:2,field:1,now:0,sort:1,basket:1,alternatives:1,stockQualified:2,selections:2,allocate:3,covers:2,join:4};
    let nodes: table[] = p.nodes; unique(nodes,"id"); for (let node: table of nodes) { m.closed(node,["id","op","args","params"]); let id: string = node.id; m.name(id); let op: string = node.op; let params: table = node.params; let args: string[] = node.args; if (m.contains(["selections","stockQualified","field"],op) && !model.experimental) { m.reject("Experimental selection operation is not registered for generation"); } if (m.present(arities,op)) { let arity: number = arities[op]; if (args.length !== arity) { m.reject("Wrong arity for "+op); } } else { if (op !== "array" && op !== "concat" && !(model.allowCustom && op === "custom")) { m.reject("Unknown operation "+op); } }
        let keys: string[] = [];
        if (m.contains(["choicePick","choiceSelect","choiceValid","resultText","fragmentComparison","comparisonValue","inputEdit"],op) && !model.fragments) { m.reject("Fragment operation is not a custom graph operator"); }
        if (op === "resultText") { keys = ["format"]; } if (op === "comparisonValue") { keys = ["field"]; } if (op === "inputEdit") { keys = ["format","minimum","maximum"]; } if (op === "custom") { keys = ["section"]; } if (op === "literal") { keys = ["type","value"]; } if (op === "record") { keys = ["type","fields"]; } if (op === "update") { keys = ["fields"]; } if (op === "array") { keys = ["element"]; } if (op === "lookup") { keys = ["key"]; } if (op === "sort" || op === "field") { keys = ["field"]; } if (op === "basket") { keys = ["id","quantity"]; } if (op === "selections") { keys = ["type","quantity","cost","capacity","constraints"]; } if (op === "alternatives") { keys = ["type","roles"]; } if (op === "allocate") { keys = ["quantity","cost","quotas"]; } if (op === "covers") { keys = ["components","key","itemId","quantity","groups"]; } m.closed(params,keys);
        if (op === "record" || op === "update") { let fields: table[] = params.fields; unique(fields,"field"); for (let field: table of fields) { m.closed(field,["field","node"]); } }
        if (op === "allocate") { let quotas: table[] = params.quotas; for (let quota: table of quotas) { m.closed(quota,["field","minimum"]); } }
        if (op === "alternatives") { let roles: table[] = params.roles; for (let role: table of roles) { m.closed(role,["field","quantity"]); } }
        if (op === "covers") { let groups: table[] = params.groups; for (let group: table of groups) { m.closed(group,["predicate","minimum"]); } }
    }
    return null;
}
function issue(issues: string[], message: string): null { if (!m.contains(issues,message)) { issues[issues.length] = message; } return null; }
function target(model: m.Model, issues: string[], path: string, field: string): null { let found: boolean = false; for (let entry: table of m.fields(model,"State")) { let name: string = entry.name; if (name === field) { found = true; } } if (!found) { issue(issues,path+": state field '"+field+"' is undeclared. Declare its type and JSON initial value in state; derived binds an existing field, not a new declaration."); } return null; }
function reference(model: m.Model, issues: string[], path: string, ref: string): null { if (strings.startsWith(ref,"$state.")) { let parts: string[] = strings.split(ref,"."); target(model,issues,path,parts[1]); } else { if (strings.startsWith(ref,"$payload")) { issue(issues,path+": payload is only valid as an event payload binding"); } else { if (!strings.startsWith(ref,"$") && !m.present(model.nodes,ref)) { issue(issues,path+": unknown expression '"+ref+"'"); } } } return null; }
export function bindings(model: m.Model, p: table): null { let issues: string[] = []; for (let id: string of tables.keys(model.nodes)) { let node: table = model.nodes[id]; for (let ref: string of references(node)) { reference(model,issues,"nodes["+id+"]",ref); } } let derived: table[] = p.derived; for (let entry: table of derived) { let field: string = entry.field; let node: string = entry.node; target(model,issues,"derived.field",field); reference(model,issues,"derived.node",node); } let controls: table[] = p.controls; for (let control: table of controls) { let field: string = control.field; target(model,issues,"controls.field",field); let invalidations: string[] = control.invalidate; for (let invalid: string of invalidations) { let found: boolean = false; for (let entry: table of m.fields(model,"State")) { let name: string = entry.name; let type: string = entry.type; if (name === invalid && type === "boolean") { found = true; } } if (!found) { issue(issues,"controls.invalidate: '"+invalid+"' must name a declared BOOLEAN validity field"); } } } let actions: table[] = p.actions; for (let action: table of actions) { let updates: table[] = action.updates; for (let update: table of updates) { let field: string = update.field; let node: string = update.node; target(model,issues,"actions.updates.field",field); reference(model,issues,"actions.updates.node",node); } let steps: table[] = action.steps; for (let step: table of steps) { let bind: string = step.bind; if (bind !== "") { target(model,issues,"actions.steps.bind",bind); } let kind: string = step.kind; if (kind === "call" && bind !== "") { let node: string = step.node; if (node === "") { issue(issues,"actions.steps.node: a nonempty bind requires an explicit projection"); } } } } let views: table[] = p.views; for (let view: table of views) { let props: table[] = view.props; for (let prop: table of props) { let node: string = prop.node; reference(model,issues,"views",node); if (!strings.startsWith(node,"$") && m.present(model.nodes,node)) { let entry: table = model.nodes[node]; let op: string = entry.op; if (op !== "literal") { issue(issues,"views: bind computations through derived state fields"); } } } } if (issues.length > 0) { let message: string = "Behavioral binding errors (workspace unchanged):\n"; for (let entry: string of issues) { message = message+entry+"\n"; } m.reject(message); } return null; }
export function main(): null { return null; }
