import * as decoded from "../decoded";
import * as m from "./lowering-model";
import * as strings from "std/string";
import * as tables from "std/table";
function unique(entries: Record<string, unknown>[], key: string): null { let seen: string[] = []; for (let entry of entries) { let value: string = (entry[key] as string); if (m.contains(seen,value)) { m.reject("Duplicate "+key); } seen[seen.length] = value; } return null; }
export function references(node: Record<string, unknown>): string[] { let args: string[] = decoded.strings(node.args); let result: string[] = []; for (let arg of args) { result[result.length] = arg; } let p: Record<string, unknown> = (node.params as Record<string, unknown>); let op: string = (node.op as string); if (op === "record" || op === "update") { let fields: Record<string, unknown>[] = decoded.records(p.fields); for (let field of fields) { let ref: string = (field.node as string); result[result.length] = ref; } } if (op === "allocate") { let quotas: Record<string, unknown>[] = decoded.records(p.quotas); for (let quota of quotas) { let ref: string = (quota.minimum as string); result[result.length] = ref; } } if (op === "alternatives") { let roles: Record<string, unknown>[] = decoded.records(p.roles); for (let role of roles) { let ref: string = (role.quantity as string); result[result.length] = ref; } } if (op === "selections") { let cs: Record<string, unknown>[] = decoded.records(p.constraints); for (let c of cs) { let lo: string = (c.minimum as string); let hi: string = (c.maximum as string); result[result.length] = lo; result[result.length] = hi; } } if (op === "covers") { let groups: Record<string, unknown>[] = decoded.records(p.groups); for (let group of groups) { let minimum: string = (group.minimum as string); let predicate: string = (group.predicate as string); result[result.length] = minimum; result[result.length] = predicate; } } return result; }
export function checkNode(model: m.Model, id: string, active: string[]): null { if (strings.startsWith(id,"$")) { return null; } if (m.contains(active,id)) { m.reject("Expression cycle at "+id); } if (!model.hasNode(id)) { m.reject("Unknown expression "+id); } let next: string[] = []; for (let entry of active) { next[next.length] = entry; } next[next.length] = id; let node: Record<string, unknown> = model.node(id); for (let ref of references(node)) { checkNode(model,ref,next); } return null; }
export function shapes(model: m.Model, p: Record<string, unknown>): null {
    let keys: string[] = ["records","state","nodes","derived","controls","actions","views","root"]; if (model.allowCustom) { keys[keys.length] = "custom"; keys[keys.length] = "reason"; } m.closed(p,keys);
    let records: Record<string, unknown>[] = decoded.records(p.records); for (let record of records) { m.closed(record,["name","fields"]); let fields: Record<string, unknown>[] = decoded.records(record.fields); for (let field of fields) { m.closed(field,["name","type"]); } unique(fields,"name"); }
    let state: Record<string, unknown>[] = decoded.records(p.state); unique(state,"name"); for (let field of state) { m.closed(field,["name","type","initial"]); }
    let derived: Record<string, unknown>[] = decoded.records(p.derived); unique(derived,"field"); for (let field of derived) { m.closed(field,["field","node"]); }
    let controls: Record<string, unknown>[] = decoded.records(p.controls); unique(controls,"field"); for (let control of controls) { m.closed(control,["field","label","widget","minimum","maximum","step","invalidate"]); }
    let actions: Record<string, unknown>[] = decoded.records(p.actions); unique(actions,"id"); for (let action of actions) { m.closed(action,["id","fields","updates","steps"]); let fields: Record<string, unknown>[] = decoded.records(action.fields); unique(fields,"name"); for (let field of fields) { m.closed(field,["name","type"]); } let updates: Record<string, unknown>[] = decoded.records(action.updates); unique(updates,"field"); for (let update of updates) { m.closed(update,["field","node"]); } let steps: Record<string, unknown>[] = decoded.records(action.steps); let names: string[] = ["state","action","row","left","right"]; for (let step of steps) { let kind: string = (step.kind as string); if (kind === "call" || kind === "eachCall") { let keys: string[] = ["kind","id","module","function","args","bind","node","when"]; if (kind === "eachCall") { keys[keys.length] = "each"; } m.closed(step,keys); let name: string = (step.id as string); m.name(name); if (m.contains(names,name) || m.contains(names,name+"Present")) { m.reject("Duplicate/reserved workflow reference"); } names[names.length] = name; names[names.length] = name+"Present"; } else { if (kind !== "set") { m.reject("Unknown workflow step"); } m.closed(step,["kind","bind","node"]); } } }
    let views: Record<string, unknown>[] = decoded.records(p.views); unique(views,"id"); for (let view of views) { m.closed(view,["id","component","props","events","children","each","key","when"]); let props: Record<string, unknown>[] = decoded.records(view.props); unique(props,"name"); let names: string[] = []; for (let prop of props) { m.closed(prop,["name","node"]); let name: string = (prop.name as string); names[names.length] = name; } let events: Record<string, unknown>[] = decoded.records(view.events); unique(events,"name"); for (let event of events) { m.closed(event,["name","action","payload"]); let name: string = (event.name as string); if (m.contains(names,name)) { m.reject("Duplicate prop/event"); } let payload: Record<string, unknown>[] = decoded.records(event.payload); unique(payload,"field"); for (let field of payload) { m.closed(field,["field","node"]); } } }
    let arities: Record<string, unknown> = {literal:0,record:0,add:2,subtract:2,multiply:2,divide:2,floor:1,ceil:1,abs:1,numberText:1,eq:2,ne:2,lt:2,le:2,gt:2,ge:2,choicePick:1,choiceSelect:3,choiceValid:3,resultText:2,fragmentComparison:3,comparisonValue:1,inputEdit:2,and:2,or:2,not:1,choose:3,integer:1,clock:1,length:1,filter:2,project:2,sum:2,any:2,all:2,update:2,first:1,lookup:2,field:1,now:0,sort:1,basket:1,alternatives:1,stockQualified:2,selections:2,allocate:3,covers:2,join:4};
    let nodes: Record<string, unknown>[] = decoded.records(p.nodes); unique(nodes,"id"); for (let node of nodes) { m.closed(node,["id","op","args","params"]); let id: string = (node.id as string); m.name(id); let op: string = (node.op as string); let params: Record<string, unknown> = (node.params as Record<string, unknown>); let args: string[] = decoded.strings(node.args); if (m.contains(["selections","stockQualified","field"],op) && !model.experimental) { m.reject("Experimental selection operation is not registered for generation"); } if (m.present(arities,op)) { let arity: number = (arities[op] as number); if (args.length !== arity) { m.reject("Wrong arity for "+op); } } else { if (op !== "array" && op !== "concat" && !(model.allowCustom && op === "custom")) { m.reject("Unknown operation "+op); } }
        let keys: string[] = [];
        if (m.contains(["choicePick","choiceSelect","choiceValid","resultText","fragmentComparison","comparisonValue","inputEdit"],op) && !model.fragments) { m.reject("Fragment operation is not a custom graph operator"); }
        if (op === "resultText") { keys = ["format"]; } if (op === "comparisonValue") { keys = ["field"]; } if (op === "inputEdit") { keys = ["format","minimum","maximum"]; } if (op === "custom") { keys = ["section"]; } if (op === "literal") { keys = ["type","value"]; } if (op === "record") { keys = ["type","fields"]; } if (op === "update") { keys = ["fields"]; } if (op === "array") { keys = ["element"]; } if (op === "lookup") { keys = ["key"]; } if (op === "sort" || op === "field") { keys = ["field"]; } if (op === "basket") { keys = ["id","quantity"]; } if (op === "selections") { keys = ["type","quantity","cost","capacity","constraints"]; } if (op === "alternatives") { keys = ["type","roles"]; } if (op === "allocate") { keys = ["quantity","cost","quotas"]; } if (op === "covers") { keys = ["components","key","itemId","quantity","groups"]; } m.closed(params,keys);
        if (op === "record" || op === "update") { let fields: Record<string, unknown>[] = decoded.records(params.fields); unique(fields,"field"); for (let field of fields) { m.closed(field,["field","node"]); } }
        if (op === "allocate") { let quotas: Record<string, unknown>[] = decoded.records(params.quotas); for (let quota of quotas) { m.closed(quota,["field","minimum"]); } }
        if (op === "alternatives") { let roles: Record<string, unknown>[] = decoded.records(params.roles); for (let role of roles) { m.closed(role,["field","quantity"]); } }
        if (op === "covers") { let groups: Record<string, unknown>[] = decoded.records(params.groups); for (let group of groups) { m.closed(group,["predicate","minimum"]); } }
    }
    return null;
}
function issue(issues: string[], message: string): null { if (!m.contains(issues,message)) { issues[issues.length] = message; } return null; }
function target(model: m.Model, issues: string[], path: string, field: string): null { let found: boolean = false; for (let entry of m.fields(model,"State")) { let name: string = (entry.name as string); if (name === field) { found = true; } } if (!found) { issue(issues,path+": state field '"+field+"' is undeclared. Declare its type and JSON initial value in state; derived binds an existing field, not a new declaration."); } return null; }
function reference(model: m.Model, issues: string[], path: string, ref: string): null { if (strings.startsWith(ref,"$state.")) { let parts: string[] = strings.split(ref,"."); target(model,issues,path,parts[1]); } else { if (strings.startsWith(ref,"$payload")) { issue(issues,path+": payload is only valid as an event payload binding"); } else { if (!strings.startsWith(ref,"$") && !model.hasNode(ref)) { issue(issues,path+": unknown expression '"+ref+"'"); } } } return null; }
export function bindings(model: m.Model, p: Record<string, unknown>): null { let issues: string[] = []; for (let id of model.nodeIds) { let node: Record<string, unknown> = model.node(id); for (let ref of references(node)) { reference(model,issues,"nodes["+id+"]",ref); } } let derived: Record<string, unknown>[] = decoded.records(p.derived); for (let entry of derived) { let field: string = (entry.field as string); let node: string = (entry.node as string); target(model,issues,"derived.field",field); reference(model,issues,"derived.node",node); } let controls: Record<string, unknown>[] = decoded.records(p.controls); for (let control of controls) { let field: string = (control.field as string); target(model,issues,"controls.field",field); let invalidations: string[] = decoded.strings(control.invalidate); for (let invalid of invalidations) { let found: boolean = false; for (let entry of m.fields(model,"State")) { let name: string = (entry.name as string); let type: string = (entry.type as string); if (name === invalid && type === "boolean") { found = true; } } if (!found) { issue(issues,"controls.invalidate: '"+invalid+"' must name a declared BOOLEAN validity field"); } } } let actions: Record<string, unknown>[] = decoded.records(p.actions); for (let action of actions) { let updates: Record<string, unknown>[] = decoded.records(action.updates); for (let update of updates) { let field: string = (update.field as string); let node: string = (update.node as string); target(model,issues,"actions.updates.field",field); reference(model,issues,"actions.updates.node",node); } let steps: Record<string, unknown>[] = decoded.records(action.steps); for (let step of steps) { let bind: string = (step.bind as string); if (bind !== "") { target(model,issues,"actions.steps.bind",bind); } let kind: string = (step.kind as string); if (kind === "call" && bind !== "") { let node: string = (step.node as string); if (node === "") { issue(issues,"actions.steps.node: a nonempty bind requires an explicit projection"); } } } } let views: Record<string, unknown>[] = decoded.records(p.views); for (let view of views) { let props: Record<string, unknown>[] = decoded.records(view.props); for (let prop of props) { let node: string = (prop.node as string); reference(model,issues,"views",node); if (!strings.startsWith(node,"$") && model.hasNode(node)) { let entry: Record<string, unknown> = model.node(node); let op: string = (entry.op as string); if (op !== "literal") { issue(issues,"views: bind computations through derived state fields"); } } } } if (issues.length > 0) { let message: string = "Behavioral binding errors (workspace unchanged):\n"; for (let entry of issues) { message = message+entry+"\n"; } m.reject(message); } return null; }
export function main(): null { return null; }
