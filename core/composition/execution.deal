import * as decoded from "../decoded";
import * as json from "std/json";
import * as strings from "std/string";
import * as tables from "std/table";
function contains(values: string[], value: string): boolean { for (let entry of values) { if (entry === value) { return true; } } return false; }
function append(values: string[], additions: string[]): null { for (let value of additions) { if (!contains(values,value)) { values[values.length] = value; } } return null; }
function refs(node: Record<string, unknown>): string[] {
    let result: string[] = []; let args: string[] = decoded.strings(node.args); append(result,args); let params: Record<string, unknown> = (node.params as Record<string, unknown>); let op: string = (node.op as string);
    if (op === "record" || op === "update") { let fields: Record<string, unknown>[] = decoded.records(params.fields); for (let field of fields) { let value: string = (field.node as string); append(result,[value]); } }
    if (op === "allocate") { let quotas: Record<string, unknown>[] = decoded.records(params.quotas); for (let quota of quotas) { let minimum: string = (quota.minimum as string); append(result,[minimum]); } }
    if (op === "alternatives") { let roles: Record<string, unknown>[] = decoded.records(params.roles); for (let role of roles) { let quantity: string = (role.quantity as string); append(result,[quantity]); } }
    if (op === "selections") { let constraints: Record<string, unknown>[] = decoded.records(params.constraints); for (let constraint of constraints) { let minimum: string = (constraint.minimum as string); let maximum: string = (constraint.maximum as string); append(result,[minimum,maximum]); } }
    if (op === "covers") { let groups: Record<string, unknown>[] = decoded.records(params.groups); for (let group of groups) { let minimum: string = (group.minimum as string); let predicate: string = (group.predicate as string); append(result,[minimum,predicate]); } }
    return result;
}
function dependencies(id: string, nodes: Record<string, unknown>, derived: Record<string, unknown>, active: string[], transitive: boolean): string[] {
    let result: string[] = [];
    if (strings.startsWith(id,"$state.")) {
        let parts: string[] = strings.split(id,"."); let field: string = parts[1]; result[result.length] = field;
        if (transitive) { for (let key of tables.keys(derived)) { if (key === field) { let expression: string = (derived[field] as string); append(result,dependencies(expression,nodes,derived,active,true)); } } }
        return result;
    }
    if (strings.startsWith(id,"$") || id === "") { return result; }
    if (contains(active,id)) { throw {code:"INVALID_CONFIG",message:"Expression or derived cycle"}; }
    let next: string[] = []; append(next,active); append(next,[id]);
    let node: Record<string, unknown> = (nodes[id] as Record<string, unknown>); for (let ref of refs(node)) { append(result,dependencies(ref,nodes,derived,next,transitive)); }
    return result;
}
function intersects(left: string[], right: string[]): boolean { for (let entry of left) { if (contains(right,entry)) { return true; } } return false; }
function workflow(action: Record<string, unknown>): boolean { let steps: Record<string, unknown>[] = decoded.records(action.steps); for (let step of steps) { let kind: string = (step.kind as string); if (kind === "call" || kind === "eachCall") { return true; } } return false; }
function reads(action: Record<string, unknown>, nodes: Record<string, unknown>, derived: Record<string, unknown>, providersOnly: boolean): string[] {
    let result: string[] = []; let steps: Record<string, unknown>[] = decoded.records(action.steps);
    for (let step of steps) {
        let kind: string = (step.kind as string); let expressions: string[] = [];
        if (kind === "call" || kind === "eachCall") {
            let args: string[] = decoded.strings(step.args); append(expressions,args); let condition: string = (step["when"] as string); append(expressions,[condition]);
            if (!providersOnly) { let projection: string = (step.node as string); append(expressions,[projection]); if (kind === "eachCall") { let each: string = (step.each as string); append(expressions,[each]); } }
        } else { if (!providersOnly) { let expression: string = (step.node as string); append(expressions,[expression]); } }
        for (let expression of expressions) { append(result,dependencies(expression,nodes,derived,[],true)); }
    }
    return result;
}
function writes(action: Record<string, unknown>): string[] { let result: string[] = []; let steps: Record<string, unknown>[] = decoded.records(action.steps); for (let step of steps) { let field: string = (step.bind as string); if (field !== "") { append(result,[field]); } } return result; }
function ordered(derived: Record<string, unknown>[], nodes: Record<string, unknown>, definitions: Record<string, unknown>): Record<string, unknown>[] {
    let result: Record<string, unknown>[] = []; let done: string[] = []; let targets: string[] = [];
    for (let entry of derived) { let field: string = (entry.field as string); if (contains(targets,field)) { throw {code:"INVALID_CONFIG",message:"Duplicate derived field"}; } targets[targets.length] = field; }
    while (result.length < derived.length) {
        let added: boolean = false;
        for (let entry of derived) { let field: string = (entry.field as string); if (!added && !contains(done,field)) {
            let expression: string = (entry.node as string); let ready: boolean = true;
            for (let dependency of dependencies(expression,nodes,definitions,[],false)) { if (contains(targets,dependency) && !contains(done,dependency)) { ready = false; } }
            if (ready) { result[result.length] = entry; done[done.length] = field; added = true; }
        } }
        if (!added) { throw {code:"INVALID_CONFIG",message:"Derived cycle"}; }
    }
    return result;
}
export function executionJson(input: string): string {
    let plan: Record<string, unknown> = json.parse(input); let nodesList: Record<string, unknown>[] = decoded.records(plan.nodes); let nodes: Record<string, unknown> = {}; let derivedList: Record<string, unknown>[] = decoded.records(plan.derived); let derived: Record<string, unknown> = {};
    for (let node of nodesList) { let id: string = (node.id as string); nodes[id] = node; }
    for (let entry of derivedList) { let field: string = (entry.field as string); let expression: string = (entry.node as string); derived[field] = expression; }
    let actions: Record<string, unknown>[] = decoded.records(plan.actions); let workflows: Record<string, unknown>[] = []; let ownership: Record<string, unknown> = {}; let byId: Record<string, unknown> = {};
    for (let action of actions) { if (workflow(action)) {
        let id: string = (action.id as string); let written: string[] = writes(action); let read: string[] = reads(action,nodes,derived,false); let provider: string[] = reads(action,nodes,derived,true);
        for (let field of written) {
            for (let known of tables.keys(ownership)) { if (known === field) { throw {code:"INVALID_CONFIG",message:"State field has multiple workflow owners"}; } }
            ownership[field] = id;
        }
        let value: Record<string, unknown> = {id:id,writes:written,reads:read,providers:provider}; workflows[workflows.length] = value; byId[id] = value;
    } }
    let invalidations: Record<string, unknown> = {}; let controls: Record<string, unknown>[] = decoded.records(plan.controls);
    for (let action of actions) {
        let id: string = (action.id as string); let changed: string[] = []; let updates: Record<string, unknown>[] = decoded.records(action.updates);
        for (let update of updates) { let field: string = (update.field as string); append(changed,[field]); }
        for (let entry of workflows) { let target: string = (entry.id as string); if (target === id) { let written: string[] = decoded.strings(entry.writes); append(changed,written); } }
        invalidations[id] = invalidate(changed,id,workflows);
    }
    for (let control of controls) { let field: string = (control.field as string); let changed: string[] = [field]; let invalid: string[] = decoded.strings(control.invalidate); append(changed,invalid); invalidations["Set"+field] = invalidate(changed,"",workflows); }
    return (json.stringify({ordered:ordered(derivedList,nodes,derived),workflows:byId,invalidations:invalidations}) as string);
}
function invalidate(changed: string[], except: string, workflows: Record<string, unknown>[]): Record<string, unknown>[] {
    let affected: string[] = []; append(affected,changed); let invalidated: string[] = []; let updated: boolean = true;
    while (updated) {
        updated = false;
        for (let entry of workflows) { let id: string = (entry.id as string); let read: string[] = decoded.strings(entry.reads); let written: string[] = decoded.strings(entry.writes);
            if (id !== except && (intersects(affected,read) || intersects(affected,written)) && !contains(invalidated,id)) { invalidated[invalidated.length] = id; append(affected,written); updated = true; }
        }
    }
    let result: Record<string, unknown>[] = [];
    for (let entry of workflows) { let id: string = (entry.id as string); if (contains(invalidated,id)) {
        let written: string[] = decoded.strings(entry.writes); let provider: string[] = decoded.strings(entry.providers); let external: string[] = [];
        for (let field of provider) { if (!contains(written,field)) { external[external.length] = field; } }
        result[result.length] = {id:id,clear:intersects(affected,external)};
    } }
    return result;
}
export function main(): null { return null; }
