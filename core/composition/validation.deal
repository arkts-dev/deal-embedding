import * as shapes from "./validation.generated";
import * as math from "std/math";

// Closed shapes are schema-derived; semantic graph checks belong to composition.
export function validateJson(input: string): null { return shapes.validateJson(input); }
export function input(config: Record<string, unknown>): null {
    let format: string = (config.format as string);
    if (format === "text") { let value: string = (config.value as string); return null; }
    if (format === "boolean") { let value: boolean = (config.value as boolean); return null; }
    let value: number = (config.value as number); let minimum: number = (config.minimum as number); let maximum: number = (config.maximum as number);
    if (value-value !== 0 || minimum-minimum !== 0 || maximum-maximum !== 0 || minimum > maximum || value < minimum || value > maximum) {
        throw {code:"INVALID_CONFIG",message:"Invalid numeric input bounds"};
    }
    if (math.floor(value) !== value || math.floor(minimum) !== minimum || math.floor(maximum) !== maximum || minimum < -2147483648 || maximum > 2147483647) {
        throw {code:"INVALID_CONFIG",message:"Whole-unit input bounds required"};
    }
    if (format === "time" && (minimum < 0 || maximum > 1439)) { throw {code:"INVALID_CONFIG",message:"Time bounds must be minute-of-day"}; }
    return null;
}
