import * as decoded from "../decoded";
import * as syntax from "embedding/syntax";
import * as json from "std/json";
import * as strings from "std/string";
import * as tables from "std/table";
function fail(message: string): null { throw {code:"INVALID_CONFIG",message:"Fragments: "+message}; }
function contains(values: string[], key: string): boolean { for (let value of values) { if (value === key) { return true; } } return false; }
function present(value: Record<string, unknown>, key: string): boolean { return contains(tables.keys(value),key); }
function bare(value: string, prefix: string): string { if (strings.startsWith(value,prefix)) { return strings.substring(value,strings.length(prefix),strings.length(value)); } return value; }
function expression(value: Record<string, unknown>, bindings: Record<string, unknown>): string {
    let kind: string = (value.kind as string); if (kind !== "path") { fail("Unsupported authored view expression"); }
    let parts: string[] = decoded.strings(value.parts);
    if (parts.length === 1 && parts[0] === "payload") { return "$payload"; }
    if (parts[0] === "row") { let result: string = "$row"; let index: number = 1; while (index < parts.length) { result = result+"."+parts[index]; index = index+1; } return result; }
    if (parts.length === 2 && parts[0] === "state" && present(bindings,parts[1])) { let result: string = (bindings[parts[1]] as string); return result; }
    fail("Unbound authored view path"); return "";
}
class Context { views: Record<string, unknown>[]; serial: number; }
function call(c: Context, node: Record<string, unknown>, bindings: Record<string, unknown>, actions: Record<string, unknown>, condition: string, each: string, key: string): string {
    let props: Record<string, unknown>[] = []; let events: Record<string, unknown>[] = []; let callArguments: Record<string, unknown>[] = decoded.records(node.arguments);
    for (let argument of callArguments) { let name: string = (argument.name as string); let value: Record<string, unknown> = (argument.value as Record<string, unknown>); let kind: string = (value.kind as string);
        if (kind === "action") { let actionName: string = (value.name as string); actionName = bare(actionName,"app."); if (!present(actions,actionName)) { fail("Unbound authored action"); } let action: string = (actions[actionName] as string); let fields: Record<string, unknown>[] = decoded.records(value.fields); let payload: Record<string, unknown>[] = []; for (let field of fields) { let name: string = (field.name as string); let value: Record<string, unknown> = (field.value as Record<string, unknown>); payload[payload.length] = {field:name,node:expression(value,bindings)}; } events[events.length] = {name:name,action:action,payload:payload}; }
        else { props[props.length] = {name:name,node:expression(value,bindings)}; }
    }
    let id: string = "boundView"+decimal(c.serial); c.serial = c.serial+1;
    let name: string = (node.name as string); let children: Record<string, unknown>[] = decoded.records(node.children); let childIds: string[] = nodes(c,children,bindings,actions,"","","");
    c.views[c.views.length] = {id:id,component:bare(name,"ui."),props:props,events:events,children:childIds,each:each,key:key,when:condition}; return id;
}
function decimal(value: number): string { let encoded: string = (json.stringify({value:value}) as string); let result: string = strings.substring(encoded,9,strings.length(encoded)-1); if (strings.endsWith(result,".0")) { return strings.substring(result,0,strings.length(result)-2); } return result; }
function nodes(c: Context, values: Record<string, unknown>[], bindings: Record<string, unknown>, actions: Record<string, unknown>, condition: string, each: string, key: string): string[] {
    let result: string[] = [];
    for (let node of values) { let kind: string = (node.kind as string); let ids: string[] = [];
        if (kind === "each") { let children: Record<string, unknown>[] = decoded.records(node.children); let source: Record<string, unknown> = (node.source as Record<string, unknown>); let keyValue: Record<string, unknown> = (node.key as Record<string, unknown>); ids = nodes(c,children,bindings,actions,condition,expression(source,bindings),expression(keyValue,bindings)); }
        else { if (kind === "when") { let otherwise: Record<string, unknown>[] = decoded.records(node["else"]); if (condition !== "" || otherwise.length !== 0) { fail("Unsupported authored view condition"); } let children: Record<string, unknown>[] = decoded.records(node["then"]); let test: Record<string, unknown> = (node.condition as Record<string, unknown>); ids = nodes(c,children,bindings,actions,expression(test,bindings),each,key); }
        else { if (kind === "call") { ids = [call(c,node,bindings,actions,condition,each,key)]; } else { fail("Unsupported authored view node"); } } }
        for (let id of ids) { result[result.length] = id; }
    } return result;
}
function replace(ids: string[], replacements: Record<string, unknown>): string[] { let result: string[] = []; for (let id of ids) { if (present(replacements,id)) { let values: string[] = decoded.strings(replacements[id]); for (let value of values) { result[result.length] = value; } } else { result[result.length] = id; } } return result; }
function descendants(ids: string[], byId: Record<string, unknown>, result: string[]): null {
    for (let id of ids) {
        if (!contains(result,id)) {
            result[result.length] = id;
            let view: Record<string, unknown> = byId[id] as Record<string, unknown>;
            descendants(decoded.strings(view.children),byId,result);
        }
    }
    return null;
}
function editable(plan: Record<string, unknown>, expanded: Record<string, unknown>, replacements: Record<string, unknown>): null {
    let views: Record<string, unknown>[] = decoded.records(plan.views); let byId: Record<string, unknown> = {}; for (let view of views) { let id: string = (view.id as string); byId[id] = view; }
    let editable: Record<string, unknown> = (expanded.editable as Record<string, unknown>); let instanceViews: Record<string, unknown> = (expanded.instanceViews as Record<string, unknown>);
    for (let instance of tables.keys(editable)) { let enabled: string = (editable[instance] as string); let source: string[] = decoded.strings(instanceViews[instance]); let ids: string[] = []; descendants(replace(source,replacements),byId,ids);
        for (let id of ids) { let view: Record<string, unknown> = (byId[id] as Record<string, unknown>); let component: string = (view.component as string); if (contains(["IntField","TimeField","TextField","Option","SecondaryAction"],component)) { let props: Record<string, unknown>[] = decoded.records(view.props); let found: boolean = false; for (let prop of props) { let name: string = (prop.name as string); if (name === "enabled") { if (found) { fail("Duplicate enabled property"); } prop.node = enabled; found = true; } } if (!found) { props[props.length] = {name:"enabled",node:enabled}; } view.props = props; } }
    } return null;
}
export function bindJson(input: string): string {
    let expanded: Record<string, unknown> = json.parse(input); let plan: Record<string, unknown> = (expanded.plan as Record<string, unknown>); let views: Record<string, unknown>[] = decoded.records(plan.views); let c: Context = {views:views,serial:0}; let replacements: Record<string, unknown> = {}; let authored: Record<string, unknown>[] = decoded.records(expanded.authoredViews);
    for (let view of authored) { let id: string = (view.id as string); let kind: string = (view.kind as string); let bindings: Record<string, unknown> = (view.bindings as Record<string, unknown>); let actions: Record<string, unknown> = (view.actions as Record<string, unknown>); replacements[id] = nodes(c,syntax.viewTree(kind),bindings,actions,"","",""); }
    for (let view of views) { let children: string[] = decoded.strings(view.children); view.children = replace(children,replacements); }
    plan.views = views; editable(plan,expanded,replacements); return (json.stringify(plan) as string);
}
export function main(): null { return null; }
