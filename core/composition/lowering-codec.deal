import * as decoded from "../decoded";
import * as m from "./lowering-model";
import * as x from "./lowering-expressions";
import * as tables from "std/table";
export function wireType(type: string): string { let child: string = m.element(type); if (child !== "") { return wireType(child)+"[]"; } if (m.scalar(type)) { return type; } return "Record<string, unknown>"; }
export function providerType(model: m.Model, type: Record<string, unknown>, id: string): string { let kind: string = (type.kind as string); if (m.scalar(kind)) { return kind; } if (kind === "array") { let child: Record<string, unknown> = (type.element as Record<string, unknown>); return providerType(model,child,id+"Row")+"[]"; } if (kind === "record") { let fields: Record<string, unknown>[] = decoded.records(type.fields); let fs: Record<string, unknown>[] = []; for (let entry of fields) { let name: string = (entry.name as string); let schema: Record<string, unknown> = (entry.type as Record<string, unknown>); let optional: boolean = (entry.optional as boolean); let ft: string = providerType(model,schema,id+"_"+m.name(name)); if (optional) { let option: string = m.declare(model,id+"_"+m.name(name)+"Option",[{name:"present",type:"boolean"},{name:"value",type:ft}]); model.optional[option] = ft; ft = option; } fs[fs.length] = {name:name,type:ft}; } return m.declare(model,id,fs); } m.reject("Unsupported provider value "+kind); return ""; }
export function matches(model: m.Model, type: string, schema: Record<string, unknown>): boolean { let kind: string = (schema.kind as string); if (kind === "array") { let child: Record<string, unknown> = (schema.element as Record<string, unknown>); return m.element(type) !== "" && matches(model,m.element(type),child); } if (kind !== "record") { return type === kind; } if (!m.present(model.records,type)) { return false; } let fields: Record<string, unknown>[] = decoded.records(schema.fields); let fs: Record<string, unknown>[] = m.fields(model,type); if (fs.length !== fields.length) { return false; } for (let entry of fields) { let name: string = (entry.name as string); let schema: Record<string, unknown> = (entry.type as Record<string, unknown>); let optional: boolean = (entry.optional as boolean); let ft: string = ""; for (let field of fs) { let key: string = (field.name as string); if (key === name) { ft = (field.type as string); } } if (ft === "") { return false; } if (optional) { if (!m.present(model.records,ft)) { return false; } let option: Record<string, unknown>[] = m.fields(model,ft); if (option.length !== 2 || m.field(model,ft,"present") !== "boolean") { return false; } ft = m.field(model,ft,"value"); } if (!matches(model,ft,schema)) { return false; } } return true; }
export function mark(model: m.Model, type: string, schema: Record<string, unknown>): null { let kind: string = (schema.kind as string); if (kind === "array") { let child: Record<string, unknown> = (schema.element as Record<string, unknown>); mark(model,m.element(type),child); } if (kind === "record") { let fields: Record<string, unknown>[] = decoded.records(schema.fields); for (let entry of fields) { let name: string = (entry.name as string); let child: Record<string, unknown> = (entry.type as Record<string, unknown>); let optional: boolean = (entry.optional as boolean); let ft: string = m.field(model,type,name); if (optional) { let value: string = m.field(model,ft,"value"); model.optional[ft] = value; ft = value; } mark(model,ft,child); } } return null; }
export function decode(model: m.Model, type: string, source: string, out: x.Output): m.Value { if (m.scalar(type)) { let id: string = m.fresh(model); out.code = out.code+"let "+id+": "+type+" = ("+source+" as "+type+");\n"; return {type:type,code:id}; } let child: string = m.element(type); if (child !== "") { let raw: string = m.fresh(model); let dest: string = m.fresh(model); let row: string = m.fresh(model); let helper: string = m.fresh(model); let wire: string = wireType(type); model.helpers = model.helpers+"function "+helper+"(value:unknown):unknown[] { let typed:"+wire+" | null = null; try { typed = value as "+wire+"; } catch (error) {} if (typed !== null) { let result:unknown[] = []; for (let item of typed) { result[result.length] = item; } return result; } return value as unknown[]; }\n"; out.code = out.code+"let "+raw+": unknown[] = "+helper+"("+source+"); let "+dest+": "+type+" = []; for (let "+row+" of "+raw+") {\n"; let value: m.Value = decode(model,child,row,out); out.code = out.code+dest+"["+dest+".length] = "+value.code+"; }\n"; return {type:type,code:dest}; } let raw: string = m.fresh(model); out.code = out.code+"let "+raw+": Record<string, unknown> = ("+source+" as Record<string, unknown>);\n"; let values: Record<string, unknown> = {}; for (let entry of m.fields(model,type)) { let name: string = (entry.name as string); let ft: string = (entry.type as string); if (m.present(model.optional,ft)) { let inner: string = (model.optional[ft] as string); let dest: string = m.fresh(model); let key: string = m.fresh(model); out.code = out.code+"let "+dest+": "+ft+" = "+m.defaultValue(model,ft)+"; for (let "+key+" of tables.keys("+raw+")) { if ("+key+" === "+m.quote(name)+") {\n"; let value: m.Value = decode(model,inner,raw+"["+m.quote(name)+"]",out); out.code = out.code+dest+" = {m_present:true,m_value:"+value.code+"}; } }\n"; values[name] = dest; } else { values[name] = decode(model,ft,raw+"["+m.quote(name)+"]",out).code; } } let dest: string = m.fresh(model); out.code = out.code+"let "+dest+": "+type+" = "+m.copy(model,type,raw,values)+";\n"; return {type:type,code:dest}; }
export function encode(model: m.Model, value: m.Value, schema: Record<string, unknown>, out: x.Output): string { let kind: string = (schema.kind as string); if (kind === "array") { let type: string = m.element(value.type); if (type === "") { m.reject("Capability requires array"); } let result: string = m.fresh(model); let row: string = m.fresh(model); let child: Record<string, unknown> = (schema.element as Record<string, unknown>); let wt: string = wireSchema(schema); out.code = out.code+"let "+result+": "+wt+" = []; for (let "+row+" of "+value.code+") {\n"; let encoded: string = encode(model,{type:type,code:row},child,out); out.code = out.code+result+"["+result+".length] = "+encoded+"; }\n"; return result; } if (kind === "record") { let fields: Record<string, unknown>[] = decoded.records(schema.fields); let fs: Record<string, unknown>[] = m.fields(model,value.type); if (fields.length !== fs.length) { m.reject("Capability record argument fields"); } let result: string = m.fresh(model); out.code = out.code+"let "+result+": Record<string, unknown> = {};\n"; for (let entry of fields) { let name: string = (entry.name as string); let child: Record<string, unknown> = (entry.type as Record<string, unknown>); let optional: boolean = (entry.optional as boolean); let ft: string = m.field(model,value.type,name); let code: string = value.code+"."+m.symbol(name); if (optional) { if (!m.present(model.optional,ft)) { m.reject("Optional argument needs a presence/value record"); } let inner: string = (model.optional[ft] as string); out.code = out.code+"if ("+code+".m_present) {\n"; let encoded: string = encode(model,{type:inner,code:code+".m_value"},child,out); out.code = out.code+result+"["+m.quote(name)+"] = "+encoded+"; }\n"; } else { let encoded: string = encode(model,{type:ft,code:code},child,out); out.code = out.code+result+"["+m.quote(name)+"] = "+encoded+";\n"; } } return result; } if (value.type !== kind) { m.reject("Capability argument type: expected "+kind+", got "+value.type); } return value.code; }
function wireSchema(schema: Record<string, unknown>): string { let kind: string = (schema.kind as string); if (kind === "record") { return "Record<string, unknown>"; } if (kind === "array") { let child: Record<string, unknown> = (schema.element as Record<string, unknown>); return wireSchema(child)+"[]"; } return kind; }
export function main(): null { return null; }
