import * as m from "./lowering-model";
import * as x from "./lowering-expressions";
import * as tables from "std/table";
export function wireType(type: string): string { let child: string = m.element(type); if (child !== "") { return wireType(child)+"[]"; } if (m.scalar(type)) { return type; } return "table"; }
export function providerType(model: m.Model, type: table, id: string): string { let kind: string = type.kind; if (m.scalar(kind)) { return kind; } if (kind === "array") { let child: table = type.element; return providerType(model,child,id+"Row")+"[]"; } if (kind === "record") { let fields: table[] = type.fields; let fs: table[] = []; for (let entry: table of fields) { let name: string = entry.name; let schema: table = entry.type; let optional: boolean = entry.optional; let ft: string = providerType(model,schema,id+"_"+m.name(name)); if (optional) { let option: string = m.declare(model,id+"_"+m.name(name)+"Option",[{name:"present",type:"boolean"},{name:"value",type:ft}]); model.optional[option] = ft; ft = option; } fs[fs.length] = {name:name,type:ft}; } return m.declare(model,id,fs); } m.reject("Unsupported provider value "+kind); return ""; }
export function matches(model: m.Model, type: string, schema: table): boolean { let kind: string = schema.kind; if (kind === "array") { let child: table = schema.element; return m.element(type) !== "" && matches(model,m.element(type),child); } if (kind !== "record") { return type === kind; } if (!m.present(model.records,type)) { return false; } let fields: table[] = schema.fields; let fs: table[] = m.fields(model,type); if (fs.length !== fields.length) { return false; } for (let entry: table of fields) { let name: string = entry.name; let schema: table = entry.type; let optional: boolean = entry.optional; let ft: string = ""; for (let field: table of fs) { let key: string = field.name; if (key === name) { ft = field.type; } } if (ft === "") { return false; } if (optional) { if (!m.present(model.records,ft)) { return false; } let option: table[] = m.fields(model,ft); if (option.length !== 2 || m.field(model,ft,"present") !== "boolean") { return false; } ft = m.field(model,ft,"value"); } if (!matches(model,ft,schema)) { return false; } } return true; }
export function mark(model: m.Model, type: string, schema: table): null { let kind: string = schema.kind; if (kind === "array") { let child: table = schema.element; mark(model,m.element(type),child); } if (kind === "record") { let fields: table[] = schema.fields; for (let entry: table of fields) { let name: string = entry.name; let child: table = entry.type; let optional: boolean = entry.optional; let ft: string = m.field(model,type,name); if (optional) { let value: string = m.field(model,ft,"value"); model.optional[ft] = value; ft = value; } mark(model,ft,child); } } return null; }
export function decode(model: m.Model, type: string, source: string, out: x.Output): m.Value { if (m.scalar(type)) { let id: string = m.fresh(model); out.code = out.code+"let "+id+": "+type+" = "+source+";\n"; return {type:type,code:id}; } let child: string = m.element(type); if (child !== "") { let raw: string = m.fresh(model); let dest: string = m.fresh(model); let row: string = m.fresh(model); out.code = out.code+"let "+raw+": "+wireType(type)+" = "+source+"; let "+dest+": "+type+" = []; for (let "+row+": "+wireType(child)+" of "+raw+") {\n"; let value: m.Value = decode(model,child,row,out); out.code = out.code+dest+"["+dest+".length] = "+value.code+"; }\n"; return {type:type,code:dest}; } let raw: string = m.fresh(model); out.code = out.code+"let "+raw+": table = "+source+";\n"; let values: table = {}; for (let entry: table of m.fields(model,type)) { let name: string = entry.name; let ft: string = entry.type; if (m.present(model.optional,ft)) { let inner: string = model.optional[ft]; let dest: string = m.fresh(model); let key: string = m.fresh(model); out.code = out.code+"let "+dest+": "+ft+" = "+m.defaultValue(model,ft)+"; for (let "+key+": string of tables.keys("+raw+")) { if ("+key+" === "+m.quote(name)+") {\n"; let value: m.Value = decode(model,inner,raw+"["+m.quote(name)+"]",out); out.code = out.code+dest+" = {m_present:true,m_value:"+value.code+"}; } }\n"; values[name] = dest; } else { values[name] = decode(model,ft,raw+"["+m.quote(name)+"]",out).code; } } let dest: string = m.fresh(model); out.code = out.code+"let "+dest+": "+type+" = "+m.copy(model,type,raw,values)+";\n"; return {type:type,code:dest}; }
export function encode(model: m.Model, value: m.Value, schema: table, out: x.Output): string { let kind: string = schema.kind; if (kind === "array") { let type: string = m.element(value.type); if (type === "") { m.reject("Capability requires array"); } let result: string = m.fresh(model); let row: string = m.fresh(model); let child: table = schema.element; let wt: string = wireSchema(schema); out.code = out.code+"let "+result+": "+wt+" = []; for (let "+row+": "+type+" of "+value.code+") {\n"; let encoded: string = encode(model,{type:type,code:row},child,out); out.code = out.code+result+"["+result+".length] = "+encoded+"; }\n"; return result; } if (kind === "record") { let fields: table[] = schema.fields; let fs: table[] = m.fields(model,value.type); if (fields.length !== fs.length) { m.reject("Capability record argument fields"); } let result: string = m.fresh(model); out.code = out.code+"let "+result+": table = {};\n"; for (let entry: table of fields) { let name: string = entry.name; let child: table = entry.type; let optional: boolean = entry.optional; let ft: string = m.field(model,value.type,name); let code: string = value.code+"."+m.symbol(name); if (optional) { if (!m.present(model.optional,ft)) { m.reject("Optional argument needs a presence/value record"); } let inner: string = model.optional[ft]; out.code = out.code+"if ("+code+".m_present) {\n"; let encoded: string = encode(model,{type:inner,code:code+".m_value"},child,out); out.code = out.code+result+"["+m.quote(name)+"] = "+encoded+"; }\n"; } else { let encoded: string = encode(model,{type:ft,code:code},child,out); out.code = out.code+result+"["+m.quote(name)+"] = "+encoded+";\n"; } } return result; } if (value.type !== kind) { m.reject("Capability argument type: expected "+kind+", got "+value.type); } return value.code; }
function wireSchema(schema: table): string { let kind: string = schema.kind; if (kind === "record") { return "table"; } if (kind === "array") { let child: table = schema.element; return wireSchema(child)+"[]"; } return kind; }
export function main(): null { return null; }
