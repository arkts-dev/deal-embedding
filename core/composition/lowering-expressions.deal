import * as m from "./lowering-model";
import * as selection from "./lowering-selection";
import * as strings from "std/string";
import * as tables from "std/table";

export class Output { code: string; }
function emit(model: m.Model, out: Output, type: string, expression: string): m.Value { let id: string = m.fresh(model); out.code = out.code+"let "+id+": "+type+" = "+expression+";\n"; return {type:type,code:id}; }
function scalar(model: m.Model, id: string, env: table, out: Output, active: string[], type: string): string { return m.require(expr(model,id,env,out,active),type).code; }
function copyActive(active: string[], id: string): string[] { let result: string[] = []; for (let value: string of active) { result[result.length] = value; } result[result.length] = id; return result; }
export function expr(model: m.Model, id: string, env: table, out: Output, active: string[]): m.Value {
    if (strings.startsWith(id,"$")) { return m.ref(model,id,env); }
    if (m.contains(active,id)) { m.reject("Expression cycle at "+id); }
    if (!m.present(model.nodes,id)) { m.reject("Unknown expression "+id); }
    let node: table = model.nodes[id]; let op: string = node.op; let args: string[] = node.args; let p: table = node.params; let chain: string[] = copyActive(active,id);
    if (op === "literal") { let type: string = p.type; let value: string = p.value; let target: string = m.type(model,type); return emit(model,out,target,m.initial(model,target,m.data(value))); }
    if (op === "now") { return {type:"number",code:"time.nowMillis()"}; }
    if (op === "record") { let type: string = p.type; let target: string = m.type(model,type); let bindings: table = m.bindings(p,"fields"); let replacements: table = {}; let keys: string[] = []; for (let entry: table of m.fields(model,target)) { let field: string = entry.name; let type: string = entry.type; keys[keys.length] = field; let expression: string = bindings[field]; replacements[field] = m.require(expr(model,expression,env,out,chain),type).code; } m.closed(bindings,keys); return emit(model,out,target,m.copy(model,target,"",replacements)); }
    if (op === "array") { let name: string = p.element; let type: string = m.type(model,name); let result: string = "["; let first: boolean = true; for (let argument: string of args) { if (!first) { result = result+","; } first = false; result = result+m.require(expr(model,argument,env,out,chain),type).code; } return emit(model,out,type+"[]",result+"]"); }
    if (op === "concat") { let result: string = ""; for (let argument: string of args) { if (result !== "") { result = result+" + "; } result = result+scalar(model,argument,env,out,chain,"string"); } if (result === "") { result = "\"\""; } return emit(model,out,"string",result); }
    return operation(model,op,args,p,env,out,chain);
}
function operation(model: m.Model, op: string, args: string[], p: table, env: table, out: Output, chain: string[]): m.Value {
    if (op === "custom") { let section: string = p.section; let custom: table = model.custom[section]; let params: table[] = custom.parameters; if (args.length !== params.length) { m.reject("Custom arity"); } let values: string = ""; let index: number = 0; for (let param: table of params) { let type: string = param.type; if (index > 0) { values = values+","; } values = values+scalar(model,args[index],env,out,chain,m.type(model,type)); index = index+1; } let result: string = custom.result; return emit(model,out,m.type(model,result),"custom_"+m.name(section)+"("+values+")"); }
    let a: m.Value = expr(model,args[0],env,out,chain);
    if (m.contains(["add","subtract","multiply","divide","eq","ne","lt","le","gt","ge","and","or"],op)) {
        let b: m.Value = expr(model,args[1],env,out,chain); let symbol: string = ""; let type: string = "number";
        if (op === "add") { symbol = "+"; } if (op === "subtract") { symbol = "-"; } if (op === "multiply") { symbol = "*"; } if (op === "divide") { symbol = "/"; }
        if (symbol !== "") { m.require(a,"number"); m.require(b,"number"); } else {
            type = "boolean";
            if (op === "and" || op === "or") { m.require(a,"boolean"); m.require(b,"boolean"); symbol = "&&"; if (op === "or") { symbol = "||"; } } else {
                if (a.type !== b.type || !m.scalar(a.type)) { m.reject("Comparison types"); }
                if (op !== "eq" && op !== "ne" && a.type !== "number" && a.type !== "string") { m.reject("Ordered comparison needs number or string"); }
                if (op === "eq") { symbol = "==="; } if (op === "ne") { symbol = "!=="; } if (op === "lt") { symbol = "<"; } if (op === "le") { symbol = "<="; } if (op === "gt") { symbol = ">"; } if (op === "ge") { symbol = ">="; }
            }
        }
        return emit(model,out,type,"("+a.code+" "+symbol+" "+b.code+")");
    }
    if (op === "not") { m.require(a,"boolean"); return emit(model,out,"boolean","!"+a.code); }
    if (op === "floor" || op === "ceil" || op === "abs") { m.require(a,"number"); if (op !== "abs") { return emit(model,out,"number","math."+op+"("+a.code+")"); } let result: m.Value = emit(model,out,"number",a.code); out.code = out.code+"if ("+result.code+" < 0) { "+result.code+" = -"+result.code+"; }\n"; return result; }
    if (op === "choose") { m.require(a,"boolean"); let yes: Output = {code:""}; let no: Output = {code:""}; let b: m.Value = expr(model,args[1],env,yes,chain); let c: m.Value = m.require(expr(model,args[2],env,no,chain),b.type); let result: m.Value = emit(model,out,b.type,m.defaultValue(model,b.type)); out.code = out.code+"if ("+a.code+") {\n"+yes.code+result.code+" = "+b.code+";\n} else {\n"+no.code+result.code+" = "+c.code+";\n}\n"; return result; }
    if (op === "integer" || op === "clock") { m.require(a,"number"); let fn: string = "decimal"; if (op === "clock") { fn = "clockMinutes"; } return emit(model,out,"string","values."+fn+"("+a.code+")"); }
    if (op === "numberText") { m.require(a,"number"); let encoded: string = m.fresh(model); let text: string = m.fresh(model); let table: string = m.fresh(model); out.code = out.code+"if ("+a.code+" - "+a.code+" !== 0) { throw {code:\"INVALID_NUMBER\",message:\"Expected a finite value\"}; } let "+table+": table = {}; "+table+"[\"value\"] = "+a.code+"; let "+encoded+": string = json.stringify("+table+"); let "+text+": string = strings.substring("+encoded+",9,strings.length("+encoded+") - 1);\n"; return {type:"string",code:text}; }
    if (op === "field") { let field: string = p.field; return {type:m.field(model,a.type,field),code:a.code+"."+m.symbol(field)}; }
    if (op === "length") { if (m.element(a.type) === "") { m.reject("length needs array"); } return emit(model,out,"number",a.code+".length"); }
    if (op === "first") { let type: string = m.element(a.type); if (type === "") { m.reject("first needs array"); } let result: m.Value = emit(model,out,type,m.defaultValue(model,type)); out.code = out.code+"if ("+a.code+".length > 0) { "+result.code+" = "+a.code+"[0]; }\n"; return result; }
    if (op === "lookup") { let type: string = m.element(a.type); if (type === "") { m.reject("lookup needs array"); } let field: string = p.key; let key: m.Value = m.require(expr(model,args[1],env,out,chain),m.field(model,type,field)); let result: m.Value = emit(model,out,type,m.defaultValue(model,type)); let row: string = m.fresh(model); out.code = out.code+"for (let "+row+": "+type+" of "+a.code+") { if ("+row+"."+m.symbol(field)+" === "+key.code+") { "+result.code+" = "+row+"; } }\n"; return result; }
    return collection(model,op,a,args,p,env,out,chain);
}
function collection(model: m.Model, op: string, a: m.Value, args: string[], p: table, env: table, out: Output, chain: string[]): m.Value {
    if (m.contains(["filter","project","sum","any","all","update"],op)) {
        let rowType: string = m.element(a.type); if (rowType === "") { m.reject(op+" needs array"); } let row: string = m.fresh(model); let inner: Output = {code:""}; let scope: table = m.extend(env,"row",{type:rowType,code:row}); let body: m.Value = expr(model,args[1],scope,inner,chain); let type: string = a.type; let initial: string = "[]";
        if (op === "sum") { m.require(body,"number"); type = "number"; initial = "0"; } if (op === "any" || op === "all") { type = "boolean"; initial = "false"; if (op === "all") { initial = "true"; } } if (op === "project") { type = body.type+"[]"; }
        if (op !== "sum" && op !== "project") { m.require(body,"boolean"); }
        let result: m.Value = emit(model,out,type,initial); out.code = out.code+"for (let "+row+": "+rowType+" of "+a.code+") {\n"+inner.code;
        if (op === "filter") { out.code = out.code+"if ("+body.code+") { "+result.code+"["+result.code+".length] = "+row+"; }\n"; }
        if (op === "project") { out.code = out.code+result.code+"["+result.code+".length] = "+body.code+";\n"; }
        if (op === "sum") { out.code = out.code+result.code+" = "+result.code+" + "+body.code+";\n"; }
        if (op === "any" || op === "all") { let symbol: string = "||"; if (op === "all") { symbol = "&&"; } out.code = out.code+result.code+" = "+result.code+" "+symbol+" "+body.code+";\n"; }
        if (op === "update") { let changes: table = m.bindings(p,"fields"); let replacements: table = {}; let changed: Output = {code:""}; for (let field: string of tables.keys(changes)) { let node: string = changes[field]; replacements[field] = m.require(expr(model,node,scope,changed,chain),m.field(model,rowType,field)).code; } let item: string = m.fresh(model); out.code = out.code+"let "+item+": "+rowType+" = "+m.copy(model,rowType,row,{})+"; if ("+body.code+") {\n"+changed.code+item+" = "+m.copy(model,rowType,row,replacements)+"; }\n"+result.code+"["+result.code+".length] = "+item+";\n"; }
        out.code = out.code+"}\n"; return result;
    }
    if (op === "join") { let right: m.Value = expr(model,args[1],env,out,chain); let lt: string = m.element(a.type); let rt: string = m.element(right.type); if (lt === "" || rt === "") { m.reject("join needs arrays"); } let l: string = m.fresh(model); let r: string = m.fresh(model); let scope: table = m.extend(m.extend(env,"left",{type:lt,code:l}),"right",{type:rt,code:r}); let inner: Output = {code:""}; let projection: Output = {code:""}; let predicate: m.Value = m.require(expr(model,args[2],scope,inner,chain),"boolean"); let value: m.Value = expr(model,args[3],scope,projection,chain); let result: m.Value = emit(model,out,value.type+"[]","[]"); out.code = out.code+"for (let "+l+": "+lt+" of "+a.code+") { for (let "+r+": "+rt+" of "+right.code+") {\n"+inner.code+"if ("+predicate.code+") {\n"+projection.code+result.code+"["+result.code+".length] = "+value.code+"; } } }\n"; return result; }
    if (op === "sort") { let type: string = m.element(a.type); let field: string = p.field; let ft: string = m.field(model,type,field); if (ft !== "number" && ft !== "string") { m.reject("Sort numeric/string field required"); } let result: m.Value = emit(model,out,a.type,"[]"); let row: string = m.fresh(model); let i: string = m.fresh(model); let j: string = m.fresh(model); let left: string = m.fresh(model); let right: string = m.fresh(model); out.code = out.code+"for (let "+row+": "+type+" of "+a.code+") { "+result.code+"["+result.code+".length] = "+row+"; } let "+i+": number = 0; while ("+i+" < "+result.code+".length) { let "+j+": number = 1; while ("+j+" < "+result.code+".length - "+i+") { let "+left+": "+type+" = "+result.code+"["+j+"-1]; let "+right+": "+type+" = "+result.code+"["+j+"]; if ("+left+"."+m.symbol(field)+" > "+right+"."+m.symbol(field)+") { "+result.code+"["+j+"-1] = "+right+"; "+result.code+"["+j+"] = "+left+"; } "+j+" = "+j+"+1; } "+i+" = "+i+"+1; }\n"; return result; }
    if (op === "basket") { let type: string = m.element(a.type); let idField: string = p.id; let quantity: string = p.quantity; m.require({type:m.field(model,type,idField),code:""},"string"); m.require({type:m.field(model,type,quantity),code:""},"number"); let result: m.Value = emit(model,out,"string","\"\""); let row: string = m.fresh(model); let qty: string = row+"."+m.symbol(quantity); out.code = out.code+"for (let "+row+": "+type+" of "+a.code+") { if ("+qty+" > 0) { if (math.floor("+qty+") !== "+qty+") { throw {code:\"INVALID_INTEGER\",message:\"Invalid basket quantity\"}; } if ("+result.code+" !== \"\") { "+result.code+" = "+result.code+" + \",\"; } "+result.code+" = "+result.code+" + "+row+"."+m.symbol(idField)+" + \":\" + values.decimal("+qty+"); } }\n"; return result; }
    return fragment(model,op,a,args,p,env,out,chain);
}
function fragment(model: m.Model, op: string, a: m.Value, args: string[], p: table, env: table, out: Output, chain: string[]): m.Value {
    if (op === "selections" || op === "stockQualified") { return experimental(model,op,a,args,p,env,out,chain); }
    if (op === "inputEdit") { let action: m.Value = expr(model,args[1],env,out,chain); let format: string = p.format; let kind: string = "Number"; let expected: string = "number"; let bounds: string = ""; if (format === "text") { kind = "Text"; expected = "string"; } if (format === "boolean") { kind = "Boolean"; expected = "boolean"; } m.require(a,expected); if (kind === "Number") { m.require(action,"number"); let lo: number = p.minimum; let hi: number = p.maximum; bounds = ","+m.decimal(lo)+","+m.decimal(hi); } else { m.require(action,"string"); } let result: m.Value = emit(model,out,"inputFragment."+kind+"State","inputFragment.edit"+kind+"({m_value:"+a.code+"},{m_value:"+action.code+"}"+bounds+")"); return {type:a.type,code:result.code+".m_value"}; }
    if (op === "fragmentComparison") { m.require(a,"number"); return emit(model,out,"comparisonFragment.State","comparisonFragment.compare("+a.code+","+scalar(model,args[1],env,out,chain,"number")+","+scalar(model,args[2],env,out,chain,"boolean")+")"); }
    if (op === "comparisonValue") { m.require(a,"comparisonFragment.State"); let field: string = p.field; let type: string = "number"; if (field === "status") { type = "string"; } else { if (field === "present") { type = "boolean"; } else { if (field !== "difference" && field !== "magnitude") { m.reject("Unknown comparison port"); } } } return {type:type,code:a.code+".m_"+field}; }
    if (op === "resultText") { m.require(a,"number"); let format: string = p.format; return emit(model,out,"string","resultFragment.number("+a.code+","+m.quote(format)+","+scalar(model,args[1],env,out,chain,"boolean")+").m_text"); }
    if (op === "choicePick" || op === "choiceSelect" || op === "choiceValid") { let type: string = m.element(a.type); let row: string = m.fresh(model); let projected: string = m.fresh(model); let expected: table = {id:"string",label:"string",eligible:"boolean",cost:"number"}; let fs: table[] = m.fields(model,type); if (fs.length !== 4) { m.reject("Choice record shape"); } for (let entry: table of fs) { let name: string = entry.name; let type: string = entry.type; let target: string = expected[name]; if (type !== target) { m.reject("Choice record shape"); } } out.code = out.code+"let "+projected+": choiceFragment.Option[] = []; for (let "+row+": "+type+" of "+a.code+") { let entry: choiceFragment.Option = "+m.copy(model,type,row,{})+"; "+projected+"["+projected+".length] = entry; }\n"; let expression: string = "choiceFragment.prepare("+projected+",true)"; if (op !== "choicePick") { let selected: m.Value = m.require(expr(model,args[1],env,out,chain),type); let copied: string = m.copy(model,type,selected.code,{}); if (op === "choiceValid") { return emit(model,out,"boolean","choiceFragment.valid("+projected+","+copied+","+scalar(model,args[2],env,out,chain,"boolean")+")"); } expression = "choiceFragment.select({m_rows:"+projected+",m_selected:"+copied+",m_present:true},{m_id:"+scalar(model,args[2],env,out,chain,"string")+"})"; } let result: m.Value = emit(model,out,"choiceFragment.State",expression); return emit(model,out,type,m.copy(model,type,result.code+".m_selected",{})); }
    return algorithms(model,op,a,args,p,env,out,chain);
}
function algorithms(model: m.Model, op: string, a: m.Value, args: string[], p: table, env: table, out: Output, chain: string[]): m.Value {
    let rowType: string = m.element(a.type); if (rowType === "") { m.reject(op+" requires rows"); }
    if (op === "allocate") { let quantity: string = p.quantity; let cost: string = p.cost; m.require({type:m.field(model,rowType,quantity),code:""},"number"); m.require({type:m.field(model,rowType,cost),code:""},"number"); let quotas: table[] = p.quotas; let flags: string = ""; let minimums: string = ""; for (let quota: table of quotas) { let field: string = quota.field; let minimum: string = quota.minimum; m.require({type:m.field(model,rowType,field),code:""},"boolean"); if (flags !== "") { flags = flags+","; minimums = minimums+","; } flags = flags+"row."+m.symbol(field); minimums = minimums+scalar(model,minimum,env,out,chain,"number"); } let total: string = scalar(model,args[1],env,out,chain,"number"); let budget: string = scalar(model,args[2],env,out,chain,"number"); let projected: string = m.fresh(model); let result: string = m.fresh(model); let dest: string = m.fresh(model); let replacements: table = {}; replacements[quantity] = "count"; out.code = out.code+"let "+projected+": allocation.Row[] = []; for (let row: "+rowType+" of "+a.code+") { let flags: boolean[] = ["+flags+"]; let entry: allocation.Row = {cost:row."+m.symbol(cost)+",quotas:flags}; "+projected+"["+projected+".length] = entry; }\nlet "+result+": allocation.State = allocation.allocate("+projected+","+total+","+budget+",["+minimums+"]); let "+dest+": "+a.type+" = []; let index: number = 0; while (index < "+a.code+".length) { let row: "+rowType+" = "+a.code+"[index]; let count: number = 0; if ("+result+".found) { count = "+result+".quantities[index]; } let selected: "+rowType+" = "+m.copy(model,rowType,"row",replacements)+"; "+dest+"["+dest+".length] = selected; index = index+1; }\n"; return {type:a.type,code:dest}; }
    if (op === "alternatives") { let type: string = p.type; let candidate: string = m.type(model,type); let roles: table[] = p.roles; let flags: string = ""; let quantities: string = ""; if (roles.length === 0) { m.reject("At least one role required"); } for (let role: table of roles) { let field: string = role.field; let quantity: string = role.quantity; m.require({type:m.field(model,rowType,field),code:""},"boolean"); if (flags !== "") { flags = flags+","; quantities = quantities+","; } flags = flags+"row."+m.symbol(field); quantities = quantities+scalar(model,quantity,env,out,chain,"number"); } let ct: string = m.element(m.field(model,rowType,"components")); let projected: string = m.fresh(model); let baskets: string = m.fresh(model); let result: string = m.fresh(model); out.code = out.code+"let "+projected+": alternativeSearch.Row[] = []; for (let row: "+rowType+" of "+a.code+") { let components: alternativeSearch.Component[] = []; for (let component: "+ct+" of row.m_components) { let entry: alternativeSearch.Component = {id:component.m_id,quantity:component.m_quantity}; components[components.length] = entry; } let flags: boolean[] = ["+flags+"]; let entry: alternativeSearch.Row = {id:row.m_id,capacity:row.m_capacity,components:components,roles:flags}; "+projected+"["+projected+".length] = entry; }\nlet "+baskets+": alternativeSearch.Basket[] = alternatives.enumerate("+projected+",["+quantities+"]).baskets; let "+result+": "+candidate+"[] = []; for (let basket: alternativeSearch.Basket of "+baskets+") { let items: "+a.type+" = []; let key: string = \"\"; let label: string = \"\"; let index: number = 0; while (index < "+a.code+".length) { let row: "+rowType+" = "+a.code+"[index]; let count: number = basket.quantities[index]; if (count > 0) { let selected: "+rowType+" = "+m.copy(model,rowType,"row",{quantity:"count"})+"; items[items.length] = selected; if (key !== \"\") { key = key+\",\"; label = label+\" + \"; } key = key+row.m_id+\":\"+values.decimal(count); label = label+row.m_label+\" × \"+values.decimal(count); } index = index+1; } let entry: "+candidate+" = {m_items:items,m_key:key,m_label:label}; "+result+"["+result+".length] = entry; }\n"; return {type:candidate+"[]",code:result}; }
    if (op === "covers") { let catalogue: m.Value = expr(model,args[1],env,out,chain); m.require(catalogue,a.type); let components: string = p.components; let key: string = p.key; let itemId: string = p.itemId; let quantity: string = p.quantity; let ct: string = m.element(m.field(model,rowType,components)); let groups: table[] = p.groups; let totals: string[] = []; let counts: string[] = []; for (let group: table of groups) { let minimum: string = group.minimum; totals[totals.length] = m.fresh(model); counts[counts.length] = scalar(model,minimum,env,out,chain,"number"); } let dest: m.Value = emit(model,out,a.type,"[]"); let pkg: string = m.fresh(model); let component: string = m.fresh(model); let row: string = m.fresh(model); let known: string = m.fresh(model); let valid: string = m.fresh(model); out.code = out.code+"for (let "+pkg+": "+rowType+" of "+a.code+") { let "+valid+": boolean = true;\n"; for (let total: string of totals) { out.code = out.code+"let "+total+": number = 0;\n"; } let qty: string = component+"."+m.symbol(quantity); out.code = out.code+"for (let "+component+": "+ct+" of "+pkg+"."+m.symbol(components)+") { if ("+qty+" < 1 || math.floor("+qty+") !== "+qty+" || "+qty+" - "+qty+" !== 0) { "+valid+" = false; } let "+known+": boolean = false; for (let "+row+": "+rowType+" of "+catalogue.code+") { if ("+row+"."+m.symbol(key)+" === "+component+"."+m.symbol(itemId)+") { "+known+" = true;\n"; let index: number = 0; for (let group: table of groups) { let predicate: string = group.predicate; let test: string = scalar(model,predicate,m.extend(env,"row",{type:rowType,code:row}),out,chain,"boolean"); out.code = out.code+"if ("+test+") { "+totals[index]+" = "+totals[index]+" + "+qty+"; }\n"; index = index+1; } out.code = out.code+"} } if (!"+known+") { "+valid+" = false; } }\n"; let enough: string = "true"; index = 0; for (let count: string of counts) { enough = enough+" && "+totals[index]+" >= "+count; index = index+1; } out.code = out.code+"if ("+valid+" && "+enough+") { "+dest.code+"["+dest.code+".length] = "+pkg+"; } }\n"; return dest; }
    m.reject("Unsupported operation "+op+"; request an explicit custom section or full-source fallback"); return {type:"null",code:"null"};
}
function experimental(model: m.Model, op: string, a: m.Value, args: string[], p: table, env: table, out: Output, chain: string[]): m.Value {
    let b: m.Value = expr(model,args[1],env,out,chain); let result: table = {};
    if (op === "stockQualified") { result = selection.stock(model,a,b); }
    else { m.require(b,"number"); let minima: string[] = []; let maxima: string[] = []; let constraints: table[] = p.constraints; for (let c: table of constraints) { let lo: string = c.minimum; let hi: string = c.maximum; minima[minima.length] = scalar(model,lo,env,out,chain,"number"); maxima[maxima.length] = scalar(model,hi,env,out,chain,"number"); } result = selection.select(model,a,b,p,minima,maxima); }
    let prefix: string = result.prefix; out.code = out.code+prefix; let type: string = result.type; let code: string = result.code; return {type:type,code:code};
}
export function main(): null { return null; }
