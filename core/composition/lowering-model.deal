import * as decoded from "../decoded";
import * as json from "std/json";
import * as strings from "std/string";
import * as tables from "std/table";

export class Value { type: string; code: string; }
export class Model { records: Record<string, unknown>; declarations: string; helpers: string; nodes: Record<string, unknown>; optional: Record<string, unknown>; serial: number; custom: Record<string, unknown>; fragments: boolean; allowCustom: boolean; experimental: boolean; contracts: Record<string, unknown>[]; }
export function value(type: string, code: string): Value { return {type:type,code:code}; }
export function create(contracts: Record<string, unknown>[], custom: boolean, experimental: boolean): Model { return {records:{},declarations:"",helpers:"",nodes:{},optional:{},serial:0,custom:{},fragments:false,allowCustom:custom,experimental:experimental,contracts:contracts}; }
export function reject(message: string): null { throw {code:"INVALID_CONFIG",message:message}; }
export function contains(values: string[], value: string): boolean { for (let entry of values) { if (entry === value) { return true; } } return false; }
export function present(value: Record<string, unknown>, key: string): boolean { return contains(tables.keys(value),key); }
export function name(value: string): string { let index: number = 0; for (let ch of value) { let alphabet: string = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ"; if (index > 0) { alphabet = alphabet + "_0123456789"; } if (!strings.contains(alphabet,ch)) { reject("Invalid ID: "+value); } index = index + 1; } if (index === 0) { reject("Invalid ID: "+value); } return value; }
export function symbol(value: string): string { return "m_"+name(value); }
export function decimal(value: number): string { if (value-value !== 0) { reject("Nonfinite number"); } let encoded: string = (json.stringify({value:value}) as string); let text: string = strings.substring(encoded,9,strings.length(encoded)-1); let exponent: string[] = strings.split(strings.replace(text,"E","e"),"e"); if (exponent.length === 2) { let power: number = 0; let negative: boolean = false; for (let ch of exponent[1]) { if (ch === "-") { negative = true; } else { if (ch !== "+") { let digit: number = 0; for (let candidate of "0123456789") { if (candidate === ch) { power = power*10+digit; } digit = digit+1; } } } } if (negative) { power = -power; } let mantissa: string = exponent[0]; let sign: string = ""; if (strings.startsWith(mantissa,"-")) { sign = "-"; mantissa = strings.substring(mantissa,1,strings.length(mantissa)); } let pieces: string[] = strings.split(mantissa,"."); let digits: string = strings.replace(mantissa,".",""); let point: number = strings.length(pieces[0])+power; while (point < 0) { digits = "0"+digits; point = point+1; } while (point > strings.length(digits)) { digits = digits+"0"; } if (point === 0) { return sign+"0."+digits; } if (point === strings.length(digits)) { return sign+digits; } return sign+strings.substring(digits,0,point)+"."+strings.substring(digits,point,strings.length(digits)); } if (strings.endsWith(text,".0")) { return strings.substring(text,0,strings.length(text)-2); } return text; }
export function fresh(m: Model): string { let result: string = "v"+decimal(m.serial); m.serial = m.serial+1; return result; }
function carriageReturn(): string { let value: Record<string, unknown> = json.parse("{\"value\":\"\\r\"}"); let result: string = (value.value as string); return result; }
export function quote(value: string): string { let result: string = "\""; for (let ch of value) { if (ch === "\"") { result = result+"\\\""; } else { if (ch === "\\") { result = result+"\\\\"; } else { if (ch === "\n") { result = result+"\\n"; } else { if (ch === carriageReturn()) { result = result+"\\r"; } else { if (ch === "\t") { result = result+"\\t"; } else { result = result+ch; } } } } } } return result+"\""; }
export function closed(value: Record<string, unknown>, keys: string[]): null { let actual: string[] = tables.keys(value); if (actual.length !== keys.length) { reject("Unexpected object fields"); } for (let key of actual) { if (!contains(keys,key)) { reject("Unexpected field: "+key); } } return null; }
export function element(type: string): string { if (strings.endsWith(type,"[]")) { return strings.substring(type,0,strings.length(type)-2); } return ""; }
export function scalar(type: string): boolean { return contains(["number","string","boolean","null"],type); }
export function type(m: Model, value: string): string { if (strings.endsWith(value,"[]")) { return type(m,element(value))+"[]"; } if (scalar(value)) { return value; } let result: string = symbol(value); if (!present(m.records,result)) { reject("Unknown type: "+value); } return result; }
export function fields(m: Model, type: string): Record<string, unknown>[] { if (!present(m.records,type)) { reject("Expected record, got "+type); } let result: Record<string, unknown>[] = decoded.records(m.records[type]); return result; }
export function field(m: Model, type: string, key: string): string { let available: string = ""; for (let entry of fields(m,type)) { let name: string = (entry.name as string); let value: string = (entry.type as string); if (name === key) { return value; } available = available+name+": "+value+"; "; } reject("No field '"+key+"' in "+type+". Available fields: "+available+"Preserve the disclosed nested field path; never flatten records."); return ""; }
export function declare(m: Model, name: string, fields: Record<string, unknown>[]): string { if (present(m.records,name)) { reject("Duplicate record "+name); } m.records[name] = fields; m.declarations = m.declarations+"export class "+name+" { "; for (let field of fields) { let key: string = (field.name as string); let type: string = (field.type as string); m.declarations = m.declarations+symbol(key)+": "+type+"; "; } m.declarations = m.declarations+"}\n"; return name; }
export function copy(m: Model, type: string, source: string, replacements: Record<string, unknown>): string { let result: string = "{"; let first: boolean = true; for (let entry of fields(m,type)) { let key: string = (entry.name as string); let value: string = source+"."+symbol(key); if (present(replacements,key)) { value = (replacements[key] as string); } if (!first) { result = result+","; } first = false; result = result+symbol(key)+":"+value; } return result+"}"; }
export function defaultValue(m: Model, type: string): string { if (element(type) !== "") { return "[]"; } if (type === "number") { return "0"; } if (type === "string") { return "\"\""; } if (type === "boolean") { return "false"; } if (type === "null") { return "null"; } let replacements: Record<string, unknown> = {}; for (let entry of fields(m,type)) { let key: string = (entry.name as string); let child: string = (entry.type as string); replacements[key] = defaultValue(m,child); } return copy(m,type,"",replacements); }
export function initial(m: Model, type: string, raw: Record<string, unknown>): string { let child: string = element(type); if (child !== "") { let result: string = "["; let values: Record<string, unknown>[] = boxedArray(raw,child); let first: boolean = true; for (let value of values) { if (!first) { result = result+","; } first = false; result = result+initial(m,child,value); } return result+"]"; } if (type === "number") { let value: number = (raw.value as number); return decimal(value); } if (type === "string") { let value: string = (raw.value as string); return quote(value); } if (type === "boolean") { let value: boolean = (raw.value as boolean); if (value) { return "true"; } return "false"; } if (type === "null") { let value: null = (raw.value as null); return "null"; } let value: Record<string, unknown> = (raw.value as Record<string, unknown>); let replacements: Record<string, unknown> = {}; let keys: string[] = []; for (let entry of fields(m,type)) { let key: string = (entry.name as string); let childType: string = (entry.type as string); keys[keys.length] = key; replacements[key] = initial(m,childType,boxedField(value,key,childType)); } closed(value,keys); return copy(m,type,"",replacements); }
function boxedField(value: Record<string, unknown>, key: string, type: string): Record<string, unknown> { if (type === "number") { let v: number = (value[key] as number); return {value:v}; } if (type === "string") { let v: string = (value[key] as string); return {value:v}; } if (type === "boolean") { let v: boolean = (value[key] as boolean); return {value:v}; } if (type === "null") { let v: null = (value[key] as null); return {value:v}; } if (element(type) !== "") { let v: Record<string, unknown>[] = decoded.records(value[key]); return {value:v}; } let v: Record<string, unknown> = (value[key] as Record<string, unknown>); return {value:v}; }
function boxedArray(raw: Record<string, unknown>, type: string): Record<string, unknown>[] { let result: Record<string, unknown>[] = []; if (type === "number") { let values: number[] = decoded.numbers(raw.value); for (let v of values) { result[result.length] = {value:v}; } return result; } if (type === "string") { let values: string[] = decoded.strings(raw.value); for (let v of values) { result[result.length] = {value:v}; } return result; } if (type === "boolean") { let values: boolean[] = decoded.booleans(raw.value); for (let v of values) { result[result.length] = {value:v}; } return result; } let values: Record<string, unknown>[] = decoded.records(raw.value); for (let v of values) { result[result.length] = {value:v}; } return result; }
export function data(text: string): Record<string, unknown> { return json.parse("{\"value\":"+text+"}"); }
export function require(value: Value, type: string): Value { if (value.type !== type) { reject("Expected "+type+", got "+value.type); } return value; }
export function ref(m: Model, path: string, env: Record<string, unknown>): Value { let parts: string[] = strings.split(strings.substring(path,1,strings.length(path)),"."); if (!present(env,parts[0])) { reject("Unknown reference "+path); } let value: Value = (env[parts[0]] as Value); let result: Value = {type:value.type,code:value.code}; let index: number = 1; while (index < parts.length) { result.type = field(m,result.type,parts[index]); result.code = result.code+"."+symbol(parts[index]); index = index+1; } return result; }
export function bindings(value: Record<string, unknown>, key: string): Record<string, unknown> { let entries: Record<string, unknown>[] = decoded.records(value[key]); let result: Record<string, unknown> = {}; for (let entry of entries) { let field: string = (entry.field as string); if (present(result,field)) { reject("Duplicate binding"); } let node: string = (entry.node as string); result[field] = node; } return result; }
export function extend(env: Record<string, unknown>, key: string, value: Value): Record<string, unknown> { let result: Record<string, unknown> = {}; for (let name of tables.keys(env)) { let entry: Value = (env[name] as Value); result[name] = entry; } result[key] = value; return result; }
export function functionContract(m: Model, module: string, name: string): Record<string, unknown> { for (let contract of m.contracts) { let id: string = (contract.module as string); if (id === module) { let functions: Record<string, unknown>[] = decoded.records(contract.functions); for (let fn of functions) { let id: string = (fn.name as string); if (id === name) { return fn; } } reject("Unknown function "+module+"."+name); } } reject("Undisclosed module "+module); return {}; }
export function main(): null { return null; }
