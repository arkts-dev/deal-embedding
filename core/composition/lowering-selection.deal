import * as decoded from "../decoded";
import * as m from "./lowering-model";
import * as tables from "std/table";
function invalid(value: string, condition: string, message: string): string { return "if ("+condition+") { throw {code:\"INVALID_SELECTION\",message:"+m.quote(message)+"}; }\n"; }
function integral(value: string, message: string): string { return invalid(value,value+" < 0 || math.floor("+value+") !== "+value+" || "+value+" - "+value+" !== 0",message); }
export function select(model: m.Model, src: m.Value, budget: m.Value, p: Record<string, unknown>, minima: string[], maxima: string[]): Record<string, unknown> {
    let rowType: string = m.element(src.type); if (rowType === "") { m.reject("Selection rows required"); } let candidateName: string = (p.type as string); let candidate: string = m.type(model,candidateName); let result: string = candidate+"[]"; let fields: Record<string, unknown>[] = m.fields(model,candidate); if (fields.length !== 2 || m.field(model,candidate,"items") !== src.type || m.field(model,candidate,"cost") !== "number") { m.reject("Candidate requires items and cost"); }
    let quantity: string = (p.quantity as string); let cost: string = (p.cost as string); let capacity: string = (p.capacity as string);
    for (let field of [quantity,cost,capacity]) { if (m.field(model,rowType,field) !== "number") { m.reject("Numeric selection fields required"); } }
    let constraints: Record<string, unknown>[] = decoded.records(p.constraints); if (constraints.length === 0) { m.reject("At least one selection constraint required"); }
    let params: string = ""; let next: string = ""; let bounds: string = ""; let invalidBounds: string = "false"; let complete: string = "true"; let useful: string = "false"; let args: string = ""; let index: number = 0;
    for (let c of constraints) { let field: string = (c.field as string); if (m.field(model,rowType,field) !== "number") { m.reject("Numeric constraint required"); } let suffix: string = m.decimal(index); let value: string = "row."+m.symbol(field); params = params+", lo"+suffix+": number, hi"+suffix+": number"; next = next+", lo"+suffix+" - count * "+value+", hi"+suffix+" - count * "+value; bounds = bounds+"if ("+value+" > 0 && count > math.floor(hi"+suffix+" / "+value+")) { count = math.floor(hi"+suffix+" / "+value+"); }\n"; invalidBounds = invalidBounds+" || hi"+suffix+" < 0"; complete = complete+" && lo"+suffix+" <= 0 && hi"+suffix+" >= 0"; useful = useful+" || "+value+" > 0"; args = args+", "+minima[index]+", "+maxima[index]; index = index+1; }
    let fn: string = "select"+m.decimal(model.serial); model.serial = model.serial+1;
    let replacements: Record<string, unknown> = {}; replacements[quantity] = "count";
    model.helpers = model.helpers+"function "+fn+"(rows: "+src.type+", index: number, budget: number"+params+"): "+result+" {\nlet output: "+result+" = []; if (budget < 0 || "+invalidBounds+") { return output; }\nif (index >= rows.length) { if ("+complete+") { let empty: "+src.type+" = []; output[0] = {m_items:empty,m_cost:0}; } return output; }\nlet row: "+rowType+" = rows[index]; let count: number = row."+m.symbol(capacity)+"; if (!("+useful+")) { count = 0; }\n"+bounds+"while (count >= 0) {\nlet tails: "+result+" = "+fn+"(rows,index+1,budget-count*row."+m.symbol(cost)+next+");\nfor (let tail of tails) { let items: "+src.type+" = []; let selected: "+rowType+" = "+m.copy(model,rowType,"row",replacements)+"; items[0] = selected; for (let item of tail.m_items) { items[items.length] = item; } output[output.length] = {m_items:items,m_cost:tail.m_cost+count*row."+m.symbol(cost)+"}; } count = count-1; } return output; }\n";
    let code: string = ""; for (let value of minima) { code = code+integral(value,"Invalid quota bounds"); } for (let value of maxima) { code = code+integral(value,"Invalid quota bounds"); } code = code+invalid(budget.code,budget.code+" - "+budget.code+" !== 0","Invalid budget");
    let row: string = m.fresh(model); let ids: string = m.fresh(model); let key: string = m.fresh(model);
    code = code+"let "+ids+": Record<string, unknown> = {}; for (let "+row+" of "+src.code+") { for (let "+key+" of tables.keys("+ids+")) { if ("+key+" === "+row+".m_id) { throw {code:\"INVALID_SELECTION\",message:\"Duplicate item identity\"}; } } "+ids+"["+row+".m_id] = true;\n"+integral(row+"."+m.symbol(capacity),"Invalid integral capacity or weight");
    for (let c of constraints) { let field: string = (c.field as string); code = code+integral(row+"."+m.symbol(field),"Invalid integral capacity or weight"); }
    let price: string = row+"."+m.symbol(cost); code = code+invalid(price,price+" < 0 || "+price+" - "+price+" !== 0","Invalid cost")+"}\n"; let dest: string = m.fresh(model); code = code+"let "+dest+": "+result+" = "+fn+"("+src.code+",0,"+budget.code+args+");\n"; return {type:result,code:dest,prefix:code};
}
export function stock(model: m.Model, candidates: m.Value, catalogue: m.Value): Record<string, unknown> {
    let ct: string = m.element(candidates.type); let rt: string = m.element(catalogue.type); if (ct === "" || rt === "" || m.field(model,ct,"items") !== catalogue.type) { m.reject("Stock catalogue type"); } let componentType: string = m.element(m.field(model,rt,"components")); if (componentType === "") { m.reject("Components required"); }
    let dest: string = m.fresh(model); let basket: string = m.fresh(model); let item: string = m.fresh(model); let component: string = m.fresh(model); let known: string = m.fresh(model); let stock: string = m.fresh(model); let demand: string = m.fresh(model); let valid: string = m.fresh(model); let found: string = m.fresh(model);
    let code: string = "let "+dest+": "+candidates.type+" = []; for (let "+basket+" of "+candidates.code+") { let "+valid+": boolean = true;\nfor (let "+item+" of "+basket+".m_items) { if ("+item+".m_quantity > 0) { for (let "+component+" of "+item+".m_components) { let "+found+": boolean = false; for (let "+known+" of "+catalogue.code+") { if ("+known+".m_id === "+component+".m_id) { "+found+" = true; } } if (!"+found+" || "+component+".m_quantity < 1 || math.floor("+component+".m_quantity) !== "+component+".m_quantity || "+component+".m_quantity - "+component+".m_quantity !== 0) { "+valid+" = false; } } } }\nfor (let "+stock+" of "+catalogue.code+") { let "+demand+": number = 0; for (let "+item+" of "+basket+".m_items) { if ("+item+".m_id === "+stock+".m_id) { "+demand+" = "+demand+" + "+item+".m_quantity; } for (let "+component+" of "+item+".m_components) { if ("+component+".m_id === "+stock+".m_id) { "+demand+" = "+demand+" + "+item+".m_quantity * "+component+".m_quantity; } } } if ("+demand+" > "+stock+".m_capacity) { "+valid+" = false; } } if ("+valid+") { "+dest+"["+dest+".length] = "+basket+"; } }\n";
    return {type:candidates.type,code:dest,prefix:code};
}
export function main(): null { return null; }
