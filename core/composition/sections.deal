import * as decoded from "../decoded";
import * as contract from "../section-contract";
import * as json from "std/json";
import * as strings from "std/string";
import * as tables from "std/table";

function clone(value: Record<string, unknown>): Record<string, unknown> { return json.parse(json.stringify(value) as string); }
function contains(values: string[], value: string): boolean { for (let item of values) { if (item === value) { return true; } } return false; }
function expression(value: Record<string, unknown>, mapping: Record<string, unknown>): null {
    if (Object.hasOwn(value,"expr")) { value.expr = contract.rewrite(value.expr as string,mapping); return null; }
    for (let key of tables.keys(value)) {
        let child: Record<string, unknown> | null = null; try { child = value[key] as Record<string, unknown>; } catch (error) { }
        if (child !== null) { expression(child as Record<string, unknown>,mapping); value[key] = child; }
        else { let array: Record<string, unknown>[] | null = null; try { array = decoded.records(value[key]); } catch (error) { }
            if (array !== null) { let values: Record<string, unknown>[] = array as Record<string, unknown>[]; for (let entry of values) { expression(entry,mapping); } value[key] = values; }
        }
    } return null;
}
// Namespace isolation owns all state/actions/view roots via ordinary maintained instances.
// No user graph, assignment, source body or native validator is involved.
export function flatten(plan: Record<string, unknown>): Record<string, unknown> {
    let result: Record<string, unknown> = clone(plan); let fragments: Record<string, unknown>[] = []; let commands: Record<string, unknown>[] = []; let display: string[] = [];
    let owned: Record<string, unknown> = {};
    let hasSections: boolean = false; for (let fragment of decoded.records(plan.fragments)) { let kind: string = fragment.kind as string; hasSections = hasSections || kind === "section"; }
    if (!hasSections) { return plan; }
    for (let fragment of decoded.records(plan.fragments)) { let id: string = fragment.id as string; if (strings.startsWith(id,"SectionOwned")) { contract.fail("Reserved owner namespace"); } }
    for (let fragment of decoded.records(plan.fragments)) {
        let id: string = fragment.id as string; let kind: string = fragment.kind as string;
        if (kind !== "section") { fragments[fragments.length] = fragment; continue; }
        let config: Record<string, unknown> = fragment.config as Record<string, unknown>; contract.check(config);
        let subtree: Record<string, unknown> = config.plan as Record<string, unknown>; let mapping: Record<string, unknown> = {}; let names: string[] = [];
        let length: string = json.stringify(strings.length(id)) as string; if (strings.endsWith(length,".0")) { length = strings.substring(length,0,strings.length(length)-2); }
        let prefix: string = "SectionOwned"+length+"_"+id+"_";
        for (let entry of decoded.records(config.imports)) { let name: string = entry.name as string; names[names.length] = name; mapping[name] = prefix+"Import_"+name; }
        for (let entry of decoded.records(subtree.fragments)) { let name: string = entry.id as string; names[names.length] = name; mapping[name] = prefix+"Part_"+name; }
        for (let entry of decoded.records(config.imports)) { let name: string = entry.name as string; let type: string = entry.type as string;
            fragments[fragments.length] = {id:mapping[name],kind:"sectionImport",config:{value:entry.value,type:type}};
        }
        for (let entry of decoded.records(subtree.fragments)) { let copy: Record<string, unknown> = clone(entry); let name: string = copy.id as string; copy.id = mapping[name]; expression(copy.config as Record<string, unknown>,mapping); fragments[fragments.length] = copy; }
        let exports: Record<string, unknown>[] = [];
        for (let entry of decoded.records(config.exports)) { let value: Record<string, unknown> = clone(entry); expression(value,mapping); exports[exports.length] = value; }
        // This internal projection is never accepted as model-authored shape.
        fragments[fragments.length] = {id:id,kind:"sectionExports",config:{exports:exports}};
        let views: string[] = []; for (let name of decoded.strings(subtree.display)) { if (!Object.hasOwn(mapping,name)) { contract.fail("Unknown owned view root"); } views[views.length] = mapping[name] as string; } owned[id] = views;
        let commandIds: string[] = [];
        for (let command of decoded.records(subtree.commands)) { let copy: Record<string, unknown> = clone(command); let name: string = copy.id as string; contract.name(name); if (contains(commandIds,name) || contains(names,name)) { contract.fail("Overlapping command owner"); } commandIds[commandIds.length] = name; copy.id = prefix+"Command_"+name;
            let targets: string[] = []; for (let target of decoded.strings(copy.targets)) { if (!Object.hasOwn(mapping,target)) { contract.fail("Unowned command target"); } targets[targets.length] = mapping[target] as string; } copy.targets = targets; commands[commands.length] = copy;
        }
    }
    for (let command of decoded.records(plan.commands)) { let id: string = command.id as string; if (strings.startsWith(id,"SectionOwned")) { contract.fail("Reserved command namespace"); } commands[commands.length] = command; }
    for (let id of decoded.strings(plan.display)) { if (Object.hasOwn(owned,id)) { for (let view of decoded.strings(owned[id])) { display[display.length] = view; } } else { display[display.length] = id; } }
    // Import adapters are nonvisual; only owned displayed sections enter the screen recipe.
    result.fragments = fragments; result.commands = commands; result.display = display; return result;
}
export function main(): null { return null; }
