import * as embedding from "embedding";

export class ContextValue { schema: embedding.WireType; json: string; }
// Boundary codec only. Limits and admission are selected by compiled controller policy.
export function context(schema: embedding.WireType, valueJson: string, maximumBytes: number, maximumDepth: number, maximumFields: number, maximumLength: number): ContextValue;

export class PreparedStart { id: string; session: string; trace: string; }
export function prepareStart(experience: embedding.Experience, session: string): Promise<PreparedStart>;
export function persistStart(prepared: PreparedStart): Promise<null>;
export function activateStart(prepared: PreparedStart): Promise<null>;
// Abort releases only the unactivated store; it retains preparation and saved source.
export function abortStart(prepared: PreparedStart, code: string, message: string): Promise<null>;
