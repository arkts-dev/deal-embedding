import * as embedding from "embedding";
import * as strings from "std/string";

// The accepted composition binds every migrated spec component the items name: a numeric field,
// a guarded numeric text, a boolean toggle, a value-carrying button and an authored text.
function panelView(): string { return "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Text(text: \"Authored text 😀\") ui.NumberField(label: \"Value\", value: state.value, minimum: 0, maximum: 999, step: 1, onChange: action app.Change {value: payload}) When(state.double_ready) { ui.NumberText(value: state.double_display) } ui.Toggle(label: \"Flag\", checked: state.flag, onChange: action app.Switch {value: payload}) ui.Button(text: \"Load\", value: state.value, onClick: action app.Load {sequence: payload}) ui.Button(text: \"Link\", value: state.value, onClick: action app.Link {value: payload}) } }"; }
function fragment(id: string, initial: string): screens.Instance {
  let fields: screens.Field[] = [
    {name:"value",type:"number",role:"authoritative",dependencies:[],initial:initial,owner:id},
    {name:"double",type:"number",role:"derived",dependencies:["value"],initial:"null",owner:id},
    {name:"flag",type:"boolean",role:"authoritative",dependencies:[],initial:"false",owner:id},
    {name:"sequence",type:"number",role:"authoritative",dependencies:[],initial:"0",owner:id},
    {name:"display",type:"number",role:"authoritative",dependencies:[],initial:"1",owner:id},
    {name:"head",type:"Entry | null",role:"authoritative",dependencies:[],initial:"null",owner:id},
    {name:"mirror",type:"Entry | null",role:"authoritative",dependencies:[],initial:"null",owner:id},
    {name:"leaf",type:"Entry | null",role:"authoritative",dependencies:[],initial:"null",owner:id}
  ];
  let updates: screens.Handler[] = [{action:"Change",function:"change"},{action:"Switch",function:"switchValue"},{action:"Load",function:"load"},{action:"Link",function:"link"}];
  // head and mirror alias one another, their optional `next` fields form a cycle, and leaf
  // omits `next` entirely: the saved graph must keep identity, cycles and absence.
  let fragment: screens.Fragment = {declarations:"export class Change { value: number; } export class Switch { value: boolean; } export class Load { sequence: number; } export class Link { value: number; } export class Entry { value: number; next?: Entry; labels?: Record<string, string>; }",fields:fields,updates:updates,effects:[],helpers:"export function change(state: AppState, action: Change): AppState { return {value: action.value, double: state.double}; } export function switchValue(state: AppState, action: Switch): AppState { return {flag: action.value}; } export function load(state: AppState, action: Load): AppState { return {sequence: action.sequence}; } export function link(state: AppState, action: Link): AppState { let head: Entry = {value: action.value}; let mirror: Entry = {value: action.value+1}; let leaf: Entry = {value: action.value+2, labels: {\"__proto__\": \"safe\", text: \"\\ud800\"}}; head.next = mirror; mirror.next = head; return {head: head, mirror: mirror, leaf: leaf}; }",view:panelView(),options:[],content:[],ports:[],holes:[],covers:[],owns:[id]};
  return {id:id,kind:"custom",origin:"custom",parameters:{},fragment:fragment,bodies:{}};
}
function composition(instances: screens.Instance[]): screens.Composition { return {screen:{title:"Counter",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:instances},bindings:{},actions:{},connections:[]}; }
function cleanView(instance: screens.Instance): void { instance.fragment.view = panelView(); }
function insist(value: boolean, message: string): void { if (!value) { throw {name:"TEST_FAILED",message:message}; } }
export async function rejects(): Promise<null> {
  let instance: screens.Instance = fragment("calculation","3"); cleanView(instance);
  let calculation: composer.Computation = {instance:"calculation",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:[]};
  let rejected: boolean = false; try { await composer.assemble(composition([instance]),[calculation]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA"; } insist(rejected,"Undeclared state read admitted");
  // A later syntax failure must not mask the earlier undeclared-read policy error.
  calculation.reason = "(";
  rejected = false; try { await composer.assemble(composition([instance]),[calculation]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA"; } insist(rejected,"Batched syntax reordered policy rejection");
  calculation.reason = "\"Unavailable\"";
  calculation.dependencies = ["f_calculation_value"];
  calculation.value = "Array.isArray(state.value) ? 0 : state.value * 2";
  let inspected: composer.Result = await composer.assemble(composition([instance]),[calculation]);
  insist(inspected.source.deal.includes("Array.isArray"),"Pure array inspection was not emitted");
  calculation.value = "clock.nowMillis()"; instance.fragment.declarations = instance.fragment.declarations+" import * as clock from \"std/time\";";
  rejected = false; try { await composer.assemble(composition([instance]),[calculation]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA"; } insist(rejected,"Clock admitted in recompute");
  calculation.value = "Array.isArray(clock.nowMillis()) ? 1 : 0";
  rejected = false; try { await composer.assemble(composition([instance]),[calculation]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA"; } insist(rejected,"Array inspection hid an effectful argument");
  instance.fragment.helpers = instance.fragment.helpers+" export function indirect(candidate: AppState): number { return clock.nowMillis() + candidate.value; }"; calculation.value = "indirect(state)";
  rejected = false; try { await composer.assemble(composition([instance]),[calculation]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA"; } insist(rejected,"Transitive clock read admitted");
  calculation.value = "state.value * 2";
  rejected = false; try { await composer.assemble(composition([instance]),[]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA"; } insist(rejected,"Missing producer admitted");
  // A fragment may not shadow the composer-owned persistence roles.
  let shadowed: screens.Instance = fragment("shadow","3"); cleanView(shadowed);
  shadowed.fragment.helpers = shadowed.fragment.helpers+" export function bridgeRestoredState(state: AppState): AppState { return state; }";
  let producer: composer.Computation = {instance:"shadow",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_shadow_value"]};
  rejected = false; try { await composer.assemble(composition([shadowed]),[producer]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.name === "CONSTRUCTION_SCHEMA" && error.message.includes("Composer-owned declaration"); } insist(rejected,"Composer-owned persistence role shadowed");
  return null;
}
export async function construct(): Promise<string> {
  let instance: screens.Instance = fragment("calculation","3");
  cleanView(instance);
  instance.fragment.fields[instance.fragment.fields.length] = {name:"samples",type:"(number | null)[]",role:"authoritative",dependencies:[],initial:"[1, null, 3]",owner:instance.id};
  instance.fragment.fields[instance.fragment.fields.length] = {name:"matrix",type:"((number | null)[] | null)[] | null",role:"authoritative",dependencies:[],initial:"[[1, null], null, []]",owner:instance.id};
  instance.fragment.fields[instance.fragment.fields.length] = {name:"triple",type:"number",role:"derived",dependencies:["double"],initial:"null",owner:instance.id};
  let record: screens.Composition = composition([instance]);
  let calculations: composer.Computation[] = [{instance:"calculation",field:"double",value:"state.value * 2",ready:"state.value >= 0",reason:"\"Value must be nonnegative\"",dependencies:["f_calculation_value"]}];
  calculations[calculations.length] = {instance:instance.id,field:"triple",value:"(state.double as number) * 3",ready:"true",reason:"\"Upstream unavailable\"",dependencies:["f_calculation_double"]};
  let result: composer.Result = await composer.assemble(record,calculations);
  return s.encode(result);
}
// The clock part issues a monotone countdown: an authoritative elapsed/running/completed trio, a
// checked millisecond duration from the issued length source, a clamped remaining, a once-only
// completion and a restart that clears elapsed. It assembles and compiles as emitted source.
export async function clockPart(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Focus\",\"inputs\":[],\"constants\":[{\"id\":\"span\",\"label\":\"Span\",\"measure\":\"minutes\",\"value\":1}],\"requirements\":[],\"needs\":[{\"id\":\"focus\",\"type\":\"countdown\",\"words\":\"Focus\",\"reads\":[\"span\"],\"spec\":{\"label\":\"Focus\",\"length\":\"span\"}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.alternatives.length === 1 && definitions.alternatives[0].id === "clock_focus" && definitions.alternatives[0].kind === "clock","Countdown clock alternative missing");
  // The alternative's selection criteria state the behaviour the emitted part implements: the admitted
  // monotone delta always counts and only a wall reading departing from it invalidates trust, so nobody
  // selects this clock against a bounded catch-up rule it does not have.
  let clockCriteria: string = definitions.alternatives[0].criteria;
  insist(strings.contains(clockCriteria,"the admitted monotone delta always counts"),"the clock criteria omit the emitted advance rule: "+clockCriteria);
  insist(!strings.contains(clockCriteria,"driver bound") && !strings.contains(clockCriteria,"advances by one interval"),"the clock criteria advertise a bounded catch-up the part does not implement: "+clockCriteria);
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"focus",alternative:"clock_focus",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(built.instance.fragment.covers.length === 1 && built.instance.fragment.covers[0] === "focus","Clock part covers no need");
  let focusSlot: screens.Slot = {id:"focus",need:"focus",reads:["span"],writes:[],provider:false,allowedKinds:["clock"],valueType:"number",status:"filled",instance:"parts",reason:""};
  let result: composer.Result = await composer.assemble({screen:{title:"Focus",target:"screen",layout:{kind:"stack",positions:[]},slots:[focusSlot],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations);
  // The constant length converts to exactly 60000 checked milliseconds of this part's duration.
  insist(strings.contains(result.source.deal,"let value: number = 60000.0;"),"Constant countdown duration was not converted to 60000 milliseconds");
  insist(strings.contains(result.source.deal,"export class f_parts_Tick_focus") && strings.contains(result.source.deal,"export class f_parts_Ready_focus"),"Clock driver actions missing");
  // The private driver identities are compiler metadata, including the qualified runtime fields it
  // reads and the host interval; generated source only carries the issued carriers.
  insist(result.metadata.clockDrivers.length === 1,"Clock driver metadata missing");
  let issuedDriver: screens.Driver = result.metadata.clockDrivers[0];
  insist(issuedDriver.need === "focus" && issuedDriver.intervalMs === 1000,"Clock driver metadata is wrong");
  insist(issuedDriver.request === "f_parts_request_focus" && issuedDriver.running === "f_parts_running_focus","Clock driver runtime fields are not qualified compiler metadata");
  insist(issuedDriver.restore === "f_parts_restore","Clock driver restore identity is not issued: "+issuedDriver.restore);
  // A Session resume is a lifecycle event the private driver publishes: the issued carrier advances the
  // Session epoch and clears the sampling anchors while the authoritative run is retained.
  insist(issuedDriver.resume === "clock_resume","Clock driver resume identity is not issued: "+issuedDriver.resume);
  insist(strings.contains(result.source.deal,"export class f_parts_ResumeClock") && strings.contains(result.source.deal,"export function f_parts_resumeClock"),"The issued clock resume carrier is missing");
  insist(strings.contains(result.source.dealui,"id: \"clock_resume\""),"The clock resume carrier is not emitted");
  // The Session-local clock epoch and its trust are issued runtime state the expiry driver reads; the
  // driver metadata names exactly those compiled fields.
  insist(result.metadata.sessionClock.epoch === "f_parts_clockEpoch" && result.metadata.sessionClock.trust === "f_parts_clockTrust","the Session clock identity is not issued metadata");
  insist(result.metadata.sessionClock.resume === "clock_resume" && issuedDriver.resume === result.metadata.sessionClock.resume,"the Session resume identity is not issued metadata");
  insist(issuedDriver.epoch === "f_parts_clockEpoch" && issuedDriver.trust === "f_parts_clockTrust","Clock driver does not name the Session clock epoch fields: "+issuedDriver.epoch+" "+issuedDriver.trust);
  insist(strings.contains(result.source.deal,"f_parts_clockEpoch: number;") && strings.contains(result.source.deal,"f_parts_clockTrust: boolean;"),"the Session clock epoch is not emitted runtime state");
  // Every admitted press compares its own paired reading exactly as the tick does; no press keeps a
  // monotone-only trust rule of its own.
  insist(strings.contains(result.source.deal,"clockEpochNext") && strings.contains(result.source.deal,"clockTrustNext") && strings.contains(result.source.deal,"clockNoticeNow"),"the Session trust epoch has no paired comparison");
  insist(!strings.contains(result.source.deal,"clockEpochPress") && !strings.contains(result.source.deal,"clockTrustPress"),"a press kept a monotone-only trust rule");
  // Every press carrier carries the wall reading of its paired sample and the run baseline is that
  // reading instead of a cleared placeholder.
  insist(strings.contains(result.source.dealui,"onTick: action app.f_parts_Start_focus {wall: payload}") && strings.contains(result.source.dealui,"onTick: action app.f_parts_Pause_focus {wall: payload}") && strings.contains(result.source.dealui,"onTick: action app.f_parts_Reset_focus {wall: payload}"),"a press carrier does not carry the wall reading of its paired sample");
  // The admitted press keeps its own wall reading as the run baseline and compares it through the same
  // compiled expressions the tick uses instead of a monotone-only rule.
  let startParts: string[] = strings.split(result.source.deal,"export function f_parts_start_focus");
  insist(startParts.length === 2,"the emitted pair carries no start reducer");
  let startBody: string = strings.substring(startParts[1],0,9000);
  insist(strings.contains(startBody,"let rawWall: number = action.wall;") && strings.contains(startBody,"f_parts_wall_focus: wall,") && strings.contains(startBody,"f_parts_clockNoticeNow(") && strings.contains(startBody,"f_parts_clockEpochNext("),"a press neither reads its paired wall sample nor compares it: "+startBody);
  insist(strings.contains(result.source.deal,"export function f_parts_restore(state: AppState): AppState"),"The issued clock restore identity is not emitted");
  for (let identity of [issuedDriver.sample,issuedDriver.tick,issuedDriver.start,issuedDriver.pause,issuedDriver.reset]) { insist(strings.contains(result.source.dealui,"id: \""+identity+"\""),"Issued driver identity is not emitted: "+identity); }
  insist(strings.contains(result.source.deal,"export class f_parts_Start_focus") && strings.contains(result.source.deal,"export class f_parts_Pause_focus") && strings.contains(result.source.deal,"export class f_parts_Reset_focus"),"The issued clock controls are missing");
  insist(strings.contains(result.source.dealui,"running: false, onTick") && !strings.contains(result.source.dealui,"running: true, onTick"),"A driver carrier must never run from a renderer event");
  // Nothing fabricates a scheduled interval when a sample is missing.
  insist(!strings.contains(result.source.deal,"clockTick") && strings.contains(result.source.deal,"clockPrepared"),"A missing sample must never become a scheduled interval");
  insist(!strings.contains(result.source.dealui,"sample_focus >= 0"),"Start must not wait for a periodic tick");
  // The cold-restore normalization pauses the run and clears the runtime sampling bookkeeping while
  // retaining the authoritative elapsed and completed values.
  let after: string[] = strings.split(result.source.deal,"export function f_parts_restorePaused");
  insist(after.length === 2,"Clock restore normalization missing");
  let normalization: string = strings.substring(after[1],0,2000);
  insist(strings.contains(normalization,"f_parts_running_focus: false") && strings.contains(normalization,"f_parts_anchor_focus: (-1.0)") && strings.contains(normalization,"f_parts_sample_focus: (-1.0)") && strings.contains(normalization,"f_parts_wall_focus: (-1.0)") && strings.contains(normalization,"f_parts_notice_focus: \"\""),"Clock restore normalization is incomplete: "+normalization);
  // A restore starts the Session epoch untrusted and advances it, so evidence captured before the
  // restore is stale; nothing re-trusts it by restoring.
  insist(strings.contains(normalization,"f_parts_clockEpoch: (state.f_parts_clockEpoch + 1.0)") && strings.contains(normalization,"f_parts_clockTrust: false"),"Clock restore does not advance the Session trust epoch: "+normalization);
  insist(!strings.contains(normalization,"f_parts_trusted_focus"),"a per-clock trust boolean survived the Session trust epoch");
  insist(strings.contains(normalization,"f_parts_pending_focus: (-1.0)") && strings.contains(normalization,"f_parts_request_focus: 0.0"),"Clock restore normalization leaves prepared driver state: "+normalization);
  insist(strings.contains(normalization,"f_parts_elapsed_focus: state.f_parts_elapsed_focus") && strings.contains(normalization,"f_parts_completed_focus: state.f_parts_completed_focus"),"Clock restore normalization must retain authoritative elapsed/completed: "+normalization);
  insist(strings.contains(result.source.deal,"export function f_parts_restore(state: AppState): AppState"),"Clock restore normalization is not wired to recompute");
  insist(strings.contains(result.source.deal,"f_parts_sample_focus: number;") && !strings.contains(result.source.deal,"f_parts_sample_focus: number | null;"),"Runtime sampling state lost");
  return s.encode(result);
}
// A countdown whose length is an editable issued input, beside a stopwatch in the same owner
// instance: draft changes recompute the duration and remaining without touching elapsed, a start
// with an unready duration is a guarded no-op, and the stopwatch never completes.
export async function clockInputPart(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Timer\",\"inputs\":[{\"id\":\"minutes\",\"label\":\"Minutes\",\"kind\":\"amount\",\"measure\":\"minutes\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"focus\",\"type\":\"countdown\",\"words\":\"Focus\",\"reads\":[\"minutes\"],\"spec\":{\"label\":\"Focus\",\"length\":\"minutes\"}},{\"id\":\"lap\",\"type\":\"stopwatch\",\"words\":\"Lap\",\"reads\":[],\"spec\":{\"label\":\"Lap\"}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.alternatives.length === 2,"Both clock alternatives were not issued");
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"focus",alternative:"clock_focus",status:"selected",reason:""},{need:"lap",alternative:"clock_lap",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(built.instance.fragment.covers.length === 2,"Both clock needs are not covered");
  // Each declared clock publication is one issued source under its need identifier.
  insist(bindings.source(registry,"focus").getter === "f_parts_remaining_focus" && bindings.source(registry,"focus").ready === "f_parts_remaining_focus_ready","the countdown publication issued no remaining source");
  insist(bindings.source(registry,"lap").getter === "f_parts_duration_lap" && bindings.source(registry,"lap").ready === "f_parts_duration_lap_ready","the stopwatch publication issued no duration source");
  let result: composer.Result = await composer.assemble({screen:{title:"Timer",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations);
  insist(strings.contains(result.source.deal,"let value: number = ((state.f_parts_minutes as number) * 60000.0);"),"Editable countdown duration was not converted by checked arithmetic");
  return s.encode(result);
}
// A negative constant length never becomes a clock: the shared checked conversion refuses it and the
// alternative stays ineligible with a located reason rather than offering a fabricated duration.
export function clockRejects(): null {
  let plan: plans.Plan = plans.decode("{\"title\":\"Bad\",\"inputs\":[],\"constants\":[{\"id\":\"span\",\"label\":\"Span\",\"measure\":\"minutes\",\"value\":-1}],\"requirements\":[],\"needs\":[{\"id\":\"focus\",\"type\":\"countdown\",\"words\":\"Focus\",\"reads\":[\"span\"],\"spec\":{\"label\":\"Focus\",\"length\":\"span\"}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.alternatives.length === 1,"The countdown need was not offered as an alternative");
  insist(definitions.alternatives[0].eligible === false && strings.contains(definitions.alternatives[0].reason,"checked nonnegative millisecond duration"),"A negative constant length was offered as a clock");
  return null;
}
// The production bind path: a plan action need whose parameter is an issued plan input resolves its
// wire schema from the reserved source's declared DEAL type, issues one binding, and backs exactly one
// emitted operation carrying that argument's dependency set and its revision field.
export async function planOperation(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Call\",\"inputs\":[{\"id\":\"value\",\"label\":\"Value\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"note\",\"label\":\"Note\",\"kind\":\"text\",\"measure\":\"number\",\"value\":\"hello\"}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"submit\",\"type\":\"action\",\"words\":\"Submit\",\"reads\":[\"value\"],\"spec\":{\"on\":\"button\",\"operation\":\"write\",\"arguments\":{\"value\":\"value\"}}},{\"id\":\"annotate\",\"type\":\"action\",\"words\":\"Annotate\",\"reads\":[\"note\"],\"spec\":{\"on\":\"button\",\"operation\":\"writeText\",\"arguments\":{\"label\":\"note\"}}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  let registry: bindings.Registry = bindings.create([contract()]);
  let built: parts.Built = parts.buildWithProviders(plan,definitions,[],registry,null,clockConfig());
  let issued: Record<string, unknown> = construction.planBindings(plan,registry).bindings;
  insist(Object.hasOwn(issued,"submit") && Object.hasOwn(issued,"annotate"),"a plan action need issued no binding input");
  let rejected: string[] = await bindings.issueComposition(registry,issued,{},"Record the value","");
  insist(rejected.length === 0,"the production binding path rejected an issued plan input: "+s.encode(rejected));
  insist(registry.bindings.length === 2 && (registry.bindings[0].parameterOrder[0] as string) === "value","the plan binding did not cover the contract parameter");
  insist((registry.bindings[1].parameterOrder[0] as string) === "label","a text input did not bind its contract parameter");
  insist(registry.bindings[0].evidence.request === "Record the value","the issued binding carries no request evidence");
  let result: composer.Result = await composer.assembleWith({screen:{title:"Call",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations,registry,null);
  insist(result.metadata.operations.length === 2,"each issued binding did not back exactly one operation");
  insist(s.contains(result.metadata.operations[0].dependencies,"f_parts_value"),"the emitted operation lost its argument dependency set");
  insist(strings.contains(result.source.deal,"revision_submit: number;") && strings.contains(result.source.deal,"revision_annotate: number;"),"the emitted operation carries no revision field");
  // A state-backed argument is checked against the frozen parameter like any other source. A text
  // input can produce any host string, so a parameter declared with a 64-unit bound is incompatible
  // with it: that binding keeps its need open naming the parameter instead of issuing a call the
  // provider boundary must reject.
  let shortRegistry: bindings.Registry = bindings.create([contract()]);
  let shortBuilt: parts.Built = parts.buildWithProviders(plan,definitions,[],shortRegistry,null,clockConfig());
  let shortRejected: string[] = await bindings.issueComposition(shortRegistry,JSON.parse("{\"annotate\":{\"module\":\"demo/facts\",\"function\":\"writeShort\",\"arguments\":{\"label\":\"note\"}}}"),{},"Record the value","");
  insist(shortBuilt.instance.fragment.fields.length > 0,"the text-input plan emitted no parts instance");
  insist(shortRejected.length === 1 && strings.contains(shortRejected[0],"label") && strings.contains(shortRejected[0],"Incompatible wire schema") && shortRegistry.bindings.length === 0,"a state-backed text input bypassed the frozen parameter's wire bound: "+s.encode(shortRejected));
  return s.encode(result);
}
// A plan action argument that names a plan input, a plan constant, a disclosed fact, the frozen
// request or a part publication binds to one issued source and backs one emitted operation: every
// source kind the binding contract names is reserved by the production Bind stage before a parameter
// is resolved.
export async function contextOperation(): Promise<string> {
  let facts: string = "{\"facts\":[{\"id\":\"currency\",\"text\":\"EUR\"},{\"id\":\"due-date\",\"text\":\"Friday\"}]}";
  let original: string = "Record the value of 5 in EUR";
