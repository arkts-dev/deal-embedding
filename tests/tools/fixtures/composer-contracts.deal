  let instance: screens.Instance = owner("a",3);
  instance.definition = screens.issueDefinition(instance.fragment);
  instance.fragment.fields[0].initial = "4";
  refused = false;
  try { await composer.assembleWith(assembly([instance],[],[],"screen"),[assemblyComputations()[0]],bindings.create([]),null); } catch (error) { refused = true; }
  insist(refused,"a fragment replacing an issued default assembled");
