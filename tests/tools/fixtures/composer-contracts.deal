// A descriptor's seeded draft is a source its binding consumes. The registry records it and assembly
// emits it as authoritative state with its readiness, so an operation over a descriptor draft has an
// issued resource to depend on instead of an unissued identity.
export async function descriptorDraft(): Promise<string> {
  let instances: screens.Instance[] = [owner("a",3)];
  let slots: screens.Slot[] = [slot("a","filled","a")];
  let composition: screens.Composition = assembly(instances,slots,[],"screen");
  let registry: bindings.Registry = bindings.create([contract()]);
  let rawBindings: Record<string, unknown> = JSON.parse("{\"run\":{\"module\":\"demo/facts\",\"function\":\"writeText\",\"arguments\":{\"label\":\"memo\"}}}");
  let rawActions: Record<string, unknown> = JSON.parse("{\"run\":{\"id\":\"run\",\"label\":\"Run\",\"binding\":\"run\",\"input\":{\"sourceId\":\"memo\",\"label\":\"Memo\",\"initial\":\"seed\"}}}");
  let rejected: string[] = await bindings.issueComposition(registry,rawBindings,rawActions,"Record a memo","");
  insist(rejected.length === 0 && registry.actions.length === 1 && registry.bindings.length === 1,"a descriptor with its seeded draft issued no binding: "+s.encode(rejected));
  let result: composer.Result = await composer.assembleWith(composition,[assemblyComputations()[0]],registry,null);
  insist(strings.contains(result.source.deal,"draft_memo: string;") && strings.contains(result.source.deal,"ready_memo: boolean;"),"the descriptor draft and its readiness are not emitted state");
  insist(strings.contains(result.source.deal,"draft_memo: \"seed\""),"the descriptor draft is not seeded with its issued initial");
  insist(strings.contains(result.source.deal,"export function draftAction_memo(state: AppState, action: Draft_memo): AppState"),"the descriptor draft has no issued edit reducer");
  insist(strings.contains(result.source.deal,"export function update_Draft_memo(state: AppState, action: Draft_memo): AppState") && strings.contains(result.source.deal,"recompute(draftAction_memo(state, action))"),"the descriptor draft edit has no recompute/commit wrapper");
  // No placed panel names this descriptor, so its edit is an ordinary composition action and never a UI
  // update the compiled pair would advertise without a view that binds it.
  insist(!strings.contains(result.source.deal,"// @ui-update\nexport function update_Draft_memo"),"a descriptor no panel names advertised a UI update nothing binds");
  insist(result.metadata.operations.length === 1 && s.contains(result.metadata.operations[0].dependencies,"draft_memo") && s.contains(result.metadata.operations[0].dependencies,"ready_memo"),"the descriptor operation lost its draft dependency set");
  return s.encode(result);
}
// A catalogue reader wired to a part publication resolves the publisher's declared getter: the
// connection is recorded and the dependency the reader derives names the resource the composition
// emits, never the publisher's port name.
export async function readerConnection(): Promise<null> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Summary\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"done\",\"type\":\"entries\",\"words\":\"Log\",\"reads\":[],\"quote\":\"log\",\"spec\":{\"label\":\"Log\",\"fields\":[]}},{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[],\"spec\":{\"label\":\"Total\",\"format\":\"count\",\"unit\":\"\",\"formula\":\"1\",\"example\":{\"inputs\":{},\"result\":1}}},{\"id\":\"progress\",\"type\":\"content\",\"words\":\"Progress\",\"reads\":[\"done\",\"total\"],\"spec\":{}}],\"questions\":[]}",[],[],"log","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  let choices: constructionSelection.Choice[] = [{need:"done",alternative:"entries_done",status:"selected",reason:""},{need:"total",alternative:"part_total",status:"selected",reason:""}];
  let registry: bindings.Registry = bindings.create([]);
  // The publisher is the real parts instance of this plan: its publications are the sources a reader
  // resolves and it emits the fields those publications name.
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(bindings.source(registry,"done").getter === "f_parts_count_done","the entries publication issued no count source");
  insist(bindings.source(registry,"total").getter === "f_parts_total","the figure publication issued no source");
  let listDefinition: catalogue.Definition | null = null;
  for (let definition of catalogue.definitions()) { if (definition.kind === "list_summary") { listDefinition = definition; } }
  insist(listDefinition !== null,"the issued definition set declares no list_summary kind");
  let parameters: Record<string, unknown> = await catalogue.decode(listDefinition as catalogue.Definition,{});
  let entry: catalogue.Configured = {need:"progress",definition:listDefinition as catalogue.Definition,parameters:parameters,accepted:true,reason:""};
  let reader: screens.Instance = await catalogue.instantiate(entry,registry);
  let composition: screens.Composition = {screen:{title:"Summary",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]};
  let wired: string = construction.connect(composition,reader,registry,plan); insist(wired === "","a reader wired to part publications was not connected: "+wired);
  insist(composition.connections.length === 2,"the resolved connections were not recorded");
  let computed: composer.Computation[] = catalogue.computations(reader,composition.connections,composition.screen.instances);
  insist(computed.length === 1,"the reader derived no computation");
  let dependencies: string[] = computed[0].dependencies;
  insist(dependencies.length === 2 && s.contains(dependencies,"f_parts_count_done") && s.contains(dependencies,"f_parts_total"),"the reader dependency does not name the publishers' declared getters: "+s.encode(dependencies));
  // The composed experience is accepted: each derived dependency names an emitted field, which is what
