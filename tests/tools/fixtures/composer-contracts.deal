  // `host/storage` is effect-bound at every position that reaches generated source. A field initializer
  // is emitted into initialState(), so a storage call there runs at mount outside every effect and rejects.
  let storageInit: screens.Instance[] = [fragment("a","3")];
  storageInit[0].fragment.declarations = "import * as store from \"host/storage\";"+storageInit[0].fragment.declarations;
  storageInit[0].fragment.fields[3].initial = "store.load(\"k\")";
  refused = false;
  let storageMessage: string = "";
  try { await composer.assembleWith(assembly(storageInit,[],[],"screen"),[{instance:"a",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_a_value"]}],bindings.create([]),null); } catch (errorUnknown) { let error: Error = errorUnknown as Error; refused = true; storageMessage = error.message; }
  insist(refused && strings.contains(storageMessage,"effect-bound storage") && strings.contains(storageMessage,"a.sequence"),"host/storage in a field initializer was admitted: "+storageMessage);
  // The same call inside the declared effect of the owner is the admitted position.
  let effectStorage: screens.Instance = effectOwner(false);
  effectStorage.fragment.declarations = "import * as store from \"host/storage\";"+effectStorage.fragment.declarations;
  effectStorage.fragment.helpers = effectStorage.fragment.helpers+" export async function performStored(state: AppState, action: Start): Promise<Done> { let saved: string = store.load(\"k\"); return {value: state.value+1}; }";
  effectStorage.fragment.effects = [{action:"Start",function:"performStored"}];
  effectStorage.definition = screens.issueDefinition(effectStorage.fragment);
  let effectAccepted: composer.Result = await composer.assembleWith({screen:{title:"Effect",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[effectStorage]},bindings:{},actions:{},connections:[]},[],bindings.create([]),null);
  insist(strings.contains(effectAccepted.source.deal,"export async function effect_f_worker_Start"),"a storage call inside an effect was rejected");
  // A view is never an effect position: the emitted view module would reach the private store outside
  // every effect, so a fragment view that imports it rejects.
  let viewStorage: screens.Instance = fragment("a","3");
  viewStorage.fragment.view = "import * as store from \"host/storage\";"+viewStorage.fragment.view;
  refused = false;
  let viewStorageMessage: string = "";
  try { await composer.assembleWith(assembly([viewStorage],[],[],"screen"),[{instance:"a",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_a_value"]}],bindings.create([]),null); } catch (errorUnknown) { let error: Error = errorUnknown as Error; refused = true; viewStorageMessage = error.message; }
  insist(refused && strings.contains(viewStorageMessage,"effect-bound storage"),"host/storage imported by a view was admitted: "+viewStorageMessage);
  // Declared `owns` grants no permission and gates nothing: two instances declaring the same `owns`
  // spelling with disjoint written resources assemble, and the unused declaration is only a notice.
  let sharedOwns: screens.Instance[] = [owner("a",3),owner("b",4)];
  sharedOwns[1].fragment.owns = ["value"];
  let sharedSlots: screens.Slot[] = [slot("a","filled","a"),slot("b","filled","b")];
  let shared: composer.Result = await composer.assembleWith(assembly(sharedOwns,sharedSlots,[],"screen"),assemblyComputations(),bindings.create([]),null);
  insist(shared.metadata.slots.length === 2,"two instances declaring one owns entry were rejected");
  // A view may bind only an action its owner exports.
  let ghostView: screens.Instance[] = [owner("a",3)];
  ghostView[0].fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Button(text: \"Go\", value: 1, onClick: action app.Ghost {value: payload}) } }";
  refused = false;
  try { await composer.assembleWith(assembly(ghostView,[],[],"screen"),[assemblyComputations()[0]],bindings.create([]),null); } catch (error) { refused = true; }
  insist(refused,"A view binding an unexported action was admitted");
  refused = false;
  try { await composer.assembleWith(assembly([owner("a",3),owner("b",4)],[],[],"chat"),assemblyComputations(),bindings.create([]),null); } catch (error) { refused = true; }
  insist(refused,"Multi-fragment chat target without an issued chat root admitted");
  // A composition that places no fragment emits no program: an empty AppState has no root view.
  refused = false;
  try { await composer.assembleWith(assembly([],[],[],"screen"),[],bindings.create([]),null); } catch (error) { refused = true; }
  insist(refused,"A composition with no runnable fragment was admitted");
  // A computation may name the raw text buffer it parses only as an authoritative resource of its own
  // instance: a derived resource keeps its readiness guard, and a foreign or unissued one keeps its port
  // and issuedness rules instead of becoming an unchecked read.
  let derivedBuffer: composer.Computation = {instance:"a",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_a_value"],buffers:["f_a_double"]};
  refused = false; let bufferReason: string = "";
  try { await composer.assembleWith(assembly([owner("a",3)],[],[],"screen"),[derivedBuffer],bindings.create([]),null); } catch (error) { refused = true; bufferReason = (error as Error).message; }
  insist(refused && strings.contains(bufferReason,"Buffer is not an authoritative resource of its own instance: double f_a_double"),"a derived resource was admitted as an unchecked buffer read: "+bufferReason);
  let unissuedBuffer: composer.Computation = {instance:"a",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_a_value"],buffers:["f_a_absent"]};
  refused = false; bufferReason = "";
  try { await composer.assembleWith(assembly([owner("a",3)],[],[],"screen"),[unissuedBuffer],bindings.create([]),null); } catch (error) { refused = true; bufferReason = (error as Error).message; }
  insist(refused && strings.contains(bufferReason,"Buffer names an unissued resource: double f_a_absent"),"an unissued resource was admitted as a buffer read: "+bufferReason);
  let foreignBuffer: composer.Computation = {instance:"a",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_a_value"],buffers:["f_b_value"]};
  refused = false; bufferReason = "";
  try { await composer.assembleWith(assembly([owner("a",3),owner("b",4)],[],[],"screen"),[foreignBuffer,assemblyComputations()[1]],bindings.create([]),null); } catch (error) { refused = true; bufferReason = (error as Error).message; }
  insist(refused && strings.contains(bufferReason,"Buffer is not an authoritative resource of its own instance: double f_b_value"),"another owner's resource was admitted as an unchecked buffer read: "+bufferReason);
  return null;
}
// A countdown whose length names an issued live need of seconds is built from that need's checked
// publication: plan decode and the clock part agree on the same accepted duration source.
export async function clockNeedSource(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Remaining\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"remaining\",\"type\":\"live\",\"words\":\"Read remaining\",\"reads\":[],\"spec\":{\"label\":\"Remaining\",\"measure\":\"seconds\",\"unit\":\"s\",\"query\":\"host/probe.read\"}},{\"id\":\"focus\",\"type\":\"countdown\",\"words\":\"Focus\",\"reads\":[\"remaining\"],\"spec\":{\"label\":\"Focus\",\"length\":\"remaining\"}}],\"questions\":[]}",[],[],"","");
  insist(Object.hasOwn(plan.needs[1],"duration") && (plan.needs[1].duration as plans.DurationSource).measure === "seconds","Plan decode did not resolve the issued live need as a duration source");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"remaining",alternative:"real_remaining",status:"selected",reason:""},{need:"focus",alternative:"clock_focus",status:"selected",reason:""}];
  // The scalar read part of this composition publishes the live need as a derived number.
  let readBuilt: scalar.Built = {fields:[{name:"remaining",type:"number",role:"derived",dependencies:[],initial:"null",owner:"parts"}],updates:[],effects:[],declarations:"",helpers:"",view:"",computations:[{instance:"parts",field:"remaining",value:"1.0",ready:"true",reason:"\"Unavailable\"",dependencies:[]}],covers:["remaining"],invalidations:[]};
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,readBuilt,clockConfig());
  insist(s.contains(built.instance.fragment.covers,"focus"),"The countdown sized by an issued live need was not built");
  // The live publication is the source of the need's own identifier, over the scalar read field.
  insist(bindings.source(registry,"remaining").type === "number" && bindings.source(registry,"remaining").getter === "f_parts_remaining","the live publication issued no numeric source");
  // The filled live-need slot issues its publication pair over the scalar read field.
  // The slot carries the kind its accepted alternative declares and its filling instance implements.
  let slots: screens.Slot[] = [{id:"remaining",need:"remaining",reads:[],writes:[],provider:false,allowedKinds:["scalar_read"],valueType:"number",status:"filled",instance:"parts",reason:""}];
  let result: composer.Result = await composer.assemble({screen:{title:"Remaining",target:"screen",layout:{kind:"stack",positions:[]},slots:slots,instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations);
  insist(strings.contains(result.source.deal,"(state.f_parts_remaining as number) * 1000.0"),"The live need length was not converted by checked arithmetic");
  insist(strings.contains(result.source.deal,"export function publish_f_parts_remaining(state: AppState): number"),"The filled live-need slot issued no publication");
  insist(strings.contains(result.source.deal,"export function ready_f_parts_remaining(state: AppState): boolean"),"The filled live-need slot issued no readiness");
  insist(result.metadata.slots[0].allowedKinds.length === 1 && result.metadata.slots[0].allowedKinds[0] === "scalar_read","the live-need slot did not carry the kind its filling instance implements");
  return s.encode(result);
}
// A countdown length naming a figure whose own operand was not issued must leave the countdown need
// open: emitting the clock over a publication this build skips would abort assembly on a dependency
// nothing emits instead of keeping the need open with a reason.
export async function clockDurationUnbuilt(): Promise<null> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Remaining\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"base\",\"type\":\"figure\",\"words\":\"Base\",\"reads\":[],\"spec\":{\"label\":\"Base\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"1\",\"example\":{\"inputs\":{},\"result\":1}}},{\"id\":\"remaining\",\"type\":\"figure\",\"words\":\"Remaining\",\"reads\":[\"base\"],\"spec\":{\"label\":\"Remaining\",\"format\":\"seconds\",\"unit\":\"\",\"formula\":\"base\",\"example\":{\"inputs\":{\"base\":1},\"result\":1}}},{\"id\":\"focus\",\"type\":\"countdown\",\"words\":\"Focus\",\"reads\":[\"remaining\"],\"spec\":{\"label\":\"Focus\",\"length\":\"remaining\"}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.figures.length === 2,"the duration figures were not issued");
  let registry: bindings.Registry = bindings.create([]);
  // The second figure is selected but its own operand is not: the build skips it, so it cannot size
  // the countdown even though the alternative was offered.
  let choices: constructionSelection.Choice[] = [{need:"remaining",alternative:"part_remaining",status:"selected",reason:""},{need:"focus",alternative:"clock_focus",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(!s.contains(built.instance.fragment.covers,"remaining"),"a figure with an unissued operand was reported covered");
  // The dropped implementation is a located gap with its need identifier, not an unexplained open need.
  let dropped: string = "";
  for (let reason of built.unavailable) { dropped = dropped+reason+"|"; }
  insist(dropped.includes("remaining:") && dropped.includes("not emitted by this candidate"),"a dropped selected figure recorded no located reason: "+dropped);
  // A countdown whose length source this candidate does not emit is the other implementation the
  // builder drops, and it is located the same way.
  insist(dropped.includes("focus:") && dropped.includes("length source is not emitted"),"a dropped countdown recorded no located reason: "+dropped);
  insist(!s.contains(built.instance.fragment.covers,"focus"),"a countdown over an unbuilt figure publication was built");
  for (let field of built.instance.fragment.fields) { insist(field.name !== "duration_focus" && field.name !== "elapsed_focus" && field.name !== "remaining_focus","the clock part emitted a duration over an unbuilt publication: "+field.name); }
  // The positive half of the same branch: when both figures are selected and emitted, the seconds
  // figure is an available duration source and the countdown is built over its checked publication.
  let positiveRegistry: bindings.Registry = bindings.create([]);
  let positiveChoices: constructionSelection.Choice[] = [{need:"base",alternative:"part_base",status:"selected",reason:""},{need:"remaining",alternative:"part_remaining",status:"selected",reason:""},{need:"focus",alternative:"clock_focus",status:"selected",reason:""}];
  let positive: parts.Built = parts.buildWithProviders(plan,definitions,positiveChoices,positiveRegistry,null,clockConfig());
  insist(s.contains(positive.instance.fragment.covers,"focus"),"a countdown over an emitted figure publication was not built");
  let durationEmitted: boolean = false;
  for (let field of positive.instance.fragment.fields) { if (field.name === "duration_focus") { durationEmitted = true; } }
  insist(durationEmitted,"a countdown over an emitted figure publication emitted no checked duration");
  return null;
}
// A formula that lowers to the checked pow helper is assembled, emitted and compiled, so the helper
// call site and its declaration are proved on the real emission path.
export async function writtenFormulaPart(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Total\",\"inputs\":[{\"id\":\"op0\",\"label\":\"Op 0\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":4},{\"id\":\"op1\",\"label\":\"Op 1\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op2\",\"label\":\"Op 2\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op3\",\"label\":\"Op 3\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op4\",\"label\":\"Op 4\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op5\",\"label\":\"Op 5\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[{\"id\":\"scale\",\"label\":\"Scale\",\"measure\":\"number\",\"value\":1}],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"op0\",\"op1\",\"op2\",\"op3\",\"op4\",\"op5\",\"scale\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"pow(op0, 0.5)+op1+op2+op3+op4+op5+scale\",\"example\":{\"inputs\":{\"op0\":4,\"op1\":1,\"op2\":1,\"op3\":1,\"op4\":1,\"op5\":1,\"scale\":1},\"result\":8}}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.figures.length === 1,"the pow figure was not issued");
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"total",alternative:"part_total",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(built.instance.fragment.covers.length === 1,"the pow figure covers no need");
  let result: composer.Result = await composer.assemble({screen:{title:"Total",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations);
  // The lowered call is the host operator itself: no hand-written series stands in for it.
  insist(strings.contains(result.source.deal,"Math.pow("),"the lowered formula emitted no host pow call");
  insist(!strings.contains(result.source.deal,"formulaPow"),"the emitted pair still carries a hand-written pow helper");
  return s.encode(result);
}
// Written-formula lowering: the 300 UTF-16 unit bound is separate from the 255 alternative bound.
export function writtenFormulaCases(): null {
  let operands: formula.Operand[] = [{id:"a",expression:"state.value",type:"number",dependency:"f_parts_value",value:2}];
  let lowered: formula.Lowered = formula.lower("pow(a, 3) + round(-0.5) + abs(-0)",operands);
  insist((lowered.number as number) === 8 && strings.contains(lowered.source,"Math.pow("),"pow lower/evaluation lost: "+(lowered.source as string));
  // Round ties keep negative zero for [-0.5, 0) and abs(-0) is +0; equality alone cannot see the sign.
  let negativeZero: formula.Lowered = formula.lower("round(-0.5)",operands);
  insist(1 / (negativeZero.number as number) < 0,"round lost negative zero");
  let positiveZero: formula.Lowered = formula.lower("abs(-0)",operands);
  insist(1 / (positiveZero.number as number) > 0,"abs(-0) lost positive zero");
  let bounded: boolean = false;
  let long: string = "a"; let step: number = 0; while (step < 299) { long = long+"+1"; step = step+1; } long = long+"+1";
  try { formula.lower(long,operands); } catch (error) { bounded = true; }
  insist(bounded,"A written formula over 300 UTF-16 units was admitted");
  bounded = false;
  try { formula.lower("missing + 1",operands); } catch (error) { bounded = true; }
  insist(bounded,"A written formula over an unissued operand was admitted");
  // An over-cap alternative set is not an error: without a written formula the figure is not
  // built and the need stays open; an accepted written formula is lowered and example-checked.
  let plan: plans.Plan = plans.decode("{\"title\":\"Total\",\"inputs\":[{\"id\":\"op0\",\"label\":\"Op 0\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op1\",\"label\":\"Op 1\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op2\",\"label\":\"Op 2\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op3\",\"label\":\"Op 3\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op4\",\"label\":\"Op 4\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op5\",\"label\":\"Op 5\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[{\"id\":\"scale\",\"label\":\"Scale\",\"measure\":\"number\",\"value\":1}],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"op0\",\"op1\",\"op2\",\"op3\",\"op4\",\"op5\",\"scale\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"op0+op1+op2+op3+op4+op5+scale\",\"example\":{\"inputs\":{\"op0\":1,\"op1\":1,\"op2\":1,\"op3\":1,\"op4\":1,\"op5\":1,\"scale\":1},\"result\":7}}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  let overCapFigure: boolean = definitions.figures.length === 1 && formula.enumerate(definitions.figures[0].operands,[]).overCap;
  insist(overCapFigure,"the over-cap figure was not issued");
  let open: parts.Definitions = parts.applyWritten(plan,definitions,[]);
  insist(open.figures.length === 0,"an over-cap set without a written formula must leave the need open, not reject");
  let answer: selections.Answer = {id:"written_formula_total",selected:"written",probability:1,accepted:true,probabilities:[],text:"pow(scale, 3)+op0+op1+op2+op3+op4+op5"};
  let loweredDefinitions: parts.Definitions = parts.applyWritten(plan,definitions,[answer]);
  insist(loweredDefinitions.figures.length === 1,"the accepted written formula was not built");
  insist(strings.contains(loweredDefinitions.figures[0].expression.source,"Math.pow("),"the accepted written formula was not lowered: "+loweredDefinitions.figures[0].expression.source);
  insist(loweredDefinitions.figures[0].expression.source !== definitions.figures[0].expression.source,"the written formula did not replace the original expression");
  // The example judges the written formula over every issued operand of the figure, so an operand the
  // example does not supply is the example's own gap and never an unissued operand. The plan formula
  // reads only op0, so its example covers op0 alone while the issued operand set stays over the
  // 255 alternative bound and the written question was requested.
  let outsidePlan: plans.Plan = plans.decode("{\"title\":\"Total\",\"inputs\":[{\"id\":\"op0\",\"label\":\"Op 0\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op1\",\"label\":\"Op 1\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op2\",\"label\":\"Op 2\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op3\",\"label\":\"Op 3\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op4\",\"label\":\"Op 4\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op5\",\"label\":\"Op 5\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[{\"id\":\"scale\",\"label\":\"Scale\",\"measure\":\"number\",\"value\":1}],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"op0\",\"op1\",\"op2\",\"op3\",\"op4\",\"op5\",\"scale\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"op0\",\"example\":{\"inputs\":{\"op0\":1},\"result\":1}}}],\"questions\":[]}",[],[],"","");
  let outsideDefinitions: parts.Definitions = parts.defineWithProviders(outsidePlan,[]);
  insist(outsideDefinitions.figures.length === 1 && formula.enumerate(outsideDefinitions.figures[0].operands,[]).overCap,"the example-gap figure was not over the enumeration bound");
  // Over the bound the written formula question is requested and nothing is truncated or rejected.
  let outsideQuestions: selections.Question[] = parts.formulaQuestions(outsidePlan,outsideDefinitions,{choices:[],answers:[],settled:[],usable:true});
  let requested: boolean = false; for (let question of outsideQuestions) { if (question.id === "written_formula_total") { requested = true; } }
  insist(requested,"the over-cap figure over an example gap requested no written formula");
  let unvalued: selections.Answer = {id:"written_formula_total",selected:"written",probability:1,accepted:true,probabilities:[],text:"op5"};
  let kept: parts.Definitions = parts.applyWritten(outsidePlan,outsideDefinitions,[unvalued]);
  insist(kept.figures.length === 0,"a written formula reading an operand the example does not supply was built");
  insist(kept.unavailable.length === 1 && kept.unavailable[0].need === "total" && strings.contains(kept.unavailable[0].reason,"written formula reads an operand the issued example does not supply"),"an example gap in the written formula kept no located reason: "+s.encode(kept.unavailable));
  // A legal written formula over an issued operand outside the example whose value the example can
  // still decide through the lazy branch is built instead of being refused as an unissued operand.
  let lazy: selections.Answer = {id:"written_formula_total",selected:"written",probability:1,accepted:true,probabilities:[],text:"choose(op0 > 0, op0, op5)"};
  let decided: parts.Definitions = parts.applyWritten(outsidePlan,outsideDefinitions,[lazy]);
  insist(decided.figures.length === 1,"a legal written formula over an issued operand outside the example was refused: "+s.encode(decided.unavailable));
  insist(strings.contains(decided.figures[0].expression.source,"state.op5"),"the written formula over an outside-example operand was not lowered: "+decided.figures[0].expression.source);
  // A written formula that does not reproduce the issued example rejects; a fractional exponent
  // lowers through the checked series helper instead of being rejected.
  let wrong: selections.Answer = {id:"written_formula_total",selected:"written",probability:1,accepted:true,probabilities:[],text:"pow(scale, 3)"};
  bounded = false;
  try { parts.applyWritten(plan,definitions,[wrong]); } catch (error) { bounded = true; }
  insist(bounded,"A written formula failing the issued example was admitted");
  let fractional: formula.Expression = formula.compile("pow(scale, 1.5)",definitions.figures[0].operands);
  insist(strings.contains(fractional.source,"Math.pow("),"A fractional exponent was not lowered to the host operator: "+fractional.source);
  insist(strings.contains(fractional.source,"1.5"),"A fractional exponent was dropped from the lowered helper: "+fractional.source);
  let root: formula.Lowered = formula.lower("pow(9, 0.5)",definitions.figures[0].operands);
  insist((root.number as number) === 3,"pow(9, 0.5) is not exactly 3: "+String(root.number as number));
  let cube: formula.Lowered = formula.lower("pow(2, 0.5)",definitions.figures[0].operands);
  insist(Math.abs((cube.number as number) - 1.4142135623730951) < 0.0000001,"pow(2, 0.5) is not sqrt 2: "+String(cube.number as number));
  // Exact comparisons and an infinite operand follow the host operator, so a spec-valid yes_no figure
  // over a perfect square is accepted instead of being refused by series rounding.
  let perfect: formula.Lowered = formula.lower("pow(a + 7, 0.5) === 3",operands);
  insist(perfect.boolean as boolean,"pow(x, 0.5) === 3 must hold for a perfect square");
  let sqrtAgrees: formula.Lowered = formula.lower("pow(a + 7, 0.5) === sqrt(a + 7)",operands);
  insist(sqrtAgrees.boolean as boolean,"pow(x, 0.5) must agree with sqrt(x)");
  let infinite: formula.Lowered = formula.lower("pow(a, 1/0)",operands);
  insist((infinite.number as number) === (1/0),"an infinite exponent must stay Infinity: "+String(infinite.number as number));
  // The Bind stage resolves a plan action need against the frozen contracts.
  let actionPlan: plans.Plan = plans.decode("{\"title\":\"Call\",\"inputs\":[{\"id\":\"value\",\"label\":\"Value\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"submit\",\"type\":\"action\",\"words\":\"Submit\",\"reads\":[\"value\"],\"spec\":{\"on\":\"button\",\"operation\":\"write\",\"arguments\":{\"value\":\"value\"}}}],\"questions\":[]}",[],[],"","");
  let bindRegistry2: bindings.Registry = bindings.create([contract()]);
  let issuedBindings: Record<string, unknown> = construction.planBindings(actionPlan,bindRegistry2).bindings;
