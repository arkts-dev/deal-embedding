}
// Checking admission consumes the issued composition metadata: a matching candidate is admitted and a
// carried fact that contradicts the compiled declarations rejects.
function admissionManifest(): Record<string, unknown> {
  return JSON.parse("{\"imports\":[\"std/string\"],\"providers\":[],\"packDigests\":[\"d\"],\"issuedPackDigest\":\"d\",\"packVersions\":[\"2\"],\"issuedPackVersion\":\"2\",\"declarations\":[\"f_a_value\",\"f_parts_sample_focus\",\"expires_submit\",\"expired_submit\"],\"composition\":{\"slots\":[{\"id\":\"a\",\"need\":\"a\",\"status\":\"filled\",\"instance\":\"a\",\"writes\":[\"f_a_value\"],\"outputs\":[\"f_a_published\"],\"allowedKinds\":[\"note\"],\"reads\":[],\"event\":\"\",\"trigger\":\"\",\"action\":\"\"}],\"operations\":[{\"id\":\"submit\",\"arguments\":{\"value\":\"value\"},\"dependencies\":[\"f_a_value\"],\"expires\":\"expires_submit\",\"expired\":\"expired_submit\"}],\"runtime\":[\"f_parts_sample_focus\"],\"publications\":[\"f_a_published\"],\"drivers\":[],\"composites\":[],\"chatRoot\":false,\"clockDrivers\":[],\"sessionClock\":{\"epoch\":\"\",\"trust\":\"\",\"resume\":\"\"},\"notices\":[],\"declarations\":[\"f_a_value\",\"f_parts_sample_focus\",\"expires_submit\",\"expired_submit\"],\"owners\":[{\"name\":\"f_a_value\",\"owner\":\"a\",\"role\":\"authoritative\"},{\"name\":\"f_parts_sample_focus\",\"owner\":\"parts\",\"role\":\"runtime\"},{\"name\":\"expires_submit\",\"owner\":\"composer\",\"role\":\"authoritative\"},{\"name\":\"expired_submit\",\"owner\":\"composer\",\"role\":\"authoritative\"}],\"composerOwned\":[\"expires_submit\",\"expired_submit\"],\"instances\":[{\"id\":\"a\",\"kind\":\"note\",\"origin\":\"catalogue\",\"kinds\":[\"note\"],\"writes\":[\"f_a_value\"]},{\"id\":\"parts\",\"kind\":\"inputs_figures\",\"origin\":\"part\",\"kinds\":[\"clock\"],\"writes\":[]}],\"sources\":[\"value\"]}}");
}
export function admissionOf(manifest: string, required: boolean): string { return checking.admit(JSON.parse(manifest),required); }
export function admissionCases(): null {
  let valid: string = checking.admit(admissionManifest(),true);
  insist(valid === "","a matching issued composition was rejected at admission: "+valid);
  let tampered: Record<string, unknown> = admissionManifest();
  let composition: Record<string, unknown> = tampered.composition as Record<string, unknown>;
  let emptyDependencies: string[] = [];
  let argumentsValue: Record<string, unknown> = {value:"value"};
  let operation: Record<string, unknown> = {id:"submit",arguments:argumentsValue,dependencies:emptyDependencies};
  let operations: Record<string, unknown>[] = [operation];
  composition.operations = operations;
  insist(strings.contains(checking.admit(tampered,true),"ADMISSION_OWNERSHIP"),"an operation without a dependency set was admitted");
  // The expiry prerequisite is derived from the operation identity: dropping it, relabelling the
  // instant or the flag, and a flag outside the compiled declarations each reject.
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let droppedExpiry: Record<string, unknown> = {id:"submit",arguments:argumentsValue,dependencies:["f_a_value"]};
  composition.operations = [droppedExpiry];
  insist(strings.contains(checking.admit(tampered,true),"operation without its expiry prerequisites"),"an operation without its expiry prerequisites was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let renamedInstant: Record<string, unknown> = {id:"submit",arguments:argumentsValue,dependencies:["f_a_value"],expires:"expires_other",expired:"expired_submit"};
  composition.operations = [renamedInstant];
  insist(strings.contains(checking.admit(tampered,true),"expiry instant differs from its identity"),"a relabelled expiry instant was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let renamedFlag: Record<string, unknown> = {id:"submit",arguments:argumentsValue,dependencies:["f_a_value"],expires:"expires_submit",expired:"expired_other"};
  composition.operations = [renamedFlag];
  insist(strings.contains(checking.admit(tampered,true),"expiry prerequisite differs from its identity"),"a relabelled unexpired flag was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let withoutFlag: string[] = ["f_a_value","f_parts_sample_focus","expires_submit"];
  composition.declarations = withoutFlag; tampered.declarations = withoutFlag;
  let ownersWithoutFlag: Record<string, unknown>[] = [{name:"f_a_value",owner:"a",role:"authoritative"},{name:"f_parts_sample_focus",owner:"parts",role:"runtime"},{name:"expires_submit",owner:"composer",role:"authoritative"}];
  composition.owners = ownersWithoutFlag;
  let ownedWithoutFlag: string[] = ["expires_submit"];
  composition.composerOwned = ownedWithoutFlag;
  insist(strings.contains(checking.admit(tampered,true),"expiry prerequisite outside the compiled declarations"),"an unexpired flag outside the compiled declarations was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let missingWrites: string[] = ["f_missing"];
  let noReads: string[] = [];
  let undeclaredSlot: Record<string, unknown> = {id:"a",need:"a",status:"filled",instance:"a",writes:missingWrites,outputs:["f_a_published"],allowedKinds:["note"],reads:noReads,event:"",trigger:"",action:""};
  let undeclaredSlots: Record<string, unknown>[] = [undeclaredSlot];
  composition.slots = undeclaredSlots;
  insist(strings.contains(checking.admit(tampered,true),"slot writes an undeclared resource"),"a slot writing an undeclared resource was admitted");
  // A carried slot without its need is rejected with the slot identity, not as a malformed document.
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let absentNeed: Record<string, unknown> = {id:"a",status:"filled",instance:"a",writes:["f_a_value"],outputs:["f_a_published"],allowedKinds:["note"],reads:noReads,event:"",trigger:"",action:""};
  let absentSlots: Record<string, unknown>[] = [absentNeed];
  composition.slots = absentSlots;
  insist(strings.contains(checking.admit(tampered,true),"issued slot without its need"),"a slot without its need was not located by its identity");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let relabelledNeed: Record<string, unknown> = {id:"a",need:"other",status:"filled",instance:"a",writes:["f_a_value"],outputs:["f_a_published"],allowedKinds:["note"],reads:noReads,event:"",trigger:"",action:""};
  let relabelledSlots: Record<string, unknown>[] = [relabelledNeed];
  composition.slots = relabelledSlots;
  insist(strings.contains(checking.admit(tampered,true),"slot identity differs from its need"),"a slot whose need differs from its identity was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let issuedNeed: Record<string, unknown> = {id:"a",need:"a",status:"filled",instance:"a",writes:["f_a_value"],outputs:["f_a_published"],allowedKinds:["note"],reads:noReads,event:"",trigger:"",action:""};
  let repeatNeed: Record<string, unknown> = {id:"a",need:"a",status:"filled",instance:"a",writes:["f_a_value"],outputs:noReads,allowedKinds:["note"],reads:noReads,event:"",trigger:"",action:""};
  let duplicatedSlots: Record<string, unknown>[] = [issuedNeed,repeatNeed];
  composition.slots = duplicatedSlots;
  insist(strings.contains(checking.admit(tampered,true),"duplicate slot need"),"a duplicated slot need was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let publications: string[] = ["f_a_published","f_a_published"];
  composition.publications = publications;
  insist(strings.contains(checking.admit(tampered,true),"ADMISSION_OWNERSHIP"),"a duplicate publication was admitted");
  // A publication identity is the output its slot issues: a fabricated name and a dropped issued output
  // each disagree with the carried slot outputs.
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let fabricatedPublications: string[] = ["f_a_fabricated"];
  composition.publications = fabricatedPublications;
  insist(strings.contains(checking.admit(tampered,true),"publication names no issued output"),"a publication naming no issued output was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let noPublications: string[] = [];
  composition.publications = noPublications;
  insist(strings.contains(checking.admit(tampered,true),"issued output without its publication"),"a dropped issued output was admitted");
  // The runtime-only set and the carried role are two facts: a runtime resource relabelled to another
  // role disagrees with the set it belongs to.
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let relabelledRoles: Record<string, unknown>[] = [{name:"f_a_value",owner:"a",role:"authoritative"},{name:"f_parts_sample_focus",owner:"parts",role:"authoritative"}];
  composition.owners = relabelledRoles;
  insist(strings.contains(checking.admit(tampered,true),"runtime resource carries another role"),"a runtime resource relabelled authoritative was admitted");
  tampered = admissionManifest(); composition = tampered.composition as Record<string, unknown>;
  let promotedRoles: Record<string, unknown>[] = [{name:"f_a_value",owner:"a",role:"runtime"},{name:"f_parts_sample_focus",owner:"parts",role:"runtime"}];
  composition.owners = promotedRoles;
  insist(strings.contains(checking.admit(tampered,true),"runtime resource outside the carried runtime set"),"a resource promoted to runtime outside the runtime set was admitted");
  tampered = admissionManifest(); delete tampered.composition;
  insist(strings.contains(checking.admit(tampered,true),"ADMISSION_OWNERSHIP"),"a candidate without issued composition metadata was admitted");
  insist(checking.admit(tampered,false) === "","a supplied source without construction metadata was rejected by the ownership check");
  // Every section the composer always writes is a carried fact: dropping the composite model, the
  // chat-root decision or the clock drivers rejects, and so does a malformed composite identity.
  for (let section of ["composites","chatRoot","clockDrivers","sessionClock","notices"]) {
    let dropped: Record<string, unknown> = admissionManifest(); delete (dropped.composition as Record<string, unknown>)[section];
    insist(strings.contains(checking.admit(dropped,true),"ADMISSION_OWNERSHIP"),"a composition without its "+section+" was admitted");
  }
  let composites: Record<string, unknown> = admissionManifest();
  let issuedComposite: Record<string, unknown> = {action:"Apply",type:"Composite_Apply",update:"update_Apply",arms:["a:Change","b:Switch"]};
  (composites.composition as Record<string, unknown>).composites = [issuedComposite];
  insist(checking.admit(composites,true) === "","a matching issued composite was rejected at admission: "+checking.admit(composites,true));
  let relabelled: Record<string, unknown> = admissionManifest();
  let renamedComposite: Record<string, unknown> = {action:"Apply",type:"Composite_Other",update:"update_Apply",arms:["a:Change","b:Switch"]};
  (relabelled.composition as Record<string, unknown>).composites = [renamedComposite];
  insist(strings.contains(checking.admit(relabelled,true),"ADMISSION_OWNERSHIP"),"a composite type differing from its action identity was admitted");
  let forgedArm: Record<string, unknown> = admissionManifest();
  let forgedComposite: Record<string, unknown> = {action:"Apply",type:"Composite_Apply",update:"update_Apply",arms:["a","b:Switch"]};
  (forgedArm.composition as Record<string, unknown>).composites = [forgedComposite];
  insist(strings.contains(checking.admit(forgedArm,true),"ADMISSION_OWNERSHIP"),"a malformed composite arm was admitted");
  let duplicateArm: Record<string, unknown> = admissionManifest();
  let duplicateComposite: Record<string, unknown> = {action:"Apply",type:"Composite_Apply",update:"update_Apply",arms:["a:Change","a:Change"]};
  (duplicateArm.composition as Record<string, unknown>).composites = [duplicateComposite];
  insist(strings.contains(checking.admit(duplicateArm,true),"ADMISSION_OWNERSHIP"),"a duplicated composite arm was admitted");

  return null;
}
// A row_tap operation observes the captured row, never the collection that contains it: assembly
// issues the captured stable key and a comparison over that row's own values, so an unrelated row
// edit leaves the operation current while an edit or removal of the tapped row invalidates it.
export async function rowTapPart(): Promise<string> {
  let timestampFacts: string = "{\"facts\":[{\"id\":\"at\",\"text\":\"coffee 4 at 1700000000000\",\"type\":\"unixMillis\",\"value\":1700000000000}]}";
  let plan: plans.Plan = plans.decode("{\"title\":\"Tap\",\"inputs\":[{\"id\":\"value\",\"label\":\"Value\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"spend\",\"type\":\"entries\",\"words\":\"Log spending\",\"reads\":[],\"quote\":\"coffee 4\",\"spec\":{\"label\":\"Spending\",\"fields\":[{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\",\"decimals\":2,\"unit\":\"€\"}],\"seeds\":[{\"values\":{\"amount\":4},\"timestamp\":1700000000000}]}},{\"id\":\"tap\",\"type\":\"action\",\"words\":\"Record a tapped row\",\"reads\":[\"value\"],\"spec\":{\"on\":\"row_tap\",\"at\":\"spend\",\"operation\":\"write\",\"arguments\":{\"value\":\"value\"}}}],\"questions\":[]}",[],[],"coffee 4 at 1700000000000",timestampFacts);
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  let registry: bindings.Registry = bindings.create([contract()]);
  let choices: constructionSelection.Choice[] = [{need:"spend",alternative:"entries_spend",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  let composition: screens.Composition = {screen:screens.reserve(plan,"screen"),bindings:{},actions:{},connections:[]};
  for (let slot of composition.screen.slots) { if (slot.need === "spend") { slot.allowedKinds = ["entries"]; } }
  let bound: construction.Bound = await construction.issueBindings(composition,plan,built,registry,"coffee 4 at 1700000000000",timestampFacts);
  insist(bound.unbound.length === 0 && bound.placed,"the row tap issued no operation: "+s.encode(bound.unbound));
  let result: composer.Result = await composer.assembleWith(composition,built.computations,registry,null);
  let operations: composer.OperationRecord[] = [];
  for (let candidate of result.metadata.operations) { if (candidate.id === "tap") { operations[operations.length] = candidate; } }
  insist(operations.length === 1,"the row tap operation is not issued");
  let tap: composer.OperationRecord = operations[0];
  insist(tap.trigger === "row_tap" && tap.rowKey === "f_parts_rowKey_tap" && tap.triggerResource === "f_parts_rowKey_tap","the row tap carries no captured row identity: "+s.encode(tap));
  insist(s.contains(tap.dependencies,"f_parts_rowKey_tap"),"the row tap lost its captured row identity in its dependency set: "+s.encode(tap.dependencies));
  insist(!s.contains(tap.dependencies,"f_parts_records_spend"),"the row tap still depends on the whole records collection: "+s.encode(tap.dependencies));
  insist(strings.contains(result.source.deal,"f_parts_rowChanged_tap(next, previous)"),"the row tap revision does not compare the tapped row");
  insist(strings.contains(result.source.deal,"export class f_parts_CaptureRow_tap {") && strings.contains(result.source.deal,"update_f_parts_CaptureRow_tap"),"the captured row identity has no dispatch identity");
  // The trigger-dispatched capture has exactly one wrapper and no UI update marker: no view binds it, so
  // the UI checker must not treat it as a view action, and a duplicate wrapper would be a second route.
  insist(strings.split(result.source.deal,"update_f_parts_CaptureRow_tap").length === 2,"the captured row identity emitted more than one update wrapper");
  insist(!strings.contains(result.source.deal,"// @ui-update\nexport function update_f_parts_CaptureRow_tap"),"the trigger-dispatched capture wrapper carries a UI update marker");
  // The capture reducer is an ordinary owner reducer, so the carried instance write set names the
  // resource it writes and a filled slot's write equality can be derived from it.
  let partsWrites: string[] = [];
  for (let record of result.metadata.instances) { if (record.id === "parts") { partsWrites = record.writes; } }
  insist(s.contains(partsWrites,"f_parts_rowKey_tap"),"the carried instance write set omits the captured row identity: "+s.encode(partsWrites));
  return s.encode(result);
}
// Numeric presentation and source escaping: a numeric figure binds NumberText with its prepared value,
// unit and issued decimals, time_of_day binds ClockText with prepared minutes, an entry field applies
// its decimals and unit to the prepared row and total, and a data-only label is escaped into the
// emitted view instead of being interpolated into a source literal.
export async function presentationCases(): Promise<string> {
  let label: string = "Spend \"quoted\"\\path\nlabel";
  let planJson: string = "{\"title\":\"Presentation\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":17.5}],\"constants\":[{\"id\":\"at\",\"label\":\"At\",\"measure\":\"number\",\"value\":510}],\"requirements\":[],\"needs\":[{\"id\":\"log\",\"type\":\"entries\",\"words\":\"Log spending\",\"reads\":[],\"spec\":{\"label\":"+s.encode(label)+",\"fields\":[{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\",\"decimals\":2,\"unit\":\"€\"}],\"seeds\":[]}},{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Total\",\"format\":\"money\",\"unit\":\"EUR\",\"formula\":\"limit\",\"decimals\":2,\"example\":{\"inputs\":{\"limit\":17.5},\"result\":17.5}}},{\"id\":\"wake\",\"type\":\"figure\",\"words\":\"Wake time\",\"reads\":[\"at\"],\"spec\":{\"label\":\"Wake\",\"format\":\"time_of_day\",\"unit\":\"\",\"formula\":\"at\",\"example\":{\"inputs\":{\"at\":510},\"result\":510}}}],\"questions\":[]}";
  let plan: plans.Plan = plans.decode(planJson,[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"log",alternative:"entries_log",status:"selected",reason:""},{need:"total",alternative:"part_total",status:"selected",reason:""},{need:"wake",alternative:"part_wake",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  let composition: screens.Composition = {screen:screens.reserve(plan,"screen"),bindings:{},actions:{},connections:[]};
  for (let slot of composition.screen.slots) { if (slot.need === "log") { slot.allowedKinds = ["entries"]; } if (slot.need === "total" || slot.need === "wake") { slot.allowedKinds = ["figure"]; } }
  await construction.issueBindings(composition,plan,built,registry,"","{}");
  let result: composer.Result = await composer.assembleWith(composition,built.computations,registry,null);
  let view: string = built.instance.fragment.view;
  insist(strings.contains(view,"ui.NumberText(value: state.total_display, suffix: \"EUR\", decimals: 2)"),"a numeric figure binds no NumberText with its issued decimals: "+view);
  insist(strings.contains(view,"ui.ClockText(minutes: state.wake_display)"),"a time_of_day figure binds no ClockText: "+view);
  insist(strings.contains(view,"ui.NumberText(value: state.total_log_display, prefix: "+s.encode(label+" total: ")+", suffix: \"€\", decimals: 2)"),"the entries total binds no escaped prefix, unit or decimals: "+view);
  insist(strings.contains(result.source.deal,"fixedText_log("),"an entry number field applies no issued decimals to its row text");
  insist(strings.contains(result.source.dealui,s.encode(label+" total: ")),"the escaped label prefix reached the emitted view changed: "+result.source.dealui);
  return s.encode(result);
}

// A figure may name the issued entry aggregates of an entries need. Each aggregate operand reads the
// entries part's own emitted derived field and is attributed to that entries need, so the figure
// declares the need in its reads. A figure naming an aggregate without reading its entries need keeps a
// located undeclared-read reason instead of the need silently disappearing, and a plan identifier that
// already carries an aggregate's name is a colliding alias that rejects with the offending name.
export async function entryAggregateCases(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Spend\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"spend\",\"type\":\"entries\",\"words\":\"Log spending\",\"reads\":[],\"spec\":{\"label\":\"Spending\",\"fields\":[{\"id\":\"note\",\"label\":\"Note\",\"kind\":\"text\",\"initial\":\"\",\"measure\":\"number\"},{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\",\"unit\":\"€\",\"decimals\":2}]}},{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total spend\",\"reads\":[\"spend\"],\"spec\":{\"label\":\"Total spend\",\"format\":\"money\",\"unit\":\"€\",\"formula\":\"total_spend\",\"example\":{\"inputs\":{\"total_spend\":4},\"result\":4}}},{\"id\":\"records\",\"type\":\"figure\",\"words\":\"Recorded entries\",\"reads\":[\"spend\"],\"spec\":{\"label\":\"Recorded entries\",\"format\":\"count\",\"unit\":\"\",\"formula\":\"count_spend\",\"example\":{\"inputs\":{\"count_spend\":1},\"result\":1}}},{\"id\":\"logged\",\"type\":\"entries\",\"words\":\"Log times\",\"reads\":[],\"spec\":{\"label\":\"Logged\",\"fields\":[{\"id\":\"at\",\"label\":\"At\",\"kind\":\"time\",\"initial\":0,\"measure\":\"number\"}]}},{\"id\":\"span\",\"type\":\"figure\",\"words\":\"Logged span\",\"reads\":[\"logged\"],\"spec\":{\"label\":\"Logged span\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"total_logged\",\"example\":{\"inputs\":{\"total_logged\":0},\"result\":0}}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.unavailable.length === 0,"an entry aggregate plan was refused: "+s.encode(definitions.unavailable));
  insist(definitions.figures.length === 3,"the figures over the issued entry aggregates were not issued: "+String(definitions.figures.length));
  let figure: parts.Figure = definitions.figures[0];
  let countFigure: parts.Figure = definitions.figures[1];
  let operandIds: string[] = []; let aggregateIds: string[] = [];
  for (let operand of figure.operands) { operandIds[operandIds.length] = operand.id; if (Object.hasOwn(operand,"aggregate")) { aggregateIds[aggregateIds.length] = operand.id; } }
  let operandText: string = s.encode(operandIds); let aggregateText: string = s.encode(aggregateIds);
  insist(strings.contains(operandText,"count_spend") && strings.contains(operandText,"total_spend") && strings.contains(operandText,"total_logged"),"the issued entry aggregates are not formula operands: "+operandText);
  insist(strings.contains(aggregateText,"count_spend") && strings.contains(aggregateText,"total_spend") && strings.contains(aggregateText,"total_logged"),"an issued entry aggregate carries no owning need: "+aggregateText);
  for (let operand of figure.operands) { if (operand.id === "total_spend") { insist(operand.type === "number" && operand.dependency === "f_parts_total_spend","an entry aggregate operand is not the emitted number field: "+operand.expression); } if (operand.id === "count_spend") { insist(operand.type === "number" && operand.dependency === "f_parts_count_spend","the count aggregate operand is not the emitted number field: "+operand.expression); } }
  insist(figure.expression.dependencies.length === 1 && figure.expression.dependencies[0] === "f_parts_total_spend","a figure over the entries total did not depend on its emitted getter: "+s.encode(figure.expression.dependencies));
  insist(countFigure.expression.dependencies.length === 1 && countFigure.expression.dependencies[0] === "f_parts_count_spend","a figure over the entries count did not depend on its emitted getter: "+s.encode(countFigure.expression.dependencies));
  // The compatible set holds each issued entry aggregate exactly once, whatever the operand list holds.
  let enumeration: formula.Enumeration = formula.enumerate(figure.operands,aggregateIds);
  let sources: string[] = []; for (let alternative of enumeration.alternatives) { sources[sources.length] = alternative.source; }
  let counted: number = 0; for (let source of sources) { if (source === "total_spend") { counted = counted+1; } }
  let sourceText: string = s.encode(sources);
  insist(strings.contains(sourceText,"count_spend") && strings.contains(sourceText,"total_spend") && counted === 1,"the alternative set does not hold each issued entry aggregate exactly once: "+sourceText);
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"spend",alternative:"entries_spend",status:"selected",reason:""},{need:"total",alternative:"part_total",status:"selected",reason:""},{need:"records",alternative:"part_records",status:"selected",reason:""},{need:"logged",alternative:"entries_logged",status:"selected",reason:""},{need:"span",alternative:"part_span",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(built.unavailable.length === 0,"a figure over an issued entry aggregate was not emitted: "+s.encode(built.unavailable));
  let result: composer.Result = await composer.assembleWith({screen:{title:"Spend",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations,registry,null);
  insist(strings.contains(result.source.deal,"(state.f_parts_total_spend as number)"),"the figure does not read the emitted entries total");
  insist(strings.contains(result.source.deal,"(state.f_parts_count_spend as number)"),"the figure does not read the emitted entries count");
  insist(strings.contains(result.source.deal,"state.f_parts_total_spend_ready") && strings.contains(result.source.deal,"state.f_parts_count_spend_ready"),"a figure's readiness does not follow its entries aggregate");
  insist(strings.contains(result.source.deal,"f_parts_total: (number | null);") && strings.contains(result.source.deal,"f_parts_records: (number | null);") && strings.contains(result.source.deal,"f_parts_span: (number | null);"),"the aggregate figures are not emitted derived fields");
  // A figure naming an aggregate of an entries need it does not read is a located undeclared read.
  let unread: plans.Plan = plans.decode("{\"title\":\"Spend\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"spend\",\"type\":\"entries\",\"words\":\"Log spending\",\"reads\":[],\"spec\":{\"label\":\"Spending\",\"fields\":[{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\"}]}},{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total spend\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Total spend\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"count_spend\",\"example\":{\"inputs\":{\"count_spend\":1},\"result\":1}}}],\"questions\":[]}",[],[],"","");
  let refused: parts.Definitions = parts.defineWithProviders(unread,[]);
  insist(refused.figures.length === 0 && refused.unavailable.length === 1 && strings.contains(refused.unavailable[0].reason,"does not declare in its reads"),"a figure naming an aggregate without reading its entries need kept no located reason: "+s.encode(refused.unavailable));
  // A plan identifier that already carries an aggregate's name is a colliding alias: the plan rejects
  // with the offending name instead of issuing two operands for one id or failing later on a duplicate
  // resource at build.
  let colliding: plans.Plan = plans.decode("{\"title\":\"Count\",\"inputs\":[{\"id\":\"count_log\",\"label\":\"Count log\",\"kind\":\"count\",\"measure\":\"count\",\"value\":3}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"log\",\"type\":\"entries\",\"words\":\"Log\",\"reads\":[],\"spec\":{\"label\":\"Log\",\"fields\":[{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\"}]}},{\"id\":\"twice\",\"type\":\"figure\",\"words\":\"Twice the count\",\"reads\":[\"count_log\"],\"spec\":{\"label\":\"Twice the count\",\"format\":\"count\",\"unit\":\"\",\"formula\":\"count_log * 2\",\"example\":{\"inputs\":{\"count_log\":3},\"result\":6}}}],\"questions\":[]}",[],[],"","");
  let collidingReason: string = "";
  try { parts.defineWithProviders(colliding,[]); } catch (error) { collidingReason = (error as Error).message; }
  insist(strings.contains(collidingReason,"Entry aggregate name collides with a plan identifier: count_log"),"a plan identifier colliding with an aggregate name kept no located reason: "+collidingReason);
  return s.encode(result);
}
export function main(): void { return; }
function clockConfig(): parts.Clock { return {intervalMs:1000,toleranceMs:2000}; }
function definition(kind: string): catalogue.Definition { for (let candidate of catalogue.definitions()) { if (candidate.kind === kind) { return candidate; } } throw {name:"TEST_FAILED",message:"Missing definition: "+kind}; }
// The catalogue call site replays every decision of the one shared disclosure predicate.
export async function disclosureReplay(): Promise<null> {
  let request: string = "Rent is 900 a month and the deposit is 1800.";
  let facts: string = "utilities cost 120";
  let metrics: catalogue.Definition = definition("metrics");
  let entry: catalogue.Configured = {need:"facts",definition:metrics,parameters:await catalogue.decode(metrics,JSON.parse("{\"values\":[{\"label\":\"Rent\",\"value\":\"900\"}]}")),accepted:true,reason:""};
  insist(catalogue.disclosed(entry,request,facts,false) === "","Disclosed metrics row rejected");
  // A blank row value carries no content, exactly as the joined evidence rule always decided.
  entry.parameters = await catalogue.decode(metrics,JSON.parse("{\"values\":[{\"label\":\"Rent\",\"value\":\" \"}]}"));
  insist(catalogue.disclosed(entry,request,facts,false) === "","A blank row value stopped being admitted");
  entry.parameters = await catalogue.decode(metrics,JSON.parse("{\"values\":[{\"label\":\"Rent\",\"value\":\"1700\"}]}"));
  let denial: string = catalogue.disclosed(entry,request,facts,false);
  insist(denial !== "" && strings.contains(denial,"section_facts") && strings.contains(denial,"value"),"Invented row admitted: "+denial);
  // Only the empty string carries no content; a whitespace value that occurs nowhere rejects.
  entry.parameters = await catalogue.decode(metrics,JSON.parse("{\"values\":[{\"label\":\"Rent\",\"value\":\"\\t\"}]}"));
  denial = catalogue.disclosed(entry,request,facts,false);
  insist(denial !== "","An unevidenced whitespace row value was admitted");
  entry.parameters = await catalogue.decode(metrics,JSON.parse("{\"values\":[{\"label\":\"Rent\",\"value\":\"1700\"}]}"));
  insist(catalogue.disclosed(entry,"nothing disclosed","Rent 1700 per the lease",false) === "","Fact-evidenced row rejected");
  let checklist: catalogue.Definition = definition("checklist");
  entry = {need:"steps",definition:checklist,parameters:await catalogue.decode(checklist,JSON.parse("{\"items\":[{\"id\":\"deposit\",\"label\":\"deposit\",\"detail\":\"1800\"}]}")),accepted:true,reason:""};
  insist(catalogue.disclosed(entry,request,facts,false) === "","Disclosed checklist row rejected");
  entry.parameters = await catalogue.decode(checklist,JSON.parse("{\"items\":[{\"id\":\"deposit\",\"label\":\"deposit\",\"detail\":\"2400\"}]}"));
  denial = catalogue.disclosed(entry,request,facts,false);
  insist(strings.contains(denial,"section_steps") && strings.contains(denial,"detail"),"Invented checklist detail admitted: "+denial);
  let note: catalogue.Definition = definition("note");
  entry = {need:"memo",definition:note,parameters:await catalogue.decode(note,JSON.parse("{\"text\":\"ask about the deposit\"}")),accepted:true,reason:""};
  denial = catalogue.disclosed(entry,request,facts,true);
  insist(strings.contains(denial,"section_memo"),"Invented user-owned note admitted: "+denial);
  insist(catalogue.disclosed(entry,request,facts,false) === "","Authored non-owned note rejected");
  entry.parameters = await catalogue.decode(note,JSON.parse("{\"title\":\"Nobody wrote this\",\"text\":\"ask about the deposit\"}"));
  insist(catalogue.disclosed(entry,request,facts,false) === "","Title or subtitle became content");
  // key_facts keeps the same two supplied values under its own parameter name.
  let keyFacts: catalogue.Definition = definition("key_facts");
  entry = {need:"facts",definition:keyFacts,parameters:await catalogue.decode(keyFacts,JSON.parse("{\"items\":[{\"label\":\"Rent\",\"value\":\"900\"}]}")),accepted:true,reason:""};
  insist(catalogue.disclosed(entry,request,facts,false) === "","Disclosed key_facts row rejected");
  entry.parameters = await catalogue.decode(keyFacts,JSON.parse("{\"items\":[{\"label\":\"Rent\",\"value\":\"5000\"}]}"));
  denial = catalogue.disclosed(entry,request,facts,false);
  insist(strings.contains(denial,"section_facts") && strings.contains(denial,"value"),"Invented key_facts value admitted: "+denial);
  return null;
}
// The shared bound decides the written formula question from the figure's own operand set, which
// includes constants and issued upstream results, not only plan inputs.
export function writtenFormula(): null {
  let plan: plans.Plan = plans.decode("{\"title\":\"Total\",\"inputs\":[{\"id\":\"op0\",\"label\":\"Op 0\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op1\",\"label\":\"Op 1\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op2\",\"label\":\"Op 2\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op3\",\"label\":\"Op 3\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op4\",\"label\":\"Op 4\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1},{\"id\":\"op5\",\"label\":\"Op 5\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[{\"id\":\"scale\",\"label\":\"Scale\",\"measure\":\"number\",\"value\":1}],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"op0\",\"op1\",\"op2\",\"op3\",\"op4\",\"op5\",\"scale\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"op0+op1+op2+op3+op4+op5+scale\",\"example\":{\"inputs\":{\"op0\":1,\"op1\":1,\"op2\":1,\"op3\":1,\"op4\":1,\"op5\":1,\"scale\":1},\"result\":7}}}],\"questions\":[]}",[],[],"","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.figures.length === 1 && definitions.figures[0].operands.length === 7,"Figure alternative operands lost");
  let issued: selections.Question[] = parts.formulaQuestions(plan,definitions,{choices:[],answers:[],settled:[],usable:true});
  let written: number = 0; let formula: number = 0;
  for (let question of issued) { if (question.id === "written_formula_total") { written = written+1; } if (question.id === "formula_total") { formula = formula+1; } }
  insist(written === 1 && formula === 1,"Over-cap figure did not request the written formula");
  // A figure whose own set stays inside the bound requests no written formula.
  let bounded: plans.Plan = booleanPlan();
  let boundedDefinitions: parts.Definitions = parts.defineWithProviders(bounded,[]);
  let boundedQuestions: selections.Question[] = parts.formulaQuestions(bounded,boundedDefinitions,{choices:[],answers:[],settled:[],usable:true});
  for (let question of boundedQuestions) { insist(question.id !== "written_formula_over","Bounded figure requested a written formula"); }
  return null;
}
function booleanPlan(): plans.Plan { return plans.decode("{\"title\":\"Check\",\"inputs\":[{\"id\":\"spent\",\"label\":\"Spent\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":12},{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":10}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"over\",\"type\":\"figure\",\"words\":\"Over budget\",\"reads\":[\"spent\",\"limit\"],\"spec\":{\"label\":\"Over budget\",\"format\":\"yes_no\",\"unit\":\"\",\"formula\":\"spent > limit\",\"example\":{\"inputs\":{\"spent\":12,\"limit\":10},\"result\":1}}}],\"questions\":[]}",[],[],"",""); }
// A yes_no figure publishes a boolean through one fixed spelling and assembles as emitted source.
export async function booleanFigure(): Promise<string> {
  let plan: plans.Plan = booleanPlan();
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.figures.length === 1 && definitions.figures[0].valueType === "boolean","yes_no figure not issued as a boolean");
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"over",alternative:"part_over",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  let issued: bindings.Source = bindings.source(registry,"over");
  insist(issued.type === "boolean","yes_no figure published no boolean source");
  let result: composer.Result = await composer.assemble({screen:{title:"Check",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations);
  return s.encode(result);
}

// ---------------------------------------------------------------------------------------------
// Assembly, ownership, slots, operations, publication, chat root and hole-body contracts.
function numberWire(): embedding.WireType { let fields: embedding.WireField[] = []; return {kind:"number",fields:fields,element:null,maximum:0,minimumNumber:-1.7976931348623157e308,maximumNumber:1.7976931348623157e308}; }
function contract(): embedding.CapabilityContract {
  let parameters: embedding.Parameter[] = [{name:"value",type:numberWire()}];
  let stringFields: embedding.WireField[] = [];
  let textWire: embedding.WireType = {kind:"string",fields:stringFields,element:null,maximum:8192,minimumNumber:0,maximumNumber:0};
  let textParameters: embedding.Parameter[] = [{name:"label",type:textWire}];
  let shortFields: embedding.WireField[] = [];
  let shortWire: embedding.WireType = {kind:"string",fields:shortFields,element:null,maximum:64,minimumNumber:0,maximumNumber:0};
  let shortParameters: embedding.Parameter[] = [{name:"label",type:shortWire}];
  let boundedFields: embedding.WireField[] = [];
  let boundedWire: embedding.WireType = {kind:"number",fields:boundedFields,element:null,maximum:0,minimumNumber:0,maximumNumber:100};
  let boundedParameters: embedding.Parameter[] = [{name:"value",type:boundedWire}];
  let functions: embedding.CapabilityFunction[] = [{name:"write",description:"Record the constructed value",parameters:parameters,result:numberWire()},{name:"writeText",description:"Record a constructed label",parameters:textParameters,result:textWire},{name:"writeShort",description:"Record a bounded label",parameters:shortParameters,result:textWire},{name:"writeBounded",description:"Record a bounded rate",parameters:boundedParameters,result:numberWire()}];
  return {module:"demo/facts",description:"Test record",version:1,functions:functions};
}
function owner(id: string, value: number): screens.Instance {
  let instance: screens.Instance = fragment(id,String(value));
  instance.fragment.ports = [{name:"published",type:"number",direction:"publish",getter:"value",optional:false},{name:"doubled",type:"number",direction:"publish",getter:"double",optional:false}];
  return instance;
}
function assembly(instances: screens.Instance[], slots: screens.Slot[], composites: screens.Composite[], target: string): screens.Composition {
  return {screen:{title:"Assembly",target:target,layout:{kind:"stack",positions:[]},slots:slots,instances:instances},bindings:{},actions:{},connections:[],composites:composites};
}
function slot(id: string, status: string, instance: string): screens.Slot {
  return {id:id,need:id,reads:[],writes:[],provider:false,allowedKinds:[],valueType:"number",status:status,instance:instance,reason:""};
}
function assemblyComputations(): composer.Computation[] {
  let result: composer.Computation[] = [];
  result[0] = {instance:"a",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_a_value"]};
  result[1] = {instance:"b",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_b_value"]};
  return result;
}
export async function assemblyCases(): Promise<string> {
  let instances: screens.Instance[] = [owner("a",3),owner("b",4)];
  instances[1].fragment.holes = [{id:"whenFinished",parameter:"state",type:"AppState",result:"AppState",default:"return state;"}];
  instances[1].bodies = {whenFinished:"return {flag: true};"};
  instances[1].fragment.ports[instances[1].fragment.ports.length] = {name:"external",type:"number",direction:"read",getter:"external",optional:true,fallback:"7"};
  // A composite arm universe: `Capture` writes a disjoint resource from the value the preceding arm
  // writes, so the ordered transaction is observable on one candidate.
  instances[0].fragment.declarations = instances[0].fragment.declarations+" export class Capture { value: number; }";
  instances[0].fragment.helpers = instances[0].fragment.helpers+" export function capture(state: AppState, action: Capture): AppState { return {sequence: state.value}; }";
  instances[0].fragment.updates[instances[0].fragment.updates.length] = {action:"Capture",function:"capture"};
  instances[0].fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.NumberField(label: \"Value\", value: state.value, minimum: 0, maximum: 999, step: 1, onChange: action app.Change {value: payload}) When(state.double_ready) { ui.NumberText(value: state.double_display) } ui.Toggle(label: \"Flag\", checked: state.flag, onChange: action app.Switch {value: payload}) ui.Button(text: \"Load\", value: state.value, onClick: action app.Load {sequence: payload}) ui.Button(text: \"Capture\", value: state.value, onClick: action app.Capture {value: payload}) ui.Button(text: \"Link\", value: state.value, onClick: action app.Link {value: payload}) } }";
  // Two slots filled by the same instance are legal: slot writes are per filling instance, not per
  // slot, and the publication identity is issued once per output.
  let slots: screens.Slot[] = [slot("a","filled","a"),slot("focus","open",""),slot("b","filled","a")];
  // A trigger is the route to an issued operation, so a slot with no operation identity carries no
  // event: the accepted composition claims no route nothing can raise. `assemblyRejects` holds the
  // rejection of a slot that does carry one.
  let composites: screens.Composite[] = [{action:"Apply",arms:[{instance:"a",action:"Change"},{instance:"a",action:"Capture"},{instance:"b",action:"Switch"}]}];
  let composition: screens.Composition = assembly(instances,slots,composites,"chat");
  let registry: bindings.Registry = bindings.create([contract()]);
  bindings.reserve(registry,{id:"value",type:"number",schema:numberWire(),dependencies:[],owner:"a",payloadOwner:"",getter:"f_a_value",ready:"true"});
  let rawBindings: Record<string, unknown> = JSON.parse("{\"write\":{\"module\":\"demo/facts\",\"function\":\"write\",\"arguments\":{\"value\":\"value\"}}}");
  let rawActions: Record<string, unknown> = JSON.parse("{\"run\":{\"id\":\"run\",\"label\":\"Run\",\"binding\":\"write\"}}");
  await bindings.issueComposition(registry,rawBindings,rawActions,"Record the value","facts");
  insist(registry.bindings.length === 1 && registry.actions.length === 1,"Bind stage issued no binding");
  insist(registry.bindings[0].evidence.request === "Record the value" && registry.bindings[0].evidence.quote === "","Binding evidence is not the frozen request");
  insist(registry.bindings[0].parameterOrder.length === 1 && (registry.bindings[0].parameterOrder[0] as string) === "value","Contract-order parameter coverage lost");
  let chat: composer.ChatRoot = {children:[{instance:"a",label:"One"},{instance:"b",label:"Two"}],initialSelection:0};
  let result: composer.Result = await composer.assembleWith(composition,assemblyComputations(),registry,chat);
  let source: string = result.source.deal; let view: string = result.source.dealui;
  insist(strings.contains(source,"revision_write: number;") && strings.contains(source,"status_write: string;"),"Operation revision field missing");
  insist(strings.contains(source,"export function invocationCurrent(state: AppState, operationId: string, sequence: number, phase: string, revision: number): boolean"),"Currentness hook signature changed");
  insist(strings.contains(source,"state.revision_write === revision"),"Hook does not compare the issued revision");
  // The expiry prerequisite is emitted beside the four operation fields and the hook reads it: an
  // operation whose recorded instant has passed is never current, whichever sequence, phase and
  // revision it presents.
  insist(strings.contains(source,"expires_write: number;") && strings.contains(source,"expired_write: boolean;"),"Operation expiry prerequisites missing");
  insist(strings.contains(source,"state.expired_write === false"),"Hook ignores the issued expiry prerequisite");
  insist(strings.contains(source,"export function expireOperations(state: AppState, at: number): AppState"),"Expiry transition missing");
  insist(strings.contains(source,"if (!expired_write && state.expires_write !== 0 && (!Number.isFinite(at) || at >= state.expires_write)) { expired_write = true; }"),"Expiry transition does not derive the prerequisite from the recorded instant");
  // Admission records the deadline of the invocation it admits through its own emitted transition, so
  // a retry can be current again while the correlation of the expired invocation stays stale.
  insist(strings.contains(source,"export function recordExpiry(state: AppState, operationId: string, expiresAt: number, admittedAt: number): AppState") && strings.contains(source,"expires_write: expiresAt"),"Admission-recording expiry transition missing");
  insist(strings.contains(source,"expiresAt < admittedAt"),"Admission accepts a deadline its own reading already passed");
  insist(result.metadata.operations[0].expires === "expires_write" && result.metadata.operations[0].expired === "expired_write","Operation metadata lost its expiry prerequisites");
  insist(strings.contains(source,"export function bump(next: AppState, previous: AppState): AppState"),"Revision bump missing");
  insist(strings.contains(source,"next.f_a_value !== previous.f_a_value"),"Bump does not count the issued dependency");
  insist(result.metadata.operations.length === 1 && s.contains(result.metadata.operations[0].dependencies,"f_a_value"),"Operation dependency set lost");
  insist(result.metadata.slots.length === 3,"Slot records missing");
  insist(s.contains(result.metadata.slots[0].writes,"f_a_value") && (result.metadata.slots[1].writes.length === 0),"Slot writes are not the written resources");
  insist(s.contains(result.metadata.slots[2].writes,"f_a_value"),"A second slot filled by the same instance claims nothing");
  insist(result.metadata.slots[0].event === "" && result.metadata.slots[1].status === "open","Slot event/status lost");
  insist(result.metadata.publications.length === 3,"A repeated publication identity was minted twice or a derived output was dropped");
  insist(strings.contains(source,"export function publish_f_a_published(state: AppState): number") && strings.contains(source,"export function ready_f_a_published(state: AppState): boolean"),"Filled slot published no pair");
  // A derived output is stored as number | null, so its getter keeps the declared number signature by
  // throwing its located reason while unready and returning the stored value only when ready.
  insist(strings.contains(source,"export function publish_f_a_doubled(state: AppState): number") && strings.contains(source,"if (!state.f_a_double_ready) { throw {name: \"EMPTY_SLOT\", message: state.f_a_double_reason}; }") && strings.contains(source,"(state.f_a_double as number)"),"Derived publication getter is not signature-correct");
  insist(strings.contains(source,"export function ready_f_a_doubled(state: AppState): boolean") && strings.contains(source,"return state.f_a_double_ready;"),"Derived publication readiness lost");
  insist(strings.contains(source,"export function publish_open_focus(state: AppState): number") && strings.contains(source,"EMPTY_SLOT"),"Open slot substitutes a value");
  insist(strings.contains(source,"f_b_external: number;") && strings.contains(source,"f_b_external: 7") && !strings.contains(source,"f_b_external: (number | null)"),"Optional reader fallback not resolved as a typed nonnullable value");
  insist(strings.contains(source,"export function f_b_whenFinished(state: AppState): AppState {") && strings.contains(source,"return {f_b_flag: true"),"Hole body not emitted in place of the default");
  insist(result.metadata.composites.length === 1 && result.metadata.composites[0].action === "Apply","Composite transaction missing from metadata");
  // The composite is one emitted transaction: a composition-scope nominal class with one payload field
  // per ordered arm, one wrapper applying the owner reducers to one candidate in declaration order,
  // and one update that recomputes and commits once.
  insist(strings.contains(source,"export class Composite_Apply { arm0: f_a_Change; arm1: f_a_Capture; arm2: f_b_Switch; }"),"The composite action class is not emitted with its ordered arm payloads");
  insist(strings.contains(source,"export function composite_Apply(state: AppState, action: Composite_Apply): AppState") && strings.contains(source,"let candidate: AppState = state;"),"The composite transaction wrapper is not emitted");
  insist(strings.contains(source,"candidate = f_a_change(candidate, action.arm0);") && strings.contains(source,"candidate = f_a_capture(candidate, action.arm1);") && strings.contains(source,"candidate = f_b_switchValue(candidate, action.arm2);"),"The composite arms do not run against one candidate in declaration order");
  insist(source.indexOf("candidate = f_a_change(candidate, action.arm0);") < source.indexOf("candidate = f_a_capture(candidate, action.arm1);"),"The composite arms are not in declaration order");
  insist(strings.contains(source,"export function update_Apply(state: AppState, action: Composite_Apply): AppState") && strings.contains(source,"recompute(composite_Apply(state, action))"),"The composite update does not recompute and commit exactly once");
  insist(result.metadata.composites[0].type === "Composite_Apply" && result.metadata.composites[0].update === "update_Apply" && result.metadata.composites[0].arms.length === 3,"The issued composite dispatch identity is missing");
  let collidingComposites: screens.Composite[] = [{action:"chat",arms:[{instance:"a",action:"Change"},{instance:"b",action:"Switch"}]}];
  let collided: boolean = false;
  try { await composer.assembleWith(assembly(instances,slots,collidingComposites,"chat"),assemblyComputations(),bindings.create([]),chat); } catch (error) { collided = true; }
  insist(collided,"a composite reusing the chat-root update identity assembled");
  insist(strings.contains(view,"ui.Tabs(labels: state.chat_labels, selected: state.chat_selected"),"Chat root Tabs missing");
  insist(strings.contains(source,"chat_labels: string[];") && strings.contains(source,"chat_labels: [\"One\", \"Two\"]"),"Issued chat labels are not authoritative state");
  insist(strings.contains(source,"chat_selected: number;"),"Chat selection is not authoritative state");
  // `writes` is exactly what the filling reducers write, and a non-filled slot writes nothing.
  let partialSlots: screens.Slot[] = [slot("a","filled","a"),slot("b","missing","a")];
  let partial: composer.Result = await composer.assembleWith(assembly([owner("a",3)],partialSlots,[],"screen"),[assemblyComputations()[0]],bindings.create([]),null);
  // `writes` is exactly what the filling reducers write, including the authoritative alias/cycle
  // resources the Link reducer supplies and excluding the derived `double`.
  insist(s.contains(partial.metadata.slots[0].writes,"f_a_value") && s.contains(partial.metadata.slots[0].writes,"f_a_head") && s.contains(partial.metadata.slots[0].writes,"f_a_mirror") && s.contains(partial.metadata.slots[0].writes,"f_a_leaf") && partial.metadata.slots[0].writes.length === 6,"Slot writes are not exactly the reducer-written resources");
  insist(partial.metadata.slots[1].writes.length === 0,"A missing slot claims written resources");
  insist(partial.metadata.slots[1].provider === false,"A missing slot claims provider work");
  // The provider flag derives from the implementation's resolved provider calls, not the need type.
  let providerInstance: screens.Instance = owner("p",6);
  providerInstance.fragment.declarations = providerInstance.fragment.declarations+" import * as facts from \"demo/facts\";";
  providerInstance.fragment.helpers = providerInstance.fragment.helpers+" export function record(state: AppState, action: Change): AppState { let written: number = facts.write(action.value); return {value: written}; }";
  providerInstance.fragment.updates = [{action:"Change",function:"record"}];
  providerInstance.fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Button(text: \"Record\", value: state.value, onClick: action app.Change {value: payload}) } }";
  let providerComputation: composer.Computation = {instance:"p",field:"double",value:"state.value * 2",ready:"true",reason:"\"Unavailable\"",dependencies:["f_p_value"]};
