  insist(recordEvent === "entry_added" && recordAction === "record" && recordTrigger === "spend","the entry_added trigger names no operation: "+recordEvent+" "+recordAction+" "+recordTrigger);
  insist(tapEvent === "row_tap" && tapAction === "tap" && tapTrigger === "spend","the row_tap trigger names no operation: "+tapEvent+" "+tapAction+" "+tapTrigger);
  insist(laterEvent === "time" && laterAction === "later" && laterTrigger === "at","the time trigger names no operation: "+laterEvent+" "+laterAction+" "+laterTrigger);
  insist(doneProvider,"a triggered provider operation issued provider false");
  insist(clockEvent === "|" && entriesEvent === "|","a trigger was written onto its target's slot instead of the action's: "+clockEvent+" "+entriesEvent);
  // A part publication whose identity equals its need is not a plan operation, so it claims no
  // action identity and no provider work.
  insist(clockAction === "","a part publication claimed a plan operation identity: "+clockAction);
  // Two actions raised by one clock share one issued driver slot.
  let focusDrivers: number = 0;
  for (let driver of result.metadata.drivers) { if (driver === "countdown_end_focus") { focusDrivers = focusDrivers+1; } }
  insist(focusDrivers === 1,"two actions on one clock issued duplicate driver slots: "+s.encode(result.metadata.drivers));
  let doneDependency: boolean = false; let recordDependency: boolean = false; let doneKind: string = ""; let recordKind: string = "";
  // A raw text buffer is a read of a derived value, not a dependency resource: the parsed value and
  // its readiness already capture every semantic and invalid-draft change, so the operation revision
  // observes no draft spelling.
  let doneBuffer: boolean = false; let doneValue: boolean = false; let doneReadiness: boolean = false;
  let tapDependency: boolean = false; let tapRowKey: string = ""; let tapCollection: boolean = false; let laterDependency: boolean = false; let laterGetter: string = bindings.source(registry,"at").getter; let focusClosure: boolean = false;
  for (let operation of result.metadata.operations) {
    if (operation.id === "done") { doneKind = operation.trigger; doneDependency = s.contains(operation.dependencies,"f_parts_triggered_focus"); doneBuffer = s.contains(operation.dependencies,"f_parts_value_draft"); doneValue = s.contains(operation.dependencies,"f_parts_value"); doneReadiness = s.contains(operation.dependencies,"f_parts_value_ready"); }
    if (operation.id === "record") { recordKind = operation.trigger; recordDependency = s.contains(operation.dependencies,"f_parts_records_spend"); }
    if (operation.id === "tap") { tapDependency = s.contains(operation.dependencies,"f_parts_rowKey_tap"); tapRowKey = operation.rowKey; tapCollection = s.contains(operation.dependencies,"f_parts_records_spend"); }
    if (operation.id === "later") { laterDependency = s.contains(operation.dependencies,laterGetter); }
    if (operation.id === "focus") { focusClosure = s.contains(operation.dependencies,"f_parts_duration_focus") && s.contains(operation.dependencies,"f_parts_elapsed_focus"); }
  }
  insist(doneKind === "countdown_end" && doneDependency,"the countdown_end operation lost its trigger resource in its dependency set: "+doneKind);
  insist(doneValue && doneReadiness,"the operation lost the parsed argument value or its readiness: "+s.encode(doneValue)+s.encode(doneReadiness));
  insist(!doneBuffer,"the operation dependency set carries the raw draft buffer spelling");
  insist(!strings.contains(result.source.deal,"next.f_parts_value_draft !== previous.f_parts_value_draft"),"an equivalent draft spelling advances the operation revision");
  insist(recordKind === "entry_added" && recordDependency,"the entry_added operation lost its trigger resource in its dependency set: "+recordKind);
  insist(tapDependency && tapRowKey === "f_parts_rowKey_tap","the row_tap operation lost its row identity resource in its dependency set");
  insist(!tapCollection,"the row_tap operation still depends on the whole records collection: "+s.encode(tapDependency));
  insist(laterDependency,"the time operation lost its time source in its dependency set: "+laterGetter);
  insist(focusClosure,"a publication argument is not closed over the checked reads of its computation");
  insist(strings.contains(result.source.deal,"next.f_parts_triggered_focus !== previous.f_parts_triggered_focus"),"a countdown completion does not advance the triggered operation revision");
  insist(strings.contains(result.source.deal,"next.f_parts_records_spend !== previous.f_parts_records_spend"),"an entries collection edit does not advance the triggered operation revision");
  insist(s.contains(result.metadata.drivers,"countdown_end_focus") && s.contains(result.metadata.drivers,"entry_added_spend"),"the issued trigger drivers are missing: "+s.encode(result.metadata.drivers));
  // An `other` action's target is a written-action declaration: it issues no event slot and never
  // aborts assembly, so the plan the schema accepts still assembles.
  let otherPlan: plans.Plan = plans.decode("{\"title\":\"Other\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"log\",\"type\":\"content\",\"words\":\"Show a log\",\"reads\":[],\"spec\":{}},{\"id\":\"custom\",\"type\":\"action\",\"words\":\"Write when logged\",\"reads\":[],\"spec\":{\"on\":\"other\",\"at\":\"log\",\"operation\":\"write\",\"arguments\":{}}}],\"questions\":[]}",[],[],"Show a log","{\"facts\":[]}");
  let otherScreen: screens.Screen = screens.reserve(otherPlan,"screen");
  for (let slot of otherScreen.slots) { insist(!Object.hasOwn(slot,"event"),"an other action issued an event slot: "+slot.need); }
  let otherRegistry: bindings.Registry = bindings.create([contract()]);
  let otherBuilt: parts.Built = parts.buildWithProviders(otherPlan,parts.defineWithProviders(otherPlan,[]),[],otherRegistry,null,clockConfig());
  let otherBound: construction.Bound = await construction.issueBindings({screen:otherScreen,bindings:{},actions:{},connections:[]},otherPlan,otherBuilt,otherRegistry,"Show a log","{\"facts\":[]}");
  insist(otherBound.unbound.length === 1 && strings.contains(otherBound.unbound[0],"custom") && strings.contains(otherBound.unbound[0],"value"),"an other action's binding was not located: "+s.encode(otherBound.unbound));
  // A bound plan action is implemented by its emitted operation, so coverage never reports it missing
  // and an accepted judgement of that operation holds: the slot's instance-level status describes the
  // implementation that exists rather than overwriting the judged coverage of the operation.
  let ledger: coverage.Ledger = coverage.judge(plan,composition.screen,[]);
  let doneStatus: string = ""; let recordStatus: string = "";
  for (let entry of ledger.needs) { if (entry.id === "done") { doneStatus = entry.status; } if (entry.id === "record") { recordStatus = entry.status; } }
  insist(doneStatus !== "missing" && recordStatus !== "missing","a bound plan action is reported missing: "+doneStatus+" "+recordStatus);
  let judged: selections.Answer[] = [];
  for (let need of plan.needs) { judged[judged.length] = {id:"coverage_"+need.id,selected:"covered",probability:1,accepted:true,probabilities:[]}; }
  let coveredLedger: coverage.Ledger = coverage.judge(plan,composition.screen,judged);
  let coveredStatus: string = ""; let doneSlotStatus: string = ""; let doneSlotAction: string = ""; let doneSlotReason: string = "";
  for (let entry of coveredLedger.needs) { if (entry.id === "done") { coveredStatus = entry.status; } }
  for (let slot of composition.screen.slots) { if (slot.need === "done") { doneSlotStatus = slot.status; doneSlotReason = slot.reason; if (Object.hasOwn(slot,"action")) { doneSlotAction = s.text(slot.action); } } }
  insist(coveredStatus === "covered","a bound plan action's accepted coverage judgement was discarded: "+coveredStatus);
  insist(doneSlotStatus === "unchecked" && doneSlotAction === "done" && doneSlotReason === "Behavior coverage not yet judged","a triggered plan action's slot reports no implementation: "+doneSlotStatus+" "+doneSlotAction+" "+doneSlotReason);
  // An action need whose operation no emitted control or checked trigger raises keeps its slot open
  // and its accepted judgement is not claimed: reporting it covered would promise a behavior nothing
  // in the artifact can invoke.
  let buttonPlan: plans.Plan = plans.decode("{\"title\":\"Call\",\"inputs\":[{\"id\":\"value\",\"label\":\"Value\",\"kind\":\"amount\",\"measure\":\"number\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"submit\",\"type\":\"action\",\"words\":\"Submit\",\"reads\":[\"value\"],\"spec\":{\"on\":\"button\",\"operation\":\"write\",\"arguments\":{\"value\":\"value\"}}}],\"questions\":[]}",[],[],"Record the value","{\"facts\":[]}");
  let buttonRegistry: bindings.Registry = bindings.create([contract()]);
  let buttonBuilt: parts.Built = parts.buildWithProviders(buttonPlan,parts.defineWithProviders(buttonPlan,[]),[],buttonRegistry,null,clockConfig());
  let buttonComposition: screens.Composition = {screen:screens.reserve(buttonPlan,"screen"),bindings:{},actions:{},connections:[]};
  let buttonBound: construction.Bound = await construction.issueBindings(buttonComposition,buttonPlan,buttonBuilt,buttonRegistry,"Record the value","{\"facts\":[]}");
  insist(buttonBound.unbound.length === 0 && buttonRegistry.bindings.length === 1,"a button action with its argument issued no operation: "+s.encode(buttonBound.unbound));
  let buttonAnswers: selections.Answer[] = [{id:"coverage_submit",selected:"covered",probability:1,accepted:true,probabilities:[]}];
  let buttonNeed: coverage.NeedCoverage = coverage.judge(buttonPlan,buttonComposition.screen,buttonAnswers).needs[0];
  insist(buttonNeed.status !== "covered","an action no emitted control or checked trigger raises was reported covered: "+buttonNeed.status);
  insist(buttonNeed.reason === "No emitted control or checked trigger raises the issued operation for this need","an action no control or trigger raises kept no located reason: "+buttonNeed.reason);
  return s.encode(result);
}
// The entries composer part: authoritative records, stable keys, drafts, add/remove/undo, count and
// total from the first numeric non-time field, and admitted seeds only.
export async function entriesNeedPart(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Log\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"spend\",\"type\":\"entries\",\"words\":\"Log spending\",\"reads\":[],\"quote\":\"coffee 4\",\"spec\":{\"label\":\"Spending\",\"fields\":[{\"id\":\"note\",\"label\":\"Note\",\"kind\":\"text\",\"initial\":\"\",\"measure\":\"number\"},{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\"}],\"seeds\":[{\"values\":{\"note\":\"coffee\",\"amount\":4},\"timestamp\":1700000000000}]}}],\"questions\":[]}",[],[],"coffee 4 at 1700000000000","{\"facts\":[{\"id\":\"at\",\"text\":\"coffee 4 at 1700000000000\",\"type\":\"unixMillis\",\"value\":1700000000000}]}");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.alternatives.length === 1 && definitions.alternatives[0].id === "entries_spend","Entries alternative missing");
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"spend",alternative:"entries_spend",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  insist(built.instance.fragment.covers.length === 1 && built.instance.fragment.covers[0] === "spend","Entries part covers no need");
  insist(bindings.source(registry,"spend").getter === "f_parts_count_spend" && bindings.source(registry,"spend").ready === "f_parts_count_spend_ready","the entries publication issued no count source");
  let result: composer.Result = await composer.assembleWith({screen:{title:"Log",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations,registry,null);
  insist(strings.contains(result.source.deal,"records_spend: f_parts_Entry_spend[];"),"Entries records field missing");
  insist(strings.contains(result.source.deal,"nextKey_spend: number;") && strings.contains(result.source.deal,"removed_spend: (f_parts_Removed_spend | null);"),"Entries key/undo state missing");
  insist(strings.contains(result.source.deal,"export function f_parts_count_spend(state: AppState): number"),"Entries count helper missing");
  insist(strings.contains(result.source.deal,"export function f_parts_total_spend(state: AppState): number"),"Entries total helper missing");
  insist(strings.contains(result.source.deal,"f_parts_entriesClock.nowMillis()"),"Add action captures no wall-clock timestamp");
  // The record is the closed EntryRecord {key, timestamp, values}: `values` is a closed record of the
  // declared field identifiers with their declared types, not flattened `v_` fields.
  insist(strings.contains(result.source.deal,"export class f_parts_Values_spend {") && strings.contains(result.source.deal,"values: f_parts_Values_spend;") && strings.contains(result.source.deal,"record.values.amount"),"the closed values record is missing");
  insist(!strings.contains(result.source.deal,"v_note") && !strings.contains(result.source.deal,"serial"),"the record or its removal still carries the flattened fields");
  // Removal is addressed by the record key with the numeric row event value as its payload, and the
  // pending undo is one index-plus-record value.
  insist(strings.contains(result.source.deal,"row.key === action.key") && strings.contains(result.source.deal,"Unknown record key: "),"removal is not addressed by the record key with a located rejection");
  insist(strings.contains(result.source.deal,"export class f_parts_Removed_spend {") && strings.contains(result.source.deal,"index: number;") && strings.contains(result.source.deal,"record: f_parts_Entry_spend;"),"the pending undo value is not one index-plus-record value");  // An invalid draft keeps its own located reason, prepared for the view beside the draft.
  insist(strings.contains(result.source.deal,"export function f_parts_fieldReason_spend_amount(state: AppState): string") && strings.contains(result.source.deal,"Amount: enter a finite decimal number"),"an invalid draft has no located reason");
  insist(strings.contains(result.source.deal,"rowValue_spend"),"the row event value is not prepared by compiled policy");
  insist(strings.contains(result.source.dealui,"ForEach(state.f_parts_rows_spend, row: app.f_parts_Row_spend, key: row.key)"),"Keyed ForEach rows missing");
  insist(strings.contains(result.source.dealui,"eventValue: row.value") && strings.contains(result.source.dealui,"{key: row.key, at: payload}"),"Row tap does not bind the row key and the numeric payload");
  insist(!strings.contains(result.source.dealui,"ui.ListGroup("),"the emitted rows put a loop inside ListGroup");
  return s.encode(result);
}

// A field-less entries need is spec-legal: each tap adds exactly one timestamped record with no
// values. The emitted record literal stays parsable.
export async function entriesEmptyPart(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Marks\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"mark\",\"type\":\"entries\",\"words\":\"Marks\",\"reads\":[],\"quote\":\"mark\",\"spec\":{\"label\":\"Marks\",\"fields\":[],\"seeds\":[{\"values\":{}}]}}],\"questions\":[]}",[],[],"mark","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.alternatives.length === 1 && definitions.alternatives[0].id === "entries_mark","Field-less entries alternative missing");
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"mark",alternative:"entries_mark",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  let result: composer.Result = await composer.assembleWith({screen:{title:"Marks",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]},built.computations,registry,null);
  insist(strings.contains(result.source.deal,"f_parts_entriesClock.nowMillis()"),"a field-less entries add captures no timestamp");
  // An omitted seed timestamp uses the activation time captured once in initialState, never a fabricated
  // or seed-supplied value.
  insist(strings.contains(result.source.deal,"timestamp: capturedTime"),"an omitted seed timestamp did not use the captured activation time");
  insist(strings.contains(result.source.deal,"export class f_parts_Values_mark {") && strings.contains(result.source.deal,"values: f_parts_Values_mark;") && strings.contains(result.source.deal,"let values: f_parts_Values_mark = {};"),"a field-less entries record emitted no closed empty values record");
  insist(!strings.contains(result.source.deal,"text: ,"),"a field-less entries record emitted an empty text expression");
  return s.encode(result);
}

// A seed on a field-bearing entries need may name only some declared fields: the entries part
// initializes every unnamed field with its declared initial, so a partial record keeps the supplied
// values and a timestamp-only record supplies no value at all.
export function seedDefaults(): string {
  let plan: plans.Plan = plans.decode("{\"title\":\"Log\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"spend\",\"type\":\"entries\",\"words\":\"Log spending\",\"reads\":[],\"quote\":\"coffee\",\"spec\":{\"label\":\"Spending\",\"fields\":[{\"id\":\"note\",\"label\":\"Note\",\"kind\":\"text\",\"initial\":\"\",\"measure\":\"number\"},{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\"}],\"seeds\":[{\"values\":{\"note\":\"coffee\"}},{\"values\":{}}]}}],\"questions\":[]}",[],[],"bought coffee","");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.unavailable.length === 0,"a partial seed need was reported unavailable: "+s.encode(definitions.unavailable));
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"spend",alternative:"entries_spend",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  let initial: string = ""; let rows: string = "";
  for (let field of built.instance.fragment.fields) { if (field.name === "records_spend") { initial = field.initial; } if (field.name === "rows_spend") { rows = field.initial; } }
  return s.encode({initial:initial,rows:rows});
}

// A figure value type follows its format in both directions, and a formula that fails its issued
// example keeps its need open with the located reason instead of disappearing from the alternative set.
export function figureRejects(): string {
  let numeric: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"over\",\"type\":\"figure\",\"words\":\"Over\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Over\",\"format\":\"yes_no\",\"unit\":\"\",\"formula\":\"limit\",\"example\":{\"inputs\":{\"limit\":1},\"result\":1}}}],\"questions\":[]}",[],[],"","");
  let numericDefinitions: parts.Definitions = parts.defineWithProviders(numeric,[]);
  insist(numericDefinitions.figures.length === 0,"a numeric expression was issued as a yes_no figure");
  insist(numericDefinitions.unavailable.length === 1 && numericDefinitions.unavailable[0].need === "over" && strings.contains(numericDefinitions.unavailable[0].reason,"yes_no figure requires a boolean-typed formula"),"a numeric yes_no formula kept no located type reason: "+s.encode(numericDefinitions.unavailable));
  for (let alternative of numericDefinitions.alternatives) { insist(alternative.id !== "part_over","a refused figure still issued its part alternative"); }
  let boolean: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"limit > 0\",\"example\":{\"inputs\":{\"limit\":1},\"result\":1}}}],\"questions\":[]}",[],[],"","");
  let booleanDefinitions: parts.Definitions = parts.defineWithProviders(boolean,[]);
  insist(booleanDefinitions.figures.length === 0,"a boolean expression was issued as a numeric figure");
  insist(booleanDefinitions.unavailable.length === 1 && strings.contains(booleanDefinitions.unavailable[0].reason,"plain figure requires a number-typed formula"),"a boolean numeric-format formula kept no located type reason: "+s.encode(booleanDefinitions.unavailable));
  let failing: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":10}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"limit * 2\",\"example\":{\"inputs\":{\"limit\":10},\"result\":10}}}],\"questions\":[]}",[],[],"","");
  let failingDefinitions: parts.Definitions = parts.defineWithProviders(failing,[]);
  insist(failingDefinitions.figures.length === 0,"a figure failing its issued example was issued");
  insist(failingDefinitions.unavailable.length === 1 && failingDefinitions.unavailable[0].need === "total" && strings.contains(failingDefinitions.unavailable[0].reason,"Formula fails the issued numeric example"),"a figure failing its example kept no located reason: "+s.encode(failingDefinitions.unavailable));
  let built: parts.Built = parts.buildWithProviders(failing,failingDefinitions,[],bindings.create([]),null,clockConfig());
  let reported: string = "";
  for (let reason of built.unavailable) { reported = reported+reason+"|"; }
  insist(strings.contains(reported,"total: Formula fails the issued numeric example"),"the built result lost the located figure reason: "+reported);
  // A formula may name a figure declared after it: the fixpoint retries the deferred figure, and a
  // figure that is finally built keeps no stale refusal reason.
  let forward: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"limit\",\"rate\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"limit * rate\",\"example\":{\"inputs\":{\"limit\":1,\"rate\":2},\"result\":2}}},{\"id\":\"rate\",\"type\":\"figure\",\"words\":\"Rate\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Rate\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"limit + 1\",\"example\":{\"inputs\":{\"limit\":1},\"result\":2}}}],\"questions\":[]}",[],[],"","");
  let forwardDefinitions: parts.Definitions = parts.defineWithProviders(forward,[]);
  insist(forwardDefinitions.figures.length === 2,"a figure naming a later-declared figure was dropped by the fixpoint: "+s.encode(forwardDefinitions.unavailable));
  insist(forwardDefinitions.unavailable.length === 0,"a figure that was finally built kept a stale refusal reason: "+s.encode(forwardDefinitions.unavailable));
  // An example that omits an operand its formula uses is the example's own gap, not an unissued operand.
  let gap: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Limit\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":1}],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"limit * 2\",\"example\":{\"inputs\":{},\"result\":2}}}],\"questions\":[]}",[],[],"","");
  let gapDefinitions: parts.Definitions = parts.defineWithProviders(gap,[]);
  insist(gapDefinitions.figures.length === 0 && gapDefinitions.unavailable.length === 1 && strings.contains(gapDefinitions.unavailable[0].reason,"example supplies no value for operand limit"),"an example gap was reported as an unissued operand: "+s.encode(gapDefinitions.unavailable));
  // An example naming an identifier plan decode issued but the formula cannot use as an operand keeps
  // the need open with the second boundary's reason, which names the offending operand.
  let nonOperand: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"spend\",\"type\":\"entries\",\"words\":\"Log\",\"reads\":[],\"spec\":{\"label\":\"Log\",\"fields\":[]}},{\"id\":\"total\",\"type\":\"figure\",\"words\":\"Total\",\"reads\":[\"spend\"],\"spec\":{\"label\":\"Total\",\"format\":\"plain\",\"unit\":\"\",\"formula\":\"total_spend\",\"example\":{\"inputs\":{\"total_spend\":1,\"spend\":1},\"result\":1}}}],\"questions\":[]}",[],[],"","");
  let nonOperandDefinitions: parts.Definitions = parts.defineWithProviders(nonOperand,[]);
  insist(nonOperandDefinitions.figures.length === 0 && nonOperandDefinitions.unavailable.length === 1 && strings.contains(nonOperandDefinitions.unavailable[0].reason,"Unissued example operand: spend"),"an example naming a non-operand identifier kept no located operand reason: "+s.encode(nonOperandDefinitions.unavailable));
  return s.encode(failingDefinitions.unavailable);
}

// A view of one placed owner binds another owner's exported nominal action. The emitted binding names
// the target owner's qualified action class, so dispatch reaches that owner's reducer; only an action
// no placed owner exports rejects.
export async function foreignAction(): Promise<string> {
  let instances: screens.Instance[] = [owner("a",3),owner("b",4)];
  // Owner b publishes its flag and owner a reads it through an issued port connection, so the control
  // owner a binds renders the value only owner b writes.
  instances[1].fragment.ports[instances[1].fragment.ports.length] = {name:"flagOut",type:"boolean",direction:"publish",getter:"flag",optional:false};
  instances[0].fragment.ports[instances[0].fragment.ports.length] = {name:"flagIn",type:"boolean",direction:"read",getter:"flagIn",optional:false};
  instances[0].fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Text(text: \"Owner a\") ui.NumberField(label: \"Value\", value: state.value, minimum: 0, maximum: 999, step: 1, onChange: action app.Change {value: payload}) ui.Toggle(label: \"Owner a flag\", checked: state.flag, onChange: action app.Switch {value: payload}) ui.Toggle(label: \"Owner b flag\", checked: state.flagIn, onChange: action app.f_b_Switch {value: payload}) ui.Button(text: \"Load\", value: state.value, onClick: action app.Load {sequence: payload}) ui.Button(text: \"Link\", value: state.value, onClick: action app.Link {value: payload}) } }";
  instances[1].fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Text(text: \"Owner b\") ui.Button(text: \"Load b\", value: state.value, onClick: action app.Load {sequence: payload}) ui.Button(text: \"Link b\", value: state.value, onClick: action app.Link {value: payload}) ui.Button(text: \"Change b\", value: state.value, onClick: action app.Change {value: payload}) } }";
  let connection: screens.Connection = {readerInstance:"a",readerPort:"flagIn",writerInstance:"b",writerPort:"flagOut"};
  let registry: bindings.Registry = bindings.create([]);
  let composition: screens.Composition = {screen:{title:"Foreign",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:instances},bindings:{},actions:{},connections:[connection]};
  let result: composer.Result = await composer.assembleWith(composition,assemblyComputations(),registry,null);
  // The bound class is the target owner's: the emitted view names the foreign action class and that
  // action's owner reducer is still the dispatch target, so the target handler is reachable.
  insist(strings.contains(result.source.dealui,"onChange: action app.f_b_Switch {value: payload}"),"a foreign view did not bind the target owner's exported action: "+result.source.dealui);
  insist(strings.contains(result.source.deal,"export function update_f_b_Switch(state: AppState, action: f_b_Switch): AppState"),"the foreign-bound action has no emitted owner update wrapper");
  insist(strings.contains(result.source.dealui,"f_a_Panel(state: state)") && strings.contains(result.source.dealui,"f_b_Panel(state: state)"),"the placed fragments are not both emitted as the root children");
  // A name no placed owner exports, and an exported data class no owner handles, are still rejected
  // with the binding view and the action.
  let phantom: screens.Instance = owner("c",5);
  phantom.fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Button(text: \"Go\", value: 1, onClick: action app.f_zz_Switch {value: payload}) } }";
  let refused: boolean = false; let reason: string = "";
  try { await composer.assembleWith(assembly([owner("a",3),phantom],[],[],"screen"),[assemblyComputations()[0]],bindings.create([]),null); } catch (error) { refused = true; reason = (error as Error).message; }
  insist(refused && strings.contains(reason,"Undeclared view action: c.f_zz_Switch"),"a view binding an action no placed owner exports was admitted: "+reason);
  let dataClass: screens.Instance = owner("d",6);
  dataClass.fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Button(text: \"Go\", value: 1, onClick: action app.f_b_Entry {value: payload}) } }";
  refused = false; reason = "";
  try { await composer.assembleWith(assembly([owner("b",4),dataClass],[],[],"screen"),[assemblyComputations()[1]],bindings.create([]),null); } catch (error) { refused = true; reason = (error as Error).message; }
  insist(refused && strings.contains(reason,"Undeclared view action: d.f_b_Entry"),"an exported data class no owner handles was admitted as a bound action: "+reason);
  // Two owners whose issued qualified names concatenate to one spelling make that class ambiguous: the
  // binding is refused instead of reaching an owner the view did not name. Instance ids may contain an
  // underscore, so owner b_x's action y and owner b's action x_y both emit f_b_x_y.
  let first: screens.Instance = owner("b_x",3);
  first.fragment.declarations = first.fragment.declarations+" export class y { value: boolean; }";
  first.fragment.updates[first.fragment.updates.length] = {action:"y",function:"switchValue"};
  let second: screens.Instance = owner("b",4);
  second.fragment.declarations = second.fragment.declarations+" export class x_y { value: boolean; }";
  second.fragment.updates[second.fragment.updates.length] = {action:"x_y",function:"switchValue"};
  let binder: screens.Instance = owner("c",5);
  binder.fragment.view = "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Toggle(label: \"Ambiguous\", checked: state.flag, onChange: action app.f_b_x_y {value: payload}) } }";
  refused = false; reason = "";
  try { await composer.assembleWith(assembly([first,second,binder],[],[],"screen"),assemblyComputations(),bindings.create([]),null); } catch (error) { refused = true; reason = (error as Error).message; }
  insist(refused && strings.contains(reason,"Ambiguous qualified declaration name: f_b_x_y"),"an ambiguous qualified declaration name was admitted: "+reason);
  return s.encode(result);
}

// The issued numeric presentation rule at the entry-field site. A prepared row text and the NumberText
// total over the same stored value apply the one rule, so one amount is never displayed as two
// different numbers: fixed decimals round the shortest round-tripping decimal half away from zero and
// automatic decimals render it in plain notation.
export async function numericTextCase(): Promise<string> {
  let request: string = "amount 1.005 and rate 1e-7 and 90";
  let planJson: string = "{\"title\":\"Numeric text\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"solo\",\"type\":\"entries\",\"words\":\"Log one amount\",\"reads\":[],\"spec\":{\"label\":\"Fixed\",\"fields\":[{\"id\":\"amount\",\"label\":\"Amount\",\"kind\":\"number\",\"initial\":0,\"measure\":\"money\",\"decimals\":2,\"unit\":\"€\"}],\"seeds\":[{\"values\":{\"amount\":1.005}}]}},{\"id\":\"tiny\",\"type\":\"entries\",\"words\":\"Log a tiny rate\",\"reads\":[],\"spec\":{\"label\":\"Tiny\",\"fields\":[{\"id\":\"rate\",\"label\":\"Rate\",\"kind\":\"number\",\"initial\":0,\"measure\":\"number\"}],\"seeds\":[{\"values\":{\"rate\":0.0000001}}]}},{\"id\":\"stamp\",\"type\":\"entries\",\"words\":\"Log a minute of day\",\"reads\":[],\"spec\":{\"label\":\"Stamped\",\"fields\":[{\"id\":\"minute\",\"label\":\"A \\\"quoted\\\" time\\nsecond line\",\"kind\":\"time\",\"initial\":0,\"measure\":\"number\"}],\"seeds\":[{\"values\":{\"minute\":90}}]}}],\"questions\":[]}";
  let plan: plans.Plan = plans.decode(planJson,[],[],request,"");
  insist(plan.needs.length === 3,"the numeric text needs were not decoded");
  let definitions: parts.Definitions = parts.defineWithProviders(plan,[]);
  insist(definitions.unavailable.length === 0,"a numeric text need was reported unavailable: "+s.encode(definitions.unavailable));
  let registry: bindings.Registry = bindings.create([]);
  let choices: constructionSelection.Choice[] = [{need:"solo",alternative:"entries_solo",status:"selected",reason:""},{need:"tiny",alternative:"entries_tiny",status:"selected",reason:""},{need:"stamp",alternative:"entries_stamp",status:"selected",reason:""}];
  let built: parts.Built = parts.buildWithProviders(plan,definitions,choices,registry,null,clockConfig());
  let composition: screens.Composition = {screen:screens.reserve(plan,"screen"),bindings:{},actions:{},connections:[]};
  composition.screen.instances[0] = built.instance;
  for (let slot of composition.screen.slots) { if (slot.need === "solo" || slot.need === "tiny" || slot.need === "stamp") { slot.allowedKinds = ["entries"]; } }
  let result: composer.Result = await composer.assembleWith(composition,built.computations,registry,null);
  // One emitted formatter implements the rule; the seeded row is its projection and the total is the
  // same stored value with the same issued decimals.
  insist(strings.contains(result.source.deal,"f_parts_decimalText(") && strings.contains(result.source.deal,"f_parts_numberText("),"the emitted pair carries no shared numeric presentation formatter");
  insist(strings.contains(result.source.deal,"rowOf_solo(") && strings.contains(result.source.deal,"rowOf_tiny(") && strings.contains(result.source.deal,"rowOf_stamp("),"a seeded row is not projected by the issued row projection");
  // A time field prepares a plain integral row and no fixed-count formatter, and a field label that
  // carries a quote and a newline is escaped into the emitted row literal.
  insist(!strings.contains(result.source.deal,"f_parts_fixedText_stamp("),"a time-only entries part emitted a fixed-count row formatter");
  insist(strings.contains(result.source.deal,"f_parts_fixedText_solo("),"the number-field part lost its fixed-count row formatter");
  insist(strings.contains(result.source.deal,"f_parts_numberText(record.values.minute)"),"a time row does not project its stored value through the plain formatter");
  insist(strings.contains(result.source.deal,"\"A \\\"quoted\\\" time\\nsecond line: \""),"a field label was not escaped into the emitted row projection");
  return s.encode(result);
}
