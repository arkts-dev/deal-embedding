  let result: composer.Result = await composer.assembleWith(composition,built.computations,registry,null);
  insist(strings.contains(result.source.deal,"f_section_progress_summary"),"the resolved reader was not emitted");
  // A connection naming a port no publisher declares still rejects instead of emitting a dangling read.
  let broken: boolean = false;
  try { catalogue.computations(reader,[{readerInstance:"section_progress",readerPort:"absent",writerInstance:"parts",writerPort:"absent"}],[built.instance]); }
  catch (errorUnknown) { let error: Error = errorUnknown as Error; broken = strings.contains(error.message,"unissued publisher port"); }
  insist(broken,"a reader dependency naming no declared publisher port was admitted");
  // Reader resolution asks the publisher's issued publication source: with no issued source on the
  // registry the connection rejects instead of recording a read of nothing.
