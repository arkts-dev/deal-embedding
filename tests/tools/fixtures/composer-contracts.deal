  let emptyRegistry: bindings.Registry = bindings.create([]);
  try { construction.connect(composition,reader,emptyRegistry,plan); }
  catch (errorUnknown) { let error: Error = errorUnknown as Error; unresolved = strings.contains(error.message,"Unissued argument source"); }
  insist(unresolved,"a reader connected through a source no issuer reserved");
  // A reader whose need reads none of a publisher's needs is not connected to it, so it stays
  // unconnected rather than reading a publication the request did not ask for.
  let narrow: plans.Plan = plans.decode("{\"title\":\"Summary\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"done\",\"type\":\"entries\",\"words\":\"Log\",\"reads\":[],\"quote\":\"log\",\"spec\":{\"label\":\"Log\",\"fields\":[]}},{\"id\":\"progress\",\"type\":\"content\",\"words\":\"Progress\",\"reads\":[],\"spec\":{}}],\"questions\":[]}",[],[],"log","");
  let narrowComposition: screens.Composition = {screen:{title:"Summary",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[built.instance]},bindings:{},actions:{},connections:[]};
  let narrowFailure: string = construction.connect(narrowComposition,reader,registry,narrow); insist(narrowFailure === "Reader port is not a requested dependency: done","a reader obtained a publication its need did not read: "+narrowFailure);
  return null;
}
// An asynchronous consequence must resolve to an exported update handler of the same owner.
function effectOwner(missing: boolean): screens.Instance {
  let updates: screens.Handler[] = [{action:"Start",function:"start"}];
  if (!missing) { updates[updates.length] = {action:"Done",function:"done"}; }
  let fragment: screens.Fragment = {declarations:"export class Start { value: number; } export class Done { value: number; }",fields:[{name:"value",type:"number",role:"authoritative",dependencies:[],initial:"0",owner:"worker"}],updates:updates,effects:[{action:"Start",function:"perform"}],helpers:"export function start(state: AppState, action: Start): AppState { return {value: action.value}; } export function done(state: AppState, action: Done): AppState { return {value: action.value}; } export async function perform(state: AppState, action: Start): Promise<Done> { return {value: state.value+1}; }",view:"import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Button(text: \"Go\", value: state.value, onClick: action app.Start {value: payload}) } }",options:[],content:[],ports:[],holes:[],covers:[],owns:["worker"]};
  let instance: screens.Instance = {id:"worker",kind:"custom",origin:"custom",parameters:{},fragment:fragment,bodies:{}};
  instance.definition = screens.issueDefinition(fragment);
  return instance;
}
export async function effectCompletion(): Promise<null> {
  let accepted: composer.Result = await composer.assembleWith({screen:{title:"Effect",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[effectOwner(false)]},bindings:{},actions:{},connections:[]},[],bindings.create([]),null);
  insist(strings.contains(accepted.source.deal,"export async function effect_f_worker_Start"),"an effect with a declared completion emitted no effect wrapper");
  let refused: boolean = false;
  try { await composer.assembleWith({screen:{title:"Effect",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[effectOwner(true)]},bindings:{},actions:{},connections:[]},[],bindings.create([]),null); } catch (error) { refused = true; }
