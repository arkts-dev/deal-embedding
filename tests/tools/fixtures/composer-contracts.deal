// A fragment that disagrees with the definition its instance was issued from is a replacement and
// rejects before emission; the matching fragment is admitted.
function noteFragment(initial: string): screens.Fragment {
  return {declarations:"",fields:[{name:"text",type:"string",role:"authoritative",dependencies:[],initial:initial,owner:"memo"}],updates:[],effects:[],helpers:"",view:"import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View { ui.Column() { ui.Text(text: state.text) } }",options:[],content:[],ports:[],holes:[],covers:[],owns:[]};
}
function noteComposition(initial: string, withDefinition: boolean): string {
  let instance: screens.Instance = {id:"memo",kind:"note",origin:"catalogue",parameters:{},fragment:noteFragment(initial),bodies:{}};
  if (withDefinition) { instance.definition = screens.issueDefinition(noteFragment("\"\"")); }
  // A stack layout omits positions, so the wire JSON is assembled around the encoded instance.
  return "{\"screen\":{\"title\":\"Note\",\"target\":\"screen\",\"layout\":{\"kind\":\"stack\"},\"slots\":[],\"instances\":["+s.encode(instance)+"]},\"bindings\":{},\"actions\":{},\"connections\":[]}";
}
export async function definitionConflict(): Promise<null> {
  let admitted: screens.Projection = screens.decode(noteComposition("\"\"",true),"screen",[]);
  insist(admitted.composition.screen.instances.length === 1,"a matching issued definition was rejected");
  let refused: boolean = false;
  try { screens.decode(noteComposition("\"Replaced\"",true),"screen",[]); } catch (error) { refused = true; }
  insist(refused,"a fragment conflicting with its issued default was admitted");
  refused = false;
  try { screens.decode(noteComposition("\"\"",false),"screen",[]); } catch (error) { refused = true; }
  insist(refused,"a catalogue instance without its issued definition was admitted");
