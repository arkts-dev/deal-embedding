  let checked: plans.Plan = plans.decode("{\"title\":\"t\",\"inputs\":[{\"id\":\"note\",\"label\":\"Note\",\"kind\":\"text\",\"measure\":\"number\",\"value\":\"hello\"},{\"id\":\"flag\",\"label\":\"Flag\",\"kind\":\"toggle\",\"measure\":\"number\",\"value\":true},{\"id\":\"items\",\"label\":\"Items\",\"kind\":\"count\",\"measure\":\"count\",\"value\":2,\"min\":0,\"max\":9},{\"id\":\"pick\",\"label\":\"Pick\",\"kind\":\"choice\",\"measure\":\"number\",\"value\":1,\"options\":[{\"id\":\"a\",\"label\":\"A\",\"value\":1},{\"id\":\"b\",\"label\":\"B\",\"value\":2}]},{\"id\":\"mins\",\"label\":\"Minutes\",\"kind\":\"amount\",\"measure\":\"minutes\",\"value\":5}],\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[]}",[],[],"","");
