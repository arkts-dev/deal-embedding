  insist(s.records(plans.decode(seedPlan("{\"values\":{},\"timestamp\":1700000000000}"),[],[],fielded,partialTimestamp).needs[0].spec,"seeds").length === 1,"A timestamp-only seed with typed millisecond evidence was rejected");
