  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[{\"id\":\"keep\",\"text\":\"Keep\",\"sources\":[\"request\"]}],\"needs\":[],\"questions\":[]}","","","Missing field: needs");
  // A human question's options are declared without an omission default too.
  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[{\"id\":\"q\",\"text\":\"Pick\",\"default\":\"a\"}]}","","","question q: Missing field: options");
  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[{\"id\":\"q\",\"text\":\"Pick\",\"options\":null,\"default\":\"a\"}]}","","","question q: options must be an array of options");
