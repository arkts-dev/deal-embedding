  refusesPlan("{\"title\":\"x\",\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[]}","","","Missing field: inputs");
  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"requirements\":[],\"needs\":[],\"questions\":[]}","","","Missing field: constants");
  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"needs\":[],\"questions\":[]}","","","Missing field: requirements");
  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"questions\":[]}","","","Missing field: needs");
  refusesPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[]}","","","Missing field: questions");
