  let overflow: string = ""; try { plans.milliseconds(seconds,1e308,"cook"); } catch(errorUnknown) { overflow = (errorUnknown as Error).message; } insist(strings.contains(overflow,"duration conversion overflowed"),"Duration overflow converted: "+overflow);
