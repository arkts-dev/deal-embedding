  // evidence, and neither is a key that merely looks temporal or a bare JSON number.
  refusesPlan(emptyEntriesPlan("{\"values\":{},\"timestamp\":1700000000000}"),request,"{\"facts\":[{\"id\":\"budget\",\"text\":\"Budget\",\"amount\":1700000000000}]}","log: seed 0 timestamp 1700000000000 is not disclosed");
  refusesPlan(emptyEntriesPlan("{\"values\":{},\"timestamp\":1700000000000}"),request,"{\"facts\":[{\"id\":\"at\",\"text\":\"at\",\"millis\":1700000000000}]}","log: seed 0 timestamp 1700000000000 is not disclosed");
  refusesPlan(emptyEntriesPlan("{\"values\":{},\"timestamp\":1700000000000}"),request,"{\"at\":1700000000000}","log: seed 0 timestamp 1700000000000 is not disclosed");
  refusesPlan(emptyEntriesPlan("{\"values\":{},\"timestamp\":1700000000000}"),request,"{\"facts\":[{\"id\":\"at\",\"text\":\"at 1700000000000\",\"type\":\"amount\",\"value\":1700000000000}]}","log: seed 0 timestamp 1700000000000 is not disclosed");
  // Action.at resolves the trigger target kind; a button omits it.
  let triggerPlan: string = "{\"title\":\"t\",\"constants\":[],\"requirements\":[],\"questions\":[],\"inputs\":[{\"id\":\"timer\",\"label\":\"Timer\",\"kind\":\"amount\",\"measure\":\"seconds\",\"value\":60},{\"id\":\"spend\",\"label\":\"Spend\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":5},{\"id\":\"at\",\"label\":\"At\",\"kind\":\"time\",\"measure\":\"minutes\",\"value\":600}],\"needs\":[%NEEDS%]}";
  let countdownNeed: string = "{\"id\":\"cook\",\"type\":\"countdown\",\"words\":\"Cook\",\"reads\":[\"timer\"],\"spec\":{\"label\":\"Cook\",\"length\":\"timer\"}}";
  let logNeed: string = "{\"id\":\"log\",\"type\":\"entries\",\"words\":\"Log\",\"reads\":[],\"spec\":{\"label\":\"Log\",\"fields\":[]}}";
  let clockAction: string = "{\"id\":\"done\",\"type\":\"action\",\"words\":\"Done\",\"reads\":[],\"spec\":{\"on\":\"countdown_end\",\"at\":\"cook\",\"operation\":\"log completion\"}}";
  plans.decode(strings.replace(triggerPlan,"%NEEDS%",countdownNeed+","+clockAction),[],[],"","");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%",logNeed+",{\"id\":\"done\",\"type\":\"action\",\"words\":\"Done\",\"reads\":[],\"spec\":{\"on\":\"countdown_end\",\"at\":\"log\",\"operation\":\"log completion\"}}"),"","","done: countdown_end target is not a countdown");
  plans.decode(strings.replace(triggerPlan,"%NEEDS%",logNeed+",{\"id\":\"added\",\"type\":\"action\",\"words\":\"Added\",\"reads\":[],\"spec\":{\"on\":\"entry_added\",\"at\":\"log\",\"operation\":\"refresh\"}}"),[],[],"","");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%",countdownNeed+",{\"id\":\"added\",\"type\":\"action\",\"words\":\"Added\",\"reads\":[],\"spec\":{\"on\":\"entry_added\",\"at\":\"cook\",\"operation\":\"refresh\"}}"),"","","added: entry_added target is not an entries need");
  plans.decode(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"tick\",\"type\":\"action\",\"words\":\"Tick\",\"reads\":[],\"spec\":{\"on\":\"time\",\"at\":\"at\",\"operation\":\"refresh\"}}"),[],[],"","");
  // A duration is not a time of day: a seconds measured input cannot raise a scheduled trigger.
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"tick\",\"type\":\"action\",\"words\":\"Tick\",\"reads\":[],\"spec\":{\"on\":\"time\",\"at\":\"timer\",\"operation\":\"refresh\"}}"),"","","tick: time target is not a time source");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"tick\",\"type\":\"action\",\"words\":\"Tick\",\"reads\":[],\"spec\":{\"on\":\"time\",\"at\":\"spend\",\"operation\":\"refresh\"}}"),"","","tick: time target is not a time source");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"tick\",\"type\":\"action\",\"words\":\"Tick\",\"reads\":[],\"spec\":{\"on\":\"time\",\"at\":\"missing\",\"operation\":\"refresh\"}}"),"","","tick: unissued trigger target missing");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"tap\",\"type\":\"action\",\"words\":\"Tap\",\"reads\":[],\"spec\":{\"on\":\"button\",\"at\":\"timer\",\"operation\":\"refresh\"}}"),"","","a button action omits its trigger source");
  // A duration bearing publication is not a time of day, so it cannot raise a scheduled trigger; a
  // row_tap trigger names a list need.
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"watch\",\"type\":\"live\",\"words\":\"Watch\",\"reads\":[],\"spec\":{\"label\":\"Watch\",\"measure\":\"seconds\",\"unit\":\"s\",\"query\":\"elapsed\"}},{\"id\":\"tick\",\"type\":\"action\",\"words\":\"Tick\",\"reads\":[],\"spec\":{\"on\":\"time\",\"at\":\"watch\",\"operation\":\"refresh\"}}"),"","","tick: time target is not a time source");
  plans.decode(strings.replace(triggerPlan,"%NEEDS%",logNeed+",{\"id\":\"tap\",\"type\":\"action\",\"words\":\"Tap\",\"reads\":[],\"spec\":{\"on\":\"row_tap\",\"at\":\"log\",\"operation\":\"remove\"}},{\"id\":\"custom\",\"type\":\"action\",\"words\":\"Custom\",\"reads\":[],\"spec\":{\"on\":\"other\",\"at\":\"log\",\"operation\":\"custom\"}}"),[],[],"","");
  // An `other` action stays open for custom writing: its `at` is the written declaration of the custom
  // action, so prose there is accepted as data and issues no trigger slot. A non-string target is
  // still a located rejection of the field that carries it.
  let customPlan: string = strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"custom\",\"type\":\"action\",\"words\":\"Custom\",\"reads\":[],\"spec\":{\"on\":\"other\",\"at\":\"after the timer ends\",\"operation\":\"custom\"}}");
  let custom: plans.Plan = plans.decode(customPlan,[],[],"","");
  insist(s.text(custom.needs[0].spec.at) === "after the timer ends","an other action lost its written target");
  insist(!Object.hasOwn(custom.needs[0],"trigger"),"an other action issued a trigger slot");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%","{\"id\":\"custom\",\"type\":\"action\",\"words\":\"Custom\",\"reads\":[],\"spec\":{\"on\":\"other\",\"at\":7,\"operation\":\"custom\"}}"),"","","custom.at");
  refusesPlan(strings.replace(triggerPlan,"%NEEDS%",countdownNeed+",{\"id\":\"tap\",\"type\":\"action\",\"words\":\"Tap\",\"reads\":[],\"spec\":{\"on\":\"row_tap\",\"at\":\"cook\",\"operation\":\"remove\"}}"),"","","tap: row_tap target is not a list need");
  // The alternative bound and the written formula bound are different bounds.
  let bounded: formula.Enumeration = formula.enumerate(operandIds(6),aggregateIds(62));
  insist(!bounded.overCap && bounded.count === 255 && bounded.alternatives.length === 255,"A 255 alternative set was not enumerated");
  insist(bounded.alternatives[0].size === 1 && bounded.alternatives[0].source === "count_0","Unavailable option is not the smallest alternative");
  let orderedOk: boolean = true; let previous: formula.Alternative = bounded.alternatives[0]; let position: number = 1;
  while (position < bounded.alternatives.length) { let current: formula.Alternative = bounded.alternatives[position]; if (current.size < previous.size) { orderedOk = false; } if (current.size === previous.size && current.source < previous.source) { orderedOk = false; } previous = current; position = position+1; }
  insist(orderedOk,"Alternative enumeration is not ordered by AST size then lexical source");
  let overCap: formula.Enumeration = formula.enumerate(operandIds(6),aggregateIds(63));
  insist(overCap.overCap && overCap.count === 256 && overCap.alternatives.length === 0,"A 256 alternative set was enumerated or truncated");
  // Only compatible alternatives are counted: a boolean operand has no numeric unary or binary form.
  let mixed: formula.Operand[] = operandIds(6);
  mixed[mixed.length] = {id:"flag",expression:"(state.flag as boolean)",type:"boolean",dependency:"f_parts_flag"};
  let filtered: formula.Enumeration = formula.enumerate(mixed,aggregateIds(62));
  insist(!filtered.overCap && filtered.count === 255,"A boolean operand entered the numeric alternative set");
  // A written formula over its own 300 code unit bound rejects; the source otherwise parses.
  let overBound: string = "1"; while (strings.length(overBound) < 301) { overBound = overBound+"+1"; }
  let rejected: string = ""; try { formula.compile(overBound,[]); } catch (errorUnknown) { let error: Error = errorUnknown as Error; rejected = error.message; }
  insist(strings.contains(rejected,"Formula length"),"A written formula over 300 code units admitted: "+rejected);
  return null;
}
// A dynamic array that carries a hole leaves the invariant element type, so the checked decoders refuse
// it instead of converting the hole into an undefined element. A hole is not expressible in DEAL source
// (an out-of-bounds assignment is itself refused), so the driving test hands the decoders a sparse array.
export function textCollectionRefuses(value: unknown): boolean { try { decoded.strings(value); return false; } catch (error) { return true; } }
export function recordCollectionRefuses(value: unknown): boolean { try { decoded.records(value); return false; } catch (error) { return true; } }
export function main(): void { return; }
// ---- The permitted import surface and effect-only private storage -------------------------
export function admissionSurface(): null {
  let providers: string[] = ["host/probe"];
  // The permitted surface is one policy: checked standard modules, the nominal graphics
  // declarations, the per-Experience store and each disclosed provider module.
  insist(admission.modules(["std/math","std/string","std/table","std/time","embedding/graphics","host/storage","host/probe"],providers).code === "","A permitted import was rejected");
  // Every excluded class is located by its module, never by a generic message.
  insist(admission.modules(["std/console"],providers).message === "ADMISSION_IMPORT: std/console","The administration console module was admitted");
  insist(admission.modules(["test/checker"],providers).message === "ADMISSION_IMPORT: test/checker","A test module was admitted");
  insist(admission.modules(["host/admin-console"],providers).message === "ADMISSION_IMPORT: host/admin-console","An administrative mechanism module was admitted");
  insist(admission.modules(["./helper"],providers).message === "ADMISSION_IMPORT: ./helper","An unissued relative path was admitted");
  // Storage is permitted from a registered effect and from a helper that only the effect reaches; it
  // is rejected from a reducer, from a reducer that enters a store-using helper, and from a store use
  // performed or captured inside a function.
  let reducer: Record<string, unknown> = JSON.parse("{\"change\":{\"calls\":[\"storage.save\"],\"reads\":[],\"indirect\":false}}");
  insist(admission.stores(reducer,[],[],["storage"]).message === "ADMISSION_STORE: change calls storage.save","Reducer storage verdict: "+s.encode(admission.stores(reducer,[],[],["storage"])));
  let helper: Record<string, unknown> = JSON.parse("{\"summarize\":{\"calls\":[\"storage.remove\"],\"reads\":[],\"indirect\":false},\"persist\":{\"calls\":[\"summarize\"],\"reads\":[],\"indirect\":true}}");
  insist(admission.stores(helper,[],[],["storage"]).message === "ADMISSION_STORE: summarize calls storage.remove","Recomputation helper storage verdict: "+s.encode(admission.stores(helper,[],[],["storage"])));
  // A reducer that enters a store-using function is refused as a position, not only as a direct call.
  let entered: Record<string, unknown> = JSON.parse("{\"change\":{\"calls\":[\"persist\"],\"reads\":[],\"indirect\":false},\"persist\":{\"calls\":[\"storage.save\"],\"reads\":[],\"indirect\":true}}");
  insist(admission.stores(entered,[],[],["storage"]).message === "ADMISSION_STORE: change calls persist","Entered store chain verdict: "+s.encode(admission.stores(entered,[],[],["storage"])));
  let captured: Record<string, unknown> = JSON.parse("{\"change\":{\"calls\":[\"save\"],\"reads\":[\"storage.save\"],\"indirect\":false}}");
  insist(admission.stores(captured,[],[],["storage"]).message === "ADMISSION_STORE: change calls storage.save","Captured store verdict: "+s.encode(admission.stores(captured,[],[],["storage"])));
  let effect: Record<string, unknown> = JSON.parse("{\"persist\":{\"calls\":[\"storage.save\"],\"reads\":[],\"indirect\":true},\"saveThrough\":{\"calls\":[\"storage.save\"],\"reads\":[],\"indirect\":false}}");
  // A registered reducer that an effect also calls stays a reducer position.
  let shared: Record<string, unknown> = JSON.parse("{\"persist\":{\"calls\":[\"change\"],\"reads\":[],\"indirect\":true},\"change\":{\"calls\":[\"storage.save\"],\"reads\":[],\"indirect\":false}}");
  insist(admission.stores(shared,["persist"],["change"],["storage"]).message === "ADMISSION_STORE: change calls storage.save","Shared reducer position verdict: "+s.encode(admission.stores(shared,["persist"],["change"],["storage"])));

  insist(admission.stores(effect,["persist","saveThrough"],[],["storage"]).code === "","An effect storage call was rejected");
  let reached: Record<string, unknown> = JSON.parse("{\"persist\":{\"calls\":[\"write\"],\"reads\":[],\"indirect\":true},\"write\":{\"calls\":[\"storage.save\"],\"reads\":[],\"indirect\":false}}");
  insist(admission.stores(reached,["persist"],[],["storage"]).code === "","A storage call reached from an effect was rejected");
  // A fragment that imports no store has no position to check.
  insist(admission.stores(reducer,[],[],[]).code === "","An absent store alias rejected a call");
  // Both verdicts are authority decisions, not source feedback, so neither authorizes repair.
  insist(!checking.repairable("ADMISSION_IMPORT: std/console") && !checking.repairable("ADMISSION_STORE: change calls storage.save"),"An admission verdict authorized repair");
  return null;
}
// The policy at its production input: compiler-parsed facts of an authored fragment.
export async function admissionFragments(): Promise<null> {
  let store: admission.Verdict = await admission.instance(fragment("import * as storage from \"host/storage\"; export class Change { value: number; }","export function change(state: AppState, action: Change): AppState { storage.save(\"k\", \"v\"); return {value: action.value}; }",[],[]),[]);
  insist(store.message === "ADMISSION_STORE: change calls storage.save","Reducer storage verdict: "+store.message);
  // A call through a captured store function is still a store use in a reducer position.
  let captured: admission.Verdict = await admission.instance(fragment("import * as storage from \"host/storage\"; export class Change { value: number; }","export function change(state: AppState, action: Change): AppState { let save = storage.save; save(\"k\", \"v\"); return {value: action.value}; }",[],[]),[]);
  insist(captured.message === "ADMISSION_STORE: change calls storage.save","Captured store verdict: "+captured.message);
  // A store call inside a closure is attributed to the function that owns the closure.
  let closure: admission.Verdict = await admission.instance(fragment("import * as storage from \"host/storage\"; export class Change { value: number; }","export function change(state: AppState, action: Change): AppState { let items: number[] = [1]; items.forEach((item: number): void => { storage.save(\"k\", \"v\"); }); return {value: action.value}; }",[],[]),[]);
  insist(closure.message === "ADMISSION_STORE: change calls storage.save","Closure store verdict: "+closure.message);
  // An initializer that seeds authoritative state from the store rejects before the call could run.
  let seeded: admission.Verdict = await admission.instance(fragment("import * as storage from \"host/storage\";","export function change(state: AppState): AppState { return state; }",[{name:"value",type:"string",role:"authoritative",dependencies:[],initial:"storage.load(\"k\")",owner:"gap"}],[]),[]);
  insist(seeded.message === "ADMISSION_STORE: value initializer uses storage.load","Initializer storage verdict: "+seeded.message);
  // A registered effect that calls the store is the permitted position, and a normal initializer
  // stays admitted while the fragment imports the store for that effect.
  let effect: screens.Handler = {action:"Save",function:"persist"};
  let allowed: admission.Verdict = await admission.instance(fragment("import * as storage from \"host/storage\"; export class Save { value: string; } export class Saved { value: string; }","export async function persist(state: AppState, action: Save): Promise<Saved> { let value: string = await storage.save(\"k\", \"v\"); return {value: value}; }",[{name:"value",type:"string",role:"authoritative",dependencies:[],initial:"\"draft\"",owner:"gap"}],[effect]),[]);
  insist(allowed.code === "","An effect-position store call was rejected: "+allowed.message);
  // A disclosed provider module and the checked standard modules are inside the surface.
  let permittedFragment: admission.Verdict = await admission.instance(fragment("import * as tables from \"std/table\"; import * as probe from \"host/probe\"; export class Change { value: number; }","export function change(state: AppState, action: Change): AppState { return {value: action.value}; }",[],[]),["host/probe"]);
  insist(permittedFragment.code === "","A permitted import was rejected: "+permittedFragment.message);
  let excluded: admission.Verdict = await admission.instance(fragment("import * as console from \"std/console\"; export class Change { value: number; }","export function change(state: AppState, action: Change): AppState { return {value: action.value}; }",[],[]),[]);
  insist(excluded.message === "ADMISSION_IMPORT: std/console","Authored import verdict: "+excluded.message);
  return null;
}
function fragment(declarations: string, helpers: string, fields: screens.Field[], effects: screens.Handler[]): screens.Instance {
  return {id:"gap",kind:"custom",origin:"custom",parameters:{},fragment:{declarations:declarations,fields:fields,updates:[],effects:effects,helpers:helpers,view:"import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Panel(state: app.AppState): View {ui.Column(){ui.Text(text: \"draft\")}}",options:[],content:[],ports:[],holes:[],covers:[],owns:["gap"]},bodies:{}};
}
// ---- Construction classification: one ask, unusable defaults ordinary ----------------------
export async function classificationRoute(): Promise<null> {
  // The route gate only decides whether the one ask is dispatched; the ask repeats the semantic
  // eligibility rule, so a cue never classifies a request on its own.
  insist(classification.permits("Let the user draw freely on the canvas"),"Explicit free drawing was not recognized");
  insist(classification.permits("Animate the shape with motion"),"Explicit motion was not recognized");
  insist(!classification.permits("Double the edited value"),"An ordinary request was classified");
  let whole: classification.Outcome = await classification.run("Let the user draw freely on the canvas","{}","[]","screen");
  insist(whole.classification === "whole" && whole.asked && whole.reason === "One complete drawing Surface","Whole classification: "+s.encode(whole));
  let part: classification.Outcome = await classification.run("Let the user sketch a moving scene","{}","[]","screen");
  insist(part.classification === "part" && part.asked && part.reason === "One scene inside an ordinary plan","Part classification: "+s.encode(part));
  let none: classification.Outcome = await classification.run("Draw a picture of a house","{}","[]","screen");
  insist(none.classification === "none" && none.asked,"None classification");
  // Unusable model content is a normal outcome with a located reason, never an error.
  let malformed: classification.Outcome = await classification.run("Let the user draw freely","{}","[]","screen");
  insist(malformed.classification === "none" && malformed.asked && malformed.reason.includes("Unusable classification"),"Malformed classification: "+s.encode(malformed));
  let unknown: classification.Outcome = await classification.run("Let the user draw freely","{}","[]","screen");
  insist(unknown.classification === "none" && unknown.reason.includes("Unknown alternative"),"Unknown classification: "+s.encode(unknown));
  let refused: classification.Outcome = await classification.run("Let the user draw freely","{}","[]","screen");
  insist(refused.classification === "none" && refused.reason.includes("refused"),"Refused classification: "+s.encode(refused));
  let absent: classification.Outcome = await classification.run("Let the user draw freely","{}","[]","screen");
  insist(absent.classification === "none" && absent.reason.includes("no answer"),"Absent classification: "+s.encode(absent));
  // A list, calculator, chart or button-game answer is unusable even when it said whole.
  let conflict: classification.Outcome = await classification.run("Let the user draw a chart of the values","{}","[]","screen");
  insist(conflict.classification === "none" && conflict.reason.includes("list, calculator, chart or button game"),"Conflict classification: "+s.encode(conflict));
  // Operational inference failure keeps its own classification and is never a content default.
  let failed: string = "";
  try { await classification.run("Let the user draw freely","{}","[]","screen"); }
  catch (errorUnknown) { let error: Error = errorUnknown as Error; failed = error.message; }
  insist(failed.includes("Injected operational failure"),"Operational failure was disguised: "+failed);
  // Chat and card targets are never classified and never promoted.
  let chat: classification.Outcome = await classification.run("Let the user draw freely","{}","[]","chat");
  insist(chat.classification === "none" && !chat.asked && chat.reason.includes("never classified"),"Chat target was classified: "+s.encode(chat));
  let card: classification.Outcome = await classification.run("Let the user draw freely","{}","[]","card");
  insist(card.classification === "none" && !card.asked && card.reason.includes("never classified"),"Card target was classified: "+s.encode(card));
  // A request that does not permit drawing or motion dispatches nothing.
  let ordinary: classification.Outcome = await classification.run("Double the edited value","{}","[]","screen");
  insist(ordinary.classification === "none" && !ordinary.asked && ordinary.reason.includes("does not explicitly permit"),"Ordinary request dispatched classification: "+s.encode(ordinary));
  // A cue is matched as a whole word of the request: the letters of an emotion or a withdrawal never
  // permit drawing, so an ineligible request dispatches no paid classification ask.
  let emotion: classification.Outcome = await classification.run("Track my emotions and the withdrawals","{}","[]","screen");
  insist(emotion.classification === "none" && !emotion.asked,"A cue substring dispatched classification: "+s.encode(emotion));
  // A punctuation-delimited cue is still a whole word, and a word that merely contains a cue is not.
  let punctuated: classification.Outcome = await classification.run("Let them sketch, then (paint)!","{}","[]","screen");
  insist(punctuated.classification === "whole" && punctuated.asked,"A punctuation-delimited cue was not admitted: "+s.encode(punctuated));
  let paragraph: classification.Outcome = await classification.run("Let the user draw a paragraph of text","{}","[]","screen");
  insist(paragraph.classification === "whole","A word containing a conflict cue downgraded the answer: "+s.encode(paragraph));
  // An inflected list, calculator or chart behavior is the same required behavior, so the downgrade
  // still fires on the whole inflected word.
  let inflected: classification.Outcome = await classification.run("Draw a tool that calculates the totals","{}","[]","screen");
  insist(inflected.classification === "none" && inflected.reason.includes("list, calculator, chart or button game"),"An inflected calculator was admitted: "+s.encode(inflected));
  // The token boundary is ASCII: a cue attached to a non-ASCII code unit is still read as a token, so the
  // gate offers the ask and the model's own eligibility answer decides it rather than dropping it here.
  let accented: classification.Outcome = await classification.run("Édraw a house for me","{}","[]","screen");
  insist(accented.classification === "whole" && accented.asked,"A non-ASCII-adjacent cue was refused without an ask: "+s.encode(accented));
  // Part enters the plan as exactly one scene need reading every plan input, and a second part
  // classification adds none.
  let plan: plans.Plan = plans.decode("{\"title\":\"Draw\",\"constants\":[],\"requirements\":[],\"questions\":[],\"inputs\":[{\"id\":\"size\",\"label\":\"Size\",\"kind\":\"count\",\"measure\":\"count\",\"value\":3},{\"id\":\"active\",\"label\":\"Active\",\"kind\":\"toggle\",\"measure\":\"count\",\"value\":true}],\"needs\":[{\"id\":\"body\",\"type\":\"other\",\"words\":\"Draw it\",\"reads\":[],\"spec\":{}}]}",[],[],"","");
  let added: plans.Need = classification.scene(plan,"Draw freely");
  insist(added.id === "scene" && added.type === "scene" && added.quote === "Draw freely" && added.reads.join(",") === "size,active","Scene need shape: "+s.encode(added));
  insist(classification.scenes(plan).length === 1,"Scene need not exactly once");
  classification.scene(plan,"Draw freely");
  insist(classification.scenes(plan).length === 1,"Second part classification added a scene");
  let order: string[] = []; for (let need of plan.needs) { order[order.length] = need.id; }
  insist(order.join(",") === "body,scene","Scene need order: "+order.join(","));
  // A plan that already proposed a scene keeps it instead of gaining a second one.
  let proposed: plans.Plan = plans.decode("{\"title\":\"Draw\",\"constants\":[],\"requirements\":[],\"questions\":[],\"inputs\":[],\"needs\":[{\"id\":\"picture\",\"type\":\"scene\",\"words\":\"Draw it\",\"reads\":[],\"spec\":{}}]}",[],[],"","");
  let kept: plans.Need = classification.scene(proposed,"Draw freely");
  insist(kept.id === "picture" && classification.scenes(proposed).length === 1,"Proposed scene was duplicated");
  return null;
}

// Alignment is the ordered, thresholded stage over the accepted composition. Rounds, their enabled
// sets, the copied decision thresholds, once-per-kind and the normal stop are driven here through the
// production policy with issued candidate facts only: the policy never declares a kind or a threshold.
function alignPlan(needs: string): plans.Plan { return plans.decode("{\"title\":\"Align\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":"+needs+",\"questions\":[]}",[],[],"",""); }
function alignContext(): constructionSelection.Context { return {original:"Align the issued sections",facts:"{}",contracts:"",specification:""}; }
function alignCandidate(need: string, kind: string, reads: string, publishes: string): alignment.Candidate {
  return {need:need,id:"cat_"+need+"_"+kind,kind:kind,criteria:"Issued "+kind+" section for "+need,reads:decoded.strings(JSON.parse(reads)),publishes:decoded.strings(JSON.parse(publishes))};
}
function alignNeeds(): string { return "[{\"id\":\"reader\",\"type\":\"content\",\"words\":\"Show completion\",\"reads\":[],\"spec\":{}},{\"id\":\"plain\",\"type\":\"content\",\"words\":\"Toggle the items\",\"reads\":[],\"spec\":{}},{\"id\":\"source\",\"type\":\"content\",\"words\":\"List the rows\",\"reads\":[],\"spec\":{}},{\"id\":\"late\",\"type\":\"live\",\"words\":\"Read the latest value\",\"reads\":[],\"spec\":{\"label\":\"Latest\",\"measure\":\"number\",\"unit\":\"\",\"query\":\"host/probe.read\"}}]"; }
function alignCandidates(): alignment.Candidate[] {
  return [alignCandidate("reader","list_summary","[\"done:number\",\"total:number\"]","[]"),alignCandidate("reader","progress_line","[\"done:number\",\"total:number\"]","[]"),
    alignCandidate("plain","checklist","[]","[\"labels:string[]\"]"),
    alignCandidate("source","master_list","[]","[\"items:string[]\",\"selected:number\"]"),
    alignCandidate("late","detail_view","[\"items:string[]\",\"selected:number\"]","[]")];
}
export async function alignmentRounds(): Promise<null> {
  // A: round one offers the reader the accepted composition already satisfies, round two the
  // standalone kinds, and round three only the reader an instance accepted in round two enables.
  let ordered: alignment.Outcome = await alignment.run(alignContext(),alignPlan(alignNeeds()),alignCandidates(),[],["note"],["done:number","total:number"]);
  insist(!ordered.stopped,"Alignment stopped without an unanswered batch");
  insist(ordered.rounds === 3,"Expected three ordered rounds, saw "+String(ordered.rounds));
  let order: string[] = []; for (let entry of ordered.accepted) { order[order.length] = entry.need; }
  insist(order.join(",") === "reader,plain,source,late","Round order: "+order.join(","));
  // The accepted readers and standalone sections publish exactly the ports their definitions declare.
  insist(ordered.publishers === 5,"Expected five publishers, saw "+String(ordered.publishers));
  // B: an answer below the 0.5 nonlive threshold is refused, and an unanswered batch stops the stage
  // with no later round while the needs it never reached stay open with their located reason.
  let below: alignment.Outcome = await alignment.run(alignContext(),alignPlan(alignNeeds()),alignCandidates(),[],["note"],["done:number","total:number"]);
  insist(below.stopped,"An unanswered alignment batch did not stop the stage");
  insist(below.rounds === 2,"A stopped stage issued a later round: "+String(below.rounds));
  insist(below.accepted.length === 0,"A refused alignment was accepted");
  insist(alignment.reason(below,"reader") === "Alignment below the 0.5 threshold","Nonlive threshold not copied: "+alignment.reason(below,"reader"));
  insist(alignment.reason(below,"late") === "alignment stopped","Remaining need reason: "+alignment.reason(below,"late"));
  insist(below.publishers === 2,"A stopped stage changed the publishers: "+String(below.publishers));
  // C: a live need uses the live-alignment threshold, so 0.6 is below it and 0.65 exactly decides it.
  let meterPlan: plans.Plan = alignPlan("[{\"id\":\"meter\",\"type\":\"live\",\"words\":\"Read the meter\",\"reads\":[],\"spec\":{\"label\":\"Meter\",\"measure\":\"number\",\"unit\":\"\",\"query\":\"host/probe.read\"}}]");
  let meterCandidates: alignment.Candidate[] = [alignCandidate("meter","reading_status","[\"latest:number\"]","[\"count:number\"]")];
  let meter: alignment.Outcome = await alignment.run(alignContext(),meterPlan,meterCandidates,[],["note"],["latest:number"]);
  insist(meter.rounds === 1 && meter.accepted.length === 0,"A 0.6 live answer cleared the live threshold");
  insist(alignment.reason(meter,"meter") === "Alignment below the 0.65 threshold","Live threshold not copied: "+alignment.reason(meter,"meter"));
  // D: each catalogue kind is selected at most once per composition, and a candidate whose required
  // readers the composition cannot satisfy is never offered.
  let uniquePlan: plans.Plan = alignPlan("[{\"id\":\"a\",\"type\":\"content\",\"words\":\"Show the disclosed facts\",\"reads\":[],\"spec\":{}},{\"id\":\"b\",\"type\":\"content\",\"words\":\"Show the disclosed notes\",\"reads\":[],\"spec\":{}},{\"id\":\"c\",\"type\":\"content\",\"words\":\"Show the disclosed details\",\"reads\":[],\"spec\":{}}]");
  let uniqueCandidates: alignment.Candidate[] = [alignCandidate("a","metrics","[]","[]"),alignCandidate("b","metrics","[]","[]"),alignCandidate("c","detail_view","[\"items:string[]\",\"selected:number\"]","[]")];
  let unique: alignment.Outcome = await alignment.run(alignContext(),uniquePlan,uniqueCandidates,[],["note"],[]);
  insist(unique.rounds === 1,"Expected the standalone round only, saw "+String(unique.rounds));
  insist(unique.accepted.length === 1 && unique.accepted[0].need === "a","Once-per-kind kept the first answer only: "+String(unique.accepted.length));
  insist(alignment.reason(unique,"b") === "Catalogue kind already selected: metrics","Once-per-kind: "+alignment.reason(unique,"b"));
  insist(alignment.reason(unique,"c") === "No eligible alignment candidate","An unsatisfiable reader was offered: "+alignment.reason(unique,"c"));
  // E: an unanswered batch stops the stage without discarding an alignment an earlier round already
  // accepted, and the needs it never reached stay open with the stop reason.
  let stopped: alignment.Outcome = await alignment.run(alignContext(),alignPlan(alignNeeds()),alignCandidates(),[],["note"],["done:number","total:number"]);
  insist(stopped.stopped,"An unanswered batch did not stop alignment");
  insist(stopped.rounds === 2,"A stopped stage issued a later round: "+String(stopped.rounds));
  insist(stopped.accepted.length === 1 && stopped.accepted[0].need === "reader","A stop discarded an accepted alignment: "+String(stopped.accepted.length));
  insist(alignment.reason(stopped,"plain") === "alignment stopped","A need the stop never reached: "+alignment.reason(stopped,"plain"));
  // F: a scene need is never spoken about by alignment, even when a candidate is issued for it.
  let scenePlan: plans.Plan = alignPlan("[{\"id\":\"picture\",\"type\":\"scene\",\"words\":\"Draw the scene\",\"reads\":[],\"spec\":{}}]");
  let sceneOutcome: alignment.Outcome = await alignment.run(alignContext(),scenePlan,[alignCandidate("picture","spotlight","[]","[]")],[],["note"],[]);
  insist(sceneOutcome.rounds === 0,"A scene need entered an alignment batch");
  insist(sceneOutcome.open.length === 0,"A scene need was left open by alignment");
  insist(alignment.reason(sceneOutcome,"picture") === "","A scene need gained an alignment reason");
  // G: a need whose every candidate kind the composition already holds is named by the once-per-kind
  // rule rather than by an unsatisfiable reader.
  let exhaustedPlan: plans.Plan = alignPlan("[{\"id\":\"a\",\"type\":\"content\",\"words\":\"Show the disclosed facts\",\"reads\":[],\"spec\":{}},{\"id\":\"b\",\"type\":\"content\",\"words\":\"Show the disclosed notes\",\"reads\":[],\"spec\":{}}]");
  let exhaustedCandidates: alignment.Candidate[] = [alignCandidate("a","metrics","[]","[]"),alignCandidate("b","metrics","[]","[]")];
  let exhausted: alignment.Outcome = await alignment.run(alignContext(),exhaustedPlan,exhaustedCandidates,[],["note","metrics"],[]);
  insist(exhausted.rounds === 0,"An exhausted kind set dispatched a batch: "+String(exhausted.rounds));
  insist(alignment.reason(exhausted,"a") === "Every eligible catalogue kind is already selected","Exhausted kinds: "+alignment.reason(exhausted,"a"));
  // H: an open need that carries both standalone and reader candidates is asked in the standalone
  // round with the standalone kinds only; when the instance accepted there publishes the ports its
  // reader declares, the third round re-asks that need with the reader it was never offered instead of
  // closing it by its earlier answer.
  let enabledPlan: plans.Plan = alignPlan("[{\"id\":\"items\",\"type\":\"content\",\"words\":\"Toggle the items\",\"reads\":[],\"spec\":{}},{\"id\":\"summary\",\"type\":\"content\",\"words\":\"Show completion\",\"reads\":[\"items\"],\"spec\":{}}]");
  let enabledCandidates: alignment.Candidate[] = [alignCandidate("items","note","[]","[]"),alignCandidate("items","checklist","[]","[\"done:number\",\"total:number\"]"),alignCandidate("summary","note","[]","[]"),alignCandidate("summary","list_summary","[\"done:number\",\"total:number\"]","[]")];
  let enabled: alignment.Outcome = await alignment.run(alignContext(),enabledPlan,enabledCandidates,[],["metrics"],[]);
  insist(!enabled.stopped,"The reader round stopped without an unanswered batch");
  insist(enabled.rounds === 2,"Expected the standalone round and the enabled-reader round, saw "+String(enabled.rounds));
  let enabledOrder: string[] = []; for (let entry of enabled.accepted) { enabledOrder[enabledOrder.length] = entry.need+":"+entry.kind; }
  insist(enabledOrder.join(",") === "items:checklist,summary:list_summary","Re-asked need did not end on its enabled reader: "+enabledOrder.join(","));
  // The need the third round filled is closed: an earlier round's located reason is not retained beside
  // an accepted instance.
  insist(enabled.open.length === 0,"An accepted need stayed open: "+s.encode(enabled.open));
  insist(alignment.reason(enabled,"summary") === "","An accepted need kept its earlier reason: "+alignment.reason(enabled,"summary"));
  // I: a need asked in the reader round is not re-asked in the standalone round with a candidate set it
  // already answered, and the third round offers it only the reader an earlier acceptance enables, not
  // the reader the accepted composition already satisfied.
  let repeatPlan: plans.Plan = alignPlan("[{\"id\":\"counter\",\"type\":\"content\",\"words\":\"Keep the count\",\"reads\":[],\"spec\":{}},{\"id\":\"items\",\"type\":\"content\",\"words\":\"Toggle the items\",\"reads\":[],\"spec\":{}},{\"id\":\"reader\",\"type\":\"content\",\"words\":\"Read the meter\",\"reads\":[\"counter\"],\"spec\":{}}]");
  let repeatCandidates: alignment.Candidate[] = [alignCandidate("items","checklist","[]","[\"done:number\",\"total:number\"]"),alignCandidate("reader","reading_status","[\"latest:number\"]","[]"),alignCandidate("reader","metrics","[]","[]"),alignCandidate("reader","list_summary","[\"done:number\",\"total:number\"]","[]")];
  let repeat: alignment.Outcome = await alignment.run(alignContext(),repeatPlan,repeatCandidates,[],["note"],["latest:number"]);
  insist(!repeat.stopped,"The reader rounds stopped without an unanswered batch");
  insist(repeat.rounds === 3,"Expected three dispatched rounds, saw "+String(repeat.rounds));
  insist(repeat.accepted.length === 1 && repeat.accepted[0].need === "items","The standalone round accepted: "+s.encode(repeat.accepted));
  insist(alignment.reason(repeat,"reader") === "Alignment chose the unavailable option","The reader round reason: "+alignment.reason(repeat,"reader"));
  return null;
}
