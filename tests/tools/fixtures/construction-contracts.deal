  const dynamic: unknown[] = JSON.parse("[\"😀\",\"\\ud800\",\"\\u0001\",\"\\\"\",\"\\\\\",\"\\n\"]");
  const fresh: string[] = decoded.strings(dynamic); insist(fresh.join("") === typed.join(""),"Dynamic array conversion lost UTF-16 units");
  let refusedCollection: boolean = false; try { decoded.strings(JSON.parse("[1]")); } catch(error) { refusedCollection = true; } insist(refusedCollection,"Wrong element kind admitted to a typed collection");
  refusedCollection = false; try { decoded.records(JSON.parse("7")); } catch(error) { refusedCollection = true; } insist(refusedCollection,"Non-array admitted as a typed collection");
  let location: string = "";
  try { decoded.records(JSON.parse("[1]")); } catch (errorUnknown) { let error: Error = errorUnknown as Error; location = error.message; }
  insist(strings.contains(location,"record at index 0"),"Collection rejection is not located: "+location);
  const controls: string = JSON.parse(literals.quote(typed.join(""))); insist(controls === typed.join(""),"Source literal escape round-trip");
  const projection = screens.decode("{\"screen\":{\"title\":\"Test\",\"target\":\"screen\",\"layout\":{\"kind\":\"stack\"},\"slots\":[],\"instances\":[]},\"bindings\":{},\"actions\":{},\"connections\":[]}","screen",[]);
  insist(projection.composition.screen.instances.length === 0,"Contextual screen decoding");
  let badScreen: boolean = false; try { screens.decode("{\"screen\":{\"title\":\"Test\",\"target\":\"screen\",\"layout\":{\"kind\":\"stack\"},\"slots\":[],\"instances\":[],\"extra\":0},\"bindings\":{},\"actions\":{},\"connections\":[]}","screen",[]); } catch(error) { badScreen = true; } insist(badScreen,"Extra nominal screen field admitted");
  let plan: plans.Plan = plans.decode("{\"title\":\"Budget\",\"inputs\":[{\"id\":\"limit\",\"label\":\"Budget\",\"kind\":\"amount\",\"measure\":\"money\",\"value\":120}],\"constants\":[],\"requirements\":[{\"id\":\"preserve\",\"text\":\"Stay within the budget\",\"sources\":[\"request\"],\"needs\":[\"remaining\"]}],\"needs\":[{\"id\":\"remaining\",\"type\":\"figure\",\"words\":\"Remaining budget\",\"reads\":[\"limit\"],\"spec\":{\"label\":\"Remaining\",\"format\":\"money\",\"unit\":\"EUR\",\"formula\":\"limit\",\"example\":{\"inputs\":{\"limit\":120},\"result\":120}}}],\"questions\":[]}",[],[],"","");
  insist(plan.inputs.length === 1 && plan.requirements.length === 1,"Plan ledger");
  insist(!Object.hasOwn(plan.inputs[0],"min"),"Absent numeric bounds became values");
  insist((plan.needs[0].spec.shown as boolean) && (plan.needs[0].spec.decimals as number) === -1,"Declared defaults");
  rejectsPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[],\"legacy\":[]}");
  rejectsPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[],\"title\":\"y\"}");
  rejectsPlan("{\"title\":\"x\",\"inputs\":null,\"constants\":[],\"requirements\":[],\"needs\":[],\"questions\":[]}");
  rejectsPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"n\",\"type\":\"other\",\"words\":\"x\",\"reads\":[\"invented\"],\"spec\":{}}],\"questions\":[]}");
  rejectsPlan("{\"title\":\"x\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"n\",\"type\":\"other\",\"words\":\"x\",\"reads\":[\"n\"],\"spec\":{}}],\"questions\":[]}");
  // Every declared Plan array and every declared Requirement array is required: omitting one rejects
