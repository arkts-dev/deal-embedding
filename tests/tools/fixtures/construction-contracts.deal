  refusesPlan("{\"title\":\"t\",\"inputs\":[],\"constants\":[],\"requirements\":[],\"needs\":[{\"id\":\"cook\",\"type\":\"countdown\",\"words\":\"Cook\",\"reads\":[],\"spec\":{\"label\":\"Cook\",\"length\":\"timer\"}}],\"questions\":[]}","","","cook: unissued duration source timer");
