export function repairAdmission(): null {
  // Admission and authority verdicts are never repair evidence; trusted checker feedback is.
  for (const diagnostics of ["ADMISSION_IMPORT: std/console","ADMISSION_PACK: compiler pack digest mismatch","ADMISSION_PACK: compiler pack version mismatch","ADMISSION_TARGET: a compile input requires the experience's frozen target","CHECK_PROVIDER: provider access during checking"]) {
    insist(!checking.repairable(diagnostics),"Authority verdict authorized repair: "+diagnostics);
  }
  for (const diagnostics of ["CHECK_PROP: Surface.width finite","CHECK_CARD: sixth picture","CHECK_SURFACE: missing, blank or unchanged frame scene","CHECK_TREE: bad tree","{\"version\":2,\"diagnostics\":[{\"code\":\"E8001\"}]}","FIXTURE_CHECK: source repair required"]) {
    insist(checking.repairable(diagnostics),"Source feedback refused repair: "+diagnostics);
  }
  return null;
}

function insist(value: boolean, message: string): void { if (!value) { throw {name:"TEST_FAILED",message:message}; } }
function rejectsPlan(raw: string): void { let rejected: boolean = false; try { plans.decode(raw,[],[],"",""); } catch (error) { rejected = true; } insist(rejected,"Invalid plan admitted"); }
function planFailure(raw: string, original: string, facts: string): string { try { plans.decode(raw,[],[],original,facts); } catch (errorUnknown) { let error: Error = errorUnknown as Error; return error.message; } return ""; }
function refusesPlan(raw: string, original: string, facts: string, located: string): void { let message: string = planFailure(raw,original,facts); insist(message !== "","Invalid plan admitted: "+located); insist(strings.contains(message,located),"Plan rejection "+located+" missing, got: "+message); }
export function schemas(): null {
  for (const path of ["M +.5 -.5 L 1. 2.","M 001 000.5 L 1.e2 .5E+1","M -0 +0 A 01 02 0 0 1 3 4 Z"]) { graphics.path(path); }
  for (const path of ["M 1e 0","M 1e+ 0","M . 0","M 1e999 0","M 0 0 A 1 1 0 2 0 3 4"]) {
    let rejected: boolean = false; try { graphics.path(path); } catch(error) { rejected = true; } insist(rejected,"Malformed SVG number admitted: "+path);
  }
  // The checked collection decodes into a fresh invariant array and keeps every UTF-16 unit, including
