function computation(instance: string, target: string, value: string, ready: string, reason: string, dependencies: string[]): composer.Computation { return {instance:instance,field:target,value:value,ready:ready,reason:reason,dependencies:dependencies}; }
function foodState(): string[] { return ["f_food_menu","f_food_windows","f_food_pizzas","f_food_budget"]; }
function hireState(): string[] { return ["f_hire_equipment","f_hire_quotes","f_hire_hireBudget"]; }

// The issued pair with the assembly metadata the compiler and checking admission consume.
export function main(): void { return; }
export async function plan(): Promise<string> {
  let composition: screens.Composition = {screen:{title:"Constructed outcomes",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[foodInstance(),hireInstance()]},bindings:{},actions:{},connections:[]};
  let foodUnknown: string = "\"Provider records are missing, the request inputs are invalid or the option set exceeds the disclosed search bound of four 300 mm options; feasibility is unknown\"";
  let hireUnknown: string = "\"Provider records are missing or the request inputs are invalid; availability is unknown\"";
  let computations: composer.Computation[] = [];
  // The allocation is published only for a deliverable request: without a
  // meeting window the delivered cost is unknown, so the budget cannot be checked and no allocation
  // is complete. The located reason names the deadline rather than claiming the request is feasible.
  let foodUndeliverable: string = "(foodDecidable(state) ? \"No delivery window meets the required 18:30 deadline, so no allocation is deliverable on time\" : \"Provider records are missing, the request inputs are invalid or the option set exceeds the disclosed search bound of four 300 mm options; feasibility is unknown\")";
  computations[computations.length] = computation("food","allocation","foodAllocation(state)","foodDecidable(state) && foodWindowMeets(state)",foodUndeliverable,foodState());
  // A delivered total exists only for a complete feasible allocation: an infeasible request publishes no
  // cost instead of the delivery charge of an empty basket.
  computations[computations.length] = computation("food","foodCents","foodDelivered(state)","foodDecidable(state) && foodFeasible(state)","(foodDecidable(state) && foodWindowMeets(state) ? \"No feasible allocation exists, so no delivered total is available\" : (foodDecidable(state) ? \"No delivery window meets the required 18:30 deadline, so no delivered total is available\" : \"Provider records are missing, the request inputs are invalid or the option set exceeds the disclosed search bound of four 300 mm options; no delivered total is available\"))",foodState());
  computations[computations.length] = computation("food","foodFeasible","foodFeasible(state)","foodDecidable(state)",foodUnknown,foodState());
  computations[computations.length] = computation("food","foodSummary","foodSummary(state)","foodDecidable(state)",foodUnknown,foodState());
  computations[computations.length] = computation("hire","choice","hireChoice(state)","hireDecidable(state)",hireUnknown,hireState());
  // The hire total and the refundable deposit are two separate results: neither is ever the other, and
  // neither is available for a request no quote can satisfy.
  computations[computations.length] = computation("hire","hireCents","hireCents(state)","hireDecidable(state) && hireFeasible(state)","(hireDecidable(state) ? \"No usable whole-basket quote exists, so no hire total is available\" : \"Provider records are missing or the request inputs are invalid; the hire total is unknown\")",hireState());
  computations[computations.length] = computation("hire","depositCents","hireDeposit(state)","hireDecidable(state) && hireFeasible(state)","(hireDecidable(state) ? \"No usable whole-basket quote exists, so no refundable deposit is available\" : \"Provider records are missing or the request inputs are invalid; the refundable deposit is unknown\")",hireState());
  computations[computations.length] = computation("hire","hireFeasible","hireFeasible(state)","hireDecidable(state)",hireUnknown,hireState());
  computations[computations.length] = computation("hire","hireSummary","hireSummary(state)","hireDecidable(state)",hireUnknown,hireState());
  let result: composer.Result = await composer.assemble(composition,computations);
  return s.encode({source:result.source,metadata:result.metadata});
}
function rejectedSource(helper: string): screens.Instance {
  let fields: screens.Field[] = [field("menu","Record<string, unknown>[]","authoritative","[]",[],"gap"),field("notes","string","authoritative","\"\"",[],"gap"),field("probe","number","derived","null",["menu"],"gap")];
  let fragment: screens.Fragment = {declarations:"",fields:fields,updates:[],effects:[],helpers:helper,view:"import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Gap(state: app.AppState): View { ui.Column() { When(state.probe_ready) { ui.NumberText(value: state.probe_display) } } }",options:[],content:[],ports:[],holes:[],covers:[],owns:[]};
  return {id:"gap",kind:"custom",origin:"custom",parameters:{},fragment:fragment,bodies:{}};
