  results[results.length] = await rejection("export function compare(a: Record<string, unknown>, b: Record<string, unknown>): number { return 0; } export function probe(state: AppState): number { let own = state.menu.toSorted(compare); own[0] = {}; return own.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let own = state.menu.toSorted((a: Record<string, unknown>, b: Record<string, unknown>): number => { state.menu[0] = {}; return 0; }); return own.length; }","probe(state)",["f_gap_menu"]);
