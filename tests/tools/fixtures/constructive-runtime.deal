import * as composer from "./composer";
import * as screens from "./screen";
import * as s from "./construction-schema";

// Two request-specific constructive calculations over the records the disclosed providers actually
// return: a complete Food allocation of six 300 mm pizzas with at least two vegan inside a delivered
// budget, and a whole-basket Equipment comparison of a package against separate hire under shared stock
// with the refundable deposit kept apart from the hire total. Every value is read from the frozen
// provider fields - the Pizza menu's diameterMm and each delivery window's own deliveryCents, the Rental
// equipment record's attributes, its own available and its components, and each whole-basket quote reply
// held with the basket it was issued for - so a renamed label, a different delivery charge or a shorter
// cable changes the outcome.
// The base replies are the demo stores' own records. The remaining loaders are controls: a renamed 300 mm
// menu, a 305 mm menu, a five-option menu, a two-meeting-window reply, a dearer delivery reply, a late
// window set, a quote reply that reports its basket unavailable, a cheaper basket quoted with the 3 m
// cable and a two-package basket over one remaining stand are contract-level record sets the frozen
// contracts permit while today's store presents one instance of them, and a menu record without a diameter
// or a quote reply without availability stand for a restored payload, whose restore path checks only the
// declared top-level fields.
// Every result is a composer-owned derived value, so one search implementation
// is what recomputes after an edit. A prompt or a model string is not an input to it, and no ordering,
// reservation or booking call exists anywhere in this fixture.

function foodView(): string { return "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Food(state: app.AppState): View { ui.Column() { ui.NumberField(label: \"Pizzas\", value: state.pizzas, minimum: 0, maximum: 12, step: 1, onChange: action app.f_food_SetPizzas {value: payload}) ui.NumberField(label: \"Budget cents\", value: state.budget, minimum: 0, maximum: 100000, step: 100, onChange: action app.f_food_SetBudget {value: payload}) ui.Button(text: \"Load pizza menu\", value: 1, onClick: action app.f_food_LoadFood {value: payload}) ui.Button(text: \"Load twelve inch menu\", value: 1, onClick: action app.f_food_LoadInches {value: payload}) ui.Button(text: \"Clear pizza menu\", value: 1, onClick: action app.f_food_ClearFood {value: payload}) ui.Button(text: \"Load wide pizza menu\", value: 1, onClick: action app.f_food_LoadWide {value: payload}) ui.Button(text: \"Load renamed pizza menu\", value: 1, onClick: action app.f_food_LoadRenamed {value: payload}) ui.Button(text: \"Load incomplete pizza menu\", value: 1, onClick: action app.f_food_LoadIncomplete {value: payload}) ui.Button(text: \"Load late delivery windows\", value: 1, onClick: action app.f_food_LoadLate {value: payload}) ui.Button(text: \"Load dearer delivery window\", value: 1, onClick: action app.f_food_LoadDearer {value: payload}) ui.Button(text: \"Load two meeting windows\", value: 1, onClick: action app.f_food_LoadTwoWindows {value: payload}) When(state.foodSummary_ready) { ui.Text(text: state.foodSummary_display) } When(!state.foodSummary_ready) { ui.Text(text: state.foodSummary_reason, style: \"muted\") } When(state.foodCents_ready) { ui.NumberText(value: state.foodCents_display, suffix: \" cents\") } } }"; }
function hireView(): string { return "import * as app from \"./experience\"; import * as ui from \"./platform.dealui-pack\"; export view Hire(state: app.AppState): View { ui.Column() { ui.NumberField(label: \"Hire budget cents\", value: state.hireBudget, minimum: 0, maximum: 100000, step: 50, onChange: action app.f_hire_SetHireBudget {value: payload}) ui.Button(text: \"Load rental catalogue\", value: 1, onClick: action app.f_hire_LoadHire {value: payload}) ui.Button(text: \"Quote with a three metre cable\", value: 1, onClick: action app.f_hire_LoadShortCable {value: payload}) ui.Button(text: \"Quote two packages\", value: 1, onClick: action app.f_hire_LoadTwoPackages {value: payload}) ui.Button(text: \"Load an unavailable quote\", value: 1, onClick: action app.f_hire_QuoteUnavailable {value: payload}) ui.Button(text: \"Load a quote without availability\", value: 1, onClick: action app.f_hire_SparseQuote {value: payload}) ui.Button(text: \"Load exhausted stand stock\", value: 1, onClick: action app.f_hire_NoStand {value: payload}) ui.Button(text: \"Clear rental quotes\", value: 1, onClick: action app.f_hire_ClearQuotes {value: payload}) When(state.hireSummary_ready) { ui.Text(text: state.hireSummary_display) } When(!state.hireSummary_ready) { ui.Text(text: state.hireSummary_reason, style: \"muted\") } When(state.depositCents_ready) { ui.NumberText(value: state.depositCents_display, suffix: \" cents refundable deposit\") } } }"; }

// The Food search: every quantity vector of the menu in a fixed order, exactly the requested pizza count of
// 300 mm pizzas, at least two vegan, within the budget the selected delivery window's own deliveryCents
// leaves. The whole option set is enumerated, so an exhausted search is a definite "no feasible
// allocation" and never a fabricated one; a record missing a field the requirement needs is undecidable
// (unknown) rather than an exclusion.
function foodHelpers(): string { return ""
  +" export function foodDecidable(state: AppState): boolean { if (!(Math.floor(state.pizzas) === state.pizzas)) { return false; } if (state.pizzas < 0 || state.pizzas > 12) { return false; } if (state.menu.length < 1 || state.menu.length > 8) { return false; } if (state.windows.length < 1) { return false; } if (!Number.isFinite(state.budget) || state.budget < 0) { return false; } if (foodEligible(state) > 4) { return false; } let ids: string[] = []; for (let row of state.menu) { let id: unknown = row.id; let cents: unknown = row.cents; let diameter: unknown = row.diameterMm; let vegan: unknown = row.vegan; let label: unknown = row.name; if (typeof id !== \"string\") { return false; } let name: string = id; if (name === \"\") { return false; } if (typeof cents !== \"number\") { return false; } let price: number = cents; if (!Number.isFinite(price) || price < 0) { return false; } if (typeof diameter !== \"number\") { return false; } let millimetres: number = diameter; if (!Number.isFinite(millimetres) || millimetres < 1) { return false; } if (typeof vegan !== \"boolean\") { return false; } if (typeof label !== \"string\") { return false; } for (let prior of ids) { if (prior === name) { return false; } } ids[ids.length] = name; } for (let window of state.windows) { let required: unknown = window.meetsRequirement; let delivery: unknown = window.deliveryCents; let windowId: unknown = window.id; let windowFrom: unknown = window.from; let windowUntil: unknown = window.until; if (typeof required !== \"boolean\") { return false; } if (typeof windowId !== \"string\") { return false; } if (typeof windowFrom !== \"string\") { return false; } if (typeof windowUntil !== \"string\") { return false; } if (typeof delivery !== \"number\") { return false; } let charge: number = delivery; if (!Number.isFinite(charge) || charge < 0) { return false; } } return true; }"
  +" export function foodEligible(state: AppState): number { let count: number = 0; for (let row of state.menu) { let diameter: unknown = row.diameterMm; if (typeof diameter === \"number\") { let millimetres: number = diameter; if (millimetres === 300) { count = count + 1; } } } return count; }"
  +" export function foodWindow(state: AppState): Record<string, unknown> | null { let chosen: Record<string, unknown> | null = null; let best: number = -1; for (let window of state.windows) { if ((window.meetsRequirement as boolean) === true) { let charge: number = window.deliveryCents as number; if (chosen === null || charge < best) { chosen = window; best = charge; } } } return chosen; }"
  +" export function foodWindowMeets(state: AppState): boolean { let window: Record<string, unknown> | null = foodWindow(state); return window !== null; }"
  +" export function foodDelivery(state: AppState): number { let window: Record<string, unknown> | null = foodWindow(state); if (window === null) { return 0; } return window.deliveryCents as number; }"
  +" export function foodAllocation(state: AppState): string[] { let delivery: number = foodDelivery(state); let size: number = state.menu.length; let digits: number[] = []; let cursor: number = 0; while (cursor < size) { digits[cursor] = 0; cursor = cursor + 1; } let best: string[] = []; let found: boolean = false; let done: boolean = false; while (!done) { let count: number = 0; let vegan: number = 0; let food: number = 0; let index: number = 0; while (index < size) { let row: Record<string, unknown> = state.menu[index] as Record<string, unknown>; let quantity: number = digits[index]; if (!((row.diameterMm as number) === 300)) { quantity = 0; } let cents: number = row.cents as number; let isVegan: boolean = row.vegan as boolean; count = count + quantity; food = food + cents * quantity; if (isVegan) { vegan = vegan + quantity; } index = index + 1; } if (!found) { if (count === state.pizzas) { if (vegan >= 2) { if ((food + delivery) <= state.budget) { found = true; let chosen: string[] = []; let place: number = 0; while (place < size) { let picked: Record<string, unknown> = state.menu[place] as Record<string, unknown>; let copies: number = digits[place]; let copy: number = 0; while (copy < copies) { chosen[chosen.length] = picked.id as string; copy = copy + 1; } place = place + 1; } best = chosen; } } } } let position: number = 0; done = true; while (position < size) { let row: Record<string, unknown> = state.menu[position] as Record<string, unknown>; let limit: number = 0; if ((row.diameterMm as number) === 300) { limit = state.pizzas; } if (digits[position] < limit) { digits[position] = digits[position] + 1; done = false; position = size; } else { digits[position] = 0; position = position + 1; } } } return best; }"
  +" export function foodFeasible(state: AppState): boolean { let allocation: string[] = foodAllocation(state); if (!(allocation.length === state.pizzas)) { return false; } if (!(state.pizzas >= 2)) { return false; } if (!(foodVeganCount(state) >= 2)) { return false; } return foodWindowMeets(state); }"
  +" export function foodDelivered(state: AppState): number { let allocation: string[] = foodAllocation(state); let cents: number = foodDelivery(state); for (let id of allocation) { let counted: boolean = false; for (let row of state.menu) { if (!counted) { if ((row.id as string) === id) { cents = cents + (row.cents as number); counted = true; } } } } return cents; }"
  +" export function foodVeganCount(state: AppState): number { let allocation: string[] = foodAllocation(state); let vegan: number = 0; for (let id of allocation) { let counted: boolean = false; for (let row of state.menu) { if (!counted) { if ((row.id as string) === id) { counted = true; if (row.vegan as boolean) { vegan = vegan + 1; } } } } } return vegan; }"
  +" export function foodSummary(state: AppState): string { let allocation: string[] = foodAllocation(state); let count: number = allocation.length; if (foodEligible(state) === 0) { return \"No 300 mm pizza is disclosed, so no allocation can satisfy the request\"; } if (!(state.pizzas >= 2)) { return \"At least two vegan pizzas need at least two pizzas, so no allocation of \"+String(state.pizzas)+\" pizzas can satisfy the request\"; } if (count === state.pizzas) { let window: Record<string, unknown> | null = foodWindow(state); if (window === null) { return \"No delivery window meets the required 18:30 deadline, so no allocation is deliverable on time\"; } let names: string = \"\"; for (let id of allocation) { for (let row of state.menu) { if ((row.id as string) === id) { names = names + (row.name as string) + \"; \"; } } } return \"Complete allocation of \"+String(count)+\" pizzas, \"+String(foodVeganCount(state))+\" vegan, \"+String(foodDelivered(state))+\" cents delivered in window \"+(window.id as string)+\" \"+(window.from as string)+\"-\"+(window.until as string)+\", required by 18:30: \"+names; } return \"No feasible allocation of \"+String(state.pizzas)+\" pizzas, at least 2 vegan, within \"+String(state.budget)+\" cents delivered\"; }"
  +" export function setPizzas(state: AppState, action: SetPizzas): AppState { return {pizzas: action.value}; }"
  +" export function setBudget(state: AppState, action: SetBudget): AppState { return {budget: action.value}; }"
  +" export function loadFood(state: AppState, action: LoadFood): AppState { return {menu: foodMenu(), windows: foodWindows()}; }"
  +" export function loadInches(state: AppState, action: LoadInches): AppState { return {menu: inchMenu(), windows: foodWindows()}; }"
  +" export function clearFood(state: AppState, action: ClearFood): AppState { return {menu: [], windows: []}; }"
  +" export function loadLate(state: AppState, action: LoadLate): AppState { return {windows: lateWindows(), menu: state.menu}; }"
  +" export function loadWide(state: AppState, action: LoadWide): AppState { return {menu: wideMenu(), windows: foodWindows()}; }"
  +" export function loadIncomplete(state: AppState, action: LoadIncomplete): AppState { return {menu: incompleteMenu(), windows: foodWindows()}; }"
  +" export function loadRenamed(state: AppState, action: LoadRenamed): AppState { return {menu: renamedMenu(), windows: foodWindows()}; }"
  +" export function loadDearer(state: AppState, action: LoadDearer): AppState { return {windows: dearWindows(), menu: state.menu}; }"
  +" export function loadTwoWindows(state: AppState, action: LoadTwoWindows): AppState { return {windows: twoWindows(), menu: state.menu}; }"
  +" export function wideMenu(): Record<string, unknown>[] { return [{id: \"a\", name: \"A\", size: \"30 cm\", diameterMm: 300, cents: 1000, vegan: true, vegetarian: true, ingredients: \"\", allergens: \"\"}, {id: \"b\", name: \"B\", size: \"30 cm\", diameterMm: 300, cents: 1100, vegan: false, vegetarian: true, ingredients: \"\", allergens: \"\"}, {id: \"c\", name: \"C\", size: \"30 cm\", diameterMm: 300, cents: 1200, vegan: true, vegetarian: true, ingredients: \"\", allergens: \"\"}, {id: \"d\", name: \"D\", size: \"30 cm\", diameterMm: 300, cents: 1300, vegan: false, vegetarian: true, ingredients: \"\", allergens: \"\"}, {id: \"e\", name: \"E\", size: \"30 cm\", diameterMm: 300, cents: 1400, vegan: false, vegetarian: true, ingredients: \"\", allergens: \"\"}]; }"
  +" export function foodMenu(): Record<string, unknown>[] { return [{id: \"margherita\", name: \"Margherita\", size: \"30 cm\", diameterMm: 300, cents: 1000, vegan: false, vegetarian: true, ingredients: \"Tomato, mozzarella, basil\", allergens: \"Milk, wheat\"}, {id: \"garden\", name: \"Garden Vegan\", size: \"30 cm\", diameterMm: 300, cents: 1200, vegan: true, vegetarian: true, ingredients: \"Tomato, plant-based cheese, seasonal vegetables\", allergens: \"Wheat\"}, {id: \"pepperoni\", name: \"Pepperoni\", size: \"30 cm\", diameterMm: 300, cents: 1300, vegan: false, vegetarian: false, ingredients: \"Tomato, mozzarella, pepperoni\", allergens: \"Meat, milk, wheat\"}]; }"
  +" export function foodWindows(): Record<string, unknown>[] { return [{id: \"w1\", from: \"17:45\", until: \"18:15\", meetsRequirement: true, deliveryCents: 500}, {id: \"w2\", from: \"18:15\", until: \"18:45\", meetsRequirement: false, deliveryCents: 500}, {id: \"w3\", from: \"18:45\", until: \"19:15\", meetsRequirement: false, deliveryCents: 500}]; }"
  +" export function lateWindows(): Record<string, unknown>[] { return [{id: \"w2\", from: \"18:15\", until: \"18:45\", meetsRequirement: false, deliveryCents: 500}, {id: \"w3\", from: \"18:45\", until: \"19:15\", meetsRequirement: false, deliveryCents: 500}, {id: \"w4\", from: \"19:15\", until: \"19:45\", meetsRequirement: false, deliveryCents: 500}]; }"
  +" export function twoWindows(): Record<string, unknown>[] { return [{id: \"w1\", from: \"17:45\", until: \"18:15\", meetsRequirement: true, deliveryCents: 900}, {id: \"w2\", from: \"18:15\", until: \"18:45\", meetsRequirement: true, deliveryCents: 500}, {id: \"w3\", from: \"18:45\", until: \"19:15\", meetsRequirement: false, deliveryCents: 500}]; }"
  +" export function dearWindows(): Record<string, unknown>[] { return [{id: \"w1\", from: \"17:45\", until: \"18:15\", meetsRequirement: true, deliveryCents: 900}, {id: \"w2\", from: \"18:15\", until: \"18:45\", meetsRequirement: false, deliveryCents: 900}, {id: \"w3\", from: \"18:45\", until: \"19:15\", meetsRequirement: false, deliveryCents: 900}]; }"
  +" export function incompleteMenu(): Record<string, unknown>[] { return [{id: \"margherita\", name: \"Margherita\", size: \"30 cm\", cents: 1000, vegan: false, vegetarian: true, ingredients: \"Tomato, mozzarella, basil\", allergens: \"Milk, wheat\"}]; }"
  +" export function renamedMenu(): Record<string, unknown>[] { return [{id: \"margherita\", name: \"Margherita\", size: \"Pizza grande\", diameterMm: 300, cents: 1000, vegan: false, vegetarian: true, ingredients: \"Tomato, mozzarella, basil\", allergens: \"Milk, wheat\"}, {id: \"garden\", name: \"Garden Vegan\", size: \"Pizza grande\", diameterMm: 300, cents: 1200, vegan: true, vegetarian: true, ingredients: \"Tomato, plant-based cheese, seasonal vegetables\", allergens: \"Wheat\"}]; }"
  +" export function inchMenu(): Record<string, unknown>[] { return [{id: \"margherita\", name: \"Margherita\", size: \"12 inch\", diameterMm: 305, cents: 1000, vegan: false, vegetarian: true, ingredients: \"Tomato, mozzarella, basil\", allergens: \"Milk, wheat\"}, {id: \"garden\", name: \"Garden Vegan\", size: \"12 inch\", diameterMm: 305, cents: 1200, vegan: true, vegetarian: true, ingredients: \"Tomato, plant-based cheese, seasonal vegetables\", allergens: \"Wheat\"}]; }";
}

// The Equipment search: one alternative basket is one host/rental quote. A quote reply carries no basket
// identity, so each reply is held with the basket it was issued for, as the itemId/quantity lines the
// request names. A reply is usable only when the quote reports it available and its own cents fit the
// editable hire budget, every item the basket contains - a package's own components expanded and
// multiplied by its quoted quantity - meets the frozen requirement from its record's attributes, and the
// item's own available covers the quantity the shared stock takes. Each quoted basket names an alternative
// once, and the reply's own available already aggregates the consumption of the whole basket; each quoted
// item is then re-checked against its own available as well. The
// refundable deposit is read from the selected reply and never added to the hire total. A field the
// comparison needs that is absent is undecidable (unknown), not an exclusion.
function hireHelpers(): string { return ""
  +" export function hireDecidable(state: AppState): boolean { if (!Number.isFinite(state.hireBudget) || state.hireBudget < 0) { return false; } if (state.quotes.length < 1 || state.quotes.length > 16) { return false; } if (state.equipment.length < 1 || state.equipment.length > 32) { return false; } let ids: string[] = []; for (let item of state.equipment) { let id: unknown = item.id; let cents: unknown = item.cents; let available: unknown = item.available; let attributes: unknown = item.attributes; if (typeof id !== \"string\") { return false; } let name: string = id; if (name === \"\") { return false; } if (typeof cents !== \"number\") { return false; } let price: number = cents; if (!Number.isFinite(price) || price < 0) { return false; } if (typeof available !== \"number\") { return false; } let remaining: number = available; if (!Number.isFinite(remaining) || remaining < 0) { return false; } if (typeof attributes !== \"object\") { return false; } if (attributes === null) { return false; } let record: Record<string, unknown> = attributes as Record<string, unknown>; let kind: unknown = record.kind; if (typeof kind !== \"string\") { return false; } let category: string = kind; if (category === \"stand\") { let adjustable: unknown = record.adjustable; let clip: unknown = record.clipAdapter; if (typeof adjustable !== \"boolean\") { return false; } if (typeof clip !== \"boolean\") { return false; } } else if (category === \"cable\") { let balanced: unknown = record.balanced; let from: unknown = record.connectorFrom; let to: unknown = record.connectorTo; let length: unknown = record.lengthMm; if (typeof balanced !== \"boolean\") { return false; } if (typeof from !== \"string\") { return false; } let start: string = from; if (start === \"\") { return false; } if (typeof to !== \"string\") { return false; } let finish: string = to; if (finish === \"\") { return false; } if (typeof length !== \"number\") { return false; } let millimetres: number = length; if (!Number.isFinite(millimetres) || millimetres < 0) { return false; } } let components: unknown = item.components; if (typeof components !== \"object\") { return false; } if (components === null) { return false; } let parts: Record<string, unknown>[] = components as Record<string, unknown>[]; if (category === \"package\") { if (parts.length === 0) { return false; } } for (let part of parts) { let componentId: unknown = part.itemId; let componentQuantity: unknown = part.quantity; if (typeof componentId !== \"string\") { return false; } let componentName: string = componentId; if (componentName === \"\") { return false; } if (typeof componentQuantity !== \"number\") { return false; } let count: number = componentQuantity; if (!Number.isFinite(count) || count < 1) { return false; } if (equipmentAt(state,componentName) === null) { return false; } } for (let prior of ids) { if (prior === name) { return false; } } ids[ids.length] = name; } for (let entry of state.quotes) { let lines: unknown = entry.lines; if (typeof lines !== \"object\") { return false; } if (lines === null) { return false; } let quoted: Record<string, unknown>[] = lines as Record<string, unknown>[]; if (quoted.length < 1 || quoted.length > 16) { return false; } for (let line of quoted) { let itemId: unknown = line.itemId; let quantity: unknown = line.quantity; if (typeof itemId !== \"string\") { return false; } let quotedId: string = itemId; if (quotedId === \"\") { return false; } if (typeof quantity !== \"number\") { return false; } let copies: number = quantity; if (!Number.isFinite(copies) || copies < 1 || !(Math.floor(copies) === copies)) { return false; } if (equipmentAt(state,quotedId) === null) { return false; } } let reply: Record<string, unknown> | null = quoteOf(entry); if (reply === null) { return false; } let cents: unknown = reply.cents; let deposit: unknown = reply.depositCents; let available: unknown = reply.available; if (typeof cents !== \"number\") { return false; } let hire: number = cents; if (!Number.isFinite(hire) || hire < 0) { return false; } if (typeof deposit !== \"number\") { return false; } let refundable: number = deposit; if (!Number.isFinite(refundable) || refundable < 0) { return false; } if (typeof available !== \"boolean\") { return false; } } return true; }"
  +" export function quoteOf(entry: Record<string, unknown>): Record<string, unknown> | null { let reply: unknown = entry.quote; if (typeof reply !== \"object\") { return null; } if (reply === null) { return null; } return reply as Record<string, unknown>; }"
  +" export function quoteCents(entry: Record<string, unknown>): number { let reply: Record<string, unknown> | null = quoteOf(entry); if (reply === null) { return 0; } return reply.cents as number; }"
  +" export function quoteDeposit(entry: Record<string, unknown>): number { let reply: Record<string, unknown> | null = quoteOf(entry); if (reply === null) { return 0; } return reply.depositCents as number; }"
  +" export function equipmentAt(state: AppState, itemId: string): Record<string, unknown> | null { for (let item of state.equipment) { if ((item.id as string) === itemId) { return item; } } return null; }"
  +" export function kindOf(item: Record<string, unknown>): string { let attributes: Record<string, unknown> = item.attributes as Record<string, unknown>; return attributes.kind as string; }"
  +" export function availableFor(state: AppState, itemId: string): number { let item: Record<string, unknown> | null = equipmentAt(state,itemId); if (item === null) { return 0; } return item.available as number; }"
  +" export function itemFits(state: AppState, itemId: string): boolean { let item: Record<string, unknown> | null = equipmentAt(state,itemId); if (item === null) { return false; } let attributes: Record<string, unknown> = item.attributes as Record<string, unknown>; let kind: string = attributes.kind as string; if (kind === \"stand\") { if ((attributes.adjustable as boolean) !== true) { return false; } return (attributes.clipAdapter as boolean) === true; } if (kind === \"cable\") { if ((attributes.balanced as boolean) !== true) { return false; } if ((attributes.connectorFrom as string) !== \"XLR female\") { return false; } if ((attributes.connectorTo as string) !== \"XLR male\") { return false; } return (attributes.lengthMm as number) >= 10000; } return false; }"
  +" export function basketLabel(entry: Record<string, unknown>): string { let lines: Record<string, unknown>[] = entry.lines as Record<string, unknown>[]; let label: string = \"\"; for (let line of lines) { if (label !== \"\") { label = label + \",\"; } label = label + (line.itemId as string) + \":\" + String(line.quantity as number); } return label; }"
  +" export function componentIssue(state: AppState, itemId: string, quantity: number): string { if (!itemFits(state,itemId)) { return \"a required item does not meet the requirement\"; } if (!(availableFor(state,itemId) >= quantity)) { return \"its stock is unavailable\"; } return \"\"; }"
  +" export function basketIssue(state: AppState, entry: Record<string, unknown>): string { let reply: Record<string, unknown> | null = quoteOf(entry); if (reply === null) { return \"no quote reply is disclosed for this basket\"; } let cents: number = reply.cents as number; if (cents > state.hireBudget) { return String(cents)+\" cents exceeds the \"+String(state.hireBudget)+\" cent budget\"; } if ((reply.available as boolean) !== true) { return \"the quote reports the basket unavailable\"; } let lines: Record<string, unknown>[] = entry.lines as Record<string, unknown>[]; let hasStand: boolean = false; let hasCable: boolean = false; for (let line of lines) { let itemId: string = line.itemId as string; let quantity: number = line.quantity as number; let item: Record<string, unknown> | null = equipmentAt(state,itemId); if (item === null) { return \"a quoted item is not in the equipment reply\"; } let components: Record<string, unknown>[] = item.components as Record<string, unknown>[]; if (components.length === 0) { let issue: string = componentIssue(state,itemId,quantity); if (issue !== \"\") { return issue; } if (kindOf(item) === \"stand\") { hasStand = true; } if (kindOf(item) === \"cable\") { hasCable = true; } } else { for (let component of components) { let componentId: string = component.itemId as string; let required: number = (component.quantity as number) * quantity; let componentItem: Record<string, unknown> | null = equipmentAt(state,componentId); if (componentItem === null) { return \"a package component is not in the equipment reply\"; } let issue: string = componentIssue(state,componentId,required); if (issue !== \"\") { return issue; } if (kindOf(componentItem) === \"stand\") { hasStand = true; } if (kindOf(componentItem) === \"cable\") { hasCable = true; } } } } if (!hasStand) { return \"the basket holds no stand that meets the requirement\"; } if (!hasCable) { return \"the basket holds no cable that meets the requirement\"; } return \"\"; }"
  +" export function basketUsable(state: AppState, entry: Record<string, unknown>): boolean { return basketIssue(state,entry) === \"\"; }"
  +" export function hireIndex(state: AppState): number { let choice: number = -1; let best: number = -1; let index: number = 0; while (index < state.quotes.length) { let entry: Record<string, unknown> = state.quotes[index] as Record<string, unknown>; if (basketUsable(state,entry)) { let cents: number = quoteCents(entry); if (best < 0 || cents < best) { best = cents; choice = index; } } index = index + 1; } return choice; }"
  +" export function hireSelected(state: AppState): Record<string, unknown> | null { let index: number = hireIndex(state); if (index < 0) { return null; } return state.quotes[index] as Record<string, unknown>; }"
  +" export function hireChoice(state: AppState): string { let index: number = hireIndex(state); if (index < 0) { return \"\"; } return basketLabel(state.quotes[index] as Record<string, unknown>); }"
  +" export function hireCents(state: AppState): number { let selected: Record<string, unknown> | null = hireSelected(state); if (selected === null) { return 0; } return quoteCents(selected); }"
  +" export function hireDeposit(state: AppState): number { let selected: Record<string, unknown> | null = hireSelected(state); if (selected === null) { return 0; } return quoteDeposit(selected); }"
  +" export function hireFeasible(state: AppState): boolean { return hireChoice(state) !== \"\"; }"
  +" export function hireReason(state: AppState, entry: Record<string, unknown>): string { return \"excluded, \"+basketIssue(state,entry); }"
  +" export function hireSummary(state: AppState): string { let reasons: string = \"\"; for (let entry of state.quotes) { let label: string = basketLabel(entry); if (basketUsable(state,entry)) { reasons = reasons + label + \": included at \" + String(quoteCents(entry)) + \" cents hire; \"; } else { reasons = reasons + label + \": \" + hireReason(state,entry) + \"; \"; } } let choice: string = hireChoice(state); if (choice === \"\") { return \"No usable whole-basket quote within \" + String(state.hireBudget) + \" cents; \" + reasons; } return \"Selected \" + choice + \" at \" + String(hireCents(state)) + \" cents hire with \" + String(hireDeposit(state)) + \" cents refundable deposit held separately; \" + reasons; }"
  +" export function setHireBudget(state: AppState, action: SetHireBudget): AppState { return {hireBudget: action.value}; }"
  +" export function loadHire(state: AppState, action: LoadHire): AppState { return {equipment: rentalEquipment(2), quotes: [rentalQuote(rentalLines([\"package\"],[1]),true), rentalQuote(rentalLines([\"stand\",\"cable10\"],[1,1]),true)]}; }"
  +" export function loadShortCable(state: AppState, action: LoadShortCable): AppState { return {equipment: rentalEquipment(2), quotes: [rentalQuote(rentalLines([\"package\"],[1]),true), rentalQuote(rentalLines([\"stand\",\"cable3\"],[1,1]),true)]}; }"
  // A two-package basket consumes the package's own components twice: two stands against the one the
  // equipment reply still holds, although the reply itself reports the basket available and its price fits
  // the hire budget. The nested quantity, not the reply's own flag, has to exclude it.
  +" export function loadTwoPackages(state: AppState, action: LoadTwoPackages): AppState { return {equipment: rentalEquipment(1), quotes: [rentalQuote(rentalLines([\"package\"],[2]),true), rentalQuote(rentalLines([\"stand\",\"cable10\"],[1,1]),true)]}; }"
  +" export function quoteUnavailable(state: AppState, action: QuoteUnavailable): AppState { return {equipment: rentalEquipment(2), quotes: [rentalQuote(rentalLines([\"package\"],[1]),true), rentalQuote(rentalLines([\"stand\",\"cable10\"],[1,1]),false)]}; }"
  +" export function loadSparseQuote(state: AppState, action: SparseQuote): AppState { return {equipment: rentalEquipment(2), quotes: [rentalQuote(rentalLines([\"package\"],[1]),true), sparseQuote()]}; }"
  // The exhausted-stock control keeps the quote replies issued while the equipment reply is replaced, so the
  // re-check against each record's own available is what refuses the basket.
  +" export function noStand(state: AppState, action: NoStand): AppState { return {equipment: rentalEquipment(0)}; }"
  +" export function clearQuotes(state: AppState, action: ClearQuotes): AppState { return {quotes: []}; }"
  +" export function rentalAttributes(kind: string, adjustable: boolean, clipAdapter: boolean, balanced: boolean, connectorFrom: string, connectorTo: string, lengthMm: number): Record<string, unknown> { let attributes: Record<string, unknown> = {kind: kind, adjustable: adjustable, clipAdapter: clipAdapter, balanced: balanced, connectorFrom: connectorFrom, connectorTo: connectorTo, lengthMm: lengthMm}; return attributes; }"
  +" export function rentalLines(ids: string[], quantities: number[]): Record<string, unknown>[] { let lines: Record<string, unknown>[] = []; let index: number = 0; while (index < ids.length) { let line: Record<string, unknown> = {itemId: ids[index], quantity: quantities[index]}; lines[lines.length] = line; index = index + 1; } return lines; }"
  +" export function rentalRecord(id: string, name: string, specification: string, cents: number, available: number, included: string, category: string, attributes: Record<string, unknown>, components: Record<string, unknown>[]): Record<string, unknown> { let record: Record<string, unknown> = {id: id, name: name, specification: specification, cents: cents, available: available, included: included, category: category, attributes: attributes, components: components}; return record; }"
  +" export function rentalEquipment(standAvailable: number): Record<string, unknown>[] { let packageAvailable: number = standAvailable; if (packageAvailable > 2) { packageAvailable = 2; } let noComponents: Record<string, unknown>[] = []; let packageComponents: Record<string, unknown>[] = rentalLines([\"stand\",\"cable10\"],[1,1]); let records: Record<string, unknown>[] = []; records[records.length] = rentalRecord(\"stand\",\"Boom microphone stand\",\"Adjustable boom; adapter fitting the venue microphone clip\",800,standAvailable,\"Boom stand; Clip adapter\",\"Microphones\",rentalAttributes(\"stand\",true,true,false,\"\",\"\",0),noComponents); records[records.length] = rentalRecord(\"cable10\",\"Vocal cable 10 m\",\"Balanced XLR female → XLR male, 10 m\",500,3,\"10 m balanced XLR cable\",\"Cables\",rentalAttributes(\"cable\",false,false,true,\"XLR female\",\"XLR male\",10000),noComponents); records[records.length] = rentalRecord(\"package\",\"Vocal package\",\"One boom stand plus one 10 m cable\",1200,packageAvailable,\"1 boom microphone stand; 1 clip adapter; 1 XLR female → XLR male cable, 10 m\",\"Microphones\",rentalAttributes(\"package\",false,false,false,\"\",\"\",0),packageComponents); records[records.length] = rentalRecord(\"cable3\",\"Vocal cable 3 m\",\"Balanced XLR female → XLR male, 3 m\",300,2,\"3 m balanced XLR cable\",\"Cables\",rentalAttributes(\"cable\",false,false,true,\"XLR female\",\"XLR male\",3000),noComponents); records[records.length] = rentalRecord(\"amp\",\"Bass combo amplifier\",\"At least 300 W into its built-in speaker; 6.35 mm instrument input; balanced XLR DI output\",4000,1,\"Amplifier; Power cable\",\"Backline\",rentalAttributes(\"amplifier\",false,false,false,\"\",\"\",0),noComponents); return records; }"
  +" export function quotedCents(lines: Record<string, unknown>[]): number { let equipment: Record<string, unknown>[] = rentalEquipment(2); let cents: number = 0; for (let line of lines) { let id: string = line.itemId as string; let quantity: number = line.quantity as number; for (let item of equipment) { if ((item.id as string) === id) { cents = cents + (item.cents as number) * quantity; } } } return cents; }"
  +" export function sparseQuote(): Record<string, unknown> { let reply: Record<string, unknown> = {cents: 1300, depositCents: 5000, expiresInMinutes: 15, terms: \"Collection only. Exact items reserved; substitutions need approval.\"}; let entry: Record<string, unknown> = {lines: rentalLines([\"stand\",\"cable10\"],[1,1]), quote: reply}; return entry; }"
  +" export function rentalQuote(lines: Record<string, unknown>[], available: boolean): Record<string, unknown> { let reply: Record<string, unknown> = {cents: quotedCents(lines), depositCents: 5000, expiresInMinutes: 15, terms: \"Collection only. Exact items reserved; substitutions need approval.\", available: available}; let entry: Record<string, unknown> = {lines: lines, quote: reply}; return entry; }";
}

function field(name: string, type: string, role: string, initial: string, dependencies: string[], owner: string): screens.Field { return {name:name,type:type,role:role,dependencies:dependencies,initial:initial,owner:owner}; }

