async function rejection(helper: string, value: string, dependencies: string[]): Promise<string> {
  let composition: screens.Composition = {screen:{title:"Rejected",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[rejectedSource(helper)]},bindings:{},actions:{},connections:[]};
  let computation: composer.Computation = {instance:"gap",field:"probe",value:value,ready:"true",reason:"\"Unavailable\"",dependencies:dependencies};
  try { await composer.assemble(composition,[computation]); return "ACCEPTED"; }
  catch (unknownError) { let error: Error = unknownError as Error; return error.message; }
}
// The paths a constructive calculation must never smuggle a committed value through, and the shape it
// must be allowed: a write to the state parameter, a field write to that parameter after rebinding it to
// a container this helper allocated, a write through a local that borrows a state array, a write through a
// local whose borrow an early break leaves in place, a write through a local whose borrow a caught throw,
// a checked call that can throw or a runtime check that fails leaves in place, a write at the top of a loop
// body whose previous iteration left the local naming the state array it borrowed, a loop binding that
// shadows a fresh local, an asserted state element and an indirect callee the summary cannot inspect stay
// refused with their own located reasons, an undeclared state read inside an assignment is still a read,
// while building an array this helper allocated itself is admitted, and so are the two early-exit helpers
// once what they contain can no longer skip the allocation the block ends with, and the same holds for a
// body that always ends on its own allocation before the loop runs again.
export async function localCopyPlan(): Promise<string> {
  let instance: screens.Instance = rejectedSource("export function probe(state: AppState): number { let own = state.menu.slice(); own[0] = {id: \"replaced\"}; let held: Record<string, unknown>[] = []; try { held = state.menu; let n = held.length; held = []; } catch(e) {} held[0] = {}; return own.length + held.length; }");
  instance.fragment.helpers = instance.fragment.helpers + " export function sorted(state: AppState): number { let keys = Object.keys(state.menu[0]); let own = state.menu.toSorted((a: Record<string, unknown>, b: Record<string, unknown>): number => 0); own[0] = {}; return keys.length + own.length; }";
  instance.fragment.helpers = instance.fragment.helpers.replace("return own.length + held.length;", "return own.length + held.length + sorted(state);");
  instance.fragment.fields[0].initial = "[{id: \"original\"}]";
  let composition: screens.Composition = {screen:{title:"Copies",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[instance]},bindings:{},actions:{},connections:[]};
  let computation: composer.Computation = {instance:"gap",field:"probe",value:"probe(state)",ready:"true",reason:"\"Unavailable\"",dependencies:["f_gap_menu"]};
  let result: composer.Result = await composer.assemble(composition,[computation]);
  return s.encode({source:result.source,metadata:result.metadata});
}
export async function negatives(): Promise<string> {
  let results: string[] = [];
  results[results.length] = await rejection("export function probe(state: AppState): number { state.menu = []; return 1; }","probe(state)",["f_gap_menu"]);
  // Rebinding the state parameter to a container this helper allocated names it fresh; the field write
  // that follows would then look like an element of its own allocation if the parameter were not always
  // committed state, so it stays a located refusal instead.
  results[results.length] = await rejection("export function probe(state: AppState): number { let rows: Record<string, unknown>[] = []; state = {menu: rows}; state.notes = \"x\"; return 1; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let rows: Record<string, unknown>[] = state.menu; rows[0] = {}; return rows.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let measure = (value: number): number => value + 1; return measure(state.menu.length); }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let out: string[] = []; let index: number = 0; while (index < 3) { out[out.length] = String(index); index = index + 1; } return out.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let total: number = 0; total = total + state.menu.length; return total; }","probe(state)",[]);
  results[results.length] = await rejection("export function probe(state: AppState): number { (state.menu as Record<string, unknown>[])[0] = {}; return 1; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let rows: Record<string, unknown>[] = []; for (let rows of state.menu.slice(0)) { rows.id = \"x\"; } return rows.length; }","probe(state)",["f_gap_menu"]);
  // A break leaves the loop body before the allocation its later statements make, so the local still names
  // the state array it borrowed when the write runs: the borrow survives the exit and the write is refused.
  // The same helper without the break runs the whole body, ends on its own allocation, and is admitted.
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; while (n < 1) { held = state.menu; if (n === 0) { break; } held = []; n = n + 1; } held[0] = {id: \"damaged\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; while (n < 1) { held = state.menu; held = []; n = n + 1; } held[0] = {id: \"damaged\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  // A checked call that can throw unwinds out of the try block before the allocation its later statement
  // makes, and a caught throw does the same when it is the throw itself: either way the catch block runs
  // with the local still naming the state array it borrowed, so the borrow survives the exit and the write
  // that follows is refused. The same helper with nothing that can throw runs the whole try block, ends on
  // its own allocation, and is admitted.
  results[results.length] = await rejection("export function checkMenu(state: AppState): number { for (let row of state.menu) { if ((row.id as string) === \"bad\") { throw {name: \"BAD_ROW\", message: \"record fails validation\"}; } } return 1; } export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; checkMenu(state); held = []; } catch (e) { } held[0] = {id: \"x\"}; return 1; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; throw {name: \"X\", message: \"Y\"}; held = []; } catch (e) { } held[0] = {id: \"x\"}; return 1; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; held = []; } catch (e) { } held[0] = {id: \"x\"}; return 1; }","probe(state)",["f_gap_menu"]);
  // A loop body runs again with what its previous iteration left: a `continue`, a caught throw or a
  // checked call that can throw skips the allocation the body's later statement would make, so the
  // write at the top of the next iteration reaches the state array the local still borrows and is
  // refused. The same body that always ends on its own allocation is admitted, for `while` and for a
  // `for`-of loop, whose body also repeats.
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; while (n < 3) { held[0] = {id: \"damaged\"}; held = state.menu; if (n === 0) { n = n + 1; continue; } held = []; n = n + 1; } return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; while (n < 3) { held[0] = {id: \"damaged\"}; held = state.menu; held = []; n = n + 1; } return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; while (n < 3) { held[0] = {id: \"damaged\"}; try { held = state.menu; if (n === 0) { throw {name: \"X\", message: \"Y\"}; } held = []; } catch (e) { } n = n + 1; } return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; while (n < 3) { held[0] = {id: \"damaged\"}; try { held = state.menu; held = []; } catch (e) { } n = n + 1; } return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; for (let row of state.menu) { held[0] = {id: \"damaged\"}; held = state.menu; if (n === 0) { n = n + 1; continue; } held = []; n = n + 1; } return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let n: number = 0; for (let row of state.menu) { held[0] = {id: \"damaged\"}; held = state.menu; held = []; n = n + 1; } return held.length; }","probe(state)",["f_gap_menu"]);
  // The emitted code realizes an `as` assertion, an element access and a member access as runtime type
  // checks, and each of them throws where the value it admits is not there: an element at a position the
  // array does not hold, a field a record does not carry, a value the assertion cannot narrow. Such a throw
  // runs the catch block with the borrow the try block already committed - exactly the escape a caught
  // `throw` reaches - so a read that can fail is an exit and the write after the catch stays refused. The
