  results[results.length] = await rejection("export function probe(state: AppState): number { let own = state.menu.toSorted((a: Record<string, unknown>, b: Record<string, unknown>): number => 0); own[0].id = \"bad\"; return own.length; }","probe(state)",["f_gap_menu"]);
