  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let own: Record<string, unknown>[] = []; try { held = state.menu; own[9] = {id: \"x\"}; held = []; } catch (e) { } held[0] = {id: \"stolen\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; let n = held.length; held = []; } catch (e) { } held[0] = {}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let record: Record<string, unknown> = state.menu[0]; try { held = state.menu; let n = record.length; held = []; } catch (e) { } held[0] = {}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let own = state.menu.slice(); own[0] = {}; return own.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let own = state.menu.slice(); own[0].id = \"damaged\"; return own.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let own = state.menu.slice(); let alias = own; alias[0].id = \"damaged\"; return own.length; }","probe(state)",["f_gap_menu"]);
