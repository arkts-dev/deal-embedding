  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; let own: Record<string, unknown> = {id: \"ok\"}; let id: unknown = own.id; held = []; } catch (e) { } held[0] = {id: \"ok\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let numbers: number[] = []; try { held = state.menu; let value: number = numbers[0]; held = []; } catch (e) { } held[0] = {id: \"stolen\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; let numbers: number[] = []; try { held = state.menu; let value: number = numbers.length; held = []; } catch (e) { } held[0] = {id: \"ok\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; let own: Record<string, unknown> = {id: \"ok\"}; let id: unknown = own.id; let text: string = id as string; held = []; } catch (e) { } held[0] = {id: \"stolen\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; try { held = state.menu; let own: Record<string, unknown> = {id: \"ok\"}; let id: unknown = own.id; let text: unknown = id; held = []; } catch (e) { } held[0] = {id: \"ok\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  // A member read admits its receiver and the field against the type the statement needs, and a field the
