  results[results.length] = await rejection("export function probe(state: AppState): number { let held: Record<string, unknown>[] = []; for (let row of state.menu) { try { held = state.menu; let absent: Record<string, unknown> = {id: \"none\"}; held = []; } catch (e) { } } held[0] = {id: \"ok\"}; return held.length; }","probe(state)",["f_gap_menu"]);
  // An element access checks its position at run time whether it reads or writes, so a write at a position
