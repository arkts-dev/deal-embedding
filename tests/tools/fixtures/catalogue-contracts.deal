import * as catalogue from "./catalogue";
import * as screens from "./screen";
import * as composer from "./composer";
import * as bindings from "./bindings";
import * as plans from "./plan";
import * as selecting from "./construction-selection";
import * as s from "./construction-schema";

// The four read-only sections and the two fact sections, driven through the compiled catalogue
// policy itself: closed decoding, row bounds, the one disclosure predicate, initialized fragments
// and real assembly. No copy of the decoder lives here; every check calls the production functions.
function insist(value: boolean, message: string): void { if (!value) { throw {name:"TEST_FAILED",message:message}; } }
function definition(kind: string): catalogue.Definition {
  for (let entry of catalogue.definitions()) { if (entry.kind === kind) { return entry; } }
  throw {name:"TEST_FAILED",message:"Missing catalogue kind: "+kind};
}
async function accepts(kind: string, json: string): Promise<Record<string, unknown>> {
  return await catalogue.decode(definition(kind),JSON.parse(json));
}
async function rejects(kind: string, json: string, message: string): Promise<number> {
  let refused: boolean = false;
  try { await catalogue.decode(definition(kind),JSON.parse(json)); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw {name:"TEST_FAILED",message:message+" raised "+error.name+": "+error.message}; } refused = true; }
  if (!refused) { throw {name:"TEST_FAILED",message:"Admitted "+message}; }
  return 1;
}
async function configured(kind: string, json: string): Promise<catalogue.Configured> {
  let entry: catalogue.Configured = {need:kind,definition:definition(kind),parameters:await accepts(kind,json),accepted:true,reason:""};
  return entry;
}
function label(units: number): string { let result: string = ""; let index: number = 0; while (index < units) { result = result+"a"; index = index+1; } return result; }

// Escaping and exactness: every decoded text keeps its UTF-16 units, and bounds count units.
export async function decoding(): Promise<string> {
  let result: Record<string, unknown> = {};
  result.data_table = await accepts("data_table","{\"title\":\"Spend table \\ud83d\\ude00\",\"subtitle\":\"\",\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"],[\"Food\",\"2.5\",\"quote \\\" and \\\\ and \\n and \\u0001\"]]}");
  result.timeline = await accepts("timeline","{\"rows\":[{\"minute\":0,\"title\":\"Wake\"},{\"minute\":570,\"title\":\"Standup\",\"detail\":\"daily\"},{\"minute\":1439,\"title\":\"Sleep\",\"detail\":\"\"}]}");
  result.bar_chart = await accepts("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":2.5},{\"label\":\"Wed\",\"value\":10}],\"maximum\":10}");
  result.trend_chart = await accepts("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":-2},{\"label\":\"b\",\"value\":0.25},{\"label\":\"c\",\"value\":3}],\"minimum\":-3,\"maximum\":3}");
  // Neither chart kind sorts its supplied points: labels and values keep the given order.
  result.unsorted_bars = await accepts("bar_chart","{\"points\":[{\"label\":\"Wed\",\"value\":10},{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":2.5}],\"maximum\":10}");
  result.unsorted_trend = await accepts("trend_chart","{\"points\":[{\"label\":\"c\",\"value\":3},{\"label\":\"a\",\"value\":-2},{\"label\":\"b\",\"value\":0.25}],\"minimum\":-3,\"maximum\":3}");
  result.empty_table = await accepts("data_table","{\"headers\":[\"A\",\"B\",\"C\"],\"rows\":[]}");
  result.empty_timeline = await accepts("timeline","{\"rows\":[]}");
  result.empty_chart = await accepts("bar_chart","{\"points\":[],\"maximum\":4}");
  // The declared upper bounds are accepted whole: twelve rows, twelve rail rows and twelve points.
  let table: string = ""; let rails: string = ""; let points: string = "";
  let minutes: string[] = ["0","15","30","45","60","75","90","105","120","135","150","165"];
  let index: number = 0;
  for (let minute of minutes) {
    if (index > 0) { table = table+","; rails = rails+","; points = points+","; }
    table = table+"[\"a\",\"b\",\"c\"]";
    rails = rails+"{\"minute\":"+minute+",\"title\":\"t"+String(index)+"\"}";
    points = points+"{\"label\":\"p"+String(index)+"\",\"value\":"+minute+"}";
    index = index+1;
  }
  result.twelve_rows = await accepts("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":["+table+"]}");
  result.twelve_rail = await accepts("timeline","{\"rows\":["+rails+"]}");
  result.twelve_points = await accepts("bar_chart","{\"points\":["+points+"],\"maximum\":165}");
  // The fact sections accept their full twelve-row bound, and a nondecreasing rail admits equal minutes.
  let metricRows: string = ""; let metricIndex: number = 0;
  while (metricIndex < 12) { if (metricIndex > 0) { metricRows = metricRows+","; } metricRows = metricRows+"{\"label\":\"m"+String(metricIndex)+"\",\"value\":\"v"+String(metricIndex)+"\"}"; metricIndex = metricIndex+1; }
  result.twelve_metrics = await accepts("metrics","{\"values\":["+metricRows+"]}");
  result.equal_minutes = await accepts("timeline","{\"rows\":[{\"minute\":30,\"title\":\"a\"},{\"minute\":30,\"title\":\"b\"}]}");
  // The shared text domains: 32 UTF-16 units fit a label, 512 fit a cell, and an astral pair counts
  // as two units rather than one scalar.
  result.bounds = await accepts("data_table","{\"headers\":[\""+label(32)+"\",\"b\",\"c\"],\"rows\":[[\""+label(512)+"\",\"b\",\"c\"],[\"\ud83d\ude00\ud83d\ude00\",\"\",\"\"]]}");
  result.max_rail = await accepts("timeline","{\"rows\":[{\"minute\":1,\"title\":\"a\",\"detail\":\""+label(512)+"\"}]}");
  return s.encode(result);
}

export async function rejectionMatrix(): Promise<number> {
  let count: number = 0;
  count = count+await rejects("data_table","{\"title\":\""+label(513)+"\",\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[]}","title over its bound");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[],\"extra\":1}","unknown data_table field");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[[\"a\",\"b\",\"c\",\"d\"]]}","four-cell table row");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[[\"a\",\"b\"]]}","short table row");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\"],\"rows\":[]}","two-column headers");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\",\"d\"],\"rows\":[]}","four-column headers");
  count = count+await rejects("data_table","{\"headers\":5,\"rows\":[]}","nonarray headers");
  // A text would decode to three single-character headers, so only the array rule refuses it.
  count = count+await rejects("data_table","{\"headers\":\"abc\",\"rows\":[[\"a\",\"b\",\"c\"]]}","text headers");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":5}","nonarray table rows");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[\"abc\"]}","row that is not a cell array");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[[1,\"b\",\"c\"]]}","numeric table cell");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[[\""+label(513)+"\",\"b\",\"c\"]]}","cell over its bound");
  count = count+await rejects("data_table","{\"headers\":[\" \" ,\"b\",\"c\"],\"rows\":[]}","blank header");
  count = count+await rejects("data_table","{\"headers\":[\""+label(33)+"\",\"b\",\"c\"],\"rows\":[]}","header over its bound");
  count = count+await rejects("data_table","{\"headers\":[\"a\",\"b\",\"c\"],\"rows\":[[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"],[\"a\",\"b\",\"c\"]]}","thirteen table rows");
  count = count+await rejects("data_table","{\"rows\":[]}","missing table headers");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":10,\"title\":\"a\",\"extra\":1}]}","unknown timeline field");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":10}]}","timeline row without a title");
  count = count+await rejects("timeline","{\"rows\":5}","nonarray timeline rows");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":10,\"title\":5}]}","numeric timeline title");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":10,\"title\":\"a\"},{\"minute\":5,\"title\":\"b\"}]}","decreasing timeline minutes");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1440,\"title\":\"a\"}]}","minute past the shared domain");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":-1,\"title\":\"a\"}]}","negative minute");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1.5,\"title\":\"a\"}]}","fractional minute");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1e999,\"title\":\"a\"}]}","nonfinite minute");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1,\"title\":\""+label(33)+"\"}]}","timeline title over its bound");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1,\"title\":\"a\",\"detail\":\""+label(513)+"\"}]}","timeline detail over its bound");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1,\"title\":\"a\",\"detail\":null}]}","null timeline detail");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1,\"title\":\"a\",\"detail\":5}]}","numeric timeline detail");
  count = count+await rejects("timeline","{\"rows\":[5]}","timeline row that is not a record");
  count = count+await rejects("timeline","{\"rows\":[{\"minute\":1,\"title\":\"a\"},{\"minute\":2,\"title\":\"a\"},{\"minute\":3,\"title\":\"a\"},{\"minute\":4,\"title\":\"a\"},{\"minute\":5,\"title\":\"a\"},{\"minute\":6,\"title\":\"a\"},{\"minute\":7,\"title\":\"a\"},{\"minute\":8,\"title\":\"a\"},{\"minute\":9,\"title\":\"a\"},{\"minute\":10,\"title\":\"a\"},{\"minute\":11,\"title\":\"a\"},{\"minute\":12,\"title\":\"a\"},{\"minute\":13,\"title\":\"a\"}]}","thirteen rail rows");
  count = count+await rejects("bar_chart","{\"points\":5,\"maximum\":5}","nonarray chart points");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1,\"extra\":1}],\"maximum\":5}","unknown point field");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":5,\"value\":1}],\"maximum\":5}","numeric point label");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":\"1\"}],\"maximum\":5}","text chart value");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":-1}],\"maximum\":5}","negative bar value");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":6}],\"maximum\":5}","bar value above maximum");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1}],\"maximum\":0}","nonpositive maximum");
  // With a zero value the scale check admits maximum 0, so only the positive rule refuses this.
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":0}],\"maximum\":0}","positive maximum rule");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1}],\"maximum\":1e999}","nonfinite maximum");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1}],\"maximum\":\"5\"}","text chart maximum");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1}],\"maximum\":false}","boolean chart maximum");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1e999}],\"maximum\":5}","nonfinite point value");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\""+label(33)+"\",\"value\":1}],\"maximum\":5}","point label over its bound");
  count = count+await rejects("bar_chart","{\"points\":[{\"label\":\"a\",\"value\":1},{\"label\":\"b\",\"value\":1},{\"label\":\"c\",\"value\":1},{\"label\":\"d\",\"value\":1},{\"label\":\"e\",\"value\":1},{\"label\":\"f\",\"value\":1},{\"label\":\"g\",\"value\":1},{\"label\":\"h\",\"value\":1},{\"label\":\"i\",\"value\":1},{\"label\":\"j\",\"value\":1},{\"label\":\"k\",\"value\":1},{\"label\":\"l\",\"value\":1},{\"label\":\"m\",\"value\":1}],\"maximum\":5}","thirteen chart points");
  count = count+await rejects("bar_chart","{\"points\":[5],\"maximum\":5}","chart point that is not a record");
  count = count+await rejects("bar_chart","{\"points\":[]}","chart without its scale");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":1}],\"minimum\":0,\"maximum\":2}","single trend point");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":1},{\"label\":\"b\",\"value\":1}],\"minimum\":2,\"maximum\":2}","empty trend scale");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":1},{\"label\":\"b\",\"value\":1}],\"minimum\":3,\"maximum\":2}","reversed trend scale");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":4},{\"label\":\"b\",\"value\":1}],\"minimum\":0,\"maximum\":3}","trend value above maximum");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":-4},{\"label\":\"b\",\"value\":1}],\"minimum\":-3,\"maximum\":3}","trend value below minimum");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":1},{\"label\":\"b\",\"value\":1}],\"minimum\":0,\"maximum\":1e999}","nonfinite trend maximum");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":1},{\"label\":\"b\",\"value\":1}],\"minimum\":\"0\",\"maximum\":3}","text trend minimum");
  count = count+await rejects("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":1},{\"label\":\"b\",\"value\":1}],\"maximum\":3}","trend chart without its minimum");
  // The existing fact sections must refuse the same wrong types instead of re-spelling them.
  count = count+await rejects("metrics","{\"values\":5}","nonarray metric values");
  count = count+await rejects("metrics","{\"values\":[{\"label\":\"a\",\"value\":5}]}","numeric metric value");
  count = count+await rejects("metrics","{\"values\":[{\"label\":5,\"value\":\"a\"}]}","numeric metric label");
  count = count+await rejects("metrics","{\"values\":[{\"label\":\"a\",\"value\":\"b\",\"extra\":1}]}","unknown metric row field");
  count = count+await rejects("metrics","{\"values\":[{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"},{\"label\":\"a\",\"value\":\"b\"}]}","thirteen metric rows");
  count = count+await rejects("key_facts","{\"items\":[{\"label\":\"a\",\"value\":true}]}","boolean key-fact value");
  count = count+await rejects("key_facts","{}","key facts without items");
  // A spotlight message is a required text; a numeric or absent message is refused.
  count = count+await rejects("spotlight","{\"message\":5}","numeric spotlight message");
  count = count+await rejects("spotlight","{}","spotlight without its message");
  // The shared entry row refuses a non-boolean completion instead of emitting a cast value.
  count = count+await rejects("checklist","{\"items\":[{\"id\":\"a\",\"label\":\"b\",\"done\":\"yes\"}]}","text checklist completion");
  count = count+await rejects("checklist","{\"items\":[{\"id\":5,\"label\":\"b\"}]}","numeric checklist identity");
  count = count+await rejects("checklist","{\"items\":[{\"id\":\"a\",\"label\":\"b\",\"detail\":null}]}","null checklist detail");
  // A label list is an array of texts, not a text or a collection of other wire kinds.
  count = count+await rejects("actions","{\"labels\":5}","nonarray action labels");
  count = count+await rejects("actions","{\"labels\":[5]}","numeric action label");
  count = count+1; await catalogue.decode(definition("actions"),JSON.parse("{\"labels\":[\"Only\"]}"));
  count = count+1; await catalogue.decode(definition("actions"),JSON.parse("{\"labels\":[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\",\"i\",\"j\",\"k\",\"l\"]}"));
  count = count+await rejects("actions","{\"labels\":[\"a\",\"b\",\"c\",\"d\",\"e\",\"f\",\"g\",\"h\",\"i\",\"j\",\"k\",\"l\",\"m\"]}","thirteen action labels");
  count = count+1; await catalogue.decode(definition("timer"),JSON.parse("{\"presets\":[{\"label\":\"a\",\"seconds\":1},{\"label\":\"b\",\"seconds\":2},{\"label\":\"c\",\"seconds\":3},{\"label\":\"d\",\"seconds\":4},{\"label\":\"e\",\"seconds\":5},{\"label\":\"f\",\"seconds\":6}]}"));
  let stops: string = ""; let stopIndex: number = 0;
  while (stopIndex < 12) { if (stopIndex > 0) { stops = stops+","; } stops = stops+"{\"id\":\"s"+String(stopIndex)+"\",\"label\":\"Stop\",\"minutes\":1}"; stopIndex = stopIndex+1; }
  count = count+1; await catalogue.decode(definition("itinerary"),JSON.parse("{\"stops\":["+stops+"]}"));
  count = count+await rejects("itinerary","{\"stops\":["+stops+",{\"id\":\"s12\",\"label\":\"Stop\",\"minutes\":1}]}","thirteen stops");
  // The search and master lists decode the same disclosed entry rows under the same twelve-row bound.
  let entries: string = ""; let entryIndex: number = 0;
  while (entryIndex < 12) { if (entryIndex > 0) { entries = entries+","; } entries = entries+"{\"id\":\"e"+String(entryIndex)+"\",\"label\":\"Row\"}"; entryIndex = entryIndex+1; }
  count = count+1; await catalogue.decode(definition("search_list"),JSON.parse("{\"items\":["+entries+"]}"));
  count = count+await rejects("search_list","{\"items\":["+entries+",{\"id\":\"e12\",\"label\":\"Row\"}]}","thirteen search rows");
  count = count+await rejects("search_list","{\"items\":[{\"id\":\"a\",\"label\":\"Row\",\"done\":\"yes\"}]}","text search completion");
  count = count+1; await catalogue.decode(definition("master_list"),JSON.parse("{\"items\":["+entries+"]}"));
  count = count+await rejects("master_list","{\"items\":["+entries+",{\"id\":\"e12\",\"label\":\"Row\"}]}","thirteen master rows");
  count = count+await rejects("master_list","{\"items\":[{\"id\":\"a\",\"label\":\"Row\",\"extra\":1}]}","unknown master row field");
  return count;
}


// One predicate, two call sites: every supplied value is admitted only by request or fact evidence.
function admits(entry: catalogue.Configured, original: string, facts: string, userOwned: boolean): boolean {
  return catalogue.disclosed(entry,original,facts,userOwned) === "";
}
// Each disclosure case counts once, so deleting a case fails the exact-count check.
function checked(condition: boolean, message: string): number { insist(condition,message); return 1; }
export async function disclosure(): Promise<number> {
  let substring: catalogue.Configured = {need:"fabricated",definition:definition("bar_chart"),parameters:await accepts("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":40}],\"maximum\":200}"),accepted:true,reason:""};
  insist(catalogue.disclosed(substring,"Mon 140","",false).includes("point 0 value"),"numeric substring was admitted at catalogue call site");
  insist(catalogue.disclosed(substring,"","{\"rows\":[{\"label\":\"Mon\",\"value\":3},{\"label\":\"Tue\",\"value\":40}]}",false).includes("fields are not one disclosed record"),"fabricated catalogue row combination admitted");
  let request: string = "Show what I paid";
  let count: number = 0;
  // The table supplies its headers and cells; each needs evidence and an empty cell needs none.
  let headers: string = "{\"headers\":[\"Item\",\"Amount\",\"Note\"]";
  let admitted: catalogue.Configured = await configured("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"],[\"Food\",\"\",\"\"]]}");
  count = count+checked(admits(admitted,request,headers+",\"row\":{\"item\":\"Rent\",\"amount\":\"40\",\"note\":\"paid\"},\"item\":{\"name\":\"Food\"}}",false),"Disclosed table refused");
  let invented: catalogue.Configured = await configured("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"pending\"]]}");
  let located: string = catalogue.disclosed(invented,request,headers+",\"row\":{\"item\":\"Rent\",\"amount\":\"40\"}}",false);
  count = count+checked(located !== "","Invented table cell admitted");
  // A refusal carries the need and the offending row and field, never a bare verdict.
  count = count+checked(located.includes("(data_table): row 0 cell 2"),"Unlocated table refusal: "+located);
  // A heading names the displayed column, so an invented heading is refused like any other value.
  let invented_header: catalogue.Configured = await configured("data_table","{\"headers\":[\"Item\",\"Category\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"]]}");
  let located_header: string = catalogue.disclosed(invented_header,request,headers+",\"row\":{\"item\":\"Rent\",\"amount\":\"40\",\"note\":\"paid\"}}",false);
  count = count+checked(located_header.includes("(data_table): header 1"),"Unlocated header refusal: "+located_header);
  // The identical cell is admitted from the request text instead of a disclosed fact.
  let quoted: catalogue.Configured = await configured("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Food\",\"25\",\"paid\"]]}");
  count = count+checked(!admits(quoted,request+" on Food and label it paid",headers+",\"row\":{\"amount\":\"25\"}}",false),"A row assembled from unrelated request and fact values was admitted");
  let hidden_row: catalogue.Configured = await configured("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"],[\"Food\",\"25\",\"unpaid\"]]}");
  let located_row: string = catalogue.disclosed(hidden_row,request,headers+",\"row\":{\"item\":\"Rent\",\"amount\":\"40\",\"note\":\"paid\"}}",false);
  count = count+checked(located_row.includes("(data_table): row 1 cell 0"),"Unlocated second-row refusal: "+located_row);
  // Atomic rejection: the production call site installs a decoded record only when the whole record
  // decodes, so a rejected row list leaves the instance unfilled instead of a shortened table.
  let entry: catalogue.Configured = {need:"table",definition:definition("data_table"),parameters:{},accepted:false,reason:"Not filled"};
  let refused: boolean = false;
  try { entry.parameters = await catalogue.decode(definition("data_table"),JSON.parse("{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"],[\"Food\",\"25\"]]}")); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } refused = true; }
  count = count+checked(refused,"Short row list admitted");
  count = count+checked(s.encode(entry.parameters) === "{}","A rejected row list installed partial parameters");
  // The rail supplies its minute, title and detail; an invented minute is refused like a title.
  let rail: string = "{\"rail\":[{\"at\":\"Standup\",\"note\":\"daily\",\"minute\":570}";
  let timeline: catalogue.Configured = await configured("timeline","{\"rows\":[{\"minute\":570,\"title\":\"Standup\",\"detail\":\"daily\"},{\"minute\":600,\"title\":\"Review\"}]}");
  count = count+checked(admits(timeline,"",rail+",{\"at\":\"Review\",\"minute\":600}]}",false),"Disclosed rail refused");
  let invented_detail: catalogue.Configured = await configured("timeline","{\"rows\":[{\"minute\":570,\"title\":\"Standup\",\"detail\":\"secret\"}]}");
  let located_detail: string = catalogue.disclosed(invented_detail,"",rail+"]}",false);
  count = count+checked(located_detail.includes("(timeline): row 0 detail"),"Unlocated rail detail refusal: "+located_detail);
  let invented_minute: catalogue.Configured = await configured("timeline","{\"rows\":[{\"minute\":601,\"title\":\"Standup\",\"detail\":\"daily\"}]}");
  let located_minute: string = catalogue.disclosed(invented_minute,"",rail+"]}",false);
  count = count+checked(located_minute.includes("(timeline): row 0 minute"),"Unlocated rail minute refusal: "+located_minute);
  let invented_title: catalogue.Configured = await configured("timeline","{\"rows\":[{\"minute\":570,\"title\":\"Invented\",\"detail\":\"daily\"}]}");
  let located_title: string = catalogue.disclosed(invented_title,"",rail+"]}",false);
  count = count+checked(located_title.includes("(timeline): row 0 title"),"Unlocated rail title refusal: "+located_title);
  let empty_detail: catalogue.Configured = await configured("timeline","{\"rows\":[{\"minute\":570,\"title\":\"Standup\"}]}");
  count = count+checked(admits(empty_detail,"",rail+"]}",false),"Empty detail demanded evidence");
  // A section with no rows displays nothing, so it supplies no value to evidence.
  let empty_table: catalogue.Configured = await configured("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[]}");
  count = count+checked(admits(empty_table,"","",false),"An empty table demanded evidence");
  // A row of a kind the historical four-kind rule never covered is refused by the same predicate.
  let bars: catalogue.Configured = await configured("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":2.5}],\"maximum\":10}");
  count = count+checked(admits(bars,"","{\"days\":[{\"day\":\"Mon\",\"spent\":0},{\"day\":\"Tue\",\"spent\":2.5}]}",false),"Disclosed bar points refused");
  let wrong_bar: catalogue.Configured = await configured("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":7}],\"maximum\":10}");
  let located_bar: string = catalogue.disclosed(wrong_bar,"","{\"days\":[{\"day\":\"Mon\",\"spent\":0},{\"day\":\"Tue\",\"spent\":2.5}]}",false);
  count = count+checked(located_bar.includes("(bar_chart): point 1 value"),"Unlocated chart refusal: "+located_bar);
  let trend: catalogue.Configured = await configured("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":-2},{\"label\":\"b\",\"value\":0.25}],\"minimum\":-3,\"maximum\":3}");
  count = count+checked(admits(trend,"","{\"series\":[{\"at\":\"a\",\"delta\":-2},{\"at\":\"b\",\"delta\":0.25}]}",false),"Disclosed trend points refused");
  // A number is matched like a text value: its shortest round-trip spelling occurs in the evidence, so
  // a disclosed amount written directly before prose punctuation ("Spent 5. Show Mon.") still admits
  // its value; a rule that treats that adjacent punctuation as part of the number refuses it and
  // drops a disclosed section.
  let punctuated: catalogue.Configured = await configured("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":5}],\"maximum\":10}");
  count = count+checked(!admits(punctuated,"Spent 5. Show Mon.","",false),"Unrelated statements fabricated a chart point");
  insist(admits(punctuated,"Mon spent 5.","",false),"A value before prose punctuation was refused");
  let invented_label: catalogue.Configured = await configured("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":-2},{\"label\":\"c\",\"value\":0.25}],\"minimum\":-3,\"maximum\":3}");
  let located_trend: string = catalogue.disclosed(invented_label,"","{\"series\":[{\"at\":\"a\",\"delta\":-2},{\"at\":\"b\",\"delta\":0.25}]}",false);
  count = count+checked(located_trend.includes("(trend_chart): point 1 label"),"Unlocated trend refusal: "+located_trend);
  // The existing fact sections keep the decisions the one predicate already made.
  let metrics: catalogue.Configured = await configured("metrics","{\"values\":[{\"label\":\"first\",\"value\":\"items\"}]}");
  count = count+checked(admits(metrics,"","{\"facts\":[{\"label\":\"first\",\"value\":\"items\"}]}",false),"Disclosed metric refused");
  let located_metric: string = catalogue.disclosed(metrics,"","{\"facts\":[{\"label\":\"first\",\"value\":\"other\"}]}",false);
  count = count+checked(located_metric.includes("(metrics): row 0 value"),"Unlocated metric refusal: "+located_metric);
  let invented_metric_label: catalogue.Configured = await configured("metrics","{\"values\":[{\"label\":\"third\",\"value\":\"items\"}]}");
  let located_metric_label: string = catalogue.disclosed(invented_metric_label,"","{\"facts\":[{\"label\":\"first\",\"value\":\"items\"}]}",false);
  count = count+checked(located_metric_label.includes("(metrics): row 0 label"),"Unlocated metric label refusal: "+located_metric_label);
  // The existing checklist keeps the same one-predicate decision for an invented row label.
  let invented_checklist: catalogue.Configured = await configured("checklist","{\"items\":[{\"id\":\"a\",\"label\":\"Alpha\"}]}");
  let located_checklist: string = catalogue.disclosed(invented_checklist,request,"",false);
  count = count+checked(located_checklist.includes("(checklist): row 0 label"),"Unlocated checklist refusal: "+located_checklist);
  let invented_detail_row: catalogue.Configured = await configured("checklist","{\"items\":[{\"id\":\"a\",\"label\":\"Alpha\",\"detail\":\"secret\"}]}");
  let located_detail_row: string = catalogue.disclosed(invented_detail_row,"Alpha","",false);
  count = count+checked(located_detail_row.includes("(checklist): row 0 detail"),"Unlocated checklist detail refusal: "+located_detail_row);
  // A user-owned note keeps exact disclosed text; the same note not marked user-owned is admitted.
  let owned_note: catalogue.Configured = await configured("note","{\"text\":\"invented\"}");
  let located_note: string = catalogue.disclosed(owned_note,"","",true);
  count = count+checked(located_note.includes("(note): note text"),"Unlocated user-owned note refusal: "+located_note);
  count = count+checked(admits(owned_note,"","",false),"A note that is not user-owned was refused");
  // An empty text carries no content, so an empty user-owned note is admitted like any other empty value.
  let empty_note: catalogue.Configured = await configured("note","{\"text\":\"\"}");
  count = count+checked(admits(empty_note,"","",true),"An empty user-owned note demanded evidence");
  // The user-owned rule belongs to notes only: a fact section under a user-owned answer is admitted.
  count = count+checked(admits(metrics,"","{\"facts\":[{\"label\":\"first\",\"value\":\"items\"}]}",true),"A user-owned fact section was refused");
  let facts_owned: catalogue.Configured = await configured("key_facts","{\"items\":[{\"label\":\"second\",\"value\":\"done\"}]}");
  count = count+checked(admits(facts_owned,"here: second done","",false),"Request-provenance fact refused");
  // The search and master lists hold the same disclosed entry rows, so the one predicate decides their
  // labels and details too, and the refusal locates the row and the field.
  let search: catalogue.Configured = await configured("search_list","{\"items\":[{\"id\":\"a\",\"label\":\"Alpha\",\"detail\":\"first\"}]}");
  count = count+checked(admits(search,"Show Alpha first","",false),"Disclosed search row refused");
  let located_search: string = catalogue.disclosed(search,request,"",false);
  count = count+checked(located_search.includes("(search_list): row 0 label"),"Unlocated search refusal: "+located_search);
  let master: catalogue.Configured = await configured("master_list","{\"items\":[{\"id\":\"a\",\"label\":\"Alpha\"}]}");
  let located_master: string = catalogue.disclosed(master,"","",false);
  count = count+checked(located_master.includes("(master_list): row 0 label"),"Unlocated master refusal: "+located_master);
  // The refusal names the instance, not the kind: a need with its own identity is located by it.
  let results: catalogue.Configured = {need:"results",definition:definition("search_list"),parameters:await accepts("search_list","{\"items\":[{\"id\":\"a\",\"label\":\"Alpha\"}]}"),accepted:true,reason:""};
  let located_instance: string = catalogue.disclosed(results,"","",false);
  count = count+checked(located_instance.includes("section_results (search_list): row 0 label"),"Unlocated instance refusal: "+located_instance);
  // A stop's supplied coordinate pair is disclosed navigation content: the pair is admitted from
  // evidence, and a fabricated latitude or longitude is refused with its stop and field.
  let trip: string = "{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":10,\"latitude\":12.5,\"longitude\":34.5}]}";
  let placed: catalogue.Configured = await configured("itinerary",trip);
  count = count+checked(admits(placed,"","{\"hop\":{\"label\":\"Home\",\"minutes\":10,\"lat\":12.5,\"lon\":34.5}}",false),"Disclosed stop coordinates refused");
  let invented_latitude: catalogue.Configured = await configured("itinerary",trip);
  let located_latitude: string = catalogue.disclosed(invented_latitude,"","{\"start\":{\"label\":\"Home\"},\"hop\":{\"minutes\":10,\"lon\":34.5}}",false);
  count = count+checked(located_latitude.includes("(itinerary): stop 0 latitude"),"Unlocated stop latitude refusal: "+located_latitude);
  let invented_longitude: catalogue.Configured = await configured("itinerary",trip);
  let located_longitude: string = catalogue.disclosed(invented_longitude,"","{\"start\":{\"label\":\"Home\"},\"hop\":{\"minutes\":10,\"lat\":12.5}}",false);
  count = count+checked(located_longitude.includes("(itinerary): stop 0 longitude"),"Unlocated stop longitude refusal: "+located_longitude);
  // An absent coordinate pair supplies nothing, so a stop without coordinates needs no coordinate evidence.
  let unplaced: catalogue.Configured = await configured("itinerary","{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":5}]}");
  count = count+checked(admits(unplaced,"","{\"hop\":{\"label\":\"Home\",\"minutes\":5}}",false),"A stop without coordinates demanded evidence");
  // A one-shot reminder's day is a supplied fact like its minute; a daily reminder carries no day.
  let once: catalogue.Configured = await configured("reminders","{\"rows\":[{\"id\":\"a\",\"title\":\"Pill\",\"minute\":600,\"day\":99}]}");
  count = count+checked(admits(once,"","{\"reminders\":[{\"title\":\"Pill\",\"minute\":600,\"day\":99}]}",false),"Disclosed one-shot reminder refused");
  let invented_day: catalogue.Configured = await configured("reminders","{\"rows\":[{\"id\":\"a\",\"title\":\"Pill\",\"minute\":600,\"day\":99}]}");
  let located_day: string = catalogue.disclosed(invented_day,"","{\"reminders\":[{\"title\":\"Pill\",\"minute\":600}]}",false);
  count = count+checked(located_day.includes("(reminders): reminder 0 day"),"Unlocated reminder day refusal: "+located_day);
  let daily: catalogue.Configured = await configured("reminders","{\"rows\":[{\"id\":\"a\",\"title\":\"Pill\",\"minute\":600,\"daily\":true}]}");
  count = count+checked(admits(daily,"","{\"reminders\":[{\"title\":\"Pill\",\"minute\":600}]}",false),"A daily reminder demanded a day");
  // The reminder title and minute are supplied content too, so each fabricated one is refused with its
  // row and field rather than admitted beside the evidenced day.
  let invented_reminder_title: catalogue.Configured = await configured("reminders","{\"rows\":[{\"id\":\"a\",\"title\":\"Vitamins\",\"minute\":600,\"day\":99}]}");
  let located_reminder_title: string = catalogue.disclosed(invented_reminder_title,"","{\"reminders\":[{\"title\":\"Pill\",\"minute\":600,\"day\":99}]}",false);
  count = count+checked(located_reminder_title.includes("(reminders): reminder 0 title"),"Unlocated reminder title refusal: "+located_reminder_title);
  let invented_reminder_minute: catalogue.Configured = await configured("reminders","{\"rows\":[{\"id\":\"a\",\"title\":\"Pill\",\"minute\":601,\"day\":99}]}");
  let located_reminder_minute: string = catalogue.disclosed(invented_reminder_minute,"","{\"reminders\":[{\"title\":\"Pill\",\"minute\":600,\"day\":99}]}",false);
  count = count+checked(located_reminder_minute.includes("(reminders): reminder 0 minute"),"Unlocated reminder minute refusal: "+located_reminder_minute);
  return count;
}

// Initialization copies the disclosed values once, keeps them immutable and explains empty datasets.
export async function initialization(): Promise<string> {
  let result: Record<string, unknown> = {};
  result.data_table = s.encode(await catalogue.instantiate(await configured("data_table","{\"title\":\"Spend\",\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"],[\"Food\",\"2.5\",\"quote \\\" \\u0001 \ud83d\ude00 \ud800\"]]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.timeline = s.encode(await catalogue.instantiate(await configured("timeline","{\"rows\":[{\"minute\":570,\"title\":\"Standup\",\"detail\":\"quote \\\" and \\\\ and \\n and \ud83d\ude00\"},{\"minute\":600,\"title\":\"Review\"}]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.bar_chart = s.encode(await catalogue.instantiate(await configured("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":2.5},{\"label\":\"Wed\",\"value\":10}],\"maximum\":10}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  // The emitted initializers keep the supplied point order, never a sorted copy.
  result.unsorted_bars = s.encode(await catalogue.instantiate(await configured("bar_chart","{\"points\":[{\"label\":\"Wed\",\"value\":10},{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":2.5}],\"maximum\":10}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.unsorted_trend = s.encode(await catalogue.instantiate(await configured("trend_chart","{\"points\":[{\"label\":\"c\",\"value\":3},{\"label\":\"a\",\"value\":-2},{\"label\":\"b\",\"value\":0.25}],\"minimum\":-3,\"maximum\":3}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.trend_chart = s.encode(await catalogue.instantiate(await configured("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":-2},{\"label\":\"b\",\"value\":0.25},{\"label\":\"c\",\"value\":3}],\"minimum\":-3,\"maximum\":3}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.empty_table = s.encode(await catalogue.instantiate(await configured("data_table","{\"headers\":[\"A\",\"B\",\"C\"],\"rows\":[]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.empty_timeline = s.encode(await catalogue.instantiate(await configured("timeline","{\"rows\":[]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.empty_chart = s.encode(await catalogue.instantiate(await configured("bar_chart","{\"points\":[],\"maximum\":4}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.zero_chart = s.encode(await catalogue.instantiate(await configured("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":0},{\"label\":\"b\",\"value\":0}],\"minimum\":-1,\"maximum\":1}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.metrics = s.encode(await catalogue.instantiate(await configured("metrics","{\"values\":[{\"label\":\"first\",\"value\":\"items\"},{\"label\":\"second\",\"value\":\"done\"}]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.key_facts = s.encode(await catalogue.instantiate(await configured("key_facts","{\"items\":[{\"label\":\"first\",\"value\":\"items\"}]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.empty_facts = s.encode(await catalogue.instantiate(await configured("metrics","{\"values\":[]}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  result.spotlight = s.encode(await catalogue.instantiate(await configured("spotlight","{\"message\":\"Shown\"}"),{contracts:[],sources:[],bindings:[],actions:[]}));
  return s.encode(result);
}

// Assembly: every emitted section joins one real composition and assembles without a computation.
export async function assembly(): Promise<string> {
  let registry: bindings.Registry = bindings.create([]);
  let composition: screens.Composition = {screen:{title:"Read only",target:"screen",layout:{kind:"stack",positions:[]},slots:[],instances:[]},bindings:{},actions:{},connections:[]};
  composition.screen.instances[0] = await catalogue.instantiate({need:"table",definition:definition("data_table"),parameters:await accepts("data_table","{\"title\":\"Table\",\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"]]}"),accepted:true,reason:""},registry);
  composition.screen.instances[1] = await catalogue.instantiate({need:"bars",definition:definition("bar_chart"),parameters:await accepts("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":0},{\"label\":\"Tue\",\"value\":2.5}],\"maximum\":10}"),accepted:true,reason:""},registry);
  composition.screen.instances[2] = await catalogue.instantiate({need:"trend",definition:definition("trend_chart"),parameters:await accepts("trend_chart","{\"points\":[{\"label\":\"a\",\"value\":-2},{\"label\":\"b\",\"value\":0.25}],\"minimum\":-3,\"maximum\":3}"),accepted:true,reason:""},registry);
  composition.screen.instances[3] = await catalogue.instantiate({need:"rail",definition:definition("timeline"),parameters:await accepts("timeline","{\"title\":\"Rail\",\"rows\":[{\"minute\":570,\"title\":\"Standup\",\"detail\":\"daily\"},{\"minute\":600,\"title\":\"Review\"}]}"),accepted:true,reason:""},registry);
  composition.screen.instances[4] = await catalogue.instantiate({need:"facts",definition:definition("metrics"),parameters:await accepts("metrics","{\"values\":[{\"label\":\"first\",\"value\":\"items\"}]}"),accepted:true,reason:""},registry);
  composition.screen.instances[5] = await catalogue.instantiate({need:"details",definition:definition("key_facts"),parameters:await accepts("key_facts","{\"items\":[{\"label\":\"second\",\"value\":\"done\"}]}"),accepted:true,reason:""},registry);
  composition.screen.instances[6] = await catalogue.instantiate({need:"empty",definition:definition("data_table"),parameters:await accepts("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[]}"),accepted:true,reason:""},registry);
  composition.screen.instances[7] = await catalogue.instantiate({need:"spot",definition:definition("spotlight"),parameters:await accepts("spotlight","{\"message\":\"Shown\"}"),accepted:true,reason:""},registry);
  let assembled: composer.Result = await composer.assemble(composition,[]);
  return s.encode(assembled.source);
}
// Initial generation applies no catalogue instance count and kinds stay unique: seven distinct kinds
// instantiate and assemble in one composition, while a duplicate kind is refused at decode.
export async function instanceCount(): Promise<string> {
  let registry: bindings.Registry = bindings.create([]);
  let seat: screens.Position = {id:"main",allowedKinds:["checklist","metrics","spotlight","data_table","timeline","bar_chart","key_facts"],minimum:0,maximum:7};
  let composition: screens.Composition = {screen:{title:"Seven kinds",target:"screen",layout:{kind:"positions",positions:[seat]},slots:[],instances:[]},bindings:{},actions:{},connections:[]};
  composition.screen.instances[0] = await catalogue.instantiate({need:"k0",definition:definition("checklist"),parameters:await accepts("checklist","{\"items\":[{\"id\":\"a\",\"label\":\"Alpha\"}]}"),accepted:true,reason:""},registry);
  composition.screen.instances[1] = await catalogue.instantiate({need:"k1",definition:definition("metrics"),parameters:await accepts("metrics","{\"values\":[{\"label\":\"first\",\"value\":\"items\"}]}"),accepted:true,reason:""},registry);
  composition.screen.instances[2] = await catalogue.instantiate({need:"k2",definition:definition("spotlight"),parameters:await accepts("spotlight","{\"message\":\"Shown\"}"),accepted:true,reason:""},registry);
  composition.screen.instances[3] = await catalogue.instantiate({need:"k3",definition:definition("data_table"),parameters:await accepts("data_table","{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"rows\":[[\"Rent\",\"40\",\"paid\"]]}"),accepted:true,reason:""},registry);
  composition.screen.instances[4] = await catalogue.instantiate({need:"k4",definition:definition("timeline"),parameters:await accepts("timeline","{\"rows\":[{\"minute\":570,\"title\":\"Standup\"}]}"),accepted:true,reason:""},registry);
  composition.screen.instances[5] = await catalogue.instantiate({need:"k5",definition:definition("bar_chart"),parameters:await accepts("bar_chart","{\"points\":[{\"label\":\"Mon\",\"value\":1}],\"maximum\":10}"),accepted:true,reason:""},registry);
  composition.screen.instances[6] = await catalogue.instantiate({need:"k6",definition:definition("key_facts"),parameters:await accepts("key_facts","{\"items\":[{\"label\":\"second\",\"value\":\"done\"}]}"),accepted:true,reason:""},registry);
  let needIds: string[] = [];
  for (let instance of composition.screen.instances) {
    instance.position = "main";
    let need: string = instance.fragment.covers[0]; needIds[needIds.length] = need;
    composition.screen.slots[composition.screen.slots.length] = {id:need,need:need,reads:[],writes:[],provider:false,allowedKinds:[instance.kind],valueType:"",status:"filled",instance:instance.id,reason:""};
  }
  // The emitted composition is decoded again through the production composition decoder, so the
  // no-count rule and the unique-kind rule are proved at the decode seam, not only in memory.
  let projection: screens.Projection = screens.decode(s.encode(composition),"screen",needIds);
  let decoded: screens.Composition = projection.composition;
  let computations: composer.Computation[] = [];
  for (let instance of decoded.screen.instances) { for (let entry of catalogue.computations(instance,decoded.connections,decoded.screen.instances)) { computations[computations.length] = entry; } }
  let assembled: composer.Result = await composer.assemble(decoded,computations);
  let kinds: string[] = []; for (let instance of decoded.screen.instances) { kinds[kinds.length] = instance.kind; }
  let decodedCount: number = decoded.screen.instances.length;
  // A second instance of an already selected kind is refused before any source is emitted.
  let duplicateRefused: boolean = false;
  let raw: string = "{\"screen\":{\"title\":\"Duplicate\",\"target\":\"screen\",\"layout\":{\"kind\":\"stack\"},\"slots\":[],\"instances\":["+
    "{\"id\":\"a\",\"kind\":\"spotlight\",\"origin\":\"catalogue\",\"parameters\":{},\"definition\":{\"fields\":[],\"ports\":[],\"actions\":[],\"holes\":[]},\"bodies\":{},\"fragment\":{\"declarations\":\"\",\"fields\":[],\"updates\":[],\"effects\":[],\"helpers\":\"\",\"view\":\"v\",\"options\":[],\"content\":[],\"ports\":[],\"holes\":[],\"covers\":[],\"owns\":[]}},"+
    "{\"id\":\"b\",\"kind\":\"spotlight\",\"origin\":\"catalogue\",\"parameters\":{},\"definition\":{\"fields\":[],\"ports\":[],\"actions\":[],\"holes\":[]},\"bodies\":{},\"fragment\":{\"declarations\":\"\",\"fields\":[],\"updates\":[],\"effects\":[],\"helpers\":\"\",\"view\":\"v\",\"options\":[],\"content\":[],\"ports\":[],\"holes\":[],\"covers\":[],\"owns\":[]}}]},\"bindings\":{},\"actions\":{},\"connections\":[]}";
  try { screens.decode(raw,"screen",[]); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } duplicateRefused = error.message.includes("Duplicate identity: spotlight"); }
  return s.encode({instances:decodedCount,kinds:kinds,duplicate:duplicateRefused,deal:assembled.source.deal,dealui:assembled.source.dealui});
}

// The production fill: one real model answer decodes every issued section at the one call site
// construction uses, so an empty table, a fabricated cell and a short row are decided as at runtime.
export async function fillPath(): Promise<string> {
  let context: selecting.Context = {original:"Show what I paid",facts:"{\"headers\":[\"Item\",\"Amount\",\"Note\"],\"row\":{\"item\":\"Rent\",\"amount\":\"40\"}}",contracts:"[]",specification:"specification"};
  let plan: plans.Plan = {title:"Table",eyebrow:"",subtitle:"",inputs:[],constants:[],requirements:[],needs:[{id:"empty",type:"content",words:"Show the disclosed table",quote:"",reads:[],required:true,spec:{}},{id:"unanswered",type:"content",words:"Show the disclosed table",quote:"",reads:[],required:true,spec:{}},{id:"fabricated",type:"content",words:"Show the disclosed table",quote:"",reads:[],required:true,spec:{}},{id:"short",type:"content",words:"Show the disclosed table",quote:"",reads:[],required:true,spec:{}},{id:"nulled",type:"content",words:"Show the disclosed table",quote:"",reads:[],required:true,spec:{}},{id:"measured",type:"content",words:"Show my measurement",quote:"",reads:[],required:true,spec:{}}],questions:[]};
  let empty: catalogue.Configured = {need:"empty",definition:definition("data_table"),parameters:{},accepted:false,reason:"Not filled"};
  let fabricated: catalogue.Configured = {need:"fabricated",definition:definition("data_table"),parameters:{},accepted:false,reason:"Not filled"};
  let unanswered: catalogue.Configured = {need:"unanswered",definition:definition("data_table"),parameters:{},accepted:false,reason:catalogue.notFilled()};
  let short: catalogue.Configured = {need:"short",definition:definition("data_table"),parameters:{},accepted:false,reason:"Not filled"};
  let nulled: catalogue.Configured = {need:"nulled",definition:definition("data_table"),parameters:{},accepted:false,reason:"Not filled"};
  // The numeric-presentation domain is applied by the fill decoder, and its refusal locates the instance
  // whose parameters kept their defaults.
  let measured: catalogue.Configured = {need:"measured",definition:definition("reading_status"),parameters:{},accepted:false,reason:catalogue.notFilled()};
  await catalogue.fill(context,plan,[empty,unanswered,fabricated,short,nulled,measured]);
  // Construction applies the one predicate after an accepted fill; a rejected decode never reaches it.
  let admittedEmpty: boolean = catalogue.disclosed(empty,context.original,context.facts,false) === "";
  let locatedFabricated: string = catalogue.disclosed(fabricated,context.original,context.facts,false);
  return s.encode({empty:empty,unanswered:unanswered,fabricated:fabricated,short:short,nulled:nulled,measured:measured,admittedEmpty:admittedEmpty,locatedFabricated:locatedFabricated});
}

// The two Select batches and alignment issue reader kinds only for a need that requests a dependency
// another plan need publishes. A read that names an input or a constant asks for a seed, so a reader
// kind offered for it could never be connected; the same predicate governs both call sites.
export async function alternatives(): Promise<string> {
  let plan: plans.Plan = plans.decode("{\"title\":\"Reader\",\"constants\":[],\"requirements\":[],\"questions\":[],\"inputs\":[{\"id\":\"value\",\"label\":\"Value\",\"kind\":\"count\",\"measure\":\"count\",\"value\":3}],\"needs\":[{\"id\":\"items\",\"type\":\"content\",\"words\":\"Toggle the items\",\"reads\":[],\"spec\":{}},{\"id\":\"summary\",\"type\":\"content\",\"words\":\"Show completion\",\"reads\":[\"items\"],\"spec\":{}},{\"id\":\"seeded\",\"type\":\"content\",\"words\":\"Show the edited value\",\"reads\":[\"value\"],\"spec\":{}}]}",[],[],"","");
  let offered: Record<string, unknown> = {};
  for (let need of plan.needs) {
    let kinds: string[] = [];
    for (let alternative of catalogue.alternatives(plan)) { if (alternative.need === need.id) { kinds[kinds.length] = alternative.kind; } }
    offered[need.id] = kinds;
  }
  return s.encode(offered);
}

// A supplied composition registry reference must name an issued binding, and a resolvable reference
// still has no executable navigation/calendar producer in this build: both refusals locate the need
// and reject before any fragment is emitted.
export async function registryRefusals(): Promise<number> {
  let count: number = 0;
  let navigation: string = "{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":5}],\"navigationBinding\":\"nav_1\"}";
  let calendar: string = "{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":5}],\"calendarBinding\":\"nav_1\"}";
  let supplied: string[] = ["navigationBinding","calendarBinding"];
  let wire: string[] = [navigation,calendar];
  let index: number = 0;
  // A binding the composition issued is dispatched: the section emits the start action, the completion
  // action and the asynchronous effect that calls exactly that module and function with the issued
  // argument source. The argument is passed as the source getter, not re-read from a model string.
  while (index < supplied.length) {
    let issued: bindings.Registry = bindings.create([]);
    bindings.reserve(issued,{id:"stop",type:"string",schema:null,dependencies:[],owner:"parts",payloadOwner:"",getter:"f_parts_stop",ready:"true"});
    issued.bindings[0] = {id:"nav_1",module:"host/navigation",function:"open",arguments:{target:"stop"},parameterOrder:["target"],owner:"host",evidence:{request:"",facts:"",quote:"",sources:["stop"]}};
    let entry: catalogue.Configured = {need:"trip",definition:definition("itinerary"),parameters:await accepts("itinerary",wire[index]),accepted:true,reason:""};
    let instance: screens.Instance = await catalogue.instantiate(entry,issued);
    let startName: string = "Navigate"; let runName: string = "run_navigate";
    if (supplied[index] === "calendarBinding") { startName = "ScheduleTrip"; runName = "run_trip"; }
    let dispatched: boolean = instance.fragment.effects.length === 1 && instance.fragment.effects[0].action === startName && instance.fragment.effects[0].function === runName;
    let imported: boolean = instance.fragment.declarations.includes("import * as provider_"+runName.substring(4)+" from \"host/navigation\"");
    let call: boolean = instance.fragment.helpers.includes("provider_"+runName.substring(4)+".open((state.f_parts_stop as string))");
    let handled: boolean = false; for (let entryHandler of instance.fragment.updates) { if (entryHandler.action === "Navigated" && startName === "Navigate") { handled = true; } if (entryHandler.action === "ScheduledTrip" && startName === "ScheduleTrip") { handled = true; } }
    insist(dispatched && imported && call && handled,"Itinerary binding issued no dispatch: "+supplied[index]);
    count = count+1;
    index = index+1;
  }
  // A reference the composition never issued rejects as an unresolved registry reference instead.
  let bare: bindings.Registry = bindings.create([]);
  let unissued: catalogue.Configured = {need:"trip",definition:definition("itinerary"),parameters:await accepts("itinerary",navigation),accepted:true,reason:""};
  let unresolved: boolean = false;
  try { await catalogue.instantiate(unissued,bare); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } unresolved = error.message.includes("Unresolved catalogue registry reference: nav_1"); }
  insist(unresolved,"Unissued itinerary binding admitted or unlocated");
  count = count+1;
  // A descriptor is a resolvable reference too: the dispatch resolves the descriptor's own binding, so
  // a catalogue section never names a module or function itself.
  let described: bindings.Registry = bindings.create([]);
  described.bindings[0] = {id:"sched_1",module:"host/calendar",function:"schedule",arguments:{},parameterOrder:[],owner:"run",evidence:{request:"",facts:"",quote:"",sources:[]}};
  described.actions[0] = {id:"run",label:"Schedule",binding:"sched_1",evidence:{request:"",facts:"",quote:"",sources:[]}};
  let reminderEntry: catalogue.Configured = {need:"remind",definition:definition("reminders"),parameters:await accepts("reminders","{\"rows\":[],\"scheduleBinding\":\"run\"}"),accepted:true,reason:""};
  let reminder: screens.Instance = await catalogue.instantiate(reminderEntry,described);
  // Reminders count completed and successfully scheduled rows: the scheduled count reads the recorded
  // reply keys, and the row control carries the row identity the attempt records.
  let reminderEffect: boolean = reminder.fragment.effects.length === 1 && reminder.fragment.effects[0].action === "ScheduleReminder";
  let reminderImport: boolean = reminder.fragment.declarations.includes("import * as provider_schedule from \"host/calendar\"");
  let reminderControl: boolean = reminder.fragment.view.includes("value: state.schedule_sequence, onClick: action app.ScheduleReminder {sequence: payload, id: row.id}");
  insist(reminderEffect && reminderImport && reminderControl,"Reminder schedule binding issued no per-row dispatch");
  let scheduled: boolean = false;
  for (let entry of catalogue.computations(reminder,[],[reminder])) { if (entry.field === "scheduled") { scheduled = entry.value === "scheduledCount(state)"; } }
  insist(scheduled,"The reminder scheduled count does not read the recorded replies");
  count = count+1;
  // An unissued reference is an unresolved registry reference, so resolution runs before any emission.
  let bareSchedule: catalogue.Configured = {need:"remind",definition:definition("reminders"),parameters:await accepts("reminders","{\"rows\":[],\"scheduleBinding\":\"sched_1\"}"),accepted:true,reason:""};
  let unresolvedSchedule: boolean = false;
  try { await catalogue.instantiate(bareSchedule,bindings.create([])); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } unresolvedSchedule = error.message.includes("Unresolved catalogue registry reference: sched_1"); }
  insist(unresolvedSchedule,"Unissued reminder schedule binding admitted or mislocated");
  count = count+1;
  // A dose schedule reconciles the daily mark through the calendar reply: the mark reducer exists only
  // as the completion of the dispatched operation, so a refused reply records no dose.
  let issuedCalendar: bindings.Registry = bindings.create([]);
  issuedCalendar.bindings[0] = {id:"cal_1",module:"host/calendar",function:"create",arguments:{},parameterOrder:[],owner:"host",evidence:{request:"",facts:"",quote:"",sources:[]}};
  let doseEntry: catalogue.Configured = {need:"doses",definition:definition("dose_schedule"),parameters:await accepts("dose_schedule","{\"rows\":[],\"calendarBinding\":\"cal_1\"}"),accepted:true,reason:""};
  let dose: screens.Instance = await catalogue.instantiate(doseEntry,issuedCalendar);
  let takeEffect: boolean = dose.fragment.effects.length === 1 && dose.fragment.effects[0].action === "TakeDose" && dose.fragment.effects[0].function === "run_take";
  let reconciled: boolean = dose.fragment.helpers.includes("taken_keys: takenKeys(state, state.take_target, takeDay)");
  let noLocalMark: boolean = !dose.fragment.helpers.includes("export function markDose(");
  insist(takeEffect && reconciled && noLocalMark,"Dose calendar binding did not reconcile the taken mark through the reply");
  count = count+1;
  let bareCalendar: catalogue.Configured = {need:"doses",definition:definition("dose_schedule"),parameters:await accepts("dose_schedule","{\"rows\":[],\"calendarBinding\":\"cal_1\"}"),accepted:true,reason:""};
  let unresolvedCalendar: boolean = false;
  try { await catalogue.instantiate(bareCalendar,bindings.create([])); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } unresolvedCalendar = error.message.includes("Unresolved catalogue registry reference: cal_1"); }
  insist(unresolvedCalendar,"Unissued dose calendar binding admitted or mislocated");
  count = count+1;
  // calendar_event is executable: the explicit Add dispatches the disclosed calendar operation with the
  // issued argument source, and the section publishes no port of its own.
  let eventRegistry: bindings.Registry = bindings.create([]);
  bindings.reserve(eventRegistry,{id:"minute",type:"number",schema:null,dependencies:[],owner:"parts",payloadOwner:"",getter:"f_parts_minute",ready:"true"});
  eventRegistry.bindings[0] = {id:"cal_2",module:"host/calendar",function:"propose",arguments:{minute:"minute"},parameterOrder:["minute"],owner:"host",evidence:{request:"",facts:"",quote:"",sources:["minute"]}};
  let eventEntry: catalogue.Configured = {need:"event",definition:definition("calendar_event"),parameters:await accepts("calendar_event","{\"eventTitle\":\"Show\",\"day\":4,\"minute\":570,\"durationMinutes\":90,\"calendarBinding\":\"cal_2\"}"),accepted:true,reason:""};
  let event: screens.Instance = await catalogue.instantiate(eventEntry,eventRegistry);
  let eventDispatched: boolean = event.fragment.effects.length === 1 && event.fragment.effects[0].action === "AddEvent" && event.fragment.effects[0].function === "run_event";
  let eventCall: boolean = event.fragment.helpers.includes("provider_event.propose((state.f_parts_minute as number))");
  let eventPending: boolean = event.fragment.fields.some((item: screens.Field): boolean => item.name === "event_pending" && item.type === "boolean");
  let eventControl: boolean = event.fragment.view.includes("value: state.event_sequence, onClick: action app.AddEvent {sequence: payload, id: \"\"}");
  let noPorts: boolean = event.fragment.ports.length === 0;
  insist(eventDispatched && eventCall && eventPending && eventControl && noPorts,"calendar_event issued no explicit Add over the disclosed operation");
  count = count+1;
  // A dispatch never calls the operation with an unavailable argument, and a refused duplicate never
