  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com:/a.json\",\"mode\":\"api\"}}","empty port on a named host");
