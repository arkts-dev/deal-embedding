  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[fc00::1]/a.json\",\"mode\":\"api\"}}","nonpublic IPv6 live source");
  // The decode classifier is the probe binding's own rule, applied to the parsed hextets instead of to the
