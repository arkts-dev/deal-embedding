  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com/a%20b.json\",\"mode\":\"api\"}}"));
  // A sub-delimiter in the path and square brackets in the query are legal in the transport's parser.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com/a(b.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com?a=[1]\",\"mode\":\"api\"}}"));
  // An address-like prefix that ends in a public name is a name: only the final label decides whether the
  // authority is read as an address.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://999.1.1.1.a/a.json\",\"mode\":\"api\"}}"));
  // A final label that begins with a letter is a name even when it contains digits.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.a1/a.json\",\"mode\":\"api\"}}"));
  // Blocks a probe can only reach through the network are admitted beside the refused ones, so the rule
  // refuses what cannot be reached rather than a whole family.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:3::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:4:112::1]/a.json\",\"mode\":\"api\"}}"));
  // A block the network refuses at connect time is admitted, exactly as a name that does not resolve is.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:1::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:5::1]/a.json\",\"mode\":\"api\"}}"));
  // The admitted tail of 2001::/23: the second hextets beside the refused blocks run to 0x01ff, and the
  // boundary beside benchmarking is admitted.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:1ff::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:0ff::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:40::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:0f::1]/a.json\",\"mode\":\"api\"}}"));
  // 3fff::/16 is refused whole, so its upper half is refused too and not only the documentation /20.
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[3fff:ffff::1]/a.json\",\"mode\":\"api\"}}","documentation IPv6 block edge");
  // An ordinary global-unicast destination beyond the /23 this rule enumerates is admitted like any other.
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:4860::8888]/a.json\",\"mode\":\"api\"}}"));
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com/a.json\",\"mode\":\"browser\"}}","unknown live source mode");
  // The descriptor panel's identity list carries the shared array bound.
  count = count+await rejects("intent_panel","{\"actionIds\":[\"a1\",\"a2\",\"a3\",\"a4\",\"a5\",\"a6\",\"a7\",\"a8\",\"a9\",\"a10\",\"a11\",\"a12\",\"a13\"]}","thirteen descriptor identities");
  count = count+await rejects("intent_panel","{\"actionIds\":[]}","no descriptor identities");
  count = count+await rejects("intent_panel","{\"actionIds\":[\"a\",\"a\"]}","duplicate descriptor identities");
  // The shared numeric and text domains of the remaining rows.
  count = count+await rejects("rating","{\"initial\":0}","rating below one");
  count = count+await rejects("rating","{\"initial\":11}","rating above ten");
  count = count+await rejects("progress_goal","{\"goal\":0,\"step\":1}","nonpositive goal");
  count = count+await rejects("progress_goal","{\"goal\":1,\"step\":0}","nonpositive step");
  count = count+await rejects("quick_log","{\"amount\":0,\"unit\":\"glass\",\"goal\":8}","nonpositive log amount");
  count = count+await rejects("interval_timer","{\"workSeconds\":5,\"restSeconds\":2,\"rounds\":0}","zero rounds");
  count = count+await rejects("interval_timer","{\"workSeconds\":5,\"restSeconds\":2,\"rounds\":1.5}","fractional rounds");
  count = count+await rejects("series_chart","{\"mode\":\"everything\"}","unknown series mode");
  count = count+await rejects("record_log","{\"labels\":[],\"currency\":\"EUR\"}","no log labels");
  count = count+await rejects("record_log","{\"labels\":[\"a\",\"a\"],\"currency\":\"EUR\"}","duplicate log labels");
  count = count+await rejects("record_log","{\"labels\":[\"a\"],\"currency\":\"\"}","empty currency");
  count = count+await rejects("idea_deck","{\"ideas\":[{\"id\":\"a\",\"title\":\"Walk\",\"level\":\"easy\",\"instructions\":\"\",\"minutes\":0}]}","nonpositive idea duration");
  count = count+await rejects("due_items","{\"rows\":[{\"id\":\"a\",\"name\":\"Tax\",\"day\":1.5}]}","fractional due day");
  count = count+await rejects("due_items","{\"rows\":[],\"soonDays\":-1}","negative soon days");
  count = count+await rejects("due_items","{\"rows\":[],\"soonDays\":1.5}","fractional soon days");
  count = count+await rejects("dose_schedule","{\"rows\":[{\"id\":\"a\",\"name\":\"Dose\",\"minute\":-1}]}","negative dose minute");
  return count;
}
export function main(): void { return; }
