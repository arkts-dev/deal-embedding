  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://192.0.0.9/a.json\",\"mode\":\"api\"}}","IPv4 protocol-assignment live source");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:20::1]/a.json\",\"mode\":\"api\"}}","protocol-assignment IPv6 block");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:3f::1]/a.json\",\"mode\":\"api\"}}","protocol-assignment IPv6 block edge");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:10::1]/a.json\",\"mode\":\"api\"}}","protocol-assignment IPv6 block");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:30::1]/a.json\",\"mode\":\"api\"}}","protocol-assignment IPv6 block");
