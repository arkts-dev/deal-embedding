  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.4a/a.json\",\"mode\":\"api\"}}","final label beginning with a digit");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://134744072/a.json\",\"mode\":\"api\"}}","legacy single-number IPv4 spelling");
  // A dotted quad is one to three digits per component, the width the isolate binding's address test reads:
