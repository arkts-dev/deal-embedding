  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[::1]/a.json\",\"mode\":\"api\"}}","loopback IPv6 live source");
