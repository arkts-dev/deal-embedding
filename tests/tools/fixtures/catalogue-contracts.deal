  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com:abc/a.json\",\"mode\":\"api\"}}","spelled port on a named host");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.com:99999/a.json\",\"mode\":\"api\"}}","port beyond the transport range");
