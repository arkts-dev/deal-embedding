  let guarded: bindings.Registry = bindings.create([]);
  bindings.reserve(guarded,{id:"minute",type:"number",schema:null,dependencies:[],owner:"parts",payloadOwner:"",getter:"f_parts_minute",ready:"f_parts_minute_ready"});
  guarded.bindings[0] = {id:"cal_3",module:"host/calendar",function:"propose",arguments:{minute:"minute"},parameterOrder:["minute"],owner:"host",evidence:{request:"",facts:"",quote:"",sources:["minute"]}};
  let guardedEntry: catalogue.Configured = {need:"event",definition:definition("calendar_event"),parameters:await accepts("calendar_event","{\"eventTitle\":\"Show\",\"day\":4,\"minute\":570,\"durationMinutes\":90,\"calendarBinding\":\"cal_3\"}"),accepted:true,reason:""};
  let guardedEvent: screens.Instance = await catalogue.instantiate(guardedEntry,guarded);
  let readiness: boolean = guardedEvent.fragment.helpers.includes("|| !(state.f_parts_minute_ready)");
  let refusal: boolean = guardedEvent.fragment.helpers.includes("sequence: -1, ok: false, code: \"NOT_ADMITTED\"");
  insist(readiness,"a dispatch admitted an unready argument");
  insist(refusal,"a refused attempt claimed the live attempt identity");
  count = count+1;
  // An intent panel dispatches the issued descriptors themselves: each descriptor's label, its seeded draft
  // edited through the composition-owned nominal update, and one tap per descriptor whose effect calls
  // exactly the issued module and function with that descriptor's own argument source.
  let panelRegistry: bindings.Registry = bindings.create([]);
  bindings.reserve(panelRegistry,{id:"note_draft",type:"string",schema:null,dependencies:[],owner:"send",payloadOwner:"send",getter:"draft_note_draft",ready:"ready_note_draft",derived:true});
  panelRegistry.bindings[0] = {id:"send_op",module:"host/notes",function:"send",arguments:{text:"note_draft"},parameterOrder:["text"],owner:"send",evidence:{request:"",facts:"",quote:"",sources:["note_draft"]}};
  panelRegistry.actions[0] = {id:"send",label:"Send note",binding:"send_op",input:{sourceId:"note_draft",label:"Note",initial:"Hello"},evidence:{request:"",facts:"",quote:"",sources:[]}};
  panelRegistry.bindings[1] = {id:"ping_op",module:"host/notes",function:"ping",arguments:{},parameterOrder:[],owner:"ping",evidence:{request:"",facts:"",quote:"",sources:[]}};
  panelRegistry.actions[1] = {id:"ping",label:"Ping",binding:"ping_op",evidence:{request:"",facts:"",quote:"",sources:[]}};
  let panelEntry: catalogue.Configured = {need:"panel",definition:definition("intent_panel"),parameters:await accepts("intent_panel","{\"actionIds\":[\"send\",\"ping\"]}"),accepted:true,reason:""};
  let panel: screens.Instance = await catalogue.instantiate(panelEntry,panelRegistry);
  let panelDispatch: boolean = panel.fragment.effects.length === 1 && panel.fragment.effects[0].action === "TapDescriptor" && panel.fragment.effects[0].function === "runDescriptor";
  let panelImport: boolean = panel.fragment.declarations.includes("import * as descriptor_module_0 from \"host/notes\"") && panel.fragment.declarations.split("import * as descriptor_module_0").length === 2;
  let panelDraft: boolean = panel.fragment.view.includes("value: state.draft_note_draft, onChange: action app.Draft_note_draft {value: payload}");
  let panelCall: boolean = panel.fragment.helpers.includes("descriptor_module_0.send((state.draft_note_draft as string))") && panel.fragment.helpers.includes("descriptor_module_0.ping()");
  let panelTap: boolean = panel.fragment.view.includes("onClick: action app.TapDescriptor {id: \"send\", sequence: payload}") && panel.fragment.view.includes("onClick: action app.TapDescriptor {id: \"ping\", sequence: payload}");
  let panelOrder: number = panel.fragment.view.indexOf("ui.Text(text: \"Send note\")");
  let pingOrder: number = panel.fragment.view.indexOf("ui.Text(text: \"Ping\")");
  insist(panelDispatch && panelImport && panelDraft && panelCall && panelTap,"intent_panel rendered no issued descriptor workflow");
  insist(panelOrder >= 0 && pingOrder > panelOrder,"intent_panel did not render its descriptors in actionIds order");
  // One explicit attempt per descriptor: the attempt identity is recorded per descriptor, so a tap on a
  // pending descriptor is ignored while a tap on another descriptor is still admitted.
  let perDescriptor: boolean = panel.fragment.helpers.includes("state.tap_pending_send") && panel.fragment.helpers.includes("state.tap_pending_ping") && panel.fragment.helpers.includes("state.tap_attempt_send") ;
  insist(perDescriptor,"intent_panel did not track pending state per descriptor");
  count = count+1;
  // An id the composition never issued is an unresolved registry reference, never an invented operation.
  let unresolvedPanel: catalogue.Configured = {need:"panel",definition:definition("intent_panel"),parameters:await accepts("intent_panel","{\"actionIds\":[\"missing\"]}"),accepted:true,reason:""};
  let unresolvedDescriptor: boolean = false;
  try { await catalogue.instantiate(unresolvedPanel,panelRegistry); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } unresolvedDescriptor = error.message.includes("Unresolved catalogue registry reference: missing"); }
  insist(unresolvedDescriptor,"Unissued descriptor admitted or mislocated");
  count = count+1;
  // A live figure reads through the public probe: the section starts unavailable, one explicit Refresh and
  // the read-only poll of the declared mode dispatch the probe, the five specification ports are issued,
  // and the published observation time is the source's own asof value rather than a fetch time.
  let liveSource: string = "{\"url\":\"https://example.com/data.json\",\"mode\":\"api\",\"asofPath\":\"/updated\"}";
  let liveEntry: catalogue.Configured = {need:"live",definition:definition("live_figure"),parameters:await accepts("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"Temperature\",\"unit\":\"C\",\"path\":\"/current/temp\"}],\"source\":"+liveSource+"}"),accepted:true,reason:""};
  let live: screens.Instance = await catalogue.instantiate(liveEntry,bindings.create([]));
  let probeImport: boolean = live.fragment.declarations.includes("import * as probe_section_live from \"embedding/probe\"");
  let probeEffects: boolean = live.fragment.effects.length === 3;
  let refreshed: boolean = false; let polled: boolean = false; let completed: boolean = false; let activated: boolean = false;
  for (let entryEffect of live.fragment.effects) { if (entryEffect.action === "RefreshLive" && entryEffect.function === "runRefresh") { refreshed = true; } if (entryEffect.action === "PollLive" && entryEffect.function === "runPoll") { polled = true; } if (entryEffect.action === "Activate" && entryEffect.function === "runActivate") { activated = true; } }
  for (let entryHandler of live.fragment.updates) { if (entryHandler.action === "RefreshedLive") { completed = true; } }
  let livePorts: string[] = []; for (let port of live.fragment.ports) { livePorts[livePorts.length] = port.name+":"+port.type; }
  let declaredPorts: boolean = livePorts.length === 5 && livePorts[0] === "live1:number" && livePorts[1] === "live2:number" && livePorts[2] === "live3:number" && livePorts[3] === "live_source:string" && livePorts[4] === "live_asof:string";
  let unavailable: boolean = live.fragment.view.includes("When(!state.live1_ready) {ui.Text(text: \"Temperature unavailable\", style: \"muted\")}");
  let asofFromSource: boolean = live.fragment.helpers.includes("refresh_asof: action.asof");
  let refreshControl: boolean = live.fragment.view.includes("value: state.refresh_attempt, onClick: action app.RefreshLive {sequence: payload}");
  let apiPoll: boolean = live.fragment.view.includes("intervalMs: 60000");
  insist(probeImport && probeEffects && refreshed && polled && completed && activated,"live_figure issued no public-probe read");
  // The authorized initial read is one guarded activation action on the issued one-millisecond carrier:
  // the reducer clears the authoritative marker before its effect starts, and the marker is a runtime
  // resource so a restored record never re-runs the read.
  let activationCarrier: boolean = live.activations !== undefined && live.activations.length === 1 && live.activations[0].carrier === "activate_section_live" && live.activations[0].action === "Activate" && live.activations[0].field === "activation_needed";
  let activationView: boolean = live.fragment.view.includes("ui.Ticker(id: \"activate_section_live\", intervalMs: 1, running: false, onTick: action app.Activate {now: payload})");
  let activationGuard: boolean = live.fragment.helpers.includes("if (!state.activation_needed || state.refresh_pending) { return state; }") && live.fragment.helpers.includes("activation_needed: false, activation_action: action");
  let activationRuntime: boolean = live.fragment.fields.some((item: screens.Field): boolean => item.name === "activation_needed" && item.role === "runtime") && live.fragment.fields.some((item: screens.Field): boolean => item.name === "activation_action" && item.role === "runtime");
  insist(activationCarrier && activationView && activationGuard && activationRuntime,"live_figure issued no guarded activation action for its authorized initial read");
  insist(declaredPorts,"live_figure did not publish its five specification ports: "+livePorts.join(","));
  insist(unavailable && refreshControl && asofFromSource,"live_figure did not stay unavailable until a reply or published a fetch time as its observation time");
  insist(apiPoll,"live_figure did not poll an api source at sixty seconds");
  count = count+1;
  let searchEntry: catalogue.Configured = {need:"live",definition:definition("live_figure"),parameters:await accepts("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"Temperature\",\"path\":\"/current/temp\"}],\"source\":{\"url\":\"https://example.com/data.json\",\"mode\":\"search\"}}"),accepted:true,reason:""};
  let searchLive: screens.Instance = await catalogue.instantiate(searchEntry,bindings.create([]));
  insist(searchLive.fragment.view.includes("intervalMs: 300000"),"live_figure did not poll a search source at three hundred seconds");
  count = count+1;
  return count;
}

// The declared kind table facts: parameter ownership, ports, holes and eligibility. Every expectation
// is read from the specification row, never from the table under test.
export async function ownership(): Promise<string> {
  let result: Record<string, unknown> = {};
  let kinds: string[] = []; let executable: string[] = []; let live: string[] = [];
  for (let entry of catalogue.definitions()) { kinds[kinds.length] = entry.kind; if (entry.executable) { executable[executable.length] = entry.kind; } }
  result.kinds = kinds; result.count = kinds.length; result.executable = executable;
  let decimals: catalogue.Definition = definition("reading_status");
  let parameter: catalogue.Parameter = decimals.parameters[2];
  result.decimals = {name:parameter.name,type:parameter.type,required:parameter.required,origin:parameter.origin,owner:parameter.owner,fallback:parameter.fallback};
  result.facts = catalogue.facts(decimals);
  result.readerFacts = catalogue.facts(definition("search_list"));
  // The day-scoped kinds are executable and publish the ports of their specification rows.
  result.reminderFacts = catalogue.facts(definition("reminders"));
  result.doseFacts = catalogue.facts(definition("dose_schedule"));
  result.dueFacts = catalogue.facts(definition("due_items"));
  result.panelFacts = catalogue.facts(definition("intent_panel"));
  result.liveFacts = catalogue.facts(definition("live_figure"));
  // The public probe is a mechanism of this build rather than a discovered provider contract, so the live
  // figure is offered and instantiates with no frozen contract at all while an ordinary live parameter
  // still needs one.
  result.liveOffered = catalogue.offered(definition("live_figure"));
  result.panelOffered = catalogue.offered(definition("intent_panel"));
  result.listFacts = catalogue.facts(definition("checklist"));
  // A declaration without an origin is refused before any instance can be instantiated from it.
  let unowned: catalogue.Definition = {kind:"note",criteria:"x",parameters:[{name:"text",type:"string",required:false,fallback:"",maximum:512,origin:"",owner:"fill"}],mutable:true,publishes:[],reads:[],holes:[],requirements:[],executable:true};
  let refused: boolean = false;
  try { catalogue.validate(unowned); } catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } refused = error.message.includes("without an origin"); }
  result.unowned = refused;
  // A required parameter whose owner is a provider and no frozen contract is available cannot be
  // instantiated, and the refusal locates the kind and the parameter.
  let provider: catalogue.Definition = {kind:"note",criteria:"x",parameters:[{name:"text",type:"string",required:true,fallback:"",maximum:512,origin:"live",owner:"provider"}],mutable:true,publishes:[],reads:[],holes:[],requirements:[],executable:true};
  let located: string = "";
  try { await catalogue.instantiate({need:"probe",definition:provider,parameters:{title:"",subtitle:"",text:"x"},accepted:true,reason:""},bindings.create([])); }
  catch (unknownError) { let error: Error = unknownError as Error; if (error.name !== "CONSTRUCTION_SCHEMA") { throw error; } located = error.message; }
  result.located = located;
  // Eligibility facts are offered for the executable kinds only; a kind without an implementation
  // stays open and is never offered with a substitute definition.
  let offeredKinds: string[] = [];
  for (let entry of catalogue.definitions()) { if (catalogue.offered(entry)) { offeredKinds[offeredKinds.length] = entry.kind; } }
  result.offered = offeredKinds;
  let plan: plans.Plan = {title:"T",eyebrow:"",subtitle:"",inputs:[],constants:[],requirements:[],needs:[{id:"earn",type:"content",words:"Track the points I earn and redeem",quote:"",reads:[],required:true,spec:{}},{id:"measure",type:"content",words:"Record my weight measurement",quote:"",reads:[],required:true,spec:{}},{id:"tap",type:"content",words:"One-tap logging of a glass of water",quote:"",reads:[],required:true,spec:{}}],questions:[]};
  let alternatives: selecting.Alternative[] = catalogue.alternatives(plan);
  let selected: string[] = [];
  for (let alternative of alternatives) { for (let need of plan.needs) { if (alternative.need === need.id && (alternative.kind === "points_ledger" || alternative.kind === "reading_status" || alternative.kind === "quick_log")) { selected[selected.length] = need.id+"/"+alternative.kind; } } }
  result.preference = selected;
  // Reader optionality is published exactly as the specification row declares it: only the query,
  // currency, itinerary start and deadline readers are optional; every other reader is required, so
  // an unconnected one leaves its need unfilled instead of substituting a factual fallback.
  let optionalReaders: Record<string, unknown> = {"search_list":["query"],"master_list":["query"],"number_strip":["currency"],"breakdown_table":["currency"],"settle_up":["currency"],"itinerary":["start","deadline"]};
  let readerMismatch: string = "";
  for (let entry of catalogue.definitions()) {
    let expected: string[] = []; if (Object.hasOwn(optionalReaders,entry.kind)) { expected = optionalReaders[entry.kind] as string[]; }
    for (let port of entry.reads) {
      let optional: boolean = false; for (let name of expected) { if (name === port.name) { optional = true; } }
      if (port.optional !== optional) { readerMismatch = readerMismatch+entry.kind+"."+port.name+" "; }
    }
    for (let name of expected) {
      let found: boolean = false; for (let port of entry.reads) { if (port.name === name) { found = true; } }
      if (!found) { readerMismatch = readerMismatch+"missing "+entry.kind+"."+name+" "; }
    }
  }
  result.readers = readerMismatch;
  return s.encode(result);
}
// Decode acceptance and rejection for the rows and domains the full table declares.
export async function strictness(): Promise<number> {
  let count: number = 0;
  // Shared decimals at the reading_status parameter: -1 and 6 are admitted, -2, 7 and 1.5 reject.
  let bands: string = "\"bands\":[{\"upper\":5,\"label\":\"Low\",\"level\":0},{\"upper\":null,\"label\":\"High\",\"level\":2}]}";
  let minusOne: catalogue.Definition = definition("reading_status");
  count = count+1; await catalogue.decode(minusOne,JSON.parse("{\"unit\":\"kg\",\"decimals\":-1," + bands));
  count = count+1; await catalogue.decode(minusOne,JSON.parse("{\"unit\":\"kg\",\"decimals\":6," + bands));
  count = count+await rejects("reading_status","{\"unit\":\"kg\",\"decimals\":-2," + bands,"decimals -2");
  count = count+await rejects("reading_status","{\"unit\":\"kg\",\"decimals\":7," + bands,"decimals 7");
  count = count+await rejects("reading_status","{\"unit\":\"kg\",\"decimals\":1.5," + bands,"decimals 1.5");
  count = count+await rejects("reading_status","{\"unit\":\"kg\",\"bands\":[]}","empty reading bands");
  // A single unbounded band is the degenerate but valid nonempty band list: every reading is final.
  count = count+1; await catalogue.decode(definition("reading_status"),JSON.parse("{\"unit\":\"kg\",\"bands\":[{\"upper\":null,\"label\":\"Low\",\"level\":0}]}"));
  count = count+await rejects("reading_status","{\"unit\":\"kg\",\"bands\":[{\"upper\":5,\"label\":\"Low\",\"level\":0},{\"upper\":4,\"label\":\"High\",\"level\":2}]}","decreasing reading bands");
  count = count+await rejects("reading_status","{\"unit\":\"kg\",\"bands\":[{\"upper\":5,\"label\":\"Low\",\"level\":3},{\"upper\":null,\"label\":\"High\",\"level\":2}]}","reading level outside the status mapping");
  // Timer presets: one to six, positive durations, no empty list.
  count = count+1; await catalogue.decode(definition("timer"),JSON.parse("{\"presets\":[{\"label\":\"Timer\",\"seconds\":1500}]}"));
  count = count+await rejects("timer","{\"presets\":[]}","empty preset list");
  count = count+await rejects("timer","{\"presets\":[{\"label\":\"Timer\",\"seconds\":0}]}","nonpositive preset duration");
  count = count+await rejects("timer","{\"presets\":[{\"label\":\"a\",\"seconds\":1},{\"label\":\"b\",\"seconds\":1},{\"label\":\"c\",\"seconds\":1},{\"label\":\"d\",\"seconds\":1},{\"label\":\"e\",\"seconds\":1},{\"label\":\"f\",\"seconds\":1},{\"label\":\"g\",\"seconds\":1}]}","seven presets");
  // Stops: nonnegative integral minutes, paired coordinates inside their domains.
  count = count+1; await catalogue.decode(definition("itinerary"),JSON.parse("{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":0,\"latitude\":-90,\"longitude\":180}]}"));
  count = count+await rejects("itinerary","{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":-1}]}","negative stop minutes");
  count = count+await rejects("itinerary","{\"stops\":[{\"id\":\"a\",\"label\":\"Home\",\"minutes\":1.5}]}","fractional stop minutes");
