  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://1.2.3.0004/a.json\",\"mode\":\"api\"}}","over-wide IPv4 component");
  // The binding lane carries this same IPv6 list; decode refuses each one for itself, under the same
