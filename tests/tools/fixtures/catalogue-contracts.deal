  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2000::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[3ffe::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[::]/a.json\",\"mode\":\"api\"}}","unspecified IPv6 live source");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[4000::1]/a.json\",\"mode\":\"api\"}}","IPv6 above global unicast");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:0db8::1]/a.json\",\"mode\":\"api\"}}","zero-padded documentation IPv6");
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:0db7::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:0db9::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+1; await catalogue.decode(definition("live_figure"),JSON.parse("{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:200::1]/a.json\",\"mode\":\"api\"}}"));
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://[2001:DB8::1]/a.json\",\"mode\":\"api\"}}","upper-case documentation IPv6");
  // An out-of-range dotted quad, a fragment and a spelled port are the binding's refusals, not names.
