  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://1.2.3/a.json\",\"mode\":\"api\"}}","name ending in a numeric label");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://example.123/a.json\",\"mode\":\"api\"}}","name whose final label is numeric");
