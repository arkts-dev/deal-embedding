  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://100.64.0.1/a.json\",\"mode\":\"api\"}}","carrier-grade NAT live source");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://169.254.1.1/a.json\",\"mode\":\"api\"}}","link-local IPv4 live source");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://172.16.0.1/a.json\",\"mode\":\"api\"}}","private IPv4 live source");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://192.168.0.1/a.json\",\"mode\":\"api\"}}","private IPv4 live source");
  count = count+await rejects("live_figure","{\"figures\":[{\"id\":\"a\",\"label\":\"A\",\"path\":\"/a\"}],\"source\":{\"url\":\"https://198.18.0.1/a.json\",\"mode\":\"api\"}}","benchmarking IPv4 live source");
